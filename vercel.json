{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/intranet",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/intranet.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/intranet",
      "destination": "/intranet.html"
    },
    {
      "source": "/intranet/",
      "destination": "/intranet.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-:locale.xml",
      "destination": "/api/sitemap?locale=:locale"
    },
    {
      "source": "/:locale(de|en|es)/:hardware(ps5|ps4|ps3|psvita|psp)/:slug",
      "destination": "/api/guide?locale=:locale&hardware=:hardware&slug=:slug"
    },
    {
      "source": "/((?!api/|sw\\.js|manifest\\.webmanifest|offline\\.html|icons/|favicon|robots\\.txt|sitemap).*)",
      "destination": "/index.html"
    }
  ]
}
