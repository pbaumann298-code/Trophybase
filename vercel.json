        { "key": "Expires", "value": "0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "apps.trophybase.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "bugs.trophybase.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
