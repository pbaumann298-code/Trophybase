{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./src ./public ./shared ./package.json ./vercel.json",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/favicon-(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/intranet",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/intranet.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/intranet",
      "destination": "/intranet.html"
    },
    {
      "source": "/intranet/",
      "destination": "/intranet.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-:locale(ja|en|fr|es|de|it|nl|pt|pl|ru|ko|zh-hant|zh-hans|fi|sv|ar).xml",
      "destination": "/api/sitemap?locale=:locale"
    },
    {
      "source": "/:locale(ja|en|fr|es|de|it|nl|pt|pl|ru|ko|zh-hant|zh-hans|fi|sv|ar)/:hardware(ps5|ps4|ps3|psvita|psp)/:slug",
      "destination": "/api/guide?locale=:locale&hardware=:hardware&slug=:slug"
    },
    {
      "source": "/((?!api/|sw\\.js|manifest\\.webmanifest|offline\\.html|icons/|favicon|robots\\.txt|sitemap).*)",
      "destination": "/index.html"
    }
  ]
}
