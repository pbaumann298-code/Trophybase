<file path="src/components/AdminFollowupButton.jsx">
import { useEffect, useState } from 'react';
import { isAdminUser } from '../lib/adminAccess';
import {
  loadAdminFollowups,
  subscribeAdminFollowups,
  toggleAdminFollowup,
} from '../lib/adminFollowups';

/**
 * Merkt ein Spiel für die Intranet-Wiedervorlage. Nur für Admins sichtbar.
 */
function AdminFollowupButton({ user, gameId, className = '' }) {
  const userId = user?.id ?? '';
  const visible = isAdminUser(user) && Boolean(gameId);
  const [active, setActive] = useState(false);
  const [freitext, setFreitext] = useState('');
  const [saving, setSaving] = useState(false);
  const [hint, setHint] = useState('');

  useEffect(() => {
    if (!visible) return undefined;
    let cancelled = false;
    setFreitext('');
    setActive(false);
    const apply = (entries) => {
      if (cancelled) return;
      const entry = entries.find((item) => item.id === gameId);
      setActive(Boolean(entry));
      if (entry) setFreitext(String(entry.freitext ?? ''));
    };

    loadAdminFollowups().then(apply).catch((error) => {
      if (!cancelled) setHint(error.message || 'Wiedervorlage konnte nicht geladen werden.');
    });

    const unsubscribe = subscribeAdminFollowups(apply);
    return () => {
      cancelled = true;
      unsubscribe();
    };
  }, [visible, gameId]);

  if (!visible) return null;

  const handleClick = async () => {
    if (saving) return;
    setHint('');
    setSaving(true);
    try {
      const next = await toggleAdminFollowup(userId, { id: gameId, freitext });
      const now = next.some((entry) => entry.id === gameId);
      setActive(now);
      if (!now) setFreitext('');
      setHint(now ? 'Auf der Wiedervorlage.' : 'Von der Wiedervorlage genommen.');
      window.setTimeout(() => setHint(''), 2200);
    } catch (error) {
      setHint(error.message || 'Wiedervorlage konnte nicht gespeichert werden.');
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className={`inline-flex flex-col items-stretch sm:items-end gap-1.5 ${className}`}>
      <button
        type="button"
        onClick={handleClick}
        disabled={saving}
        aria-pressed={active}
        title={active ? 'Von der Wiedervorlage nehmen' : 'Für eine spätere Anpassung merken'}
        className={`inline-flex items-center justify-center gap-2 rounded-xl border px-4 py-2.5 text-xs font-mono font-bold uppercase tracking-wider transition-all duration-200 ${
          active
            ? 'border-amber-400/50 bg-amber-500/15 text-amber-300 hover:bg-amber-500/20'
            : 'border-zinc-700 bg-transparent text-zinc-400 hover:text-amber-200 hover:border-amber-500/30'
        }`}
      >
        <span aria-hidden className="text-base leading-none">{active ? '●' : '○'}</span>
        {active ? 'Wiedervorlage' : 'Zur Wiedervorlage'}
      </button>
      <label className="flex w-full flex-col gap-1 sm:w-64 sm:items-end">
        <span className="text-[10px] font-mono uppercase tracking-wider text-zinc-500">Freitext</span>
        <textarea
          value={freitext}
          onChange={(event) => setFreitext(event.target.value)}
          disabled={saving || active}
          rows={3}
          placeholder="Notiz zur späteren Anpassung"
          className="w-full resize-y rounded-xl border border-zinc-700 bg-[#121314] px-3 py-2 text-left text-xs text-zinc-200 placeholder:text-zinc-600 focus:border-amber-500/40 focus:outline-hidden disabled:opacity-60"
        />
      </label>
      {hint ? <span className="text-[10px] font-mono text-zinc-500">{hint}</span> : null}
    </div>
  );
}

export default AdminFollowupButton;
</file>

<file path="src/components/AdminHardwareSelect.jsx">
import { useEffect, useRef, useState } from 'react';
import { supabase } from '../pages/supabaseClient';
import { setGameHardware } from '../lib/intranetGameEdits';
import {
  URL_HARDWARE_SEGMENTS,
  collectHardwareSegments,
  formatHardwareValue,
  hardwareLabel,
  hardwareToUrlSegment,
} from '../lib/gameSlug';

const OPTIONS = URL_HARDWARE_SEGMENTS.map((segment) => ({
  segment,
  label: hardwareLabel(segment),
}));

/**
 * Mehrfachauswahl für games.hardware. Gespeichert wird „PS4/PS5“.
 * Die öffentliche URL und die Sitemap nutzen nur die neueste Konsole.
 */
function AdminHardwareSelect({ gameId, hardware, onSaved }) {
  const [open, setOpen] = useState(false);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState('');
  const rootRef = useRef(null);
  const selected = collectHardwareSegments(hardware);
  const label = formatHardwareValue(selected) || hardwareLabel(hardware) || 'Konsole wählen';

  useEffect(() => {
    if (!open) return undefined;
    const onPointer = (event) => {
      if (!rootRef.current?.contains(event.target)) setOpen(false);
    };
    document.addEventListener('pointerdown', onPointer);
    return () => document.removeEventListener('pointerdown', onPointer);
  }, [open]);

  const toggle = async (segment) => {
    if (!gameId || saving) return;
    const next = selected.includes(segment)
      ? selected.filter((item) => item !== segment)
      : [...selected, segment];
    if (next.length === 0) {
      setError('Mindestens eine Konsole bleibt ausgewählt.');
      return;
    }
    const previousUrl = hardwareToUrlSegment(hardware);
    setSaving(true);
    setError('');
    const { hardware: saved, error: saveError } = await setGameHardware(supabase, gameId, next);
    setSaving(false);
    if (saveError) {
      setError(saveError.message || 'Konsole konnte nicht gespeichert werden.');
      return;
    }
    onSaved?.(saved, hardwareToUrlSegment(saved) !== previousUrl);
  };

  return (
    <div ref={rootRef} className="relative text-right">
      <button
        type="button"
        disabled={!gameId || saving}
        aria-expanded={open}
        aria-label="hardware"
        onClick={() => setOpen((value) => !value)}
        className="rounded-md border border-sky-500/30 bg-sky-500/10 px-2 py-0.5 text-right text-sm font-semibold text-sky-300 disabled:opacity-50"
      >
        {saving ? '…' : label}
      </button>
      {open ? (
        <div className="absolute right-0 z-30 mt-1 w-64 rounded-xl border border-zinc-700 bg-[#1a1b1c] p-3 text-left">
          <p className="mb-2 font-mono text-[10px] uppercase tracking-wider text-zinc-500">
            Konsolen
          </p>
          <div className="flex flex-col gap-1.5">
            {OPTIONS.map((option) => (
              <label
                key={option.segment}
                className="flex cursor-pointer items-center gap-2 text-xs text-zinc-200"
              >
                <input
                  type="checkbox"
                  checked={selected.includes(option.segment)}
                  disabled={saving}
                  onChange={() => toggle(option.segment)}
                  className="h-3.5 w-3.5 rounded-sm border-zinc-600 bg-[#121314] text-[#00ff66] focus:ring-0"
                />
                {option.label}
              </label>
            ))}
          </div>
          <p className="mt-2 text-[10px] leading-relaxed text-zinc-500">
            Mehrere Haken landen als PS4/PS5 in der Datenbank. Sitemap und öffentliche Adresse
            nutzen nur die neueste Konsole. Ein zusätzlicher Haken erzeugt keine zweite URL.
            Wechselt die neueste, ändert sich die Adresse.
          </p>
        </div>
      ) : null}
      {error ? <p className="mt-1 text-[10px] font-mono text-red-400">{error}</p> : null}
    </div>
  );
}

export default AdminHardwareSelect;
</file>

