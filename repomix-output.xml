        </form>
      )}

      {/* ==================== 2. FILTER & GRUPPIERUNGS-LEISTE ==================== */}
      <div className="rounded-2xl border border-zinc-800 bg-[#121314] p-3.5 flex flex-col gap-3">
        <div className="flex flex-wrap items-center justify-between gap-3">
