/**
 * Setzt das Cover aus einem IGDB-Bildlink (oder einer Bild-URL) und markiert status.igdb als COMPLETED,
 * damit der nächste Pipeline-Lauf dieses Cover nicht wieder ersetzt.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} gameId
 * @param {string} imageUrl
 */
export async function setIntranetIgdbCover(supabase, gameId, imageUrl) {
  const id = String(gameId ?? '').trim();
  const coverUrl = normalizeCoverInputUrl(imageUrl);
  if (!id) return { coverUrl: null, coverMap: null, coverStatus: null, status: null, error: new Error('Kein Spiel ausgewählt.') };
  if (!coverUrl) {
    return {
      coverUrl: null,
      coverMap: null,
      coverStatus: null,
      status: null,
      error: new Error('Bitte einen gültigen Bildlink (z. B. von images.igdb.com) einfügen.'),
    };
  }

  const { data: current, error: readError } = await supabase
    .from(TABLES.games)
    .select(`${GAME_STRUCT.status}, ${GAME_I18N.coverUrl}`)
    .eq(GAME_PK, id)
    .maybeSingle();

  if (readError) return { coverUrl: null, coverMap: null, coverStatus: null, status: null, error: readError };

  const statusMap = { ...parseStatusMap(current?.[GAME_STRUCT.status]) };
  statusMap.igdb = 'COMPLETED';
  delete statusMap.igdb_reason;

  const existing = current?.[GAME_I18N.coverUrl];
  const cover = existing && typeof existing === 'object' && !Array.isArray(existing) ? { ...existing } : {};
  for (const key of Object.keys(cover)) cover[key] = coverUrl;
  cover.de = coverUrl;
  cover.en = coverUrl;

  const { data, error } = await supabase
    .from(TABLES.games)
    .update({
      [GAME_I18N.coverUrl]: cover,
      [GAME_STRUCT.status]: statusMap,
      [GAME_STRUCT.coverStatus]: 'valid',
      [GAME_STRUCT.coverNotes]: null,
    })
    .eq(GAME_PK, id)
    .select(GAME_STRUCT.status)
    .maybeSingle();

  if (error) return { coverUrl: null, coverMap: null, coverStatus: null, status: null, error };
  const resolvedStatus = parseStatusMap(data?.[GAME_STRUCT.status] ?? statusMap);
  patchHomeRailsCacheGame(id, {
    cover_url: cover,
    cover_status: 'valid',
    cover_notes: null,
    status: resolvedStatus,
  });
  return {
    coverUrl,
    coverMap: cover,
    coverStatus: 'valid',
    status: resolvedStatus,
    error: null,
  };
}

/**
 * Entfernt das Cover und den Pipeline-Schlüssel status.igdb.
 * Die übrigen Status-Werte, inklusive guide_de, bleiben stehen.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} gameId
 */
export async function clearIntranetCover(supabase, gameId) {
  const id = String(gameId ?? '').trim();
  if (!id) return { status: null, coverStatus: null, error: new Error('Kein Spiel ausgewählt.') };

  const { data: current, error: readError } = await supabase
    .from(TABLES.games)
    .select(GAME_STRUCT.status)
    .eq(GAME_PK, id)
    .maybeSingle();

  if (readError) return { status: null, coverStatus: null, error: readError };

  const statusMap = { ...parseStatusMap(current?.[GAME_STRUCT.status]) };
  delete statusMap.igdb;

  const { data, error } = await supabase
    .from(TABLES.games)
    .update({
      [GAME_I18N.coverUrl]: {},
      [GAME_STRUCT.status]: statusMap,
      [GAME_STRUCT.coverStatus]: null,
      [GAME_STRUCT.coverNotes]: null,
    })
    .eq(GAME_PK, id)
    .select(GAME_STRUCT.status)
    .maybeSingle();

  if (error) return { status: null, coverStatus: null, error };
  const resolvedStatus = parseStatusMap(data?.[GAME_STRUCT.status] ?? statusMap);
  patchHomeRailsCacheGame(id, {
    cover_url: {},
    cover_status: null,
    cover_notes: null,
    status: resolvedStatus,
  });
  return {
