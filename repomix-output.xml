/* Landingpage – Netflix-Karussell-Kategorien */

.home-landing {
  width: 100%;
  max-width: 80rem;
  min-width: 0;
  margin: 0 auto;
  padding: 2.75rem 1rem 4rem;
  box-sizing: border-box;
}

.home-hero {
  text-align: center;
  margin-bottom: 2rem;
}

.home-hero-brand {
  margin: 0 0 1.1rem;
  line-height: 1;
}

.tb-brand {
  display: inline-flex;
  align-items: baseline;
  font-weight: 900;
  letter-spacing: -0.03em;
  font-size: clamp(2rem, 5.5vw, 2.75rem);
  text-decoration: none;
  user-select: none;
  color: inherit;
}

.tb-name {
  background: linear-gradient(to bottom, #ffffff, #cbd5e1 55%, #94a3b8);
