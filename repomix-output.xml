<file path="src/lib/errorReport.js">
import {
  TABLES,
  ACHIEVEMENT_PK,
  ACHIEVEMENT_STRUCT,
  ACHIEVEMENT_I18N,
  GUIDE_PK,
  GUIDE_I18N,
} from './gameSchema';
import { getLocale } from './locale';
import { readReportableDataset } from './reportableAttrs';

export const ERROR_REPORT_STORAGE_BUCKET = 'error-report-evidence';

const EVIDENCE_MAX_EDGE = 1280;
const EVIDENCE_MAX_BYTES = 150 * 1024;
const EVIDENCE_WEBP_QUALITY = 0.8;

/** Alle Guide-Reiter melden auf dieselbe Spalte in game_guides. */
const GUIDE_REPORT_TARGET = {
  table: TABLES.guides,
  pkColumn: GUIDE_PK,
  jsonLangFields: {
    name: GUIDE_I18N.itemName,
  },
};

/**
 * data-type → Supabase-Ziel.
 * jsonLangFields sind JSONB-Sprachmaps, structFields einfache Textspalten.
 */
export const REPORT_ENTITY_MAP = {
  trophy: {
    table: TABLES.achievements,
    pkColumn: ACHIEVEMENT_PK,
    jsonLangFields: {
      name: ACHIEVEMENT_I18N.name,
      description: ACHIEVEMENT_I18N.desc,
      ai_translation: ACHIEVEMENT_I18N.aiTranslation,
      guide_tip: ACHIEVEMENT_I18N.guideTip,
      guide_tip_long: ACHIEVEMENT_I18N.guideTipLong,
    },
    structFields: {
      video_url: ACHIEVEMENT_STRUCT.videoUrl,
      icon_url: ACHIEVEMENT_STRUCT.iconUrl,
    },
  },
  guide_step: GUIDE_REPORT_TARGET,
  guide_item: GUIDE_REPORT_TARGET,
  item_name: GUIDE_REPORT_TARGET,
  boss: GUIDE_REPORT_TARGET,
};

/** data-type (HTML) → community_reports.content_type */
const CONTENT_TYPE_TO_DB = {
  trophy: 'trophy',
  guide_step: 'guide_step',
  guide_item: 'item_name',
  item_name: 'item_name',
  boss: 'item_name',
  ui_text: 'ui_text',
};

/**
 * @param {{ source: string, type: string, key: string, field: string }} attrs
 */
export function resolveReportMetadata(attrs) {
  if (!attrs) return null;
  const entity = REPORT_ENTITY_MAP[attrs.type];
  if (!entity) return null;
  const column =
    entity.jsonLangFields?.[attrs.field] ?? entity.structFields?.[attrs.field];
  if (!column) return null;

  return {
    sourceIdentifier: attrs.source,
    contentType: CONTENT_TYPE_TO_DB[attrs.type] ?? attrs.type,
    contentKey: String(attrs.key),
    fieldName: attrs.field,
    sourceTable: entity.table,
    sourceColumn: column,
    pkColumn: entity.pkColumn,
  };
}

/**
 * @param {Element} element
 */
export function metadataFromElement(element) {
  const attrs = readReportableDataset(element);
  return resolveReportMetadata(attrs);
}

/**
 * @param {Element} element
 * @returns {'text'|'image'|'video'}
 */
export function detectContentKind(element, selectedText) {
  if (!element) return 'text';
  const tag = element.tagName?.toUpperCase();
  if (tag === 'IMG') return 'image';
  if (tag === 'VIDEO' || tag === 'IFRAME') return 'video';
  if (element.dataset?.field === 'icon_url') return 'image';
  if (element.dataset?.field === 'video_url') return 'video';
  return selectedText ? 'text' : 'text';
}

/** @param {string} markedContent @param {'text'|'image'|'video'} contentKind */
export function normalizeOriginalText(markedContent, contentKind) {
  const text = markedContent?.trim();
  if (text) return text;
  if (contentKind === 'image') return '[Bild / Icon]';
  if (contentKind === 'video') return '[Video]';
  return '[Inhalt]';
}

function loadImageElement(file) {
  return new Promise((resolve, reject) => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      URL.revokeObjectURL(url);
      resolve(img);
    };
    img.onerror = () => {
      URL.revokeObjectURL(url);
      reject(new Error('Bild konnte nicht geladen werden.'));
    };
    img.src = url;
  });
}

function canvasToWebpBlob(canvas, quality) {
  return new Promise((resolve) => {
    canvas.toBlob(
      (blob) => resolve(blob),
      'image/webp',
      quality,
    );
  });
}

/**
 * Skaliert ein Beleg-Bild auf max. 1280px Kante und liefert WebP (< ~150 KB).
 * Bei Canvas-Fehler bleibt die Originaldatei.
 * @param {File} file
 * @returns {Promise<File>}
 */
export async function compressEvidenceImage(file) {
  if (!file || typeof file !== 'object') return file;
  if (!String(file.type || '').startsWith('image/')) return file;

  try {
    const image = await loadImageElement(file);
    const srcW = image.naturalWidth || image.width;
    const srcH = image.naturalHeight || image.height;
    if (!srcW || !srcH) return file;

    const scale = Math.min(1, EVIDENCE_MAX_EDGE / Math.max(srcW, srcH));
    const width = Math.max(1, Math.round(srcW * scale));
    const height = Math.max(1, Math.round(srcH * scale));

    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext('2d');
    if (!ctx) return file;
    ctx.drawImage(image, 0, 0, width, height);

    let quality = EVIDENCE_WEBP_QUALITY;
    let blob = await canvasToWebpBlob(canvas, quality);
    if (!blob) return file;

    while (blob.size > EVIDENCE_MAX_BYTES && quality > 0.45) {
      quality = Math.max(0.45, quality - 0.1);
      const next = await canvasToWebpBlob(canvas, quality);
      if (!next) break;
      blob = next;
    }

    const baseName = String(file.name || 'evidence').replace(/\.[^.]+$/, '') || 'evidence';
    const safeName = `${baseName.replace(/[^\w.-]+/g, '_').slice(0, 70)}.webp`;
    return new File([blob], safeName, { type: 'image/webp', lastModified: Date.now() });
  } catch {
    return file;
  }
}

/**
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} [userId]
 * @param {File} file
 */
export async function uploadErrorReportEvidence(supabase, userId, file) {
  const compressed = await compressEvidenceImage(file);
  const safeName = compressed.name.replace(/[^\w.-]+/g, '_').slice(0, 80);
  const folder = userId || 'anonymous';
  const path = `${folder}/${Date.now()}-${safeName}`;

  const { error } = await supabase.storage
    .from(ERROR_REPORT_STORAGE_BUCKET)
    .upload(path, compressed, {
      upsert: false,
      contentType: compressed.type || 'image/webp',
    });

  if (error) {
    console.error('error-report evidence upload:', error.message);
    return { url: null, error };
  }

  const { data } = supabase.storage.from(ERROR_REPORT_STORAGE_BUCKET).getPublicUrl(path);
  return { url: data?.publicUrl ?? null, error: null };
}

/** Mehrere Belege parallel hochladen. */
export async function uploadErrorReportEvidenceBatch(supabase, userId, files) {
  const list = files?.filter(Boolean) ?? [];
  if (list.length === 0) return { urls: [], error: null };

  const results = await Promise.all(
    list.map((file) => uploadErrorReportEvidence(supabase, userId, file)),
  );

  const failed = results.find((r) => r.error);
  if (failed?.error) {
    return { urls: results.map((r) => r.url).filter(Boolean), error: failed.error };
  }

  return { urls: results.map((r) => r.url).filter(Boolean), error: null };
}

/**
 * Speichert 1..n URLs in image_url (TEXT).
 * Ein Bild = plain URL; mehrere = JSON-Array (abwärtskompatibel).
 * @param {string[]} urls
 */
export function serializeReportImageUrls(urls) {
  const clean = (urls ?? []).filter(Boolean);
  if (clean.length === 0) return null;
  if (clean.length === 1) return clean[0];
  return JSON.stringify(clean);
}

/** Liest image_url – einzelne URL oder JSON-Array. */
export function parseReportImageUrls(imageUrl) {
  if (!imageUrl) return [];
  const trimmed = String(imageUrl).trim();
  if (trimmed.startsWith('[')) {
    try {
      const parsed = JSON.parse(trimmed);
      return Array.isArray(parsed) ? parsed.filter(Boolean) : [trimmed];
    } catch {
      return [trimmed];
    }
  }
  return [trimmed];
}

/**
 * Holt beim Öffnen des Modal-Fensters ein Einmal-Ticket für die Meldung.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {{
 *   metadata: ReturnType<typeof resolveReportMetadata>,
 *   markedContent: string,
 *   contentKind: string,
 * }} params
 */
export async function requestErrorReportTicket(supabase, { metadata, markedContent, contentKind }) {
  if (!metadata) return { ticketId: null, error: new Error('Kein meldbarer Datenkontext') };

  const originalText = normalizeOriginalText(markedContent, contentKind);

  const { data, error } = await supabase.rpc('tb_issue_report_ticket', {
    p_source: metadata.sourceIdentifier,
    p_content_type: metadata.contentType,
    p_content_key: metadata.contentKey,
    p_field_name: metadata.fieldName,
    p_original_text: originalText,
  });

  if (error) {
    console.error('tb_issue_report_ticket:', error.message);
    return { ticketId: null, error };
  }

  const ticketId = typeof data === 'string' ? data : data?.ticket_id || data || null;
  return { ticketId, error: null };
}

/**
 * Schleuse: public.tb_submit_error_report (Honeypot + elapsed_ms serverseitig).
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {{
 *   metadata: ReturnType<typeof resolveReportMetadata>,
 *   markedContent: string,
 *   contentKind: string,
 *   suggestion: string,
 *   imageUrl?: string | null,
 *   imageUrls?: string[],
 *   languageCode?: string,
 *   honeypot?: string,
 *   elapsedMs?: number,
 *   ticketId?: string | null,
 * }} payload
 */
export async function submitErrorReport(supabase, payload) {
  const {
    metadata,
    markedContent,
    contentKind,
    suggestion,
    imageUrl = null,
    imageUrls,
    languageCode = getLocale(),
    honeypot = '',
    elapsedMs = 0,
    ticketId = null,
  } = payload;

  if (!metadata) {
    return { data: null, error: new Error('Kein meldbarer Datenkontext') };
  }

  const originalText = normalizeOriginalText(markedContent, contentKind);
  const suggestedText = suggestion?.trim();

  if (!suggestedText) {
    return { data: null, error: new Error('Änderungsvorschlag ist erforderlich.') };
  }

  const storedImageUrl =
    imageUrls?.length > 0
      ? serializeReportImageUrls(imageUrls)
      : imageUrl;

  const { data, error } = await supabase.rpc('tb_submit_error_report', {
    p_source: metadata.sourceIdentifier,
    p_content_type: metadata.contentType,
    p_content_key: metadata.contentKey,
    p_field_name: metadata.fieldName,
    p_original_text: originalText,
    p_suggested_text: suggestedText,
    p_language_code: languageCode,
    p_image_url: storedImageUrl,
    p_honeypot: String(honeypot ?? ''),
    p_elapsed_ms: Number(elapsedMs) || 0,
    p_ticket_id: ticketId || null,
  });

  if (error) {
    console.error('tb_submit_error_report:', error.message);
    if (error.code === '42501' || /row-level security/i.test(error.message)) {
      return {
        data: null,
        error: new Error(
          'Speichern blockiert (RLS). Bitte in Supabase die RPC tb_submit_error_report prüfen oder neu anmelden.',
        ),
      };
    }
  }

  return { data, error };
}
</file>

<file path="src/lib/localUserProgress.js">
import { isUuid } from './gameModel';
import {
  GUIDE_PROGRESS_PREFIX,
  guideProgressStorageKey,
  readCompletedGuideItems,
  saveCompletedGuideItems,
} from './guideProgressStorage';
import {
  loadUnlockedTrophies,
  saveUnlockedTrophies,
} from './trophyProgressStorage';

export const PROGRESS_OWNER_KEY = 'tb_progress_owner';
export const PROGRESS_SYNCED_EVENT = 'tb_progress_synced';
export const PLATINUM_CHANGED_EVENT = 'tb_platinum_changed';
const PLATINUM_PREFIX = 'tb_platinum:';
const TROPHY_STEP_PREFIX = 't:';
const GUIDE_STEP_PREFIX = 'g:';

function canUseStorage() {
  return typeof window !== 'undefined' && typeof window.localStorage !== 'undefined';
}

export function loadProgressOwner() {
  if (!canUseStorage()) return null;
  try {
    const owner = String(window.localStorage.getItem(PROGRESS_OWNER_KEY) ?? '').trim();
    return owner || null;
  } catch {
    return null;
  }
}

export function saveProgressOwner(userId) {
  if (!canUseStorage()) return;
  try {
    const id = String(userId ?? '').trim();
    if (!id) window.localStorage.removeItem(PROGRESS_OWNER_KEY);
    else window.localStorage.setItem(PROGRESS_OWNER_KEY, id);
  } catch {
    /* ignore */
  }
}

function platinumStorageKey(gameId) {
  const id = String(gameId ?? '').trim();
  return id ? `${PLATINUM_PREFIX}${id}` : '';
}

export function loadLocalPlatinumFlag(gameId) {
  const key = platinumStorageKey(gameId);
  if (!key || !canUseStorage()) return false;
  try {
    return window.localStorage.getItem(key) === '1';
  } catch {
    return false;
  }
}

export function saveLocalPlatinumFlag(gameId, isPlatinum) {
  const key = platinumStorageKey(gameId);
  if (!key || !canUseStorage()) return;
  try {
    if (isPlatinum) window.localStorage.setItem(key, '1');
    else window.localStorage.removeItem(key);
    window.dispatchEvent(
      new CustomEvent(PLATINUM_CHANGED_EVENT, {
        detail: { gameId: String(gameId ?? '').trim(), isPlatinum: Boolean(isPlatinum) },
      }),
    );
  } catch {
    /* ignore */
  }
}

/** Schritte für die Cloud: Präfixe trennen Trophäen und Guide-IDs. */
export function encodeProgressSteps(trophyIds, guideIds) {
  const steps = [];
  const seen = new Set();
  for (const raw of trophyIds ?? []) {
    const id = String(raw ?? '').trim();
    if (!id) continue;
    const step = `${TROPHY_STEP_PREFIX}${id}`;
    if (seen.has(step)) continue;
    seen.add(step);
    steps.push(step);
  }
  for (const raw of guideIds ?? []) {
    const id = String(raw ?? '').trim();
    if (!id) continue;
    const step = `${GUIDE_STEP_PREFIX}${id}`;
    if (seen.has(step)) continue;
    seen.add(step);
    steps.push(step);
  }
  return steps;
}

export function decodeProgressSteps(steps) {
  const trophies = [];
  const guides = [];
  const trophySeen = new Set();
  const guideSeen = new Set();

  for (const raw of steps ?? []) {
    const value = String(raw ?? '').trim();
    if (!value) continue;

    if (value.startsWith(TROPHY_STEP_PREFIX)) {
      const id = value.slice(TROPHY_STEP_PREFIX.length).trim();
      if (!id || trophySeen.has(id)) continue;
      trophySeen.add(id);
      trophies.push(id);
      continue;
    }
    if (value.startsWith(GUIDE_STEP_PREFIX)) {
      const id = value.slice(GUIDE_STEP_PREFIX.length).trim();
      if (!id || guideSeen.has(id)) continue;
      guideSeen.add(id);
      guides.push(id);
      continue;
    }
    // Alt / ohne Präfix: UUID → Guide, sonst Trophäe
    if (isUuid(value)) {
      if (guideSeen.has(value)) continue;
      guideSeen.add(value);
      guides.push(value);
    } else {
      if (trophySeen.has(value)) continue;
      trophySeen.add(value);
      trophies.push(value);
    }
  }

  return { trophies, guides };
}

function sortedUnique(values) {
  return [...new Set((values ?? []).map((v) => String(v ?? '').trim()).filter(Boolean))].sort();
}

function stepsFingerprint(steps, isPlatinum) {
  return `${isPlatinum ? '1' : '0'}|${sortedUnique(steps).join('\n')}`;
}

export function progressMapsEqual(a, b) {
  const keys = new Set([...Object.keys(a ?? {}), ...Object.keys(b ?? {})]);
  for (const gameId of keys) {
    const left = a?.[gameId];
    const right = b?.[gameId];
    const leftSteps = left?.steps ?? [];
    const rightSteps = right?.steps ?? [];
    if (stepsFingerprint(leftSteps, left?.isPlatinum) !== stepsFingerprint(rightSteps, right?.isPlatinum)) {
      return false;
    }
  }
  return true;
}

export function isLocalSubsetOfCloud(localByGame, cloudByGame) {
  for (const [gameId, localRow] of Object.entries(localByGame ?? {})) {
    const cloudRow = cloudByGame?.[gameId];
    const cloudStepsSet = new Set(cloudRow?.steps ?? []);
    for (const step of localRow?.steps ?? []) {
      if (!cloudStepsSet.has(step)) return false;
    }
    if (localRow?.isPlatinum && !cloudRow?.isPlatinum) return false;
  }
  return true;
}

function countSteps(byGame) {
  let games = 0;
  let steps = 0;
  for (const row of Object.values(byGame ?? {})) {
    const n = (row?.steps ?? []).length;
    if (n > 0 || row?.isPlatinum) {
      games += 1;
      steps += n;
    }
  }
  return { games, steps };
}

/**
 * Alle lokalen Fortschritts-Shards einlesen (Trophäen + Guide + Platin-Flag).
 * @returns {Record<string, { steps: string[], isPlatinum: boolean }>}
 */
export function scanLocalProgressByGame() {
  if (!canUseStorage()) return {};

  const byGame = {};
  const ensure = (gameId) => {
    if (!byGame[gameId]) byGame[gameId] = { trophyIds: [], guideIds: [], isPlatinum: false };
    return byGame[gameId];
  };

  try {
    for (let i = 0; i < window.localStorage.length; i += 1) {
      const key = window.localStorage.key(i);
      if (!key) continue;

      if (key.startsWith('tb_unlocked_trophies:')) {
        const gameId = key.slice('tb_unlocked_trophies:'.length).trim();
        if (!isUuid(gameId)) continue;
        const map = loadUnlockedTrophies(gameId);
        const row = ensure(gameId);
        row.trophyIds = Object.keys(map);
        continue;
      }

      if (key.startsWith(GUIDE_PROGRESS_PREFIX)) {
        const gameId = key.slice(GUIDE_PROGRESS_PREFIX.length).trim();
        if (!isUuid(gameId)) continue;
        const map = readCompletedGuideItems(gameId);
        const row = ensure(gameId);
        row.guideIds = Object.keys(map);
        continue;
      }

      if (key.startsWith(PLATINUM_PREFIX)) {
        const gameId = key.slice(PLATINUM_PREFIX.length).trim();
        if (!isUuid(gameId) || window.localStorage.getItem(key) !== '1') continue;
        ensure(gameId).isPlatinum = true;
      }
    }
  } catch {
    return {};
  }

  const encoded = {};
  for (const [gameId, row] of Object.entries(byGame)) {
    const steps = encodeProgressSteps(row.trophyIds, row.guideIds);
    if (steps.length === 0 && !row.isPlatinum) continue;
    encoded[gameId] = { steps, isPlatinum: Boolean(row.isPlatinum) };
  }
  return encoded;
}

/** Aktuellen lokalen Stand eines Spiels als Cloud-Payload. */
export function localProgressPayloadForGame(gameId) {
  const id = String(gameId ?? '').trim();
  if (!isUuid(id)) return { steps: [], isPlatinum: false };
  const trophies = Object.keys(loadUnlockedTrophies(id));
  const guides = Object.keys(readCompletedGuideItems(id));
  return {
    steps: encodeProgressSteps(trophies, guides),
    isPlatinum: loadLocalPlatinumFlag(id),
  };
}

/**
 * Cloud-Stand (oder gemergten Stand) in localStorage schreiben.
 * @param {Record<string, { steps: string[], isPlatinum?: boolean }>} byGame
 * @param {{ replaceAll?: boolean }} [options] replaceAll löscht lokale Spiele die nicht in byGame sind
 */
export function applyProgressByGameToLocal(byGame, { replaceAll = false } = {}) {
  if (!canUseStorage()) return;

  const targetIds = new Set(Object.keys(byGame ?? {}).filter((id) => isUuid(id)));

  if (replaceAll) {
    const toRemove = [];
    try {
      for (let i = 0; i < window.localStorage.length; i += 1) {
        const key = window.localStorage.key(i);
        if (!key) continue;
        let gameId = '';
        if (key.startsWith('tb_unlocked_trophies:')) gameId = key.slice('tb_unlocked_trophies:'.length);
        else if (key.startsWith(GUIDE_PROGRESS_PREFIX)) gameId = key.slice(GUIDE_PROGRESS_PREFIX.length);
        else if (key.startsWith(PLATINUM_PREFIX)) gameId = key.slice(PLATINUM_PREFIX.length);
        else continue;
        gameId = gameId.trim();
        if (isUuid(gameId) && !targetIds.has(gameId)) toRemove.push(key);
      }
      for (const key of toRemove) window.localStorage.removeItem(key);
    } catch {
      /* ignore */
    }
  }

  for (const [gameId, row] of Object.entries(byGame ?? {})) {
    if (!isUuid(gameId)) continue;
    const { trophies, guides } = decodeProgressSteps(row?.steps ?? []);
    const trophyMap = {};
    for (const id of trophies) trophyMap[id] = true;
    const guideMap = {};
    for (const id of guides) guideMap[id] = true;
    saveUnlockedTrophies(gameId, trophyMap);
    saveCompletedGuideItems(gameId, guideMap);
    saveLocalPlatinumFlag(gameId, Boolean(row?.isPlatinum));
  }

  try {
    window.dispatchEvent(new CustomEvent(PROGRESS_SYNCED_EVENT, { detail: { gameIds: [...targetIds] } }));
  } catch {
    /* ignore */
  }
}

/** Union zweier Fortschrittskarten. */
export function mergeProgressByGame(localByGame, cloudByGame) {
  const merged = {};
  const ids = new Set([
    ...Object.keys(localByGame ?? {}),
    ...Object.keys(cloudByGame ?? {}),
  ]);
  for (const gameId of ids) {
    if (!isUuid(gameId)) continue;
    const local = localByGame?.[gameId];
    const cloud = cloudByGame?.[gameId];
    const localDecoded = decodeProgressSteps(local?.steps ?? []);
    const cloudDecoded = decodeProgressSteps(cloud?.steps ?? []);
    const steps = encodeProgressSteps(
      [...localDecoded.trophies, ...cloudDecoded.trophies],
      [...localDecoded.guides, ...cloudDecoded.guides],
    );
    const isPlatinum = Boolean(local?.isPlatinum || cloud?.isPlatinum);
    if (steps.length === 0 && !isPlatinum) continue;
    merged[gameId] = { steps, isPlatinum };
  }
  return merged;
}

/**
 * @param {{ localByGame?: object, cloudByGame?: object, owner?: string|null, userId?: string }} input
 * @returns {{ action: 'noop'|'pull'|'auto_merge'|'prompt', reason?: string, localByGame: object, cloudByGame: object, localStats: {games:number,steps:number}, cloudStats: {games:number,steps:number} }}
 */
export function planProgressSync({ localByGame, cloudByGame, owner, userId }) {
  const local = localByGame ?? {};
  const cloud = cloudByGame ?? {};
  const localStats = countSteps(local);
  const cloudStats = countSteps(cloud);
  const localEmpty = localStats.games === 0 && localStats.steps === 0;
  const equal = progressMapsEqual(local, cloud);

  if (localEmpty) {
    return {
      action: cloudStats.games > 0 ? 'pull' : 'noop',
      reason: 'local_empty',
      localByGame: local,
      cloudByGame: cloud,
      localStats,
      cloudStats,
    };
  }

  if (owner === userId) {
    if (equal) {
      return {
        action: 'noop',
        reason: 'in_sync',
        localByGame: local,
        cloudByGame: cloud,
        localStats,
        cloudStats,
      };
    }
    return {
      action: 'auto_merge',
      reason: 'divergent',
      localByGame: local,
      cloudByGame: cloud,
      localStats,
      cloudStats,
    };
  }

  if (equal || isLocalSubsetOfCloud(local, cloud)) {
    return {
      action: 'noop',
      reason: 'local_subset_of_cloud',
      localByGame: local,
      cloudByGame: cloud,
      localStats,
      cloudStats,
    };
  }

  // Browser hat eigene nicht-synchronisierte Daten, Profil leer / anders / anderer Owner → nachfragen
  return {
    action: 'prompt',
    reason: !owner
      ? 'first_login'
      : owner !== userId
        ? 'foreign_or_cleared'
        : cloudStats.games === 0
          ? 'profile_empty'
          : 'divergent',
    localByGame: local,
    cloudByGame: cloud,
    localStats,
    cloudStats,
  };
}

export { guideProgressStorageKey };
</file>

<file path="src/lib/relatedGames.js">
import {
  TABLES,
  GAME_PK,
  GAME_FK,
  GAME_STRUCT,
  GUIDE_STRUCT,
  isServerDeadType,
} from './gameSchema.js';
import { getGameSelect, applyGuideCatalogFilter, excludeQuickwinStyleTypes } from './gameQueries.js';
import { getGameUuid, mergeGameRows } from './gameModel.js';
import { fetchContentCreatorsForGame } from './contentCreators.js';
import { publicStudioCredits } from './studioCredits.js';

export const SIMILAR_GAMES_MIN = 4;
const RELATED_LIMIT = 8;
const SIMILAR_FETCH = 20;

function catalogOf(includeReady) {
  return { includeReady: Boolean(includeReady), publishedOnly: !includeReady };
}

function withoutServerDead(games) {
  return (games ?? []).filter((game) => !isServerDeadType(game?.[GAME_STRUCT.gameType]));
}

async function loadGamesByIds(supabase, gameIds, locale, includeReady, limit) {
  const ids = [...new Set((gameIds || []).filter(Boolean))];
  if (!ids.length) return [];

  const { data, error } = await excludeQuickwinStyleTypes(
    applyGuideCatalogFilter(
      supabase.from(TABLES.games).select(getGameSelect()).in(GAME_PK, ids),
      catalogOf(includeReady),
    ),
  )
    .order(GAME_STRUCT.createdAt, { ascending: false })
    .limit(limit);

  if (error) return [];
  return withoutServerDead(mergeGameRows(data ?? [], locale));
}

/**
 * Andere veröffentlichte Guides derselben Creator (schon ab einem Treffer).
 */
export async function fetchCreatorOtherGames(
  supabase,
  { gameUuid, creatorIds, locale, includeReady = false, limit = RELATED_LIMIT },
) {
  const ids = [...new Set((creatorIds || []).filter(Boolean))];
  const exclude = String(gameUuid ?? '').trim();
  if (!ids.length || !exclude) return [];

  const gameIds = [];
  const seen = new Set();
  for (let from = 0; from < 5000; from += 1000) {
    const { data: links, error } = await supabase
      .from(TABLES.gameGuideCreators)
      .select(GAME_FK)
      .in(GUIDE_STRUCT.creatorId, ids)
      .neq(GAME_FK, exclude)
      .order(GAME_FK, { ascending: true })
      .range(from, from + 999);

    if (error) return [];
    if (!links?.length) break;
    for (const row of links) {
      const id = row[GAME_FK];
      if (!id || seen.has(id)) continue;
      seen.add(id);
      gameIds.push(id);
    }
    if (links.length < 1000) break;
  }

  return loadGamesByIds(supabase, gameIds, locale, includeReady, limit);
}

/**
 * Ähnliche Guides (home_tags, sonst Studio). Die Liste bleibt leer, bis
 * mindestens SIMILAR_GAMES_MIN Treffer da sind.
 */
export async function fetchSimilarGames(supabase, { game, locale, includeReady = false }) {
  const exclude = getGameUuid(game);
  if (!exclude) return [];

  const homeTags = Array.isArray(game?.[GAME_STRUCT.homeTags])
    ? game[GAME_STRUCT.homeTags].map((t) => String(t ?? '').trim()).filter(Boolean)
    : [];
  const studio = publicStudioCredits(game).studio;
  const studioQuery = studio.length >= 3 ? studio : '';
  if (homeTags.length === 0 && !studioQuery) return [];

  const catalog = catalogOf(includeReady);

  async function byHomeTags(tags) {
    if (!tags || tags.length === 0) return [];
    const { data, error } = await excludeQuickwinStyleTypes(
      applyGuideCatalogFilter(
        supabase
          .from(TABLES.games)
          .select(getGameSelect())
          .overlaps(GAME_STRUCT.homeTags, tags)
          .neq(GAME_PK, exclude),
        catalog,
      ),
    )
      .order(GAME_STRUCT.createdAt, { ascending: false })
      .limit(SIMILAR_FETCH);

    if (error) return [];
    return withoutServerDead(mergeGameRows(data ?? [], locale));
  }

  async function byStudio(column, value) {
    if (!value) return [];
    const { data, error } = await excludeQuickwinStyleTypes(
      applyGuideCatalogFilter(
        supabase.from(TABLES.games).select(getGameSelect()).ilike(column, `%${value}%`).neq(GAME_PK, exclude),
        catalog,
      ),
    )
      .order(GAME_STRUCT.createdAt, { ascending: false })
      .limit(SIMILAR_FETCH);

    if (error) return [];
    return withoutServerDead(mergeGameRows(data ?? [], locale));
  }

  const [byTags, byDeveloper, byPublisher] = await Promise.all([
    byHomeTags(homeTags),
    byStudio(GAME_STRUCT.developer, studioQuery),
    byStudio(GAME_STRUCT.publisher, studioQuery),
  ]);

  const seen = new Set([exclude]);
  const merged = [];
  for (const row of [...byTags, ...byDeveloper, ...byPublisher]) {
    const id = getGameUuid(row);
    if (!id || seen.has(id)) continue;
    seen.add(id);
    merged.push(row);
  }

  if (merged.length < SIMILAR_GAMES_MIN) return [];
  return merged.slice(0, RELATED_LIMIT);
}

export async function loadRelatedGuides(supabase, game, { locale, includeReady = false, creators } = {}) {
  const creatorList =
    creators ?? (await fetchContentCreatorsForGame(supabase, game)).data ?? [];
  const creatorIds = creatorList.map((entry) => entry.id).filter(Boolean);
  const gameUuid = getGameUuid(game);

  const [creatorGames, similarGames] = await Promise.all([
    fetchCreatorOtherGames(supabase, { gameUuid, creatorIds, locale, includeReady }),
    fetchSimilarGames(supabase, { game, locale, includeReady }),
  ]);

  return { creatorGames, similarGames, creators: creatorList };
}
</file>

<file path="src/lib/userAreaQueries.js">
import { TABLES, GAME_FK, WATCHLIST, GAME_PK, isActiveWatchlistStatus } from './gameSchema';
import { fetchProfile } from './profileQueries';
import { fetchGamesByIds } from './gameQueries';
import { getGameTitle, getGameCover, mergeGameRecord } from './gameModel';
import { getLocale } from './locale';
import { saveLocalPlatinumFlag } from './localUserProgress';
import { scanLocalPlatinumGameIds } from './platinumGames';
import { setPreferredLocales, sanitizePreferredLocales } from './userPreferences';

/** Gruppierungsfelder aus der games-Zeile, flach auf dem Watchlist-Item. */
export function watchlistGameMeta(game) {
  return {
    releaseYear: game?.release_jahr ?? null,
    homeTags: Array.isArray(game?.home_tags) ? game.home_tags : [],
    hardware: game?.hardware ?? null,
    spielTyp: game?.spiel_typ ?? null,
  };
}

function isMissingTableError(error) {
  if (!error) return false;
  const msg = String(error.message ?? '').toLowerCase();
  return (
    error.code === '42P01' ||
    msg.includes('does not exist') ||
    msg.includes('relation') ||
    msg.includes('schema cache')
  );
}

/**
 * Normalisiert den Status aus user_watchlist auf eines der 3 Haupt-Buckets:
 * PLAYING, COMPLETED, BACKLOG.
 */
export function normalizeWatchlistBucket(row) {
  if (!row) return 'BACKLOG';
  const raw = String(row.status ?? '').trim().toUpperCase();
  const progress = Number(row.progress_percent ?? 0);
  const isPlatinum = Boolean(row.is_platinum) || Number(row.earned_trophies?.platinum ?? 0) > 0;

  if (
    raw === 'COMPLETED' ||
    raw === 'COMPLETED_NO_PLATINUM' ||
    raw === 'COMPLETED_PLATINUM' ||
    raw === 'DONE' ||
    isPlatinum ||
    progress >= 100
  ) {
    return 'COMPLETED';
  }
  if (raw === 'PLAYING' || raw === 'IN_PROGRESS' || raw === 'STARTED' || (raw === 'ACTIVE' && progress > 0)) {
    return 'PLAYING';
  }
  if (raw === 'BACKLOG' || raw === 'WATCHLIST' || raw === 'PLANNED' || raw === 'ACTIVE') {
    return 'BACKLOG';
  }
  if (progress > 0) return 'PLAYING';
  return 'BACKLOG';
}

/**
 * Lädt alle Daten für das neue User-Cockpit in einem Rutsch:
 * - public.profiles
 * - public.user_watchlist inkl. Join auf public.games
 * - public.user_game_ratings
 * - public.user_guide_progress
 */
export async function fetchUserCockpitBundle(supabase, userId, locale = getLocale()) {
  if (!userId) {
    return {
      profile: null,
      watchlistItems: [],
      ratingsByGame: {},
      guideChecklists: [],
      unreadInboxCount: 0,
      errors: {},
    };
  }

  const gamesJoinSelect =
    'id, platform_game_id, hardware, slug, slugs, spieltitel, cover_url, anzahl_trophaeen, spielzeit_komplettierer, schwierigkeit_highscore, status, publishing_status, published_locales, release_jahr, home_tags, spiel_typ, entwickler, publisher';

  const [profileRes, watchlistJoinRes, ratingsRes, progressRes] = await Promise.all([
    fetchProfile(supabase, userId),
    supabase
      .from(TABLES.watchlist)
      .select(`*, games(${gamesJoinSelect})`)
      .eq('user_id', userId)
      .order('last_played_at', { ascending: false, nullsFirst: false }),
    supabase
      .from(TABLES.gameRatings || 'user_game_ratings')
      .select('*')
      .eq('user_id', userId),
    supabase
      .from(TABLES.guideProgress)
      .select('*')
      .eq('user_id', userId)
      .order('updated_at', { ascending: false }),
  ]);

  const errors = {};
  if (profileRes.error) errors.profile = profileRes.error;

  // Fallback falls direkter PostgREST-Join wegen fehlender FK-Beziehung scheitert
  let rawWatchlistRows = watchlistJoinRes.data ?? [];
  if (watchlistJoinRes.error) {
    const fallbackWatchlist = await supabase
      .from(TABLES.watchlist)
      .select('*')
      .eq('user_id', userId)
      .order('updated_at', { ascending: false });

    if (fallbackWatchlist.error) {
      errors.watchlist = fallbackWatchlist.error;
    } else {
      rawWatchlistRows = fallbackWatchlist.data ?? [];
    }
  }

  if (ratingsRes.error && !isMissingTableError(ratingsRes.error)) {
    errors.ratings = ratingsRes.error;
  }
  if (progressRes.error && !isMissingTableError(progressRes.error)) {
    errors.guideProgress = progressRes.error;
  }

  const allProgressRows = progressRes.data ?? [];
  const rawProgressRows = allProgressRows.filter(
    (row) => Array.isArray(row.completed_steps) && row.completed_steps.length > 0,
  );
  const platinumProgressIds = new Set(
    allProgressRows
      .filter((row) => Boolean(row?.is_platinum))
      .map((row) => String(row[GAME_FK] ?? '').trim())
      .filter(Boolean),
  );
  for (const localPlatId of scanLocalPlatinumGameIds()) {
    platinumProgressIds.add(localPlatId);
  }

  const gamesById = new Map();
  for (const row of rawWatchlistRows) {
    const joined = Array.isArray(row.games) ? row.games[0] : row.games;
    if (joined && joined.id) {
      gamesById.set(String(joined.id), mergeGameRecord(joined, locale));
    }
  }

  const missingGameIds = new Set();
  for (const row of rawWatchlistRows) {
    const gid = String(row[GAME_FK] ?? '').trim();
    if (gid && !gamesById.has(gid)) missingGameIds.add(gid);
  }
  for (const row of allProgressRows) {
    const gid = String(row[GAME_FK] ?? '').trim();
    if (gid && !gamesById.has(gid)) missingGameIds.add(gid);
  }
  for (const gid of platinumProgressIds) {
    if (gid && !gamesById.has(gid)) missingGameIds.add(gid);
  }

  if (missingGameIds.size > 0) {
    const { data: fetchedGames } = await fetchGamesByIds(
      supabase,
      [...missingGameIds],
      locale,
    );
    for (const g of fetchedGames ?? []) {
      const gid = String(g[GAME_PK] ?? g.id ?? '').trim();
      if (gid) gamesById.set(gid, g);
    }
  }

  const ratingsByGame = {};
  for (const r of ratingsRes.data ?? []) {
    const gid = String(r[GAME_FK] ?? '').trim();
    if (gid) {
      ratingsByGame[gid] = {
        id: r.id,
        gameId: gid,
        difficulty: r.difficulty != null ? Number(r.difficulty) : null,
        completionHours: r.completion_hours != null ? Number(r.completion_hours) : null,
        funRating: r.fun_rating != null ? Number(r.fun_rating) : null,
        comment: r.comment ?? '',
        updatedAt: r.updated_at ?? r.created_at ?? null,
      };
    }
  }

  const seenWatchlistGameIds = new Set();
  const watchlistItems = rawWatchlistRows.map((row) => {
    const gameId = String(row[GAME_FK] ?? '').trim();
    if (gameId) seenWatchlistGameIds.add(gameId);
    const joinedRaw = Array.isArray(row.games) ? row.games[0] : row.games;
    const game = gamesById.get(gameId) || (joinedRaw ? mergeGameRecord(joinedRaw, locale) : null);
    const earned =
      row.earned_trophies && typeof row.earned_trophies === 'object'
        ? {
            platinum: Number(row.earned_trophies.platinum ?? 0),
            gold: Number(row.earned_trophies.gold ?? 0),
            silver: Number(row.earned_trophies.silver ?? 0),
            bronze: Number(row.earned_trophies.bronze ?? 0),
          }
        : { platinum: 0, gold: 0, silver: 0, bronze: 0 };

    const rawStatus = String(row.status ?? '').trim().toLowerCase();
    const completedWithoutPlatinum = rawStatus === 'completed_no_platinum';
    const isPlatinum =
      !completedWithoutPlatinum &&
      (Boolean(row.is_platinum) || earned.platinum > 0 || platinumProgressIds.has(gameId));
    const progressPercent = isPlatinum
      ? 100
      : Math.max(0, Math.min(100, Number(row.progress_percent ?? 0)));
    const playtimeHours = Math.max(0, Number(row.playtime_hours ?? 0));
    const bucket = normalizeWatchlistBucket({
      ...row,
      is_platinum: isPlatinum,
      progress_percent: progressPercent,
      earned_trophies: earned,
    });

    return {
      watchlistId: row.id ?? `${userId}:${gameId}`,
      gameId,
      status: String(row.status ?? 'BACKLOG'),
      bucket,
      completedWithoutPlatinum,
      progressPercent,
      isPlatinum,
      playtimeHours,
      titleId: row.title_id ? String(row.title_id).trim() : null,
      earnedTrophies: isPlatinum && earned.platinum === 0 ? { ...earned, platinum: 1 } : earned,
      lastPlayedAt: row.last_played_at ?? row.updated_at ?? null,
      game,
      title: getGameTitle(game, locale) || gameId || 'Unbekanntes Spiel',
      cover: getGameCover(game, locale) || null,
      totalTrophies: game?.anzahl_trophaeen ?? null,
      guideCompletionTime: game?.spielzeit_komplettierer ?? null,
      rating: ratingsByGame[gameId] ?? null,
      ...watchlistGameMeta(game),
    };
  });

  // Synchronisierte Platin-Spiele aus user_guide_progress / lokalem Speicher ergänzen, falls noch nicht in user_watchlist
  for (const platGameId of platinumProgressIds) {
    if (!platGameId || seenWatchlistGameIds.has(platGameId)) continue;
    const game = gamesById.get(platGameId) ?? null;
    if (!game) continue;
    seenWatchlistGameIds.add(platGameId);
    const progRow = allProgressRows.find((r) => String(r[GAME_FK] ?? '').trim() === platGameId);
    watchlistItems.push({
      watchlistId: `sync:${userId}:${platGameId}`,
      gameId: platGameId,
      status: 'COMPLETED',
      bucket: 'COMPLETED',
      completedWithoutPlatinum: false,
      progressPercent: 100,
      isPlatinum: true,
      playtimeHours: 0,
      titleId: null,
      earnedTrophies: { platinum: 1, gold: 0, silver: 0, bronze: 0 },
      lastPlayedAt: progRow?.updated_at ?? null,
      game,
      title: getGameTitle(game, locale) || platGameId || 'Unbekanntes Spiel',
      cover: getGameCover(game, locale) || null,
      totalTrophies: game?.anzahl_trophaeen ?? null,
      guideCompletionTime: game?.spielzeit_komplettierer ?? null,
      rating: ratingsByGame[platGameId] ?? null,
      ...watchlistGameMeta(game),
    });
  }

  const guideChecklists = rawProgressRows.map((row) => {
    const gameId = String(row[GAME_FK] ?? '').trim();
    const game = gamesById.get(gameId) ?? null;
    const steps = Array.isArray(row.completed_steps)
      ? row.completed_steps.map((s) => String(s ?? '').trim()).filter(Boolean)
      : [];
    return {
      gameId,
      steps,
      stepsCount: steps.length,
      isPlatinum: Boolean(row.is_platinum),
      updatedAt: row.updated_at ?? null,
      game,
      title: getGameTitle(game, locale) || gameId,
      cover: getGameCover(game, locale) || null,
    };
  });

  return {
    profile: profileRes.data ?? null,
    watchlistItems,
    ratingsByGame,
    guideChecklists,
    unreadInboxCount: 0,
    errors,
  };
}

/**
 * Speichert oder aktualisiert ein 1-Klick-Rating (Platin-Zeit + Schwierigkeit) in public.user_game_ratings.
 */
export async function upsertUserGameRating(
  supabase,
  userId,
  gameId,
  { completionHours, difficulty, funRating = null, comment = null } = {},
) {
  if (!userId || !gameId) {
    return { data: null, error: new Error('Anmeldung und Spiel-ID erforderlich.') };
  }

  const parsedHours =
    completionHours !== '' && completionHours != null && Number.isFinite(Number(completionHours))
      ? Math.max(0, Math.round(Number(completionHours) * 10) / 10)
      : null;

  const parsedDifficulty =
    difficulty !== '' && difficulty != null && Number.isFinite(Number(difficulty))
      ? Math.max(1, Math.min(10, Math.round(Number(difficulty))))
      : null;

  if (parsedHours == null && parsedDifficulty == null) {
    return {
      data: null,
      error: new Error('Bitte gib mindestens eine Platin-Zeit (Stunden) oder Schwierigkeit (1–10) an.'),
    };
  }

  const now = new Date().toISOString();
  const payload = {
    user_id: userId,
    [GAME_FK]: gameId,
    completion_hours: parsedHours,
    difficulty: parsedDifficulty,
    updated_at: now,
  };
  if (funRating != null) payload.fun_rating = Number(funRating);
  if (comment != null) payload.comment = String(comment);

  const table = TABLES.gameRatings || 'user_game_ratings';

  // Versuch 1: Upsert über (user_id, game_id)
  const { data, error } = await supabase
    .from(table)
    .upsert(payload, { onConflict: 'user_id,game_id' })
    .select('*')
    .maybeSingle();

  if (!error) {
    return { data, error: null };
  }

  // Fallback falls kein Unique-Constraint auf (user_id, game_id) existiert: erst prüfen, dann update/insert
  const { data: existing } = await supabase
    .from(table)
    .select('id')
    .eq('user_id', userId)
    .eq(GAME_FK, gameId)
    .maybeSingle();

  if (existing?.id) {
    const upd = await supabase
      .from(table)
      .update(payload)
      .eq('id', existing.id)
      .select('*')
      .single();
    return { data: upd.data, error: upd.error };
  }

  const ins = await supabase.from(table).insert(payload).select('*').single();
  return { data: ins.data, error: ins.error };
}

/**
 * Aktualisiert den Watchlist-Status (z. B. PLAYING, COMPLETED, completed_no_platinum, BACKLOG) eines Spiels.
 */
export async function updateWatchlistEntryStatus(
  supabase,
  userId,
  gameId,
  nextStatus,
  { markPlatinum = null, progressPercent = null } = {},
) {
  if (!userId || !gameId) {
    return { error: new Error('Anmeldung und Spiel-ID erforderlich.') };
  }
  const now = new Date().toISOString();
  const payload = {
    user_id: userId,
    [GAME_FK]: gameId,
    status: nextStatus,
    last_played_at: now,
    updated_at: now,
  };
  if (progressPercent != null) {
    payload[WATCHLIST.progress] = Math.max(0, Math.min(100, Number(progressPercent)));
  } else if (markPlatinum === true) {
    payload[WATCHLIST.progress] = 100;
  }

  let { error } = await supabase
    .from(TABLES.watchlist)
    .upsert(payload, { onConflict: WATCHLIST.onConflict });

  if (error) {
    const upd = await supabase
      .from(TABLES.watchlist)
      .update({
        status: nextStatus,
        ...(payload[WATCHLIST.progress] != null ? { [WATCHLIST.progress]: payload[WATCHLIST.progress] } : {}),
        updated_at: now,
      })
      .eq('user_id', userId)
      .eq(GAME_FK, gameId);
    error = upd.error;
  }

  if (markPlatinum === true) {
    saveLocalPlatinumFlag(gameId, true);
    const { data: existingProg } = await supabase
      .from(TABLES.guideProgress)
      .select('completed_steps')
      .eq('user_id', userId)
      .eq(GAME_FK, gameId)
      .maybeSingle();
    await supabase.from(TABLES.guideProgress).upsert(
      {
        user_id: userId,
        [GAME_FK]: gameId,
        completed_steps: Array.isArray(existingProg?.completed_steps)
          ? existingProg.completed_steps
          : [],
        is_platinum: true,
        updated_at: now,
      },
      { onConflict: 'user_id,game_id' },
    );
  } else if (markPlatinum === false) {
    saveLocalPlatinumFlag(gameId, false);
    const { data: existingProg } = await supabase
      .from(TABLES.guideProgress)
      .select('completed_steps, is_platinum')
      .eq('user_id', userId)
      .eq(GAME_FK, gameId)
      .maybeSingle();
    if (existingProg?.is_platinum) {
      await supabase
        .from(TABLES.guideProgress)
        .update({ is_platinum: false, updated_at: now })
        .eq('user_id', userId)
        .eq(GAME_FK, gameId);
    }
  }

  return { error };
}

/**
 * Speichert die Mehrfachauswahl der User-Sprachen (für Guides & spätere Online-Trophäen-Verabredungen)
 * in localStorage (`preferred_locales`) sowie in Supabase User-Metadata / Profil.
 */
export async function saveUserPreferredLocales(supabase, userId, locales) {
  const sanitized = sanitizePreferredLocales(locales);
  setPreferredLocales(sanitized);

  if (!supabase || !userId) {
    return { locales: sanitized, error: null };
  }

  try {
    await supabase.auth.updateUser({
      data: { preferred_locales: sanitized },
    });
  } catch {
    /* ignore auth metadata error */
  }

  try {
    await supabase
      .from(TABLES.profiles)
      .update({ preferred_locales: sanitized, updated_at: new Date().toISOString() })
      .eq('id', userId);
  } catch {
    /* Spalte preferred_locales ist auf profiles optional */
  }

  return { locales: sanitized, error: null };
}

/**
 * Setzt die Durchlauf-Checkliste (completed_steps) eines Spiels in user_guide_progress sicher auf [] zurück,
 * ohne den PSN-Trophäenstatus (is_platinum oder user_watchlist) zu löschen.
 */
export async function resetUserGuideChecklist(supabase, userId, gameId, keepPlatinum = false) {
  if (!userId || !gameId) {
    return { error: new Error('Anmeldung und Spiel-ID erforderlich.') };
  }

  const now = new Date().toISOString();
  if (keepPlatinum) {
    const { error } = await supabase
      .from(TABLES.guideProgress)
      .update({ completed_steps: [], updated_at: now })
      .eq('user_id', userId)
      .eq(GAME_FK, gameId);
    return { error };
  }

  const { error } = await supabase
    .from(TABLES.guideProgress)
    .update({ completed_steps: [], updated_at: now })
    .eq('user_id', userId)
    .eq(GAME_FK, gameId);
  return { error };
}

export async function fetchUserAreaStats(supabase, userId) {
  if (!userId) {
    return {
      profile: null,
      profileError: null,
      watchlistCount: 0,
      earnedTrophiesCount: 0,
      unreadInboxCount: 0,
      errors: {},
    };
  }

  const [profileRes, watchlistRes, earnedRes, inboxRes] = await Promise.all([
    fetchProfile(supabase, userId),
    supabase
      .from(TABLES.watchlist)
      .select('id', { count: 'exact', head: true })
      .eq('user_id', userId),
    supabase
      .from(TABLES.earnedTrophies)
      .select('id', { count: 'exact', head: true })
      .eq('user_id', userId),
    supabase
      .from(TABLES.inbox)
      .select('id', { count: 'exact', head: true })
      .eq('user_id', userId)
      .eq('is_read', false),
  ]);

  const errors = {};
  if (profileRes.error) errors.profile = profileRes.error;
  if (watchlistRes.error) errors.watchlist = watchlistRes.error;
  if (earnedRes.error) errors.earnedTrophies = earnedRes.error;
  if (inboxRes.error) errors.inbox = inboxRes.error;

  return {
    profile: profileRes.data,
    profileError: profileRes.error,
    watchlistCount: watchlistRes.count ?? 0,
    earnedTrophiesCount: earnedRes.count ?? 0,
    unreadInboxCount: inboxRes.count ?? 0,
    errors,
  };
}

export async function fetchProfileWatchlistPreview(supabase, userId, limit = 6, locale = getLocale()) {
  if (!userId) return { items: [], error: null };

  const { data: watchlistRows, error: watchError } = await supabase
    .from(TABLES.watchlist)
    .select(`id, ${GAME_FK}, ${WATCHLIST.progress}, ${WATCHLIST.status}, updated_at`)
    .eq('user_id', userId)
    .order('updated_at', { ascending: false })
    .limit(limit * 2);

  if (watchError) {
    return { items: [], error: watchError };
  }

  const activeRows = (watchlistRows ?? [])
    .filter((row) => isActiveWatchlistStatus(row[WATCHLIST.status]))
    .slice(0, limit);

  const gameIds = [...new Set(activeRows.map((row) => row[GAME_FK]).filter(Boolean))];
  let gamesById = new Map();

  if (gameIds.length > 0) {
    const { data: games, error: gamesError } = await fetchGamesByIds(supabase, gameIds, locale);

    if (gamesError) {
      return { items: [], error: gamesError };
    }

    for (const game of games ?? []) {
      gamesById.set(game[GAME_PK], game);
    }
  }

  const items = activeRows.map((row) => {
    const game = gamesById.get(row[GAME_FK]) ?? null;
    return {
      watchlistId: row.id,
      gameId: row[GAME_FK],
      title: getGameTitle(game, locale) || row[GAME_FK],
      cover: getGameCover(game, locale) || null,
      progress: row[WATCHLIST.progress] ?? 0,
      game,
    };
  });

  return { items, error: null };
}

export function getUserAreaErrorHint(error, area) {
  if (!error) return null;
  if (isMissingTableError(error)) {
    if (area === 'profile') {
      return 'Die Tabelle „profiles“ fehlt in Supabase. Bitte supabase/profiles.sql im SQL-Editor ausführen.';
    }
    if (area === 'earnedTrophies') {
      return 'Die Tabelle „user_earned_trophies“ fehlt. Bitte supabase/user_earned_trophies.sql ausführen.';
    }
    return `Datenbank-Tabelle für „${area}“ ist noch nicht eingerichtet.`;
  }
  return error.message;
}
