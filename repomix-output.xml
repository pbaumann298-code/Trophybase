    } catch (err) {
      setError(`Zeile konnte nicht hinzugefügt werden: ${err.message}`);
    } finally {
      setActionBusy(false);
    }
  };

  // 10d. Creator Workflow-Status ändern (Qwen-VL Queue / Ready for Admin / Creator Recording)
  const handleSetCreatorWorkflowStatus = async (targetStatus, optionalVideoUrl = null) => {
    if (!selectedGameId || actionBusy) return;
    setActionBusy(true);
    setError('');
    setNotice('');

    try {
      const cleanUrl = optionalVideoUrl ? String(optionalVideoUrl).trim() : null;
      const { error: rpcErr } = await supabase.rpc('tb_set_creator_workflow_status', {
        p_game_id: selectedGameId,
        p_status: targetStatus,
        p_video_url: cleanUrl,
      });

      if (rpcErr) {
        throw new Error(rpcErr.message);
      }

      setStagingRows((prev) =>
        prev.map((row) => {
          if (row.game_id !== selectedGameId) return row;
          const nextUrl =
            cleanUrl && !String(row.video_url ?? '').trim() ? cleanUrl : row.video_url;
          return {
            ...row,
            workflow_status: targetStatus,
            video_url: nextUrl,
          };
        })
      );

      if (cleanUrl && !activeVideoUrl) {
        setActiveVideoUrl(cleanUrl);
      }

      setShowQwenModal(false);
      const statusMeta = getWorkflowStatusMeta(targetStatus);
      if (targetStatus === 'QWEN_QUEUE') {
        setNotice(
          `🤖 Video an Qwen-VL gesendet! Status: "${statusMeta.label}". Sobald die KI-Timestamps eingetragen sind, wechselt das Projekt in den Creator-Feinschliff.`
        );
      } else if (targetStatus === 'READY_FOR_ADMIN') {
        setNotice(
          `🚀 Guide für "${getLocalizedTitle(selectedGame?.spieltitel)}" erfolgreich ans Admin-Gate zur Freigabe eingereicht!`
        );
      } else {
        setNotice(`✓ Workflow-Status geändert auf: ${statusMeta.label}`);
      }
    } catch (err) {
      setError(`Workflow-Status konnte nicht aktualisiert werden: ${err.message}`);
    } finally {
      setActionBusy(false);
    }
  };

  // 10e. Killer-Feature: YouTube-Chapters in die Zwischenablage kopieren
  const handleCopyYouTubeChapters = async () => {
    const sourceRows = visibleCreatorRows.length > 0 ? visibleCreatorRows : currentCreatorRows;
    if (!sourceRows.length) {
      setError('Keine Guide-Zeilen zum Kopieren vorhanden.');
      return;
    }

    // Falls eine aktive Video-URL gewählt ist und mehrere Videos existieren, auf das aktive Video filtern
    const baseVideoUrl = activeVideoUrl
      ? String(activeVideoUrl).split('&t=')[0].split('?t=')[0].trim()
      : '';
    const rowsForActiveVideo = baseVideoUrl
      ? sourceRows.filter((r) => {
          const rUrl = String(r.video_url ?? '').split('&t=')[0].split('?t=')[0].trim();
          return !rUrl || rUrl === baseVideoUrl;
        })
      : sourceRows;

    const targetRows = rowsForActiveVideo.length > 0 ? rowsForActiveVideo : sourceRows;

    const sortedByTime = [...targetRows].sort((a, b) => {
      const secA = parseTimecodeToSeconds(a.timestamp) ?? 0;
      const secB = parseTimecodeToSeconds(b.timestamp) ?? 0;
      if (secA !== secB) return secA - secB;
      const idA = Number.parseInt(String(a.guide_id ?? '').replace(/\D/g, ''), 10) || 0;
      const idB = Number.parseInt(String(b.guide_id ?? '').replace(/\D/g, ''), 10) || 0;
      return idA - idB;
    });

    const lines = [];
    const firstSec =
      sortedByTime.length > 0 ? (parseTimecodeToSeconds(sortedByTime[0].timestamp) ?? 0) : 0;

    if (firstSec > 0) {
      lines.push('00:00 Intro');
    }

    for (const row of sortedByTime) {
      const sec = parseTimecodeToSeconds(row.timestamp) ?? 0;
      const rawTs = String(row.timestamp ?? '').trim();
      const formattedTs =
        rawTs && /^\d{1,2}:\d{2}(?::\d{2})?$/.test(rawTs)
          ? rawTs.replace(/^(\d):/, '0$1:')
          : formatSecondsAsTimecode(sec);

      const itemName = getLocalizedItemName(row.item_name).trim() || `Schritt ${row.guide_id ?? ''}`.trim();
      const rawGroup =
        getLocalizedItemName(row.chronological_group).trim() ||
        getLocalizedItemName(row.category_group).trim() ||
        getLocalizedItemName(row.boss_group).trim();
      const groupPrefix =
        rawGroup &&
        rawGroup.toLowerCase() !== 'walkthrough' &&
        rawGroup.toLowerCase() !== itemName.toLowerCase()
          ? `${rawGroup} – `
          : '';

      lines.push(`${formattedTs} ${groupPrefix}${itemName}`);
    }

    const guidePath =
      (selectedGame && intranetGameHref(selectedGame)) ||
      `/guide/${encodeURIComponent(selectedGame?.slug || selectedGameId || '')}`;
    const fullGuideUrl = `https://trophybase.app${guidePath.startsWith('/') ? guidePath : `/${guidePath}`}`;
    const gameTitle = getLocalizedTitle(selectedGame?.spieltitel);

    const clipboardBlock = [
      `🏆 Interaktiver Platin- & Sammelobjekte-Guide zu ${gameTitle}: ${fullGuideUrl}`,
      '',
      '⏱️ Kapitel / Timestamps:',
      ...lines,
    ].join('\n');

    try {
      await navigator.clipboard.writeText(clipboardBlock);
      setNotice(
        `📋 YouTube-Chapters (${lines.length} Einträge) inkl. TrophyBase-Link in die Zwischenablage kopiert!`
      );
    } catch (err) {
      setError(`Kopieren in die Zwischenablage fehlgeschlagen: ${err.message}`);
    }
  };

  const handleEnqueueWholeVideoScrape = async () => {
    if (videoScrapeBusy || !selectedGameId) return;
    const url = videoScrapeUrl.trim();
    if (!url) return;

    setVideoScrapeBusy(true);
    setVideoScrapeHint('');
    setVideoScrapeError(false);

    const { error } = await enqueueTrophyVideoForTimestampScrape(supabase, {
      gameId: selectedGameId,
      platformGameId: resolveDraftPlatformGameId(selectedGame),
      trophyId: '0',
      trophyName: videoScrapeGroupName.trim() || getLocalizedTitle(selectedGame?.spieltitel),
      videoUrl: url,
      targetGroupCol: videoScrapeTargetCol,
      customGroupName: videoScrapeGroupName,
    });

    if (error) {
      setVideoScrapeBusy(false);
      setVideoScrapeError(true);
      setVideoScrapeHint(error.message || 'Konnte nicht in die Queue gelegt werden.');
      return;
    }

    if (!videoScrapeDropDraft) {
      setVideoScrapeBusy(false);
      setVideoScrapeError(false);
      setVideoScrapeHint('✓ In Queue gelegt (Trophy #0)');
      return;
    }

    const gameId = selectedGameId;
    const creatorName = selectedCreatorName;
    const removed = stagingRows.filter(
      (row) => row.game_id === gameId && creatorKeyOfRow(row) === creatorName,
    );
    const realCreatorName =
      creatorName &&
      creatorName !== 'Unbekannter Creator' &&
      !String(creatorName).startsWith('Batch:');

    try {
      if (realCreatorName) {
        const { error: delErr } = await supabase
          .from('staging_game_guides')
          .delete()
          .eq('game_id', gameId)
          .eq('creator_name', creatorName);
        if (delErr) throw new Error(delErr.message);
      } else {
        for (const chunkIds of chunkList(removed.map((row) => row.id), 100)) {
          const { error: delErr } = await supabase
            .from('staging_game_guides')
            .delete()
            .in('id', chunkIds);
          if (delErr) throw new Error(delErr.message);
        }
      }
    } catch (err) {
      setVideoScrapeBusy(false);
      setVideoScrapeError(true);
      setVideoScrapeHint(`In Queue gelegt, Staging-Entwurf konnte nicht gelöscht werden: ${err.message || err}`);
      return;
    }

    if (removed.length === 0) {
      setVideoScrapeBusy(false);
      setVideoScrapeError(false);
      setVideoScrapeHint('✓ In Queue gelegt (Trophy #0). Kein Staging-Entwurf für diesen Creator.');
      return;
    }

    const removedIds = new Set(removed.map((row) => row.id));
    setStagingRows((prev) => prev.filter((row) => !removedIds.has(row.id)));
    const overrides = loadStagingLocalOverrides();
    let overridesChanged = false;
    for (const id of removedIds) {
      const key = String(id);
      if (Object.prototype.hasOwnProperty.call(overrides, id) || Object.prototype.hasOwnProperty.call(overrides, key)) {
        delete overrides[id];
        delete overrides[key];
        overridesChanged = true;
      }
    }
    if (overridesChanged) saveStagingLocalOverrides(overrides);
    setTotalStagingCountsMap((prev) => {
      const next = new Map(prev);
      const left = (next.get(gameId) || 0) - removed.length;
      if (left > 0) next.set(gameId, left);
      else next.delete(gameId);
      return next;
    });
    setTotalStagingCreatorsMap((prev) => {
      const next = new Map(prev);
      const left = (next.get(gameId) || 1) - 1;
      if (left > 0) next.set(gameId, left);
      else next.delete(gameId);
      return next;
    });
    setSelectedRowIds(new Set());
    setVideoScrapeBusy(false);
    setVideoScrapeOpen(false);
    setNotice(`📥 Video in die Scraper-Queue (07.0) gelegt und ${removed.length} Staging-Zeilen von "${creatorName}" entfernt.`);
    jumpToNextGame(gameId);
  };

  const scrapeGroupNameForVideo = (video, targetCol) => {
    if (targetCol === 'category_group') return video.catName || 'Sammelobjekte';
    if (targetCol === 'boss_group') return video.bossName || 'Bosse';
    return video.chronoName || 'Walkthrough';
  };

  const handleEnqueueAllCreatorVideos = async () => {
    if (videoScrapeBusy || !selectedGameId || uniqueCreatorVideos.length === 0) return;

    setVideoScrapeBusy(true);
    setVideoScrapeHint('');
    setVideoScrapeError(false);

    const items = uniqueCreatorVideos.map((video) => ({
      videoUrl: video.videoUrl,
      targetGroupCol: videoScrapeTargetCol,
      groupName: scrapeGroupNameForVideo(video, videoScrapeTargetCol),
    }));

    const { error } = await enqueueMultipleVideosForTimestampScrape(supabase, {
      gameId: selectedGameId,
      platformGameId: resolveDraftPlatformGameId(selectedGame),
      creatorName: selectedCreatorName,
      items,
    });

    if (error) {
      setVideoScrapeBusy(false);
      setVideoScrapeError(true);
      setVideoScrapeHint(error.message || 'Konnte nicht in die Queue gelegt werden.');
      return;
    }

    if (!videoScrapeDropPlaceholders) {
      setVideoScrapeBusy(false);
      setVideoScrapeError(false);
      setVideoScrapeHint(`✓ ${uniqueCreatorVideos.length} Videos in Queue gelegt`);
      return;
    }

    const gameId = selectedGameId;
    const creatorName = selectedCreatorName;
    const isRoh = activeDataSource === 'rohmaterial';
    const targetTable = isRoh ? TABLES.guidesRohmaterial : 'staging_game_guides';
    const rowsToDelete = currentCreatorRows.filter(
      (row) => (row._sourceTable || 'staging_game_guides') === targetTable,
    );
    const realCreatorName =
      creatorName &&
      creatorName !== 'Unbekannter Creator' &&
      !String(creatorName).startsWith('Batch:');

    try {
      if (realCreatorName) {
        const { error: delErr } = await supabase
          .from(targetTable)
          .delete()
          .eq('game_id', gameId)
          .eq('creator_name', creatorName);
        if (delErr) throw new Error(delErr.message);
      } else {
        for (const chunkIds of chunkList(rowsToDelete.map((row) => row.id), 100)) {
          const { error: delErr } = await supabase.from(targetTable).delete().in('id', chunkIds);
          if (delErr) throw new Error(delErr.message);
        }
      }
    } catch (err) {
      setVideoScrapeBusy(false);
      setVideoScrapeError(true);
      setVideoScrapeHint(
        `In Queue gelegt, Platzhalter konnten nicht gelöscht werden: ${err.message || err}`,
      );
      return;
    }

    const removedIds = new Set(rowsToDelete.map((row) => row.id));
    const dropRow = (row) =>
      realCreatorName
        ? !(row.game_id === gameId && row.creator_name === creatorName)
        : !removedIds.has(row.id);
    if (isRoh) {
      setRohmaterialRows((prev) => prev.filter(dropRow));
      fetchRohmaterialSummary();
    } else {
      setStagingRows((prev) => prev.filter(dropRow));
      const overrides = loadStagingLocalOverrides();
      let overridesChanged = false;
      for (const id of removedIds) {
        const key = String(id);
        if (
          Object.prototype.hasOwnProperty.call(overrides, id) ||
          Object.prototype.hasOwnProperty.call(overrides, key)
        ) {
          delete overrides[id];
          delete overrides[key];
          overridesChanged = true;
        }
      }
      if (overridesChanged) saveStagingLocalOverrides(overrides);
      setTotalStagingCountsMap((prev) => {
        const next = new Map(prev);
        const left = (next.get(gameId) || 0) - rowsToDelete.length;
        if (left > 0) next.set(gameId, left);
        else next.delete(gameId);
        return next;
      });
      setTotalStagingCreatorsMap((prev) => {
        const next = new Map(prev);
        const left = (next.get(gameId) || 1) - 1;
        if (left > 0) next.set(gameId, left);
        else next.delete(gameId);
        return next;
      });
    }

    setSelectedRowIds(new Set());
    setVideoScrapeBusy(false);
    setVideoScrapeOpen(false);
    setNotice(
      `📥 ${uniqueCreatorVideos.length} Videos von "${creatorName}" mit ihren Chrono-Gruppen in die Scraper-Queue (07.0) gelegt!`,
    );
    jumpToNextGame(gameId);
  };

  // Video embed URL
  const currentEmbedUrl = useMemo(() => {
    if (!activeVideoUrl) return null;
    return getYouTubeEmbedUrl(activeVideoUrl, activeTimestamp, { autoplay: false });
  }, [activeVideoUrl, activeTimestamp]);

  const renderApproveCoverCheck = () => {
    const currentCoverUrl = getLocalizedCover(selectedGame?.cover_url);
    const isCoverAlreadyValid = selectedGame?.cover_status === 'valid' && Boolean(currentCoverUrl);
    const googleCoverSearchUrl = `https://www.google.com/search?tbm=isch&q=${encodeURIComponent(
      `${getLocalizedTitle(selectedGame?.spieltitel)} ${selectedGame?.hardware || ''} cover igdb`.trim(),
    )}`;

    return (
      <div className="flex flex-col gap-2 border-t border-zinc-800 pt-3">
        <span className="text-xs font-bold text-zinc-300">
          3. Cover-Check (Optional – Freigabe auch ohne Cover möglich)
        </span>
        <div className="flex items-start gap-3 rounded-xl border border-zinc-800 bg-zinc-950/50 p-2.5">
          {currentCoverUrl ? (
            <img
              src={currentCoverUrl}
              alt=""
              className="h-20 w-16 flex-none rounded-lg border border-zinc-700 object-cover"
            />
          ) : (
            <div className="flex h-20 w-16 flex-none items-center justify-center rounded-lg border border-dashed border-zinc-700 bg-zinc-950 px-1 text-center font-mono text-[9px] uppercase leading-tight text-zinc-500">
              Kein Cover
            </div>
          )}
          <div className="flex min-w-0 flex-1 flex-col gap-2">
            {isCoverAlreadyValid ? (
              <span className="font-mono text-[11px] font-bold text-[#00ff66]">
                ✓ Cover ist bereits als valid verifiziert
              </span>
            ) : currentCoverUrl ? (
              <div>
                <span className="text-xs font-bold text-amber-300">🖼️ Vorhandenes Cover gültig (valid)?</span>
                <label className="mt-1 flex cursor-pointer items-center gap-2 text-xs text-zinc-200">
                  <input
                    type="checkbox"
                    checked={approveMarkCoverValid}
                    onChange={(e) => setApproveMarkCoverValid(e.target.checked)}
                    className="h-4 w-4 rounded accent-[#00ff66]"
                  />
                  <span>
                    Bei Freigabe automatisch auf <code className="text-[#00ff66]">cover_status = valid</code> setzen
                  </span>
                </label>
              </div>
            ) : (
              <span className="text-xs font-bold text-amber-300">
                ⚠️ Kein Cover vorhanden – direkt setzen oder ohne Cover freigeben:
              </span>
            )}
            <a
              href={googleCoverSearchUrl}
              target="_blank"
              rel="noopener noreferrer"
              className="inline-flex w-fit items-center gap-1 rounded-lg border border-sky-500/40 bg-sky-500/10 px-2.5 py-1 font-mono text-[11px] font-bold text-sky-200 hover:bg-sky-500/20"
            >
              🔍 Bild suchen (Google / IGDB)
            </a>
            <div className="flex items-center gap-1.5">
              <input
                type="text"
                value={approveCoverUrlInput}
                onChange={(e) => setApproveCoverUrlInput(e.target.value)}
                placeholder={
                  currentCoverUrl
                    ? 'Oder neuen IGDB-/Bild-Link zum Ersetzen einfügen…'
                    : 'IGDB- oder Bild-URL hier einfügen…'
                }
                className="min-w-0 flex-1 rounded-lg border border-zinc-700 bg-zinc-900 px-2.5 py-1.5 text-xs text-zinc-100 focus:border-[#00ff66] focus:outline-none"
              />
              <button
                type="button"
                onClick={handleApplyCoverInApproveModal}
                disabled={!approveCoverUrlInput.trim() || approveCoverSaving || actionBusy}
                className="shrink-0 rounded-lg border border-[#00ff66]/40 bg-[#00ff66]/10 px-2.5 py-1.5 font-mono text-[11px] font-bold text-[#00ff66] hover:bg-[#00ff66]/20 disabled:opacity-40"
              >
                {approveCoverSaving ? '…' : '💾 Setzen'}
              </button>
            </div>
          </div>
        </div>
      </div>
    );
  };

  return (
    <div className="flex flex-col gap-4 text-zinc-200">
      {/* Top Banner / Notice */}
      {notice && (
        <div className="flex items-center justify-between rounded-xl border border-[#00ff66]/30 bg-[#00ff66]/10 px-4 py-2.5 text-xs text-[#00ff66]">
          <span>{notice}</span>
          <button type="button" onClick={() => setNotice('')} className="text-zinc-400 hover:text-white">✕</button>
        </div>
      )}

      {error && (
        <div className="flex items-center justify-between rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-2.5 text-xs text-red-300">
          <span>{error}</span>
          <button type="button" onClick={() => setError('')} className="text-zinc-400 hover:text-white">✕</button>
        </div>
      )}

      {/* Umschalter / Zähler für verschobene große Spiele (Rohmaterial) & Datenquelle */}
      <div className="flex flex-wrap items-center justify-between gap-2 rounded-2xl border border-zinc-800 bg-[#121314] px-4 py-2.5">
        <div className="flex items-center gap-2.5 flex-wrap">
          <button
            type="button"
            onClick={() => {
              setNewProjectCreatorName(
                creatorProfile?.channel_name || selectedCreatorName || 'RaTrophies'
              );
              setShowNewProjectModal(true);
            }}
            className="inline-flex items-center gap-1.5 rounded-xl bg-[#00ff66] px-3.5 py-1.5 text-xs font-mono font-bold text-black hover:bg-[#00ff66]/90 transition shadow-md shadow-[#00ff66]/15"
          >
            <span>+ Neues Guide-Projekt</span>
          </button>

          {!isCreatorMode ? (
            <>
              {/* Modus-Umschalter: Entwürfe (staging_game_guides) vs. Rohmaterial / Multi-Tab */}
              <div className="inline-flex rounded-xl border border-zinc-800 bg-zinc-900/90 p-0.5">
                <button
                  type="button"
                  onClick={() => setActiveDataSource('staging')}
                  className={`inline-flex items-center gap-1.5 rounded-lg px-3 py-1 text-xs font-mono font-bold transition ${
                    activeDataSource === 'staging'
                      ? 'bg-[#00ff66]/15 text-[#00ff66] border border-[#00ff66]/40'
                      : 'text-zinc-400 hover:text-zinc-200 border border-transparent'
                  }`}
                >
                  <span>📝 Staging-Entwürfe ({queueGamesList.length})</span>
                </button>
                <button
                  type="button"
                  onClick={() => setActiveDataSource('rohmaterial')}
                  className={`inline-flex items-center gap-1.5 rounded-lg px-3 py-1 text-xs font-mono font-bold transition ${
                    activeDataSource === 'rohmaterial'
                      ? 'bg-purple-500/20 text-purple-200 border border-purple-400/50'
                      : 'text-zinc-400 hover:text-purple-200 border border-transparent'
                  }`}
                >
                  <span>📦 Multi-Tab / Rohmaterial ({rohmaterialGames.length})</span>
                </button>
              </div>

              <button
                type="button"
                onClick={() => setShowRohmaterialView((prev) => !prev)}
                className={`inline-flex items-center gap-2 rounded-xl border px-3 py-1.5 text-xs font-mono font-bold transition ${
                  showRohmaterialView
                    ? 'border-purple-500/60 bg-purple-500/20 text-purple-200'
                    : 'border-purple-500/30 bg-purple-500/10 text-purple-300 hover:bg-purple-500/20'
                }`}
              >
                <span>📦 Rohmaterial-Übersicht ({rohmaterialGames.length})</span>
                <span>{showRohmaterialView ? '▲' : '▼'}</span>
              </button>
              <span className="text-[11px] font-mono text-zinc-500">
                Staging: <strong className="text-zinc-300">{queueGamesList.length} Spiele</strong> ({formatQueueRowCount(totalStagingRows)} Zeilen) · Rohmaterial: <strong className="text-purple-300">{rohmaterialGames.length} Spiele</strong> ({formatQueueRowCount(totalRohmaterialRows)} Zeilen)
              </span>
            </>
          ) : (
            <span className="text-xs font-mono text-zinc-400">
              🎬 Creator-Arbeitsbereich:{' '}
              <strong className="text-[#00ff66]">
                {creatorProfile?.channel_name || 'Creator'}
              </strong>{' '}
              · <strong className="text-zinc-200">{queueGamesList.length} Projekte</strong> ({formatQueueRowCount(totalStagingRows)} Zeilen)
            </span>
          )}
        </div>

        <div className="flex items-center gap-2 flex-wrap">
          <button
            type="button"
            onClick={handleRandomizeQueue}
            title="Spiele-Liste zufällig neu mischen"
            className="rounded-lg border border-zinc-700 bg-zinc-800 px-2.5 py-1 text-[11px] font-mono text-zinc-300 hover:border-[#00ff66]/40 hover:text-[#00ff66] transition"
          >
            🎲 Zufällig mischen
          </button>
          <button
            type="button"
            onClick={() => {
              fetchQueue();
              if (!isCreatorMode) fetchRohmaterialSummary();
            }}
            className="rounded-lg border border-zinc-700 bg-zinc-800 px-2.5 py-1 text-[11px] font-mono text-zinc-300 hover:border-[#00ff66]/40 hover:text-[#00ff66] transition"
          >
            🔄 Alles aktualisieren
          </button>
        </div>
      </div>

      {/* Aufklappbare Liste der verschobenen großen Spiele (Rohmaterial / Multi-Tab) */}
      {showRohmaterialView && (
        <div className="rounded-2xl border border-purple-500/30 bg-[#15131c] p-4 flex flex-col gap-3">
          <div className="flex items-center justify-between border-b border-purple-500/20 pb-2">
            <div>
              <h3 className="text-xs font-bold uppercase tracking-wider text-purple-200">
                📦 Verschobene große Spiele zur Multi-Tab-Bearbeitung ({rohmaterialGames.length})
              </h3>
              <p className="text-[11px] text-zinc-400 font-mono">
                Spiele mit <span className="text-purple-300">status-&gt;&gt;&apos;rohmaterial&apos; = &apos;PENDING_MULTI_TAB&apos;</span> oder Einträgen in <span className="text-purple-300">game_guides_rohmaterial</span> – direkt im Editor konsolidierbar
              </p>
            </div>
            <button
              type="button"
              onClick={() => setShowRohmaterialView(false)}
              className="text-xs font-mono text-zinc-400 hover:text-white px-2 py-1"
            >
              ✕ Schließen
            </button>
          </div>

          {loadingRohmaterial ? (
            <p className="text-xs font-mono text-zinc-400 py-4 text-center animate-pulse">
              Lade Rohmaterial-Spiele…
            </p>
          ) : rohmaterialGames.length === 0 ? (
            <p className="text-xs font-mono text-zinc-500 py-4 text-center">
              Aktuell keine verschobenen großen Spiele vorhanden.
            </p>
          ) : (
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 max-h-80 overflow-y-auto pr-1">
              {rohmaterialGames.map((item, idx) => {
                const targetId = item.gameId || item.platformGameId;
                const multiTabHref = targetId ? `/guide/${encodeURIComponent(targetId)}?rohmaterial=1` : '';
                const isSelectedRoh = activeDataSource === 'rohmaterial' && selectedGameId === item.gameId;
                return (
                  <div
                    key={item.gameId || item.platformGameId || idx}
                    className={`flex items-center justify-between gap-2.5 rounded-xl border p-2.5 transition ${
                      isSelectedRoh
                        ? 'border-purple-400 bg-purple-500/20'
                        : 'border-purple-500/25 bg-zinc-900/80 hover:border-purple-400/50'
                    }`}
                  >
                    <div
                      onClick={() => {
                        setActiveDataSource('rohmaterial');
                        setSelectedGameId(item.gameId);
                      }}
                      className="flex items-center gap-2.5 min-w-0 flex-1 cursor-pointer"
                    >
                      {item.coverUrl ? (
                        <img
                          src={item.coverUrl}
                          alt={item.title}
                          className="h-11 w-9 shrink-0 rounded object-cover bg-zinc-800"
                        />
                      ) : (
                        <div className="h-11 w-9 shrink-0 rounded bg-zinc-800 flex items-center justify-center text-xs">
                          📦
                        </div>
                      )}
                      <div className="min-w-0 flex-1">
                        <p className="text-xs font-bold text-white truncate">{item.title}</p>
                        <p className="text-[10px] font-mono text-purple-300 truncate">
                          {item.platformGameId} · {item.rowCount} Zeilen
                        </p>
                        {item.creatorList?.length > 0 && (
                          <p className="text-[10px] font-mono text-zinc-400 truncate">
                            ▶ {item.creatorList.join(', ')}
                          </p>
                        )}
                      </div>
                    </div>

                    <div className="flex items-center gap-1.5 shrink-0">
                      <button
                        type="button"
                        onClick={() => {
                          setActiveDataSource('rohmaterial');
                          setSelectedGameId(item.gameId);
                          setShowRohmaterialView(false);
                        }}
                        className="rounded-lg border border-[#00ff66]/40 bg-[#00ff66]/15 px-2.5 py-1.5 text-[10px] font-mono font-bold text-[#00ff66] hover:bg-[#00ff66]/30 transition"
                        title="Im Gruppen- & Multi-Tab-Editor öffnen"
                      >
                        ✏️ Bearbeiten
                      </button>
                      {multiTabHref && (
                        <a
                          href={multiTabHref}
                          onClick={(e) => handleStaffGamePreviewClick(e, multiTabHref)}
                          className="rounded-lg border border-purple-400/40 bg-purple-500/20 px-2 py-1.5 text-[10px] font-mono font-bold text-purple-200 hover:bg-purple-500/35 no-underline"
                          title="Auf Spieleseite prüfen"
                        >
                          ↗
                        </a>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      )}

      {loading && activeSidebarGamesList.length === 0 ? (
        <div className="flex h-64 items-center justify-center font-mono text-sm text-zinc-500 animate-pulse">
          Lade Entwürfe-Queue…
        </div>
      ) : activeSidebarGamesList.length === 0 ? (
        <div className="flex flex-col items-center justify-center rounded-2xl border border-zinc-800 bg-[#121314] px-6 py-16 text-center">
          <span className="text-4xl">🎉</span>
          <h2 className="mt-3 text-lg font-bold text-white">
            {activeDataSource === 'rohmaterial' ? 'Keine Rohmaterial-Spiele' : 'Keine offenen Entwürfe'}
          </h2>
          <p className="mt-1 text-xs text-zinc-400 max-w-sm leading-relaxed">
            {activeDataSource === 'rohmaterial' ? (
              <>Aktuell liegen keine Spiele in <span className="font-mono text-zinc-300">game_guides_rohmaterial</span>.</>
            ) : (
              <>Die Staging Queue (<span className="font-mono text-zinc-300">staging_game_guides</span>) ist aktuell leer.</>
            )}
          </p>
          <div className="mt-4 flex flex-wrap items-center justify-center gap-2">
            <button
              type="button"
              onClick={() => {
                setNewProjectCreatorName(
                  creatorProfile?.channel_name || selectedCreatorName || 'RaTrophies'
                );
                setShowNewProjectModal(true);
              }}
              className="rounded-xl bg-[#00ff66] px-4 py-2 text-xs font-mono font-bold text-black hover:bg-[#00ff66]/90 shadow-md shadow-[#00ff66]/15"
            >
              + Neues Guide-Projekt anlegen
            </button>
            {!isCreatorMode && activeDataSource === 'staging' && rohmaterialGames.length > 0 && (
              <button
                type="button"
                onClick={() => setActiveDataSource('rohmaterial')}
                className="rounded-xl border border-purple-500/50 bg-purple-500/20 px-4 py-2 text-xs font-bold text-purple-200 hover:bg-purple-500/30"
              >
                📦 Zu Multi-Tab / Rohmaterial wechseln ({rohmaterialGames.length})
              </button>
            )}
            <button
              type="button"
              onClick={() => {
                fetchQueue();
                if (!isCreatorMode) fetchRohmaterialSummary();
              }}
              className="rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-2 text-xs font-bold text-zinc-200 hover:border-[#00ff66]/40 hover:text-[#00ff66]"
            >
              🔄 Queue neu laden
            </button>
          </div>
        </div>
      ) : (
        /* High-Density 3-Spalten Layout */
        <div className="grid grid-cols-1 gap-4 lg:grid-cols-12 items-start">
          
          {/* ==================== A. LINKE SPALTE: Spiele-Queue (3 Cols) ==================== */}
          <div className="lg:col-span-3 flex flex-col gap-3 rounded-2xl border border-zinc-800 bg-[#121314] p-3 max-h-[calc(100vh-160px)] overflow-hidden">
            {/* Button "+ Neues Guide-Projekt" oben links in der Queue */}
            <button
              type="button"
              onClick={() => {
                setNewProjectCreatorName(
                  creatorProfile?.channel_name || selectedCreatorName || 'RaTrophies'
                );
                setShowNewProjectModal(true);
              }}
              className="w-full flex items-center justify-center gap-1.5 rounded-xl bg-[#00ff66] px-3 py-2 text-xs font-mono font-bold text-black hover:bg-[#00ff66]/90 transition shadow-md shadow-[#00ff66]/15"
            >
              <span>+ Neues Guide-Projekt</span>
            </button>

            <div className="flex items-center justify-between gap-2 border-b border-zinc-800/80 pb-2.5 px-1">
              <div>
                <h3 className="text-xs font-bold uppercase tracking-wider text-white">
                  {activeDataSource === 'rohmaterial' ? '📦 Multi-Tab Queue' : '📝 Spiele-Queue'}
                </h3>
