<file path="supabase/game_guides_localisation_sheet.sql">
-- spiel_region gilt nicht automatisch in jedem Excel-Reiter
--
-- Ein Guide-Eintrag kann in mehreren Reitern stehen (sheet_type z. B. [1, 2]).
-- spiel_region ist trotzdem nur EINE Sprachmap auf derselben Zeile und steuert
-- die räumliche Anordnung. localisation_type steuert die Sprache. Ohne
-- eigene Spalte rutscht das Walkthrough-Gebiet (Reiter 1) in die
-- Sammelobjekte (Reiter 2) mit – genau das ist bei Astro Bot passiert.
--
-- localisation_sheet spiegelt sheet_type: JSONB-Array der Reiter, in denen
-- die Gebiets-Ebene angezeigt wird.
--
--   0 = Trophäen (game_achievements, kommt hier nicht vor)
--   1 = Walkthrough
--   2 = Sammelobjekte
--   3 = Bosse
--
-- Beispiel: Walkthrough-Galaxie, Sammelobjekt-Zeile bleibt flach
--   sheet_type:          [1, 2]
--   spiel_region:        {"de": "2. Tentakel-System:"}
--   localisation_sheet:  [1]
--
-- Das Frontend fällt ohne diese Spalte auf Walkthrough+Bosse zurück und
-- ignoriert spiel_region in den Sammelobjekten – Astro Bot muss also nicht
-- nachträglich befüllt werden. Neue Uploads sollen das Array trotzdem setzen.

alter table public.game_guides
  add column if not exists localisation_sheet jsonb;

comment on column public.game_guides.localisation_sheet is
  'Excel-Reiter, in denen spiel_region gilt: [1] Walkthrough, [2] Sammelobjekte, [3] Bosse. Wie sheet_type, aber nur fuer die Gebiets-Ebene.';

-- Optional: Walkthrough-Gebiet fuer alle Zeilen mit gefuellter spiel_region,
-- die in Reiter 1 vorkommen. Laesst Reiter 2 bewusst draussen.
--
-- update public.game_guides
-- set localisation_sheet = '[1]'::jsonb
-- where localisation_sheet is null
--   and spiel_region is not null
--   and spiel_region <> '{}'::jsonb
--   and (
--     sheet_type @> '1'::jsonb
--     or sheet_type @> '[1]'::jsonb
--   );
</file>

<file path="supabase/game_wiedervorlage.sql">
-- =============================================================================
-- game_wiedervorlage
-- Temporaere Admin-Merkliste. Einmal in der Supabase-SQL-Konsole ausfuehren.
--
-- Kein Fremdschluessel auf games: DELETE in dieser Tabelle bleibt hier.
-- Eine geloeschte Zeile entfernt das Spiel nicht und loest keine Folge-Deletes aus.
-- =============================================================================

create table if not exists public.game_wiedervorlage (
  id uuid primary key,
  platform_game_id jsonb,
  spieltitel jsonb,
  freitext text
);

do $$
declare
  con record;
begin
  for con in
    select c.conname
    from pg_constraint c
    join pg_class t on t.oid = c.conrelid
    join pg_namespace n on n.oid = t.relnamespace
    where n.nspname = 'public'
      and t.relname = 'game_wiedervorlage'
      and c.contype = 'f'
  loop
    execute format('alter table public.game_wiedervorlage drop constraint %I', con.conname);
  end loop;
end $$;

comment on table public.game_wiedervorlage is
  'Temporaere Wiedervorlage. Kopie von games.id, platform_game_id und spieltitel plus Freitext. Kein Fremdschluessel.';

alter table public.game_wiedervorlage enable row level security;

drop policy if exists game_wiedervorlage_admin on public.game_wiedervorlage;
create policy game_wiedervorlage_admin
  on public.game_wiedervorlage
  for all
  to authenticated
  using (public.tb_is_admin())
  with check (public.tb_is_admin());

revoke all on public.game_wiedervorlage from anon;
grant select, insert, update, delete on public.game_wiedervorlage to authenticated;
</file>

<file path="supabase/games_rls_select_split.sql">
-- =============================================================================
-- games SELECT-Policies splitten (Index auf guide_de fuer Anon)
-- Einmal in der Supabase-SQL-Konsole ausfuehren.
-- =============================================================================
--
-- IST: Eine Policy mit
--        tb_is_admin() OR status->>'guide_de' = 'PUBLISHED'
--      Postgres kann den Index games_guide_de_idx / games_status_guide_de_idx
--      oft nicht nutzen → Seq-Scan fuer Gaeste → Timeouts auf der Startseite.
--
-- SOLL: Zwei Policies (werden ORd):
--   1) published: nur der Index-Ausdruck, fuer anon + authenticated
--   2) admin: tb_is_admin(), nur authenticated
--
-- Danach: Startseite hart neu laden (Chrome: Strg+Shift+R).

drop policy if exists games_select on public.games;
drop policy if exists games_select_published on public.games;
drop policy if exists games_select_admin on public.games;

create policy games_select_published
  on public.games
  for select
  to anon, authenticated
  using (coalesce(status ->> 'guide_de', '') = 'PUBLISHED');

create policy games_select_admin
  on public.games
  for select
  to authenticated
  using (public.tb_is_admin());
</file>

<file path="supabase/home_payload_fsk.sql">
-- Startseiten-Kacheln lesen games.fsk mit, ohne die Rail-CTEs anzufassen.
-- STABLE statt IMMUTABLE, weil die Freigabe per PK nachgeschlagen wird.
-- Signatur bleibt gleich, bestehende Aufrufe in tb_get_home_rails gelten weiter.

create or replace function public.tb_home_game_payload(
  p_id uuid,
  p_platform_game_id jsonb,
  p_hardware text,
  p_entwickler text,
  p_spiel_typ text,
  p_status jsonb,
  p_slug text,
  p_created_at timestamptz,
  p_views integer,
  p_spieltitel jsonb,
  p_cover_url jsonb,
  p_home_tags text[] default '{}'::text[],
  p_cover_status text default null
)
returns jsonb
language sql
stable
as $$
  select jsonb_build_object(
    'id', p_id,
    'platform_game_id', p_platform_game_id,
    'hardware', p_hardware,
    'entwickler', p_entwickler,
    'home_tags', coalesce(p_home_tags, '{}'::text[]),
    'spiel_typ', p_spiel_typ,
    'status', p_status,
    'slug', p_slug,
    'created_at', p_created_at,
    'views', coalesce(p_views, 0),
    'spieltitel', p_spieltitel,
    'cover_url', p_cover_url,
