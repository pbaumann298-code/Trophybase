<file path="src/lib/intranetGameEdits.js">
import {
  ACHIEVEMENT_I18N,
  ACHIEVEMENT_PK,
  ACHIEVEMENT_STRUCT,
  GAME_FK,
  GAME_I18N,
  GAME_PK,
  GAME_PLATFORM_ID,
  GAME_STRUCT,
  GAME_TYPE,
  GUIDE_I18N,
  GUIDE_PK,
  GUIDE_SHEET_TYPE,
  GUIDE_STRUCT,
  TABLES,
  parseGameTypes,
  formatGameTypes,
  computeIsIndexable,
} from './gameSchema';
import { formatHardwareValue } from './gameSlug';
import {
  GUIDE_PUBLICATION,
  buildUnifiedGuidePublishPatch,
  guideStatusKey,
  parseStatusMap,
  publishingFieldsFromStatus,
  removeGameFromWiedervorlage,
} from './guidePublication';
import { normalizeLocale } from './locale';
import { localizeJsonField, mergeLocalizedValue } from './translationUtils';
import { patchHomeRailsCacheGame } from './homeCategories';
import { getPlatformGameId } from './gameModel';
import { normalizeTrophyVideoInput, getYouTubeVideoId } from '../utils/videoUrl';

/** Pipeline-Schlüssel, die einen vorhandenen Guide markieren und mit ihm wegfallen. */
const GUIDE_DISCARD_KEYS = new Set(['fertig', 'fertig_de', 'fertig_en']);

/**
 * Statusmappe, nachdem der Guide verworfen wurde.
 * guide_* (FERTIG / PUBLISHED) und die älteren fertig*-Schlüssel fallen weg,
 * guides wird NO_GUIDE. Übrige Pipeline-Keys bleiben.
 * @param {unknown} currentStatus
 */
export function statusAfterGuideDiscard(currentStatus) {
  const statusMap = { ...parseStatusMap(currentStatus) };
  for (const key of Object.keys(statusMap)) {
    if (key.startsWith('guide_') || GUIDE_DISCARD_KEYS.has(key)) delete statusMap[key];
  }
  statusMap.guides = 'NO_GUIDE';
  return statusMap;
}

const GAME_TYPE_VALUES = new Set(Object.values(GAME_TYPE));

/**
 * Setzt games.spiel_typ auf bis zu 2 der redaktionellen Typen.
 * Berechnet is_indexable dynamisch über computeIsIndexable:
 * - Falls ein NoIndex-Blocker ("Unlesbar", "Servertot") enthalten ist -> false
 * - Sobald mindestens ein regulär indexierbarer Typ ("Standard", "Evergreen", "Premium") enthalten ist -> true
 * - Sonst -> false
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} gameId
 * @param {string|string[]} gameTypeInput
 */
export async function setIntranetGameType(supabase, gameId, gameTypeInput) {
  const id = String(gameId ?? '').trim();
  if (!id) return { gameType: null, error: new Error('Kein Spiel ausgewählt.') };

  const parsedTypes = parseGameTypes(gameTypeInput).slice(0, 2);
  for (const t of parsedTypes) {
    if (!GAME_TYPE_VALUES.has(t)) {
      return { gameType: null, error: new Error(`Unbekannter Spieltyp: "${t}"`) };
    }
  }

  const formatted = formatGameTypes(parsedTypes);
  const isIndexable = computeIsIndexable(parsedTypes);

  const update = {
    [GAME_STRUCT.gameType]: formatted,
    [GAME_STRUCT.isIndexable]: isIndexable,
  };

  const { data, error } = await supabase
    .from(TABLES.games)
    .update(update)
    .eq(GAME_PK, id)
    .select(GAME_STRUCT.gameType)
    .maybeSingle();

  if (error) return { gameType: null, error };
  return { gameType: data?.[GAME_STRUCT.gameType] ?? formatted, error: null };
}

/**
 * Schreibt games.hardware als „PS4/PS5“. Mindestens eine Konsole.
 * Die Sitemap nimmt daraus nur die neueste Generation als ein URL-Segment.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} gameId
 * @param {string[]} segments ps5, ps4, ps3, psvita, psp
 */
export async function setGameHardware(supabase, gameId, segments) {
  const id = String(gameId ?? '').trim();
  const hardware = formatHardwareValue(segments);
  if (!id) return { hardware: null, error: new Error('Kein Spiel ausgewählt.') };
  if (!hardware) return { hardware: null, error: new Error('Mindestens eine Konsole auswählen.') };

  const { data, error } = await supabase
    .from(TABLES.games)
    .update({ [GAME_STRUCT.hardware]: hardware })
    .eq(GAME_PK, id)
    .select(GAME_STRUCT.hardware)
    .maybeSingle();

  if (error) return { hardware: null, error };
  return { hardware: data?.[GAME_STRUCT.hardware] ?? hardware, error: null };
}

/**
 * Zählt Online-/Verpassbar-Flags neu und schreibt die Spiel-Summen.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} game
 */
async function recountTrophyFlagTotals(supabase, game) {
  const { data, error: readError } = await supabase
    .from(TABLES.achievements)
    .select(`${ACHIEVEMENT_STRUCT.isMissable}, ${ACHIEVEMENT_STRUCT.isOnline}`)
    .eq(GAME_FK, game);

  if (readError) return { totals: null, error: readError };

  const rows = data ?? [];
  const missable = rows.filter((row) => row[ACHIEVEMENT_STRUCT.isMissable]).length;
  const online = rows.filter((row) => row[ACHIEVEMENT_STRUCT.isOnline]).length;
  const totals = {
    [GAME_STRUCT.hasMissableTrophies]: missable > 0,
    [GAME_STRUCT.totalMissableTrophies]: missable,
    [GAME_STRUCT.hasOnlineTrophies]: online > 0,
    [GAME_STRUCT.totalOnlineTrophies]: online,
  };

  const { error: gameError } = await supabase
    .from(TABLES.games)
    .update(totals)
    .eq(GAME_PK, game);

  if (gameError) return { totals: null, error: gameError };
  return { totals, error: null };
}

/**
 * Online, Verpassbar, Sammelobjekt und Story einer Trophäe. Versteckt bleibt Sony-Bestand.
 * Zählt danach die Spiel-Summen (Online/Verpassbar) neu, damit die Übersicht mitzieht.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} gameId
 * @param {string} achievementId
 * @param {{ is_online?: boolean, is_missable?: boolean, is_collectible?: boolean, is_story_related?: boolean }} flags
 */
export async function setAchievementFlags(supabase, gameId, achievementId, flags) {
  const game = String(gameId ?? '').trim();
  const achievement = String(achievementId ?? '').trim();
  if (!game || !achievement) return { totals: null, error: new Error('Trophäe fehlt.') };

  const patch = {};
  if (typeof flags?.is_online === 'boolean') patch[ACHIEVEMENT_STRUCT.isOnline] = flags.is_online;
  if (typeof flags?.is_missable === 'boolean') patch[ACHIEVEMENT_STRUCT.isMissable] = flags.is_missable;
  if (typeof flags?.is_collectible === 'boolean') {
    patch[ACHIEVEMENT_STRUCT.isCollectible] = flags.is_collectible;
  }
  if (typeof flags?.is_story_related === 'boolean') {
    patch[ACHIEVEMENT_STRUCT.isStoryRelated] = flags.is_story_related;
  }
  if (!Object.keys(patch).length) return { totals: null, error: new Error('Keine Trophäen-Art gewählt.') };

  const { error: writeError } = await supabase
    .from(TABLES.achievements)
    .update(patch)
    .eq(GAME_FK, game)
    .eq(ACHIEVEMENT_PK, achievement);

  if (writeError) return { totals: null, error: writeError };
  return recountTrophyFlagTotals(supabase, game);
}

/**
 * Setzt is_online für mehrere Trophäen eines Spiels und aktualisiert die Summen einmal.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} gameId
 * @param {string[]} achievementIds
 * @param {boolean} [isOnline=true]
 */
export async function setAchievementsOnline(supabase, gameId, achievementIds, isOnline = true) {
  const game = String(gameId ?? '').trim();
  const ids = [...new Set(
    (Array.isArray(achievementIds) ? achievementIds : [])
      .map((id) => String(id ?? '').trim())
      .filter(Boolean),
  )];
  if (!game || !ids.length) return { totals: null, error: new Error('Trophäen fehlen.') };

  const { error: writeError } = await supabase
    .from(TABLES.achievements)
    .update({ [ACHIEVEMENT_STRUCT.isOnline]: Boolean(isOnline) })
    .eq(GAME_FK, game)
    .in(ACHIEVEMENT_PK, ids);

  if (writeError) return { totals: null, error: writeError };
  return recountTrophyFlagTotals(supabase, game);
}

function asTipMap(value) {
  if (value && typeof value === 'object' && !Array.isArray(value)) return { ...value };
  const text = String(value ?? '').trim();
  return text ? { en: text } : {};
}

/**
 * Nimmt eine Sprache aus der Tipp-Map. Fehlt der Schlüssel, bleibt die Spalte unangetastet.
 * @param {unknown} value
 * @param {string} locale
 * @returns {Record<string, string>|null|undefined}
 */
function columnWithoutLocale(value, locale) {
  const map = asTipMap(value);
  if (!Object.prototype.hasOwnProperty.call(map, locale)) return undefined;
  delete map[locale];
  return Object.keys(map).length ? map : null;
}

/** Nur guide_tip für diese Sprache leeren. Guide-Tip-lang bleibt unangetastet. */
function localeClearPatch(row, locale) {
  const patch = {};
  const tip = columnWithoutLocale(row?.[ACHIEVEMENT_I18N.guideTip], locale);
  if (tip !== undefined) patch[ACHIEVEMENT_I18N.guideTip] = tip;
  return patch;
}

/** Nur Guide-Tip-lang für diese Sprache leeren. */
function localeClearLongTipPatch(row, locale) {
  const patch = {};
  const longTip = columnWithoutLocale(row?.[ACHIEVEMENT_I18N.guideTipLong], locale);
  if (longTip !== undefined) patch[ACHIEVEMENT_I18N.guideTipLong] = longTip;
  return patch;
}

/**
 * Schreibt video_url und timestamp einer Trophäe (YouTube).
 * Leere URL löscht beide Felder.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} gameId
 * @param {string} achievementId
 * @param {{ video_url?: string, timestamp?: string }} video
 */
export async function saveTrophyVideo(supabase, gameId, achievementId, video) {
  const game = String(gameId ?? '').trim();
  const achievement = String(achievementId ?? '').trim();
  if (!game || !achievement) return { error: new Error('Trophäe fehlt.') };

  const normalized = normalizeTrophyVideoInput(video?.video_url, video?.timestamp);
  if (normalized.error) return { error: normalized.error };

  const { error } = await supabase
    .from(TABLES.achievements)
    .update({
      [ACHIEVEMENT_STRUCT.videoUrl]: normalized.video_url || null,
      [ACHIEVEMENT_STRUCT.timestamp]: normalized.timestamp || null,
    })
    .eq(GAME_FK, game)
    .eq(ACHIEVEMENT_PK, achievement);

  return { error: error ?? null, video: normalized };
}

const VALID_SCRAPE_GROUP_COLS = new Set([
  'category_group',
  'chronological_group',
  'boss_group',
]);

/**
 * Legt eine YouTube-Video- oder Playlist-URL für eine Trophäe in
 * public.trophy_video_scrape_queue (status: 'PENDING'), damit der Scraper
 * daraus Guide-Schritte mit Timestamps extrahiert, ohne das Einzel-Video
 * der Trophäe (game_achievements.video_url) zu verändern.
 *
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {{
 *   gameId: string,
 *   platformGameId?: string|null,
 *   trophyId: string|number,
 *   trophyName?: string|null,
 *   videoUrl: string,
 *   targetGroupCol?: 'category_group'|'chronological_group'|'boss_group',
 *   customGroupName?: string|null,
 * }} params
 */
export async function enqueueTrophyVideoForTimestampScrape(
  supabase,
  {
    gameId,
    platformGameId,
    trophyId,
    trophyName,
    videoUrl,
    targetGroupCol = 'category_group',
    customGroupName = '',
  } = {},
) {
  const game = String(gameId ?? '').trim();
  const trophy = String(trophyId ?? '').trim();
  const url = String(videoUrl ?? '').trim();

  if (!game) return { data: null, error: new Error('Kein Spiel ausgewählt.') };
  if (!trophy) return { data: null, error: new Error('Trophäen-ID fehlt.') };
  if (!url) {
    return {
      data: null,
      error: new Error('Bitte eine YouTube-Video- oder Playlist-URL eingeben.'),
    };
  }

  const groupCol = VALID_SCRAPE_GROUP_COLS.has(targetGroupCol)
    ? targetGroupCol
    : 'category_group';

  const row = {
    game_id: game,
    platform_game_id: String(platformGameId ?? '').trim() || null,
    trophy_id: trophy,
    trophy_name: String(trophyName ?? '').trim() || null,
    video_url: url,
    target_group_col: groupCol,
    custom_group_name: String(customGroupName ?? '').trim() || null,
    status: 'PENDING',
  };

  const { data, error } = await supabase
    .from('trophy_video_scrape_queue')
    .insert(row)
    .select()
    .maybeSingle();

  return { data: data ?? null, error: error ?? null };
}

/**
 * Legt mehrere Kapitel-/Walkthrough-Videos eines Creators auf einmal in
 * trophy_video_scrape_queue. trophy_id '0' markiert ein allgemeines Video;
 * trophy_name bündelt sie über den Creator-Namen.
 *
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {{
 *   gameId: string,
 *   platformGameId?: string|null,
 *   creatorName?: string|null,
 *   items?: Array<{ videoUrl?: string, targetGroupCol?: string, groupName?: string }>,
 * }} params
 */
export async function enqueueMultipleVideosForTimestampScrape(
  supabase,
  { gameId, platformGameId, creatorName, items = [] } = {},
) {
  const game = String(gameId ?? '').trim();
  if (!game) return { count: 0, error: new Error('Kein Spiel ausgewählt.') };
  if (!Array.isArray(items) || items.length === 0) {
    return { count: 0, error: new Error('Keine gültigen Videos zum Einreihen gefunden.') };
  }

  const rows = items.map((it) => ({
    game_id: game,
    platform_game_id: String(platformGameId ?? '').trim() || null,
    // '0' signalisiert 07.0_Trophy_Video_Queue_Worker.py: Allgemeines Kapitel-/Walkthrough-Video (trophy_id bleibt null),
    // trophy_name übergibt den Creator-Namen, damit alle Videos im selben Creator-Tab gebündelt werden!
    trophy_id: '0',
    trophy_name: String(creatorName ?? '').trim() || null,
    video_url: String(it.videoUrl ?? '').trim(),
    target_group_col: VALID_SCRAPE_GROUP_COLS.has(it.targetGroupCol)
      ? it.targetGroupCol
      : 'chronological_group',
    custom_group_name: String(it.groupName ?? '').trim() || 'Walkthrough',
    status: 'PENDING',
  }));

  const { error } = await supabase.from('trophy_video_scrape_queue').insert(rows);
  return { count: error ? 0 : rows.length, error: error ?? null };
}

/**
 * Schreibt den kurzen Guide-Tipp einer Trophäe in der aktuellen Sprache.
 * Leerer Text löscht nur guide_tip in dieser Sprache – Guide-Tip-lang bleibt.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} gameId
 * @param {string} achievementId
 * @param {string} locale
 * @param {string} text
 */
export async function saveTrophyGuideTip(supabase, gameId, achievementId, locale, text) {
  const game = String(gameId ?? '').trim();
  const achievement = String(achievementId ?? '').trim();
  const lang = String(locale ?? '').trim();
  const next = String(text ?? '').trim();
  if (!game || !achievement) {
    return { error: new Error('Trophäe fehlt.') };
  }
  if (!lang) return { error: new Error('Keine Sprache ausgewählt.') };

  if (!next) {
    const { data, error: readError } = await supabase
      .from(TABLES.achievements)
      .select(ACHIEVEMENT_I18N.guideTip)
      .eq(GAME_FK, game)
      .eq(ACHIEVEMENT_PK, achievement)
      .maybeSingle();

    if (readError) return { error: readError };

    const patch = localeClearPatch(data, lang);
    if (!Object.keys(patch).length) return { error: null };

    const { error } = await supabase
      .from(TABLES.achievements)
      .update(patch)
      .eq(GAME_FK, game)
      .eq(ACHIEVEMENT_PK, achievement);
    return { error: error ?? null };
  }

  const { data, error: readError } = await supabase
    .from(TABLES.achievements)
    .select(ACHIEVEMENT_I18N.guideTip)
    .eq(GAME_FK, game)
    .eq(ACHIEVEMENT_PK, achievement)
    .maybeSingle();

  if (readError) return { error: readError };

  const map = asTipMap(data?.[ACHIEVEMENT_I18N.guideTip]);
  map[lang] = next;

  const { error } = await supabase
    .from(TABLES.achievements)
    .update({ [ACHIEVEMENT_I18N.guideTip]: map })
    .eq(GAME_FK, game)
    .eq(ACHIEVEMENT_PK, achievement);

  return { error: error ?? null };
}

