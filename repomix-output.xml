<file path="supabase/publish_seo.sql">
-- Voraussetzung: supabase/games_slug.sql wurde bereits ausgefuehrt
-- (Funktion tb_assign_game_slug muss existieren).

--
-- IST: tb_assign_game_slug laeuft nur bei INSERT/UPDATE von
-- spieltitel, hardware, release_jahr, slug. Die Freigabe schreibt nur
-- status.guide_de = PUBLISHED – der Trigger greift also nicht.
--
-- SOLL: Sobald ein Guide PUBLISHED wird und noch keinen Slug hat, wird er
-- erzeugt. Bestehende Slugs bleiben unveraenderlich.

create or replace function public.tb_ensure_game_slug(p_id uuid)
returns text
language plpgsql
security definer
set search_path = public
as $$
declare
  current_slug text;
begin
  select nullif(btrim(coalesce(slug, '')), '')
    into current_slug
  from public.games
  where id = p_id;

  if current_slug is not null then
    return current_slug;
  end if;

  -- hardware = hardware loest games_assign_slug aus, ohne Inhalte zu aendern.
  update public.games
  set hardware = hardware
  where id = p_id
    and (slug is null or btrim(slug) = '');

  select slug into current_slug from public.games where id = p_id;
  return current_slug;
end;
$$;

comment on function public.tb_ensure_game_slug(uuid) is
  'Erzeugt games.slug falls leer. Aufruf nach Freigabe (status.guide_de = PUBLISHED).';

revoke all on function public.tb_ensure_game_slug(uuid) from public;
grant execute on function public.tb_ensure_game_slug(uuid) to authenticated;

drop trigger if exists games_assign_slug on public.games;
create trigger games_assign_slug
  before insert or update of spieltitel, hardware, release_jahr, slug, status
  on public.games
  for each row
  execute procedure public.tb_assign_game_slug();
</file>

<file path="supabase/quickwins_guide_text_en.sql">
-- =============================================================================
-- Quickwins: item_name und chronological_group von "de" nach "en"
-- Einmal in der Supabase-SQL-Konsole. Zuerst die SELECTs, dann das UPDATE.
--
-- Nur game_guides von Spielen mit spiel_typ = Quickwin.
-- Der Text liegt unter de, ist aber Englisch.
--   de gesetzt, en leer     -> de wird en, de faellt weg
--   de und en gleicher Text -> de faellt weg, en bleibt
--   de und en verschieden   -> unangetastet (steht in der Vorschau)
-- Andere Spalten und andere Spieltypen bleiben.
-- =============================================================================

-- ---------------------------------------------------------------------------
-- 1) Vorschau
-- ---------------------------------------------------------------------------
with quickwin_guides as (
  select
    gg.id,
    gg.item_name,
    gg.chronological_group
  from public.game_guides gg
  join public.games g on g.id = gg.game_id
  where btrim(coalesce(g.spiel_typ, '')) = 'Quickwin'
)
select
  count(*) filter (
    where btrim(coalesce(item_name ->> 'de', '')) <> ''
      and btrim(coalesce(item_name ->> 'en', '')) = ''
  ) as item_name_de_nach_en,
  count(*) filter (
    where btrim(coalesce(item_name ->> 'de', '')) <> ''
      and btrim(item_name ->> 'de') = btrim(item_name ->> 'en')
  ) as item_name_de_doppelt,
  count(*) filter (
    where btrim(coalesce(item_name ->> 'de', '')) <> ''
      and btrim(coalesce(item_name ->> 'en', '')) <> ''
      and btrim(item_name ->> 'de') is distinct from btrim(item_name ->> 'en')
  ) as item_name_konflikt,
  count(*) filter (
    where btrim(coalesce(chronological_group ->> 'de', '')) <> ''
      and btrim(coalesce(chronological_group ->> 'en', '')) = ''
  ) as gruppe_de_nach_en,
  count(*) filter (
    where btrim(coalesce(chronological_group ->> 'de', '')) <> ''
      and btrim(chronological_group ->> 'de') = btrim(chronological_group ->> 'en')
  ) as gruppe_de_doppelt,
  count(*) filter (
    where btrim(coalesce(chronological_group ->> 'de', '')) <> ''
      and btrim(coalesce(chronological_group ->> 'en', '')) <> ''
      and btrim(chronological_group ->> 'de') is distinct from btrim(chronological_group ->> 'en')
  ) as gruppe_konflikt
from quickwin_guides;

-- Ein paar Beispiele, die umziehen
select
  gg.item_name ->> 'de' as item_name_de,
  gg.chronological_group ->> 'de' as gruppe_de
from public.game_guides gg
join public.games g on g.id = gg.game_id
where btrim(coalesce(g.spiel_typ, '')) = 'Quickwin'
  and btrim(coalesce(gg.item_name ->> 'de', '')) <> ''
  and btrim(coalesce(gg.item_name ->> 'en', '')) = ''
limit 15;

-- ---------------------------------------------------------------------------
-- 2) Schreiben
-- ---------------------------------------------------------------------------
begin;

update public.game_guides gg
set
  item_name = case
    when btrim(coalesce(gg.item_name ->> 'de', '')) <> ''
     and btrim(coalesce(gg.item_name ->> 'en', '')) = ''
      then (gg.item_name - 'de') || jsonb_build_object('en', gg.item_name -> 'de')
    when btrim(coalesce(gg.item_name ->> 'de', '')) <> ''
     and btrim(gg.item_name ->> 'de') = btrim(gg.item_name ->> 'en')
      then gg.item_name - 'de'
    else gg.item_name
  end,
  chronological_group = case
    when btrim(coalesce(gg.chronological_group ->> 'de', '')) <> ''
     and btrim(coalesce(gg.chronological_group ->> 'en', '')) = ''
      then (gg.chronological_group - 'de') || jsonb_build_object('en', gg.chronological_group -> 'de')
    when btrim(coalesce(gg.chronological_group ->> 'de', '')) <> ''
     and btrim(gg.chronological_group ->> 'de') = btrim(gg.chronological_group ->> 'en')
      then gg.chronological_group - 'de'
    else gg.chronological_group
  end
from public.games g
where g.id = gg.game_id
  and btrim(coalesce(g.spiel_typ, '')) = 'Quickwin'
  and (
    (
      btrim(coalesce(gg.item_name ->> 'de', '')) <> ''
      and (
        btrim(coalesce(gg.item_name ->> 'en', '')) = ''
        or btrim(gg.item_name ->> 'de') = btrim(gg.item_name ->> 'en')
      )
    )
    or (
      btrim(coalesce(gg.chronological_group ->> 'de', '')) <> ''
      and (
        btrim(coalesce(gg.chronological_group ->> 'en', '')) = ''
        or btrim(gg.chronological_group ->> 'de') = btrim(gg.chronological_group ->> 'en')
      )
    )
  );

-- Danach sollten die *_de_nach_en-Zaehler 0 sein.
-- Konflikte bleiben stehen.
select
  count(*) filter (
    where btrim(coalesce(gg.item_name ->> 'de', '')) <> ''
      and btrim(coalesce(gg.item_name ->> 'en', '')) = ''
  ) as item_name_noch_falsch,
  count(*) filter (
    where btrim(coalesce(gg.chronological_group ->> 'de', '')) <> ''
      and btrim(coalesce(gg.chronological_group ->> 'en', '')) = ''
  ) as gruppe_noch_falsch
from public.game_guides gg
join public.games g on g.id = gg.game_id
where btrim(coalesce(g.spiel_typ, '')) = 'Quickwin';

commit;
</file>

<file path="supabase/quickwins_publisher_from_entwickler.sql">
-- =============================================================================
-- Quickwins: Publisher aus entwickler nach games.publisher schieben
-- Einmal in der Supabase-SQL-Konsole. Zuerst die SELECTs, dann das UPDATE.
--
-- Nur spiel_typ = Quickwin.
-- Nur Zeilen ohne Publisher und mit gesetztem entwickler.
-- entwickler wird geleert, der Name liegt danach nur noch in publisher.
-- Andere Spieltypen und Quickwins, die schon einen Publisher haben, bleiben.
-- =============================================================================

-- ---------------------------------------------------------------------------
-- 1) Vorschau
-- ---------------------------------------------------------------------------
select
  count(*) filter (
    where nullif(btrim(coalesce(publisher, '')), '') is null
      and nullif(btrim(coalesce(entwickler, '')), '') is not null
  ) as wuerde_umziehen,
  count(*) filter (
    where nullif(btrim(coalesce(publisher, '')), '') is not null
  ) as publisher_schon_gesetzt,
  count(*) filter (
    where nullif(btrim(coalesce(publisher, '')), '') is null
      and nullif(btrim(coalesce(entwickler, '')), '') is null
  ) as beide_leer
from public.games
where btrim(coalesce(spiel_typ, '')) = 'Quickwin';

-- Haeufigste Namen, die umziehen
select
  btrim(entwickler) as entwickler,
  count(*) as spiele
from public.games
where btrim(coalesce(spiel_typ, '')) = 'Quickwin'
  and nullif(btrim(coalesce(publisher, '')), '') is null
  and nullif(btrim(coalesce(entwickler, '')), '') is not null
group by 1
order by spiele desc, entwickler
limit 40;

-- ---------------------------------------------------------------------------
-- 2) Schreiben
-- ---------------------------------------------------------------------------
begin;

update public.games
set
  publisher = btrim(entwickler),
  entwickler = null
where btrim(coalesce(spiel_typ, '')) = 'Quickwin'
  and nullif(btrim(coalesce(publisher, '')), '') is null
  and nullif(btrim(coalesce(entwickler, '')), '') is not null;

-- Danach: wuerde_umziehen = 0, publisher_schon_gesetzt entspricht der alten Zahl.
select
  count(*) filter (
    where nullif(btrim(coalesce(publisher, '')), '') is null
      and nullif(btrim(coalesce(entwickler, '')), '') is not null
  ) as noch_in_entwickler,
  count(*) filter (
    where nullif(btrim(coalesce(publisher, '')), '') is not null
      and nullif(btrim(coalesce(entwickler, '')), '') is null
  ) as nur_publisher
from public.games
where btrim(coalesce(spiel_typ, '')) = 'Quickwin';

commit;
</file>

<file path="supabase/quickwins_reset_igdb.sql">
-- =============================================================================
-- Quickwins: status.igdb zuruecksetzen, damit 04.1 die Credits neu zieht
-- Einmal in der Supabase-SQL-Konsole. Zuerst das SELECT, dann das UPDATE.
--
-- Nur spiel_typ = Quickwin und nur wenn igdb schon COMPLETED ist.
-- Der Schluessel igdb fliegt aus status. guide_de und alle anderen
-- Schluessel bleiben. publisher und entwickler bleiben, bis das Skript
-- sie ueberschreibt.
-- =============================================================================

-- ---------------------------------------------------------------------------
-- 1) Vorschau
-- ---------------------------------------------------------------------------
select
  count(*) filter (where coalesce(status ->> 'igdb', '') = 'COMPLETED') as wuerde_zuruecksetzen,
  count(*) filter (where coalesce(status ->> 'igdb', '') is distinct from 'COMPLETED') as bleibt_liegen,
  count(*) as quickwins
from public.games
where btrim(coalesce(spiel_typ, '')) = 'Quickwin';

-- ---------------------------------------------------------------------------
-- 2) Schreiben
-- ---------------------------------------------------------------------------
begin;

update public.games
set status = coalesce(status, '{}'::jsonb) - 'igdb'
where btrim(coalesce(spiel_typ, '')) = 'Quickwin'
  and coalesce(status ->> 'igdb', '') = 'COMPLETED';

select
  count(*) filter (where coalesce(status ->> 'igdb', '') = 'COMPLETED') as noch_completed
from public.games
where btrim(coalesce(spiel_typ, '')) = 'Quickwin';

commit;
</file>

<file path="supabase/recrawl_dlc_trophies.sql">
-- =============================================================================
-- DLC-Spiele erneut crawlen: status.trophies (PROCESSED) entfernen
-- Einmal in der Supabase-SQL-Konsole, NACH game_achievements_spielname.sql.
-- =============================================================================
--
-- Der Crawler nimmt nur Spiele, bei denen status.trophies fehlt oder
-- NO_TROPHIES ist. PROCESSED loeschen reicht, WENN der Crawler bestehende
-- Achievements nicht mehr ueberspringt (01.2_trophy_crawler_i18n.py).
--
-- Betrifft nur Spiele, die mindestens eine Trophäe ausserhalb von
-- default/all haben. guide_de / PUBLISHED bleiben unangetastet.
--
-- Zuerst die SELECTs, dann den UPDATE-Block entkommentieren.

-- ---------------------------------------------------------------------------
-- 1) Vorschau
-- ---------------------------------------------------------------------------

select
  count(distinct g.id) as spiele_mit_dlc_processed,
  count(distinct a.trophy_gruppe) as verschiedene_gruppen
from public.games g
join public.game_achievements a on a.game_id = g.id
where coalesce(g.status ->> 'trophies', '') = 'PROCESSED'
  and lower(coalesce(nullif(btrim(a.trophy_gruppe), ''), 'default'))
      not in ('default', 'all');

select
  g.id,
  coalesce(g.spieltitel ->> 'de', g.spieltitel ->> 'en') as titel,
  g.hardware,
  g.status ->> 'trophies' as trophies,
  g.status ->> 'guide_de' as guide_de,
  count(*) filter (
    where lower(coalesce(nullif(btrim(a.trophy_gruppe), ''), 'default'))
          not in ('default', 'all')
  ) as dlc_trophaeen
from public.games g
join public.game_achievements a on a.game_id = g.id
where coalesce(g.status ->> 'trophies', '') = 'PROCESSED'
  and exists (
    select 1
    from public.game_achievements x
    where x.game_id = g.id
      and lower(coalesce(nullif(btrim(x.trophy_gruppe), ''), 'default'))
          not in ('default', 'all')
  )
group by g.id, g.spieltitel, g.hardware, g.status
order by titel
limit 40;

