<file path="src/context/ErrorReportContext.jsx">
import { createContext, useCallback, useContext, useEffect, useRef, useState } from 'react';
import ErrorReportBubble from '../components/ErrorReportBubble';
import ErrorReportModal from '../components/ErrorReportModal';
import { metadataFromElement } from '../lib/errorReport';
import { findReportableElement } from '../lib/reportableAttrs';

const ErrorReportContext = createContext(null);

const SELECTION_DEBOUNCE_MS = 180;

function isCoarsePointer() {
  return typeof window !== 'undefined'
    && typeof window.matchMedia === 'function'
    && window.matchMedia('(pointer: coarse)').matches;
}

function computeBubblePosition(rect) {
  const padding = 8;
  const left = rect.left + rect.width / 2;

  if (isCoarsePointer()) {
    return {
      left,
      top: Math.min(window.innerHeight - 48, rect.bottom + 10),
      placement: 'below',
    };
  }

  const top = Math.max(padding, rect.top - padding);
  return { left, top, placement: 'above' };
}

export function ErrorReportProvider({ children, sessionUser }) {
  const [bubblePos, setBubblePos] = useState(null);
  const [markedContent, setMarkedContent] = useState('');
  const [modalDraft, setModalDraft] = useState(null);
  const pendingRef = useRef(null);
  const selectionTimerRef = useRef(null);

  const clearBubble = useCallback(() => {
    setBubblePos(null);
    setMarkedContent('');
    pendingRef.current = null;
  }, []);

  const openModalFromPending = useCallback(() => {
    const el = pendingRef.current;
    if (!el) return;
    const metadata = metadataFromElement(el);
    if (!metadata) {
      clearBubble();
      return;
    }

    const selection = window.getSelection();
    const selectedText = selection?.toString()?.trim() || markedContent;
    let content = selectedText;

    if (!content) {
      if (el.tagName === 'IMG') content = el.getAttribute('src') || el.alt || '';
      else if (el.tagName === 'IFRAME' || el.tagName === 'VIDEO') {
        content = el.getAttribute('src') || '';
      } else {
        content = el.textContent?.trim() || '';
      }
    }

    setModalDraft({ element: el, metadata, markedContent: content });
    clearBubble();
    selection?.removeAllRanges?.();
  }, [clearBubble, markedContent]);

  const handleSelection = useCallback(() => {
    const selection = window.getSelection();
    if (!selection || selection.isCollapsed) {
      clearBubble();
      return;
    }

    const text = selection.toString().trim();
    if (!text) {
      clearBubble();
      return;
    }

    const range = selection.rangeCount > 0 ? selection.getRangeAt(0) : null;
    if (!range) {
      clearBubble();
      return;
    }

    let node = range.startContainer;
    if (node.nodeType === Node.TEXT_NODE) node = node.parentElement;
    const reportable = findReportableElement(node);
    if (!reportable) {
      clearBubble();
      return;
    }

    const rect = range.getBoundingClientRect();
    if (!rect.width && !rect.height) {
      clearBubble();
      return;
    }

    pendingRef.current = reportable;
    setMarkedContent(text);
    setBubblePos(computeBubblePosition(rect));
  }, [clearBubble]);

  const scheduleSelectionCheck = useCallback(() => {
    if (selectionTimerRef.current) window.clearTimeout(selectionTimerRef.current);
    selectionTimerRef.current = window.setTimeout(() => {
      selectionTimerRef.current = null;
      handleSelection();
    }, SELECTION_DEBOUNCE_MS);
  }, [handleSelection]);

  const handleMediaClick = useCallback(
    (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const reportable = target.closest('[data-source][data-type][data-key][data-field]');
      if (!reportable) return;

      const tag = reportable.tagName;
      const isMedia = tag === 'IMG' || tag === 'VIDEO' || tag === 'IFRAME';

      if (!isMedia) return;

      event.preventDefault();
      event.stopPropagation();

      pendingRef.current = reportable;
      setMarkedContent(
        reportable.getAttribute('src') ||
          reportable.textContent?.trim() ||
          '',
      );
      setBubblePos(computeBubblePosition(reportable.getBoundingClientRect()));
    },
    [],
  );

  useEffect(() => {
    const onMouseUp = () => {
      window.requestAnimationFrame(handleSelection);
    };

    const onTouchEnd = () => {
      window.requestAnimationFrame(scheduleSelectionCheck);
    };

    const onSelectionChange = () => {
      scheduleSelectionCheck();
    };

    const onScroll = () => {
      if (bubblePos) clearBubble();
    };

    const onKeyDown = (e) => {
      if (e.key === 'Escape') {
        clearBubble();
        setModalDraft(null);
      }
    };

    document.addEventListener('mouseup', onMouseUp);
    document.addEventListener('touchend', onTouchEnd, { passive: true });
    document.addEventListener('selectionchange', onSelectionChange);
    document.addEventListener('click', handleMediaClick, true);
    document.addEventListener('scroll', onScroll, true);
    document.addEventListener('keydown', onKeyDown);

    return () => {
      if (selectionTimerRef.current) window.clearTimeout(selectionTimerRef.current);
      document.removeEventListener('mouseup', onMouseUp);
      document.removeEventListener('touchend', onTouchEnd);
      document.removeEventListener('selectionchange', onSelectionChange);
      document.removeEventListener('click', handleMediaClick, true);
      document.removeEventListener('scroll', onScroll, true);
      document.removeEventListener('keydown', onKeyDown);
    };
  }, [handleSelection, scheduleSelectionCheck, handleMediaClick, bubblePos, clearBubble]);

  const value = {
    openReportForElement: (element, content) => {
      const metadata = metadataFromElement(element);
      if (!metadata) return;
      setModalDraft({ element, metadata, markedContent: content || element.textContent?.trim() || '' });
    },
  };

  return (
    <ErrorReportContext.Provider value={value}>
      {children}
      <ErrorReportBubble position={bubblePos} onOpen={openModalFromPending} />
      <ErrorReportModal
        draft={modalDraft}
        sessionUser={sessionUser}
        onClose={() => setModalDraft(null)}
      />
    </ErrorReportContext.Provider>
  );
}

export function useErrorReport() {
  return useContext(ErrorReportContext);
}
</file>

<file path="src/context/PlatinumStatusContext.jsx">
import { createContext, useCallback, useContext, useEffect, useMemo, useState } from 'react';
import { supabase } from '../pages/supabaseClient';
import { PLATINUM_CHANGED_EVENT, PROGRESS_SYNCED_EVENT } from '../lib/localUserProgress';
import { scanLocalPlatinumGameIds } from '../lib/platinumGames';
import { fetchUserGuideProgress } from '../lib/userProgressQueries';

const PlatinumStatusContext = createContext(null);

export function PlatinumStatusProvider({ sessionUser, children }) {
  const userId = sessionUser?.id ?? null;
  const [platinumIds, setPlatinumIds] = useState(() => new Set(scanLocalPlatinumGameIds()));

  const refresh = useCallback(async () => {
    const next = new Set(scanLocalPlatinumGameIds());
    if (userId) {
      const { byGame, error } = await fetchUserGuideProgress(supabase, userId);
      if (!error) {
        for (const [gameId, row] of Object.entries(byGame ?? {})) {
          if (row?.isPlatinum) next.add(gameId);
        }
      }
    }
    setPlatinumIds(next);
  }, [userId]);

  useEffect(() => {
    void refresh();
  }, [refresh]);

  useEffect(() => {
    const onSynced = () => {
      void refresh();
    };
    window.addEventListener(PROGRESS_SYNCED_EVENT, onSynced);
    window.addEventListener(PLATINUM_CHANGED_EVENT, onSynced);
    return () => {
      window.removeEventListener(PROGRESS_SYNCED_EVENT, onSynced);
      window.removeEventListener(PLATINUM_CHANGED_EVENT, onSynced);
    };
  }, [refresh]);

  const value = useMemo(
    () => ({
      isPlatinum: (gameId) => {
        const id = String(gameId ?? '').trim();
        return Boolean(id) && platinumIds.has(id);
      },
      refreshPlatinum: refresh,
    }),
    [platinumIds, refresh],
  );

  return (
    <PlatinumStatusContext.Provider value={value}>
      {children}
    </PlatinumStatusContext.Provider>
  );
}

export function usePlatinumStatus() {
  const ctx = useContext(PlatinumStatusContext);
  if (!ctx) {
    return {
      isPlatinum: () => false,
      refreshPlatinum: async () => {},
    };
  }
  return ctx;
}
</file>

<file path="src/context/VisibilityContext.jsx">
import { createContext, useContext, useEffect, useMemo, useState } from 'react';
import { HIDDEN_IDS_STORAGE_KEY } from '../lib/guideKeyMigration';
import {
  DISPLAY_MODE_STORAGE_KEY,
  VISIBILITY_MODE,
  createVisibilityStore,
  gameVisibilityKey,
  itemVisibilityKey,
} from '../lib/visibilityPreferences';

const VisibilityContext = createContext(null);

const store = createVisibilityStore();

export function VisibilityProvider({ children }) {
  const [snapshot, setSnapshot] = useState(() => store.getSnapshot());

  useEffect(
    () =>
      store.subscribe(() => {
        setSnapshot(store.getSnapshot());
      }),
    [],
  );

  useEffect(() => {
    const onStorage = (event) => {
      if (event.key !== HIDDEN_IDS_STORAGE_KEY && event.key !== DISPLAY_MODE_STORAGE_KEY) return;
      store.reloadFromStorage();
    };
    window.addEventListener('storage', onStorage);
    return () => window.removeEventListener('storage', onStorage);
  }, []);

  const value = useMemo(
    () => ({
      displayMode: snapshot.displayMode,
      setDisplayMode: (mode) => store.setDisplayMode(mode),
      toggleHidden: (id) => store.toggleHidden(id),
      setHidden: (id, hidden) => store.setHidden(id, hidden),
      isHidden: (id) => store.isHidden(id),
      getEntryState: (id, options) => store.getEntryState(id, options),
      listHiddenGameUuids: () => store.listHiddenGameUuids(),
      replaceHiddenGameUuids: (ids) => store.replaceHiddenGameUuids(ids),
      itemKey: itemVisibilityKey,
      gameKey: gameVisibilityKey,
      modes: VISIBILITY_MODE,
    }),
    [snapshot],
  );

  return <VisibilityContext.Provider value={value}>{children}</VisibilityContext.Provider>;
}

export function useVisibility() {
  const ctx = useContext(VisibilityContext);
  if (!ctx) {
    throw new Error('useVisibility must be used within VisibilityProvider');
  }
  return ctx;
}
</file>

<file path="src/hooks/useAdminFollowups.js">
import { useEffect, useState } from 'react';
import { loadAdminFollowups, subscribeAdminFollowups } from '../lib/adminFollowups';

export function useAdminFollowups(userId) {
  const [entries, setEntries] = useState([]);
  const [error, setError] = useState('');

  useEffect(() => {
    if (!userId) {
      setEntries([]);
      setError('');
      return undefined;
    }

    let cancelled = false;
    let request = 0;

    const refresh = () => {
      const current = ++request;
      loadAdminFollowups()
        .then((rows) => {
          if (cancelled || current !== request) return;
          setEntries(rows);
          setError('');
        })
        .catch((err) => {
          if (cancelled || current !== request) return;
          setEntries([]);
          setError(err.message || 'Wiedervorlage konnte nicht geladen werden.');
        });
    };

    refresh();

    const unsubscribe = subscribeAdminFollowups((rows) => {
      request += 1;
      if (cancelled) return;
      setEntries(rows);
      setError('');
    });

    return () => {
      cancelled = true;
      unsubscribe();
    };
  }, [userId]);

  return { entries, error };
}
</file>

<file path="src/lib/adminFollowups.js">
import { supabase } from '../pages/supabaseClient';
import { GAME_I18N, GAME_PK, GAME_PLATFORM_ID, TABLES } from './gameSchema';

const CHANGE_EVENT = 'tb-admin-followups';
const TABLE = TABLES.gameWiedervorlage;
const ROW_SELECT = 'id, platform_game_id, spieltitel, freitext';

function notify(entries) {
  window.dispatchEvent(new CustomEvent(CHANGE_EVENT, { detail: { entries } }));
}

function normalizeRow(row) {
  return {
    id: String(row?.id ?? '').trim(),
    platform_game_id: row?.platform_game_id ?? null,
    spieltitel: row?.spieltitel ?? null,
    freitext: row?.freitext ?? null,
  };
}

export async function loadAdminFollowups() {
  const { data, error } = await supabase.from(TABLE).select(ROW_SELECT);
  if (error) {
    throw new Error(error.message || 'Wiedervorlage konnte nicht geladen werden.');
  }
  return (data ?? []).map(normalizeRow).filter((entry) => entry.id);
}

async function copyFromGames(gameId, freitext) {
  const { data, error } = await supabase
    .from(TABLES.games)
    .select(`${GAME_PK}, ${GAME_PLATFORM_ID}, ${GAME_I18N.title}`)
    .eq(GAME_PK, gameId)
    .maybeSingle();

  if (error) {
    throw new Error(error.message || 'Spiel konnte nicht gelesen werden.');
  }
  if (!data) {
    throw new Error('Spiel wurde nicht gefunden.');
  }

  const note = String(freitext ?? '').trim();
  return {
    id: data[GAME_PK],
    platform_game_id: data[GAME_PLATFORM_ID] ?? null,
    spieltitel: data[GAME_I18N.title] ?? null,
    freitext: note || null,
  };
}

/**
 * Legt eine Kopie in game_wiedervorlage an oder löscht nur diese Zeile.
 * @param {string} userId
 * @param {{ id: string, freitext?: string }} game
 */
export async function toggleAdminFollowup(userId, game) {
  const id = String(game?.id ?? '').trim();
  if (!userId || !id) {
    throw new Error('Wiedervorlage braucht eine angemeldete Admin-Sitzung.');
  }

  const { data: existing, error: readError } = await supabase
    .from(TABLE)
    .select('id')
    .eq('id', id)
    .maybeSingle();

  if (readError) {
    throw new Error(readError.message || 'Wiedervorlage konnte nicht gelesen werden.');
  }

  if (existing) {
    const { error } = await supabase.from(TABLE).delete().eq('id', id);
    if (error) {
      throw new Error(error.message || 'Wiedervorlage konnte nicht entfernt werden.');
    }
  } else {
    const row = await copyFromGames(id, game?.freitext);
    const { error } = await supabase.from(TABLE).insert(row);
    if (error) {
      throw new Error(error.message || 'Wiedervorlage konnte nicht gespeichert werden.');
    }
  }

  const next = await loadAdminFollowups();
  notify(next);
  return next;
}

export function subscribeAdminFollowups(listener) {
  if (typeof window === 'undefined') return () => {};

  const onCustom = (event) => {
    const entries = event.detail?.entries;
    if (Array.isArray(entries)) listener(entries);
  };

  window.addEventListener(CHANGE_EVENT, onCustom);
  return () => window.removeEventListener(CHANGE_EVENT, onCustom);
}
</file>

<file path="src/lib/betaAccess.js">
export const BETA_TESTER_ROLE = 'beta_tester';

/** Tester_ + genau 5 alphanumerische Zeichen */
export const BETA_TESTER_ID_PATTERN = /^Tester_[A-Za-z0-9]{5}$/;

export function isBetaTester(user) {
  if (!user) return false;
  const role = user.user_metadata?.role ?? user.app_metadata?.role;
  return role === BETA_TESTER_ROLE;
}

export function normalizeBetaTesterId(value) {
  return String(value ?? '').trim();
}

export function betaTesterEmail(testerId) {
  const id = normalizeBetaTesterId(testerId);
  return `${id.toLowerCase()}@beta.trophybase.app`;
}

function mapValidateError(code) {
  switch (code) {
    case 'missing_credentials':
      return 'Bitte Tester-ID und Passwort eingeben.';
    case 'invalid_tester_id_format':
      return 'Tester-ID muss wie Tester_A9k2M aussehen (Tester_ + 5 Zeichen).';
    case 'invalid_credentials':
      return 'Tester-ID oder Passwort ist falsch.';
    case 'already_used':
      return 'Dieser Beta-Zugang wurde bereits von jemand anderem eingelöst.';
    case 'not_authenticated':
      return 'Keine Session – bitte erneut anmelden.';
    default:
      return 'Beta-Zugang konnte nicht geprüft werden.';
  }
}

/**
 * RPC: Zugangsdaten gegen public.beta_testers prüfen.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 */
export async function validateBetaTester(supabase, testerId, password) {
  const id = normalizeBetaTesterId(testerId);
  const pw = String(password ?? '').trim();

  if (!id || !pw) {
    return { ok: false, message: mapValidateError('missing_credentials') };
  }
  if (!BETA_TESTER_ID_PATTERN.test(id)) {
    return { ok: false, message: mapValidateError('invalid_tester_id_format') };
  }

  const { data, error } = await supabase.rpc('tb_validate_beta_tester', {
    p_tester_id: id,
    p_password: pw,
  });

  if (error) {
    return { ok: false, message: error.message || mapValidateError() };
  }

  const payload = data && typeof data === 'object' ? data : {};
  if (!payload.ok) {
    return { ok: false, message: mapValidateError(payload.error) };
  }

  return {
    ok: true,
    testerId: payload.tester_id || id,
    email: payload.email || betaTesterEmail(id),
    alreadyClaimedByYou: Boolean(payload.already_claimed_by_you),
  };
}

/**
 * RPC: Slot dem aktuellen Auth-User zuordnen.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 */
export async function claimBetaTester(supabase, testerId, password) {
  const id = normalizeBetaTesterId(testerId);
  const pw = String(password ?? '').trim();

  const { data, error } = await supabase.rpc('tb_claim_beta_tester', {
    p_tester_id: id,
    p_password: pw,
  });

  if (error) {
    return { ok: false, message: error.message || mapValidateError() };
  }

  const payload = data && typeof data === 'object' ? data : {};
  if (!payload.ok) {
    return { ok: false, message: mapValidateError(payload.error) };
  }

  return { ok: true, testerId: payload.tester_id || id, email: payload.email };
}

/**
 * Rolle beta_tester in user_metadata setzen.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} [testerId]
 */
export async function markBetaTesterRole(supabase, testerId) {
  const { data, error } = await supabase.auth.updateUser({
    data: {
      role: BETA_TESTER_ROLE,
      ...(testerId ? { tester_id: normalizeBetaTesterId(testerId) } : {}),
    },
  });
  if (error) return { ok: false, message: error.message, user: null };
  return { ok: true, user: data.user };
}

/**
 * /beta-Login: Tester-ID + Passwort → Session + Rolle.
 * Legt den Auth-User bei Bedarf an (Confirm-Email sollte in der Beta aus sein).
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 */
export async function signInWithBetaTesterKeys(supabase, testerId, password) {
  const validated = await validateBetaTester(supabase, testerId, password);
  if (!validated.ok) return validated;

  const email = validated.email;
  const pw = String(password ?? '').trim();
  const id = validated.testerId;

  let user = null;
  let session = null;

  const { data: signInData, error: signInError } = await supabase.auth.signInWithPassword({
    email,
    password: pw,
  });

  if (!signInError && signInData?.session?.user) {
    user = signInData.session.user;
    session = signInData.session;
  } else {
    const { data: signUpData, error: signUpError } = await supabase.auth.signUp({
      email,
      password: pw,
      options: {
        data: {
          role: BETA_TESTER_ROLE,
          tester_id: id,
        },
      },
    });

    if (signUpError) {
      const already =
        /already registered|already exists|user already/i.test(signUpError.message || '');
      if (already) {
        return {
          ok: false,
          message:
            'Zugang existiert, Login fehlgeschlagen. Passwort prüfen oder in Supabase zurücksetzen.',
        };
      }
      return { ok: false, message: signUpError.message };
    }

    if (signUpData.session?.user) {
      user = signUpData.session.user;
      session = signUpData.session;
    } else {
      const retry = await supabase.auth.signInWithPassword({ email, password: pw });
      if (retry.error || !retry.data.session?.user) {
        return {
          ok: false,
          message:
            retry.error?.message ||
            'Account angelegt, aber keine Session. In Supabase „Confirm email“ für die Beta ggf. deaktivieren.',
        };
      }
      user = retry.data.session.user;
      session = retry.data.session;
    }
  }

  const claim = await claimBetaTester(supabase, id, pw);
  if (!claim.ok) {
    return { ok: false, message: claim.message };
  }

  if (!isBetaTester(user)) {
    const marked = await markBetaTesterRole(supabase, id);
    if (!marked.ok) return { ok: false, message: marked.message };
    user = marked.user ?? user;
  }

  return { ok: true, user, session, testerId: id, email };
}

/** @deprecated Alte Invite-Key-Tabelle; bleibt für Referenz. */
export async function redeemInviteKey(supabase, userKey, currentUserId) {
  void supabase;
  void userKey;
  void currentUserId;
  return {
    ok: false,
    message: 'Alte Invite-Keys sind abgelöst. Bitte Tester-ID + Passwort auf /beta nutzen.',
  };
}
