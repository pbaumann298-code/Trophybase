        {activeTab === 'website' && <WebsitePanel />}
        {activeTab === 'database' && <IntranetGameSearch sessionUser={sessionUser} />}
        {activeTab === 'reports' && <CommunityReportsPanel />}
        {activeTab === 'scripts' && <ScriptsPanel />}
      </main>
    </div>
  );
}

export default AdminApp;
