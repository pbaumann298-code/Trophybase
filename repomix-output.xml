].join(', ');

const GAME_SELECT_NO_PUBLISHER = GAME_SELECT.split(', ')
  .filter((column) => column !== GAME_STRUCT.publisher)
  .join(', ');

const GAME_SELECT_NO_HOME_TAGS = GAME_SELECT.split(', ')
  .filter((column) => column !== GAME_STRUCT.homeTags)
  .join(', ');

const GAME_SELECT_MINIMAL = GAME_SELECT.split(', ')
  .filter(
    (column) => column !== GAME_STRUCT.publisher && column !== GAME_STRUCT.homeTags,
  )
  .join(', ');

/** Schlanker Select für Hub-Seiten (85 % kleinerer Payload, NIEMALS das schwere beschreibung-JSONB). */
export const HUB_GAME_SELECT = [
  GAME_PK,
  GAME_STRUCT.slug,
  GAME_STRUCT.hardware,
  GAME_I18N.title,
  GAME_I18N.coverUrl,
  GAME_STRUCT.coverStatus,
  GAME_STRUCT.trophyCount,
  GAME_STRUCT.gameType,
  GAME_STRUCT.releaseYear,
  GAME_STRUCT.status,
  GAME_STRUCT.publishedLocales,
  GAME_STRUCT.publisher,
  GAME_STRUCT.developer,
  GAME_STRUCT.homeTags,
  GAME_STRUCT.hasOnlineTrophies,
  GAME_STRUCT.hasMissableTrophies,
  GAME_STRUCT.fsk,
].join(', ');

/** Publisher-Akkordeon / Titellisten: Cover ja, ohne Beschreibung. */
export const GAME_SELECT_LIST = HUB_GAME_SELECT;

/** Kachel-Karussells: Liste + Online-/Verpassbar-Flags, ohne schwere Textfelder. */
export const GAME_SELECT_TILES = HUB_GAME_SELECT;

let activeGameSelect = GAME_SELECT;

export function getGameSelect() {
  return activeGameSelect;
}

function selectForCatalogMode(mode) {
  if (mode === 'list') return GAME_SELECT_LIST;
  if (mode === 'tiles') return GAME_SELECT_TILES;
  return getGameSelect();
}

function hasPublisherColumn() {
  return activeGameSelect.includes(GAME_STRUCT.publisher);
}

function hasHomeTagsColumn() {
  return activeGameSelect.includes(GAME_STRUCT.homeTags);
}

function demoteMissingColumn(error, column, nextSelect) {
  if (!activeGameSelect.includes(column)) return false;
  const code = String(error?.code ?? '');
  const message = String(error?.message ?? '').toLowerCase();
  const missing =
    code === '42703' ||
    code === 'PGRST204' ||
    (message.includes(column) &&
      (message.includes('does not exist') ||
        message.includes('schema cache') ||
        message.includes('column')));
  if (!missing) return false;
  activeGameSelect = nextSelect;
  return true;
}

function demoteMissingPublisher(error) {
  const next = activeGameSelect.includes(GAME_STRUCT.homeTags)
    ? GAME_SELECT_NO_PUBLISHER
    : GAME_SELECT_MINIMAL;
  return demoteMissingColumn(error, GAME_STRUCT.publisher, next);
}

function demoteMissingHomeTags(error) {
  const next = activeGameSelect.includes(GAME_STRUCT.publisher)
    ? GAME_SELECT_NO_HOME_TAGS
    : GAME_SELECT_MINIMAL;
  return demoteMissingColumn(error, GAME_STRUCT.homeTags, next);
}

function demoteMissingRadarProfile(error) {
  if (!activeGameSelect.includes(GAME_STRUCT.radarProfile)) {
    return false;
  }
  const code = String(error?.code ?? '');
  const message = String(error?.message ?? '').toLowerCase();
  const missing =
    code === '42703' ||
    code === 'PGRST204' ||
    message.includes('radar_profile');
  if (!missing) return false;
  activeGameSelect = activeGameSelect
    .split(', ')
    .filter((col) => col !== GAME_STRUCT.radarProfile)
    .join(', ');
  return true;
}

/** PostgREST-Schema-Cache kennt `fsk` noch nicht: Spalte aus dem Select nehmen und einmal wiederholen. */
function isMissingFskError(error) {
  const code = String(error?.code ?? '');
  const message = String(error?.message ?? '').toLowerCase();
  if (!message.includes(GAME_STRUCT.fsk)) return false;
  return (
    code === '42703' ||
    code === 'PGRST204' ||
    message.includes('does not exist') ||
    message.includes('schema cache') ||
    message.includes('column')
  );
}

function demoteMissingFsk(error) {
  if (!activeGameSelect.includes(GAME_STRUCT.fsk)) return false;
  if (!isMissingFskError(error)) return false;
  activeGameSelect = activeGameSelect
    .split(', ')
    .filter((col) => col !== GAME_STRUCT.fsk)
    .join(', ');
  return true;
}

async function runSelect(build) {
  let result = await build();
  if (
    result?.error &&
    (demoteMissingFsk(result.error) ||
      demoteMissingPublisher(result.error) ||
      demoteMissingHomeTags(result.error) ||
      demoteMissingRadarProfile(result.error))
  ) {
    result = await build();
  }
  return result;
}

/** Lokalisierte Suchspalten (JSONB-Sprachmaps auf games) */
export const GAME_SEARCH_LOCALIZED_COLUMNS = {
  title: GAME_I18N.title,
};

/** Skalare Suchspalten auf games */
export const GAME_SEARCH_STRUCT_COLUMNS = {
  developer: GAME_STRUCT.developer,
  publisher: GAME_STRUCT.publisher,
  hardware: GAME_STRUCT.hardware,
};

/**
 * @param {unknown} ref Route-Segment: games.id (UUID) oder platform_game_id
 */
export function parseRouteGameRef(ref) {
  const id = String(ref ?? '').trim();
  if (!id) {
    return { valid: false, ref: null, kind: null, error: 'Spiel-ID fehlt' };
  }
  if (isUuid(id)) {
    return { valid: true, ref: id, kind: 'uuid', error: null };
  }
  if (NPWR_ID_PATTERN.test(id)) {
    return { valid: true, ref: id, kind: 'platform', error: null };
  }
  return {
    valid: false,
    ref: id,
    kind: null,
    error: `Ungültige Spiel-ID: „${id}"`,
  };
}

/**
 * @param {unknown} gameIds
 */
export function validateGameIdList(gameIds) {
  const raw = Array.isArray(gameIds) ? gameIds : [];
  const ids = [...new Set(raw.map((entry) => String(entry ?? '').trim()).filter(Boolean))];

  if (ids.length === 0) {
    return { valid: false, ids: [], error: 'Keine Spiel-IDs angegeben' };
  }

  const invalid = ids.filter((id) => !parseRouteGameRef(id).valid);
  if (invalid.length > 0) {
    return {
      valid: false,
      ids: [],
      error: `Ungültige Spiel-IDs: ${invalid.slice(0, 3).join(', ')}${invalid.length > 3 ? '…' : ''}`,
    };
  }

  return { valid: true, ids, error: null };
}

export function validateSearchQuery(query, options = {}) {
  const minLength = options.minLength ?? 1;
  const maxLength = options.maxLength ?? 80;
  const q = String(query ?? '').trim();

  if (!q) {
    return { valid: false, pattern: null, query: '', error: 'Suchbegriff fehlt' };
  }
  if (q.length < minLength) {
    return { valid: false, pattern: null, query: q, error: 'Suchbegriff ist zu kurz' };
  }
  if (q.length > maxLength) {
    return { valid: false, pattern: null, query: q, error: 'Suchbegriff ist zu lang' };
  }

  const sanitized = q.replace(/[%_\\]/g, '');
  if (!sanitized) {
    return { valid: false, pattern: null, query: q, error: 'Suchbegriff enthält nur Sonderzeichen' };
  }

  return { valid: true, pattern: `%${sanitized}%`, query: q, error: null };
}

function validateSearchColumn(column, allowed) {
  const col = String(column ?? '').trim();
  if (!col || !allowed.has(col)) {
    return { valid: false, column: null, error: `Unbekannte Suchspalte „${col}"` };
  }
  return { valid: true, column: col, error: null };
}

/**
 * games.platform_game_id ist JSONB. Übergibt man .contains() ein JS-Array,
 * baut supabase-js daraus ein PostgreSQL-Array-Literal (`cs.{a,b}`), woran der
 * JSON-Parser scheitert. Als String gereicht bleibt der Wert unverändert, wir
 * liefern also JSON-Syntax (`cs.["a"]`).
 * @param {string[]} values
 */
function jsonbArrayFilter(values) {
  return JSON.stringify(values);
}

async function fetchGameStructByRef(supabase, ref) {
  const parsed = parseRouteGameRef(ref);
  if (!parsed.valid) {
    return { data: null, error: new Error(parsed.error) };
  }

  const { data, error } = await runSelect(() => {
    let query = supabase.from(TABLES.games).select(getGameSelect());
    if (parsed.kind === 'uuid') {
      query = query.eq(GAME_PK, parsed.ref);
    } else {
      query = query.contains(GAME_PLATFORM_ID, jsonbArrayFilter([parsed.ref]));
    }
    return query.limit(1).maybeSingle();
  });
  return { data, error };
}

/**
 * Spiel über Pretty-URL /:locale/:hardware/:slug laden.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} hardware URL-Segment (ps5, ps4, …)
 * @param {string} slug
 * @param {string} [locale]
 */
export async function fetchGameBySlug(supabase, hardware, slug, locale = getLocale()) {
  const wantedSlug = String(slug ?? '').trim().toLowerCase();
  const wantedHw = String(hardware ?? '').trim().toLowerCase();
  if (!wantedSlug || !wantedHw) {
    return { data: null, error: new Error('Pretty-URL unvollständig') };
  }

  const { data, error } = await runSelect(() =>
    supabase
      .from(TABLES.games)
      .select(getGameSelect())
      .eq(GAME_STRUCT.slug, wantedSlug)
      .limit(20),
  );

  if (error) return { data: null, error };

  const rows = data ?? [];
  const match =
    rows.find((row) => hardwareToUrlSegment(row[GAME_STRUCT.hardware]) === wantedHw) ??
    (rows.length === 1 ? rows[0] : null);

  if (!match) return { data: null, error: null };
  return { data: mergeGameRecord(match, locale), error: null };
}

/**
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {unknown} routeRef UUID oder platform_game_id
 * @param {string} [locale]
 */
export async function fetchGameByRouteRef(supabase, routeRef, locale = getLocale()) {
  const { data: gameRow, error } = await fetchGameStructByRef(supabase, routeRef);
  if (error) return { data: null, error };
  if (!gameRow) return { data: null, error: null };

  return { data: mergeGameRecord(gameRow, locale), error: null };
}

/** @deprecated Alias */
export const fetchGameByNpwrId = fetchGameByRouteRef;

/**
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string[]} ids UUIDs und/oder platform_game_ids (Watchlist-Altdaten)
 * @param {string} [locale]
 */
export async function fetchGamesByIds(supabase, ids, locale = getLocale()) {
  const check = validateGameIdList(ids);
  if (!check.valid) {
    return { data: [], error: new Error(check.error) };
  }

  const uuids = check.ids.filter((id) => isUuid(id));
  const platformIds = check.ids.filter((id) => !isUuid(id));

  const run = () => {
    const queries = [];
    if (uuids.length) {
      queries.push(supabase.from(TABLES.games).select(getGameSelect()).in(GAME_PK, uuids));
    }
    if (platformIds.length) {
      const orFilter = platformIds
        .map((id) => `${GAME_PLATFORM_ID}.cs.["${id}"]`)
        .join(',');
      queries.push(supabase.from(TABLES.games).select(getGameSelect()).or(orFilter));
    }
    return Promise.all(queries);
  };

  let results = await run();
  let error = results.find((r) => r.error)?.error;
  if (error && (demoteMissingFsk(error) || demoteMissingPublisher(error))) {
    results = await run();
    error = results.find((r) => r.error)?.error;
  }
  if (error) return { data: [], error };

  const rows = [];
  const seen = new Set();
  for (const res of results) {
    for (const row of res.data ?? []) {
      const key = String(row[GAME_PK]);
      if (seen.has(key)) continue;
      seen.add(key);
      rows.push(row);
    }
  }

  return { data: mergeGameRows(rows, locale), error: null };
}

/** @deprecated */
export const fetchGamesByNpwrIds = fetchGamesByIds;

/** PostgREST-Default pro Request; darüber wird in Batches nachgeladen. */
export const SEARCH_FETCH_BATCH = 1000;
/** Harte Obergrenze, damit eine sehr kurze Suche den Client nicht sprengt. */
export const SEARCH_RESULT_CAP = 5000;

function quoteFilterValue(pattern) {
  return `"${String(pattern ?? '').replace(/["\\]/g, '')}"`;
}

/** Füllwörter, die zwischen den eigentlichen Suchworten stehen dürfen. */
const SEARCH_STOPWORDS = new Set([
  'the', 'a', 'an', 'of', 'and', 'or',
  'der', 'die', 'das', 'ein', 'eine', 'und', 'von',
  'le', 'la', 'les', 'des', 'et',
  'el', 'los', 'las', 'del',
]);

/**
 * Zerlegt eine Suche in Wörter. „Escape Backr“ trifft damit
 * „Escape the Backrooms“, ohne dass die Wörter direkt hintereinander stehen.
 * @param {string} query
 * @returns {string[]}
 */
export function searchWords(query) {
  const parts = String(query ?? '')
    .replace(/%/g, ' ')
    .split(/[\s,;:/|+_-]+/)
    .map((part) => part.replace(/[%_\\'’".!?()[\]]/g, ''))
    .filter((part) => part.length >= 2);

  const meaningful = parts.filter((part) => !SEARCH_STOPWORDS.has(part.toLowerCase()));
  const words = meaningful.length > 0 ? meaningful : parts;
  return words.slice(0, 6);
}

function capSearchLimit(limit, fallback = SEARCH_RESULT_CAP) {
  return Math.min(Math.max(Number(limit) || fallback, 1), SEARCH_RESULT_CAP);
}

/**
 * Titel liegen als JSONB-Sprachmap (spieltitel->>de …), daher ilike über alle
 * unterstützten Sprachen.
 */
function buildLocalizedOrFilter(column, pattern) {
  const value = quoteFilterValue(pattern);
  return SUPPORTED_LOCALES.map((lang) => `${column}->>${lang}.ilike.${value}`).join(',');
}

/**
 * Führt eine games-Suche aus und lädt bei Bedarf weitere Seiten nach, bis
 * `limit` erreicht ist oder keine Zeilen mehr kommen.
 * @param {() => object} makeQuery supabase-Query ohne limit/range
 * @param {number} limit
 */
async function fetchSearchRows(makeQuery, limit) {
  const run = async () => {
    const cap = capSearchLimit(limit);
    const all = [];
    let from = 0;

    while (from < cap) {
      const to = Math.min(from + SEARCH_FETCH_BATCH - 1, cap - 1);
      const { data, error } = await makeQuery().range(from, to);
      if (error) return { data: all, error };
      const rows = data ?? [];
      all.push(...rows);
      if (rows.length < to - from + 1) break;
      from += SEARCH_FETCH_BATCH;
    }

    return { data: all, error: null };
  };

  let result = await run();
  if (result.error && (demoteMissingFsk(result.error) || demoteMissingPublisher(result.error) || demoteMissingHomeTags(result.error))) {
    result = await run();
  }
  return result;
}

/**
 * Öffentliche Kataloge: nur PUBLISHED.
 * Admin-Vorschau: FERTIG oder PUBLISHED (noch nicht der ganze 20k-Katalog).
 * inkl. nur Trophäen: kein Guide-Statusfilter (Login + RLS).
 * Hubs (Quickwins, easy_platin, Servertot): `publishedInAny` = PUBLISHED in
 * mindestens einer der angegebenen Sprachen (Locale, de, en) statt nur in der
 * aktuellen Locale.
 * @param {object} query
 * @param {{ includeReady?: boolean, publishedOnly?: boolean, publishedInAny?: string[], includeTrophiesOnly?: boolean, locale?: string }} [catalog]
 */
function guideStatusMatch(state, locales = SUPPORTED_LOCALES) {
  return locales
    .map((lang) => `${GAME_STRUCT.status}->>${guideStatusKey(lang)}.eq.${state}`)
    .join(',');
}

/** Hub-Seiten: Spiel ist für jede Sprache sichtbar, sobald es in Locale, de oder en PUBLISHED ist. */
export function hubPublishedLocales(locale) {
  return [...new Set([String(locale || '').toLowerCase(), 'de', 'en'].filter(Boolean))];
}

export function applyGuideCatalogFilter(query, catalog = {}) {
  if (catalog.includeTrophiesOnly) return query;
  if (catalog.includeReady) {
    return query.or(
      `${guideStatusMatch(GUIDE_PUBLICATION.DONE)},${guideStatusMatch(GUIDE_PUBLICATION.PUBLISHED)},${guideStatusMatch(GUIDE_PUBLICATION.DRAFT)},${GAME_STRUCT.status}->>production_roadmap.eq.ACTIVE`,
    );
  }
  if (Array.isArray(catalog.publishedInAny) && catalog.publishedInAny.length > 0) {
    return query.or(guideStatusMatch(GUIDE_PUBLICATION.PUBLISHED, catalog.publishedInAny));
  }
  if (catalog.publishedOnly) {
    const locale = catalog.locale || getLocale();
    return query.filter(
      `${GAME_STRUCT.status}->>${guideStatusKey(locale)}`,
      'eq',
      GUIDE_PUBLICATION.PUBLISHED,
    );
  }
  return query;
}

/**
 * Admin-Suche: alle Spiele, nur veröffentlichte Guides, oder nur rohe (FERTIG / DRAFT).
 * Roh heißt guide_* = FERTIG/DRAFT in irgendeiner Sprache oder production_roadmap = ACTIVE, noch nicht PUBLISHED.
 * @param {object} query
 * @param {'all'|'published'|'raw'} [scope]
 */
export function applyStaffGuideScope(query, scope = 'all') {
  if (scope === 'published') return applyGuideCatalogFilter(query, { publishedOnly: true });
  if (scope === 'raw') {
    return query.or(
      `${guideStatusMatch(GUIDE_PUBLICATION.DONE)},${guideStatusMatch(GUIDE_PUBLICATION.DRAFT)},${GAME_STRUCT.status}->>production_roadmap.eq.ACTIVE`,
    );
  }
  return query;
}

/**
 * Öffentliche Kataloge (Suche, Startseite): Servertot immer ausblenden.
 * Optional zusätzlich nur Shovelware (`Quickwin`).
 * `easy_platin` und Kombi-Typen (`Evergreen, easy_platin`) bleiben in der Suche.
 * Behält Spiele ohne spiel_typ.
 */
export function applyExcludeQuickwins(query, exclude) {
  const column = GAME_STRUCT.gameType;
  if (!exclude) {
    return query.or(`${column}.is.null,${column}.not.ilike.%${GAME_TYPE.SERVER_DEAD}%`);
  }
  return query.or(
    `${column}.is.null,and(${column}.not.ilike.%${GAME_TYPE.QUICKWIN}%,${column}.not.ilike.%${GAME_TYPE.SERVER_DEAD}%)`,
  );
}

/** Ähnliche Spiele und neuere Ausgaben: keine Quickwins oder Servertot. easy_platin bleibt. */
export function excludeQuickwinStyleTypes(query) {
  const column = GAME_STRUCT.gameType;
  return query
    .not(column, 'ilike', `%${GAME_TYPE.QUICKWIN}%`)
    .not(column, 'ilike', `%${GAME_TYPE.SERVER_DEAD}%`);
}

async function searchLocalizedColumn(supabase, column, pattern, limit, catalog) {
  return fetchSearchRows(
    () => {
      let query = supabase
        .from(TABLES.games)
        .select(getGameSelect())
        .or(buildLocalizedOrFilter(column, pattern));
      query = applyExcludeQuickwins(applyGuideCatalogFilter(query, catalog), catalog.excludeQuickwins);
      return query;
    },
    limit,
  );
}

async function searchStructColumn(supabase, column, pattern, limit, catalog) {
  return fetchSearchRows(
    () => {
      let query = supabase.from(TABLES.games).select(getGameSelect()).ilike(column, pattern);
      query = applyExcludeQuickwins(applyGuideCatalogFilter(query, catalog), catalog.excludeQuickwins);
      return query;
    },
    limit,
  );
}

function parseStringArrayField(raw) {
  if (Array.isArray(raw)) return raw.map((item) => String(item ?? '').trim()).filter(Boolean);
  if (typeof raw === 'string' && raw.trim()) {
    const trimmed = raw.trim();
    if (trimmed.startsWith('[')) {
      try {
        const parsed = JSON.parse(trimmed);
        if (Array.isArray(parsed)) return parsed.map((item) => String(item ?? '').trim()).filter(Boolean);
      } catch {
        // ignore
      }
    }
    return [trimmed];
  }
  return [];
}

/**
 * Prüft im Client, ob ein Spiel auf eine Genre-/Subgenre-/Tag-Anfrage passt
 * (ausschließlich über `home_tags` und `formatLocalizedHomeTags`).
 */
export function gameMatchesGenreOrTagQuery(game, rawQuery, locale = getLocale()) {
  if (!game) return false;
  const q = String(rawQuery ?? '').replace(/%/g, '').trim().toLowerCase();
  if (!q) return true;

  const matchedSlugs = resolveMatchingHomeTagSlugs(q);
  const homeTags = parseStringArrayField(game[GAME_STRUCT.homeTags]).map((t) => t.toLowerCase());

  if (homeTags.includes(q)) return true;
  if (matchedSlugs.some((slug) => homeTags.includes(slug.toLowerCase()))) return true;

  const localizedTags = formatLocalizedHomeTags(
    game[GAME_STRUCT.homeTags],
    locale,
    '',
  ).toLowerCase();
  if (localizedTags.includes(q)) return true;

  const qTokens = searchWords(q).map((w) => w.toLowerCase());
  if (qTokens.length > 0) {
    const combinedText = `${localizedTags} ${homeTags.join(' ')}`;
    if (qTokens.every((tok) => combinedText.includes(tok))) return true;
  }

  return false;
}

/**
 * Baut einen PostgREST-OR-Filter für ein Genre-/Subgenre-Wort über `home_tags`-Slugs.
 */
function buildGenreOrTagFilterParts(token, extraSlugs = []) {
  const parts = [];
  const slugs = new Set([
    ...resolveMatchingHomeTagSlugs(token),
    ...extraSlugs,
  ]);
  if (hasHomeTagsColumn() && slugs.size > 0) {
    for (const slug of slugs) {
      parts.push(`${GAME_STRUCT.homeTags}.cs.{${slug}}`);
    }
  }
  return parts;
}

/**
 * Freitext über Titel, Subgenres/home_tags, Studio und Publisher.
 * Mehrere Wörter müssen alle vorkommen, aber nicht direkt hintereinander.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} pattern bereits validiertes ilike-Muster, z. B. %LEGO%
 * @param {number} [limit]
 * @param {string} [locale]
 */
function freeTextTokenFilter(token, extraHomeTagSlugs = []) {
  const pattern = `%${token}%`;
  const parts = [
    buildLocalizedOrFilter(GAME_I18N.title, pattern),
    ...buildGenreOrTagFilterParts(token, extraHomeTagSlugs),
    `${GAME_STRUCT.developer}.ilike.${quoteFilterValue(pattern)}`,
  ];
  if (hasPublisherColumn()) {
    parts.push(`${GAME_STRUCT.publisher}.ilike.${quoteFilterValue(pattern)}`);
  }
  return parts.join(',');
}

/**
 * Login-Suche ohne PUBLISHED-Filter (SECURITY DEFINER-RPC).
 * Kein RLS-OR auf games – sonst Startseiten-Timeouts fuer alle Eingeloggten.
 */
export async function searchGamesTrophiesOnlyRpc(
  supabase,
  words,
  limit = SEARCH_RESULT_CAP,
  locale = getLocale(),
  { excludeQuickwins = true } = {},
) {
  const list = (words ?? []).map((word) => String(word ?? '').trim()).filter(Boolean);
  if (list.length === 0) {
    return { data: [], error: new Error('Suchbegriff fehlt') };
  }

  const { data, error } = await supabase.rpc('tb_search_games_trophies_only', {
    p_words: list,
    p_limit: Math.min(Math.max(Number(limit) || SEARCH_RESULT_CAP, 1), 500),
  });

  if (error) return { data: [], error };

  let rows = Array.isArray(data) ? data : [];
  if (excludeQuickwins) {
    rows = rows.filter((game) => !isQuickwinStyleType(game?.[GAME_STRUCT.gameType]));
  }
  return { data: mergeGameRows(rows, locale), error: null };
}

export async function searchGamesByFreeText(
  supabase,
  pattern,
  limit = SEARCH_RESULT_CAP,
  locale = getLocale(),
  catalog = {},
) {
  const words = searchWords(pattern);
  if (words.length === 0) {
    return { data: [], error: new Error('Suchbegriff fehlt') };
  }

  const rawPhrase = String(pattern ?? '').replace(/%/g, ' ').trim();
  const phraseHomeTagSlugs = resolveMatchingHomeTagSlugs(rawPhrase);

  if (catalog.includeTrophiesOnly) {
    return searchGamesTrophiesOnlyRpc(supabase, words, limit, locale, {
      excludeQuickwins: catalog.excludeQuickwins !== false,
    });
  }

  const { data, error } = await fetchSearchRows(
    () => {
      let query = supabase.from(TABLES.games).select(getGameSelect());
      for (const word of words) {
        query = query.or(freeTextTokenFilter(word, phraseHomeTagSlugs));
      }
      return applyExcludeQuickwins(
        applyGuideCatalogFilter(
          query.order(GAME_STRUCT.releaseYear, { ascending: false, nullsFirst: false }),
          catalog,
        ),
        catalog.excludeQuickwins,
      );
    },
    limit,
  );
  if (error) return { data: [], error };
  return { data: mergeGameRows(data, locale), error: null };
}

/**
 * Sucht in einer JSONB-Sprachmap (spieltitel->>de …) oder einer skalaren
 * Textspalte (genre, entwickler, publisher). Die Spalte muss in einer der beiden
 * Allowlists stehen, damit kein beliebiger Filter durchgereicht wird.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} column
 * @param {string} pattern
 * @param {number} [limit]
 * @param {string} [locale]
 * @param {{ publishedOnly?: boolean, includeReady?: boolean }} [options]
 */
export async function searchGamesByColumn(
  supabase,
  column,
  pattern,
  limit = 60,
  locale = getLocale(),
  options = {},
) {
  const safeLimit = capSearchLimit(limit, 60);

  const localizedColumns = new Set(Object.values(GAME_SEARCH_LOCALIZED_COLUMNS));
  const structColumns = new Set(Object.values(GAME_SEARCH_STRUCT_COLUMNS));

  const colCheck = validateSearchColumn(
    column,
    new Set([...localizedColumns, ...structColumns]),
  );
  if (!colCheck.valid) {
    return { data: [], error: new Error(colCheck.error) };
  }

  const runSearch = localizedColumns.has(colCheck.column)
    ? searchLocalizedColumn
    : searchStructColumn;

  const { data, error } = await runSearch(supabase, colCheck.column, pattern, safeLimit, {
    includeReady: Boolean(options.includeReady),
    publishedOnly: Boolean(options.publishedOnly) && !options.includeReady,
    excludeQuickwins: Boolean(options.excludeQuickwins),
    locale,
  });
  if (error) return { data: [], error };

  return { data: mergeGameRows(data, locale), error: null };
}

/**
 * Startseiten-Tags: games.home_tags ist text[], Containment wie bei NPWR-Arrays.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} tag Allowlist-Slug, z. B. open_world
 */
export async function searchGamesByHomeTag(
  supabase,
  tag,
  limit = SEARCH_RESULT_CAP,
  locale = getLocale(),
  options = {},
) {
  const slug = String(tag ?? '').trim().toLowerCase();
  if (!slug) return { data: [], error: new Error('home_tags-Slug fehlt') };

  const { data, error } = await fetchSearchRows(
    () => {
      let query = supabase
        .from(TABLES.games)
        .select(getGameSelect())
        .contains(GAME_STRUCT.homeTags, [slug])
        .order(GAME_STRUCT.releaseYear, { ascending: false, nullsFirst: false });
      return applyExcludeQuickwins(
        applyGuideCatalogFilter(query, {
          includeReady: Boolean(options.includeReady),
          publishedOnly: Boolean(options.publishedOnly) && !options.includeReady,
          locale,
        }),
        options.excludeQuickwins,
      );
    },
    capSearchLimit(limit),
  );
  if (error) return { data: [], error };
  return { data: mergeGameRows(data, locale), error: null };
}

/**
 * games.sub_genres (text[]): exakter Genre-Treffer, z. B. Racing.
 */
export async function searchGamesBySubGenre(
  supabase,
  genre,
  limit = SEARCH_RESULT_CAP,
  locale = getLocale(),
  options = {},
) {
  const value = String(genre ?? '').trim();
  if (!value) return { data: [], error: new Error('Genre fehlt') };

  const { data, error } = await fetchSearchRows(
    () => {
      let query = supabase
        .from(TABLES.games)
        .select(getGameSelect())
        .overlaps(GAME_STRUCT.subGenres, [value])
        .order(GAME_STRUCT.releaseYear, { ascending: false, nullsFirst: false });
      return applyExcludeQuickwins(
        applyGuideCatalogFilter(query, {
          includeReady: Boolean(options.includeReady),
          publishedOnly: Boolean(options.publishedOnly) && !options.includeReady,
          locale,
        }),
        options.excludeQuickwins,
      );
    },
    capSearchLimit(limit),
  );
  if (error) return { data: [], error };
  return { data: mergeGameRows(data, locale), error: null };
}

/**
 * Studio in entwickler oder publisher (Rockstar sitzt oft nur im Publisher).
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} pattern bereits validiertes ilike-Muster
 */
export async function searchGamesByStudio(
  supabase,
  pattern,
  limit = SEARCH_RESULT_CAP,
  locale = getLocale(),
  options = {},
) {
  const check = validateSearchQuery(String(pattern ?? '').replace(/%/g, ''));
  if (!check.valid) return { data: [], error: new Error(check.error) };
  const like = check.pattern;
  const catalog = {
    includeReady: Boolean(options.includeReady),
    publishedOnly: Boolean(options.publishedOnly) && !options.includeReady,
    locale,
  };

  const run = (withPublisher) =>
    fetchSearchRows(
      () => {
        const parts = [`${GAME_STRUCT.developer}.ilike.${quoteFilterValue(like)}`];
        if (withPublisher) {
          parts.push(`${GAME_STRUCT.publisher}.ilike.${quoteFilterValue(like)}`);
        }
        return applyExcludeQuickwins(
          applyGuideCatalogFilter(
            supabase
              .from(TABLES.games)
              .select(getGameSelect())
              .or(parts.join(','))
              .order(GAME_STRUCT.releaseYear, { ascending: false, nullsFirst: false }),
            catalog,
          ),
          options.excludeQuickwins,
        );
      },
      capSearchLimit(limit),
    );

  let { data, error } = await run(hasPublisherColumn());
  if (error && demoteMissingFsk(error)) {
    ({ data, error } = await run(hasPublisherColumn()));
  }
  if (error && demoteMissingPublisher(error)) {
    ({ data, error } = await run(false));
  }
  if (error) return { data: [], error };
  return { data: mergeGameRows(data, locale), error: null };
}

/**
 * Erweiterte Suche: ausgefüllte Felder werden UND-verknüpft.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {{ title?: string, developer?: string, genre?: string, console?: string, hardware?: string }} filters
 * @param {{ limit?: number, locale?: string, includeReady?: boolean, publishedOnly?: boolean }} [options]
 */
export async function searchGamesAdvanced(supabase, filters = {}, options = {}) {
  const limit = capSearchLimit(options.limit, SEARCH_RESULT_CAP);
  const locale = options.locale ?? getLocale();

  const title = validateSearchQuery(filters.title);
  const developer = validateSearchQuery(filters.developer);
  const genre = validateSearchQuery(filters.genre);
  const hardware = validateSearchQuery(filters.hardware ?? filters.console);
  const tag = String(filters.tag ?? '').trim();
  const onlineMode = String(filters.onlineMode ?? '').trim();

  if (!title.valid && !developer.valid && !genre.valid && !hardware.valid && !tag && !onlineMode) {
    return { data: [], error: new Error('Mindestens ein Suchfeld ausfüllen') };
  }

  if (options.includeTrophiesOnly) {
    const words = [
      ...(title.valid ? searchWords(title.query) : []),
      ...(developer.valid ? searchWords(developer.query) : []),
      ...(genre.valid ? searchWords(genre.query) : []),
    ];
    const rpc = await searchGamesTrophiesOnlyRpc(supabase, words, limit, locale, {
      excludeQuickwins: options.excludeQuickwins !== false,
    });
    if (rpc.error) return rpc;
    let rows = rpc.data ?? [];
    if (hardware.valid) {
      const needle = hardware.query.toLowerCase();
      rows = rows.filter((game) =>
        String(game?.[GAME_STRUCT.hardware] ?? '').toLowerCase().includes(needle),
      );
    }
    if (tag) {
      rows = rows.filter((game) => gameMatchesGenreOrTagQuery(game, tag, locale));
    }
    if (genre.valid) {
      rows = rows.filter((game) => gameMatchesGenreOrTagQuery(game, genre.query, locale));
    }
    if (onlineMode === 'offline') {
      rows = rows.filter((game) => !game?.has_online_trophies || Number(game?.total_online_trophies) === 0);
    } else if (onlineMode === 'online') {
      rows = rows.filter((game) => Boolean(game?.has_online_trophies));
    }
    return { data: rows.slice(0, limit), error: null };
  }

  const { data, error } = await fetchSearchRows(() => {
    let query = supabase.from(TABLES.games).select(getGameSelect());

    if (title.valid) {
      for (const word of searchWords(title.query)) {
        query = query.or(buildLocalizedOrFilter(GAME_I18N.title, `%${word}%`));
      }
    }
    if (developer.valid) {
      const studioOr = [`${GAME_STRUCT.developer}.ilike.${quoteFilterValue(developer.pattern)}`];
      if (hasPublisherColumn()) {
        studioOr.push(`${GAME_STRUCT.publisher}.ilike.${quoteFilterValue(developer.pattern)}`);
      }
      query = studioOr.length > 1 ? query.or(studioOr.join(',')) : query.ilike(GAME_STRUCT.developer, developer.pattern);
    }
    if (genre.valid) {
      const genreSlugs = resolveMatchingHomeTagSlugs(genre.query);
      if (genreSlugs.length > 0 && hasHomeTagsColumn()) {
        query = query.overlaps(GAME_STRUCT.homeTags, genreSlugs);
      } else if (hasHomeTagsColumn()) {
        query = query.contains(GAME_STRUCT.homeTags, [genre.query.toLowerCase().trim()]);
      }
    }
    if (hardware.valid) {
      query = query.ilike(GAME_STRUCT.hardware, hardware.pattern);
    }
    if (tag) {
      query = query.contains(GAME_STRUCT.homeTags, [tag]);
    }
    if (onlineMode === 'offline') {
      query = query.or('has_online_trophies.is.false,total_online_trophies.eq.0');
    } else if (onlineMode === 'online') {
      query = query.eq('has_online_trophies', true);
    }

    return applyExcludeQuickwins(
      applyGuideCatalogFilter(query, {
        includeReady: Boolean(options.includeReady),
        publishedOnly: options.includeReady ? false : options.publishedOnly !== false,
        locale,
      }),
      options.excludeQuickwins,
    ).order(GAME_STRUCT.releaseYear, { ascending: false, nullsFirst: false });
  }, limit);

  if (error) return { data: [], error };
  let rows = data ?? [];
  if (genre.valid) {
    rows = rows.filter((game) => gameMatchesGenreOrTagQuery(game, genre.query, locale));
  }
  if (tag) {
    rows = rows.filter((game) => gameMatchesGenreOrTagQuery(game, tag, locale));
  }
  return { data: mergeGameRows(rows, locale), error: null };
}

/** Erste Batch-Größe für Sofort-Render auf Hub-Seiten (Progressive Loading). */
export const CATALOG_FETCH_PAGE = 48;
/** Hintergrund-Batch-Größe für nachfolgende Seiten auf Hub-Seiten (unter PostgREST 1.000er-Limit). */
export const HUB_BACKGROUND_BATCH = 500;

function stripPublisherColumn(columns) {
  return String(columns)
    .split(', ')
    .filter((column) => column !== GAME_STRUCT.publisher)
    .join(', ');
}

function stripFskColumn(columns) {
  return String(columns)
    .split(', ')
    .filter((column) => column !== GAME_STRUCT.fsk)
    .join(', ');
}

function isMissingPublisherError(error) {
  const code = String(error?.code ?? '');
  const message = String(error?.message ?? '').toLowerCase();
  return (
    code === '42703'
    || code === 'PGRST204'
    || (message.includes(GAME_STRUCT.publisher)
      && (message.includes('does not exist')
        || message.includes('schema cache')
        || message.includes('column')))
  );
}

/** Spieltypen mit eigener Hub-Seite (Quickwins, Easy Platins, Unobtainable). */
const HUB_GAME_TYPES = [GAME_TYPE.QUICKWIN, GAME_TYPE.EASY_PLATIN, GAME_TYPE.SERVER_DEAD];

/**
 * Veröffentlichte Spiele eines Typs (Quickwins, Easy Platins, Servertot, …).
 * Mit `limit`/`offset` nur eine Seite; sonst bis SEARCH_RESULT_CAP.
 * `mode: 'list'` = leicht (Publisher/Titel), `'tiles'` = +Cover, sonst voll.
 * Unterstützt Komma-getrennte Mehrfach-Typen in `games.spiel_typ` via .ilike.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} gameType
 * @param {string} [locale]
 * @param {{ includeReady?: boolean, limit?: number, offset?: number, mode?: 'full'|'list'|'tiles' }} [options]
 * @returns {Promise<{ data: object[], error: Error|null, hasMore?: boolean }>}
 */
export async function fetchGamesByType(supabase, gameType, locale = getLocale(), options = {}) {
  const includeReady = Boolean(options.includeReady);
  const offset = Math.max(0, Number(options.offset) || 0);
  const paged = options.limit != null || options.offset != null;
  const limit = paged
    ? capSearchLimit(options.limit ?? CATALOG_FETCH_PAGE, CATALOG_FETCH_PAGE)
    : SEARCH_RESULT_CAP;
  const isHubType = HUB_GAME_TYPES.some(
    (type) => type.toLowerCase() === String(gameType ?? '').toLowerCase(),
  );
  // Hub-Seiten laden NIEMALS das schwere beschreibung-JSONB für hunderte Spiele gleichzeitig.
  const mode =
    options.mode === 'list' || options.mode === 'tiles'
      ? options.mode
      : isHubType
        ? 'tiles'
        : 'full';
  const catalog = {
    includeReady,
    publishedOnly: !includeReady,
    // Hubs: in allen Sprachen voll, sobald der Guide in Locale, de oder en live ist.
    publishedInAny: !includeReady && isHubType ? hubPublishedLocales(locale) : undefined,
    locale,
  };

  const buildQuery = (columns) => {
    let query = supabase
      .from(TABLES.games)
      .select(columns)
      .ilike(
        GAME_STRUCT.gameType,
        isEasyPlatinGame(gameType) ? `%${GAME_TYPE.EASY_PLATIN}%` : `%${gameType}%`,
      );
    query = applyGuideCatalogFilter(query, catalog);
    return query
      .order(GAME_STRUCT.releaseYear, { ascending: false, nullsFirst: false })
      .order(GAME_PK, { ascending: true });
  };

  const fetchRange = async (columns, from, to) => {
    let used = columns;
    let result = await buildQuery(used).range(from, to);
    if (result.error && mode !== 'full' && isMissingFskError(result.error)) {
      used = stripFskColumn(used);
      result = await buildQuery(used).range(from, to);
    }
    if (result.error && mode !== 'full' && isMissingPublisherError(result.error)) {
      used = stripPublisherColumn(used);
      result = await buildQuery(used).range(from, to);
    } else if (result.error && mode === 'full') {
      result = await runSelect(() => buildQuery(getGameSelect()).range(from, to));
    }
    return { ...result, columns: used };
  };

  if (paged) {
    const columns = mode === 'full' ? getGameSelect() : selectForCatalogMode(mode);
    const { data, error } = mode === 'full'
      ? await runSelect(() => buildQuery(getGameSelect()).range(offset, offset + limit - 1))
      : await fetchRange(columns, offset, offset + limit - 1);
    if (error) return { data: [], error, hasMore: false };
    const rows = mergeGameRows(data ?? [], locale);
    return { data: rows, error: null, hasMore: (data ?? []).length >= limit };
  }

  if (mode !== 'full') {
    const all = [];
    let columns = selectForCatalogMode(mode);
    const onBatch = typeof options.onBatch === 'function' ? options.onBatch : null;

    // 1. Sofort-Render ab Batch 1: Erste 48 Spiele laden und sofort ans UI übergeben
    const firstBatchSize = CATALOG_FETCH_PAGE;
    const firstRes = await fetchRange(columns, 0, firstBatchSize - 1);
    if (firstRes.columns) columns = firstRes.columns;
    if (firstRes.error && isMissingFskError(firstRes.error)) {
      columns = stripFskColumn(columns);
    }
    if (firstRes.error && isMissingPublisherError(firstRes.error)) {
      columns = stripPublisherColumn(columns);
    }
    if (firstRes.error) {
      return { data: [], error: firstRes.error, hasMore: false };
    }
    const firstRows = firstRes.data ?? [];
    all.push(...firstRows);
    const firstMerged = mergeGameRows(all, locale);
    const hasMoreAfterFirst = firstRows.length >= firstBatchSize;
    if (onBatch) {
      onBatch(firstMerged, { isFirstBatch: true, done: !hasMoreAfterFirst });
    }
    if (!hasMoreAfterFirst) {
      return { data: firstMerged, error: null, hasMore: false };
    }

    // 2. Weitere Seiten im Hintergrund in schnellen Chunks nachladen
    let from = firstBatchSize;
    while (from < SEARCH_RESULT_CAP) {
      if (options.signal?.aborted) break;
      const to = Math.min(from + HUB_BACKGROUND_BATCH - 1, SEARCH_RESULT_CAP - 1);
      const page = await fetchRange(columns, from, to);
      const { data, error } = page;
      if (page.columns) columns = page.columns;
      if (error && isMissingFskError(error)) {
        columns = stripFskColumn(columns);
      }
      if (error && isMissingPublisherError(error)) {
        columns = stripPublisherColumn(columns);
      }
      if (error) {
        const partial = mergeGameRows(all, locale);
        if (onBatch) onBatch(partial, { isFirstBatch: false, done: true, error });
        return { data: partial, error, hasMore: false };
      }
      const rows = data ?? [];
      all.push(...rows);
      const done = rows.length < to - from + 1 || from + HUB_BACKGROUND_BATCH >= SEARCH_RESULT_CAP;
      const mergedSoFar = mergeGameRows(all, locale);
      if (onBatch) {
        onBatch(mergedSoFar, { isFirstBatch: false, done });
      }
      if (done) break;
      from += HUB_BACKGROUND_BATCH;
    }
    return { data: mergeGameRows(all, locale), error: null, hasMore: false };
  }

  const { data, error } = await fetchSearchRows(
    () => buildQuery(getGameSelect()),
    SEARCH_RESULT_CAP,
  );
  if (error) return { data: [], error, hasMore: false };
  return { data: mergeGameRows(data ?? [], locale), error: null, hasMore: false };
}

export async function fetchQuickwinGames(supabase, locale = getLocale(), options = {}) {
  return fetchGamesByType(supabase, GAME_TYPE.QUICKWIN, locale, options);
}

/**
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {number} [limit]
 * @param {string} [locale]
 */
export async function fetchRecentGames(supabase, limit = 12, locale = getLocale()) {
  const safeLimit = Math.min(Math.max(Number(limit) || 12, 1), 50);

  const { data, error } = await runSelect(() =>
    supabase
      .from(TABLES.games)
      .select(getGameSelect())
      .order(GAME_STRUCT.releaseYear, { ascending: false, nullsFirst: false })
      .order(GAME_STRUCT.createdAt, { ascending: false })
      .limit(safeLimit),
  );

  if (error) return { data: [], error };

  return { data: mergeGameRows(data ?? [], locale), error: null };
}

function capHomeLimit(limit) {
  return Math.min(Math.max(Number(limit) || 12, 1), 50);
}

/**
 * Startseiten-Reihe: Evergreen/Premium, nur redaktionell freigegebene Guides.
 * `orderColumn` zuerst, danach created_at als Tie-Breaker.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {{ types?: string[], orderColumn: string, limit?: number, locale?: string, includeReady?: boolean }} options
 */
async function fetchFeaturedHomeGames(supabase, options) {
  const types = options.types?.length ? options.types : HOME_FEATURED_GAME_TYPES;
  const limit = capHomeLimit(options.limit);
  const locale = options.locale ?? getLocale();
  const orderColumn = options.orderColumn;
  const catalog = {
    includeReady: Boolean(options.includeReady),
    publishedOnly: !options.includeReady,
    locale,
  };

  const run = (column) => {
    let query = supabase
      .from(TABLES.games)
      .select(getGameSelect());

    const orFilters = types.map((t) => `${GAME_STRUCT.gameType}.ilike.%${t}%`).join(',');
    query = query.or(orFilters);

    return applyGuideCatalogFilter(query, catalog)
      .order(column, { ascending: false, nullsFirst: false })
      .order(GAME_STRUCT.createdAt, { ascending: false })
      .limit(limit);
  };

  let { data, error } = await run(orderColumn);
  if (error && (demoteMissingFsk(error) || demoteMissingPublisher(error))) {
    ({ data, error } = await run(orderColumn));
  }
  if (error && orderColumn === GAME_STRUCT.views) {
    ({ data, error } = await run(GAME_STRUCT.createdAt));
  }
  if (error) return { data: [], error };
  return { data: mergeGameRows(data ?? [], locale), error: null };
}

/**
 * Beliebt: meistaufgerufene Evergreen-/Premium-Guides (games.views).
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {number} [limit]
 * @param {boolean} [includeReady]
 */
export async function fetchPopularGames(supabase, limit = 12, locale = getLocale(), includeReady = false) {
  return fetchFeaturedHomeGames(supabase, {
    types: HOME_FEATURED_GAME_TYPES,
    orderColumn: GAME_STRUCT.views,
    limit,
    locale,
    includeReady,
  });
}

/**
 * Neue Guides: jüngste Evergreen-/Premium-Guides (PUBLISHED, als Admin auch FERTIG).
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {number} [limit]
 * @param {string} [locale]
 * @param {boolean} [includeReady]
 */
export async function fetchNewGuideGames(supabase, limit = 12, locale = getLocale(), includeReady = false) {
  return fetchFeaturedHomeGames(supabase, {
    types: HOME_FEATURED_GAME_TYPES,
    orderColumn: GAME_STRUCT.createdAt,
    limit,
    locale,
    includeReady,
  });
}

const VIEWED_SESSION_PREFIX = 'tb_viewed:';

/**
 * Zählt einen Guide-Aufruf. Pro Browser-Tab-Session nur einmal, damit
 * React-Strict-Mode nicht doppelt zählt. Fehlt die Spalte oder die RPC,
 * schluckt der Aufruf den Fehler – die Seite bleibt nutzbar.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {unknown} gameUuid
 */
export async function incrementGameViews(supabase, gameUuid, sessionUser = null) {
  if (isStaffDeviceOrSession(sessionUser)) return;
  const uuid = String(gameUuid ?? '').trim();
  if (!uuid || !isUuid(uuid)) return;

  try {
    if (typeof sessionStorage !== 'undefined') {
      const key = `${VIEWED_SESSION_PREFIX}${uuid}`;
      if (sessionStorage.getItem(key)) return;
      sessionStorage.setItem(key, '1');
    }
  } catch {
    // sessionStorage kann in restriktiven Browsern fehlen
  }

  const { error } = await supabase.rpc('increment_game_views', { game_uuid: uuid });
  if (error) {
    try {
      if (typeof sessionStorage !== 'undefined') {
        sessionStorage.removeItem(`${VIEWED_SESSION_PREFIX}${uuid}`);
      }
    } catch {
      // ignore
    }
  }
}

/**
 * Beliebige Spielreferenz zu games.id (UUID) auflösen.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {unknown} gameOrRef
 */
export async function resolveGameUuid(supabase, gameOrRef) {
  if (gameOrRef && typeof gameOrRef === 'object') {
    const direct = getGameUuid(gameOrRef);
    if (direct) return { uuid: direct, error: null };
  }

  const ref = typeof gameOrRef === 'string' ? gameOrRef : getGameUuid(gameOrRef);
  if (!ref) return { uuid: null, error: new Error('Spielreferenz fehlt') };

  if (isUuid(ref)) return { uuid: ref, error: null };

  const { data, error } = await fetchGameStructByRef(supabase, ref);
  if (error) return { uuid: null, error };
  return { uuid: data?.[GAME_PK] ?? null, error: null };
}

/**
 * Schreibt lokalisierte games-Felder, ohne die anderen Sprachen der
 * JSONB-Sprachmap zu überschreiben.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} gameUuid
 * @param {string} locale
 * @param {Partial<Record<'title'|'coverUrl'|'description'|'statusExplanation', string>>} values
 */
export async function updateGameLocalizedFields(supabase, gameUuid, locale, values) {
  const columns = {
    title: GAME_I18N.title,
    coverUrl: GAME_I18N.coverUrl,
    description: GAME_I18N.description,
    statusExplanation: GAME_I18N.statusExplanation,
  };

  // Leere Strings bewusst erlaubt (z. B. Beschreibung einer Sprache leeren).
  const entries = Object.entries(values ?? {}).filter(
    ([key, value]) => columns[key] && value != null,
  );
  if (entries.length === 0) return { error: null };

  const { data: current, error: readError } = await supabase
    .from(TABLES.games)
    .select(Object.values(columns).join(', '))
    .eq(GAME_PK, gameUuid)
    .maybeSingle();

  if (readError) return { error: readError };

  const patch = {};
  for (const [key, value] of entries) {
    const column = columns[key];
    patch[column] = mergeLocalizedValue(current?.[column], locale, String(value).trim());
  }

  const { error } = await supabase.from(TABLES.games).update(patch).eq(GAME_PK, gameUuid);
  return { error };
}
