        className={`${btn} border-sky-500/40 text-sky-300 hover:border-sky-400 hover:text-sky-200`}
      >
        {busy ? '…' : t('markOnlineBulkApply').replaceAll('{count}', String(selectedCount))}
      </button>
    </div>
  );
}

