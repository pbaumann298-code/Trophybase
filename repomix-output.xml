<file path="server/sitemap.js">
import { SUPPORTED_LOCALES } from '../shared/countryLocaleMap.js';
import { GAME_STRUCT, GAME_TYPE } from '../src/lib/gameSchema.js';
import { hardwareToUrlSegment, buildPrettyGamePath } from '../src/lib/gameSlug.js';
import { servertotPublicPath } from '../src/lib/servertotPage.js';
import { easyPlatinsPublicPath } from '../src/lib/easyPlatinsPage.js';
import { quickwinsPublicPath } from '../src/lib/quickwinsPage.js';
import { getPublicSupabase, publicOrigin } from './publicSupabase.js';
import { parseSitemapLocale } from './prettyPath.js';
import { escapeHtml } from './escapeHtml.js';

/** Entspricht dem Cap in public.tb_sitemap_locale (supabase/tb_sitemap_locale.sql). */
const SITEMAP_URL_CAP = 10000;
const SITEMAP_RPC = 'tb_sitemap_locale';

function xmlWrap(body) {
  return `<?xml version="1.0" encoding="UTF-8"?>\n${body}`;
}

/**
 * RPC public.tb_sitemap_locale(p_locale, p_limit):
 * nur status->>guide_<lang> = PUBLISHED, is_indexable <> false und ohne
 * Quickwin / easy_platin / Servertot / Unlesbar. Liefert
 * { slug, hardware, spiel_typ, is_indexable, created_at } – dieselben Spalten,
 * die die XML-Generierung braucht (created_at → lastmod).
 */
async function rpcSitemapRows(supabase, locale, limit) {
  const { data, error } = await supabase.rpc(SITEMAP_RPC, {
    p_locale: locale,
    p_limit: limit,
  });
  if (error) return { data: null, error };
  return { data: Array.isArray(data) ? data : [], error: null };
}

/** Defensive Nachfilterung – die RPC filtert bereits, Hardware-Segment prüft nur der Server. */
function isSitemapRow(row) {
  if (!row?.slug || !hardwareToUrlSegment(row.hardware)) return false;
  if (row[GAME_STRUCT.isIndexable] === false) return false;
  if (row[GAME_STRUCT.gameType] === GAME_TYPE.SERVER_DEAD) return false;
  if (row[GAME_STRUCT.gameType] === GAME_TYPE.QUICKWIN) return false;
  if (row[GAME_STRUCT.gameType] === GAME_TYPE.EASY_PLATIN) return false;
  return true;
}

async function loadIndexablePublishedGames(supabase, locale) {
  const { data, error } = await rpcSitemapRows(supabase, locale, SITEMAP_URL_CAP);
  if (error) throw error;
  return data.filter(isSitemapRow);
}

function localesWithIndexableGames() {
  return SUPPORTED_LOCALES;
}

function urlEntry(loc, lastmod = '') {
  return [
    '  <url>',
    `    <loc>${escapeHtml(loc)}</loc>`,
    lastmod ? `    <lastmod>${escapeHtml(lastmod)}</lastmod>` : '',
    '    <changefreq>weekly</changefreq>',
    '  </url>',
  ]
    .filter(Boolean)
    .join('\n');
}

/**
 * Statische Sammelseiten – immer vor den Einzelspielen.
 * Die drei Hub-Seiten (Quickwins, Unerreichbare Platins, Easy Platins) stehen
 * in jeder Sprache fest drin; die Root-URL nur einmal (Default-Sprache de).
 */
function staticCollectionUrls(origin, locale) {
  const urls = [];
  if (locale === 'de') {
    urls.push(`${origin}/`);
  }
  urls.push(`${origin}${quickwinsPublicPath(locale)}`);
  urls.push(`${origin}${servertotPublicPath(locale)}`);
  urls.push(`${origin}${easyPlatinsPublicPath(locale)}`);
  return urls;
}

function urlset(origin, locale, games) {
  const staticPart = staticCollectionUrls(origin, locale)
    .map((loc) => urlEntry(loc))
    .join('\n');

  const gamePart = games
    .map((game) => {
      const hardware = hardwareToUrlSegment(game.hardware);
      const loc = buildPrettyGamePath(locale, hardware, game.slug);
      if (!loc) return '';
      const lastmod = String(game[GAME_STRUCT.createdAt] ?? '').slice(0, 10);
      return urlEntry(`${origin}${loc}`, lastmod);
    })
    .filter(Boolean)
    .join('\n');

  const body = [staticPart, gamePart].filter(Boolean).join('\n');

  return xmlWrap(
    `<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n${body}\n</urlset>`,
  );
}

function sitemapIndex(origin, locales) {
  const items = locales.map(
    (locale) =>
      `  <sitemap>\n    <loc>${escapeHtml(`${origin}/sitemap-${locale}.xml`)}</loc>\n  </sitemap>`,
  ).join('\n');
  return xmlWrap(
    `<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n${items}\n</sitemapindex>`,
  );
}

export async function handleSitemapRequest(requestUrl) {
  const parsed = parseSitemapLocale(requestUrl.pathname, requestUrl.search);
  const origin = publicOrigin(requestUrl);
  const headers = {
    'Content-Type': 'application/xml; charset=utf-8',
    'Cache-Control': 'public, s-maxage=86400, stale-while-revalidate=604800',
  };

  try {
    if (parsed.kind === 'index') {
      const localesWithUrls = localesWithIndexableGames();
      return new Response(sitemapIndex(origin, localesWithUrls), { status: 200, headers });
    }

    const supabase = getPublicSupabase();
    const games = await loadIndexablePublishedGames(supabase, parsed.locale);
    return new Response(urlset(origin, parsed.locale, games), {
      status: 200,
      headers,
    });
  } catch (error) {
    const message = escapeHtml(error?.message ?? 'Sitemap fehlgeschlagen');
    return new Response(xmlWrap(`<error>${message}</error>`), {
      status: 500,
      headers: {
        'Content-Type': 'application/xml; charset=utf-8',
        'Cache-Control': 'no-store',
      },
    });
  }
}
</file>

<file path="src/components/intranet/IntranetRohmaterial.jsx">
import { useCallback, useEffect, useMemo, useState } from 'react';
import { supabase } from '../../pages/supabaseClient';
import { handleStaffGamePreviewClick } from '../../lib/adminAccess';
import {
  discardRohmaterialBatch,
  fetchAllRohmaterialOverview,
} from '../../lib/rohmaterialQueries';
import IntranetDrafts from './IntranetDrafts';

const FILTERS = [
  { id: 'all', label: 'Alle' },
  { id: 'open', label: 'Offen' },
  { id: 'matched', label: 'Matched für PC' },
];

function statusTone(status) {
  const value = String(status ?? '').trim().toUpperCase();
  if (value === 'MATCHED') return 'text-sky-300 bg-sky-500/10 border-sky-500/30';
  return 'text-amber-300 bg-amber-500/10 border-amber-500/30';
}

function previewHref(row) {
  const id = String(row.gameId || row.platformGameId || '').trim();
  if (!id) return '';
  return `/guide/${encodeURIComponent(id)}?rohmaterial=1`;
}

function IntranetRohmaterial() {
  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [filter, setFilter] = useState('all');
  const [busyKey, setBusyKey] = useState('');
  const [editorGameId, setEditorGameId] = useState(null);

  const load = useCallback(async () => {
    setLoading(true);
    setError('');
    try {
      const { data, error: loadError } = await fetchAllRohmaterialOverview(supabase);
      if (loadError) throw loadError;
      setRows(data ?? []);
    } catch (err) {
      console.error('Rohmaterial Load Fehler:', err);
      setError(err?.message || 'Rohmaterial konnte nicht geladen werden.');
      setRows([]);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    load();
  }, [load]);

  const visible = useMemo(() => {
    if (filter === 'matched') {
      return rows.filter((row) => String(row.batchStatus ?? '').toUpperCase() === 'MATCHED');
    }
    if (filter === 'open') {
      return rows.filter((row) => String(row.batchStatus ?? '').toUpperCase() !== 'MATCHED');
    }
    return rows;
  }, [rows, filter]);

  const handleDiscard = async (batchKey) => {
    if (!batchKey || busyKey) return;
    if (!window.confirm(`Batch „${batchKey}" wirklich löschen?`)) return;
    setBusyKey(batchKey);
    const { error: discardError } = await discardRohmaterialBatch(supabase, batchKey);
    setBusyKey('');
    if (discardError) {
      setError(discardError.message || 'Batch konnte nicht gelöscht werden.');
      return;
    }
    setRows((prev) => prev.filter((row) => row.batchKey !== batchKey));
  };

  if (editorGameId) {
    return (
      <section className="space-y-4">
        <div className="flex items-center justify-between rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-2.5">
          <div className="flex items-center gap-2 text-xs text-amber-200 font-mono">
            <span>📦 Rohmaterial Multi-Tab & Gruppen-Konsolidierung</span>
          </div>
          <button
            type="button"
            onClick={() => {
              setEditorGameId(null);
              load();
            }}
            className="rounded-lg border border-zinc-700 bg-zinc-900 px-3 py-1.5 text-[11px] font-mono font-bold text-zinc-200 hover:border-zinc-500"
          >
            ← Zurück zur Batch-Übersicht
          </button>
        </div>
        <IntranetDrafts
          initialDataSource="rohmaterial"
          initialGameId={editorGameId === '__ALL__' ? null : editorGameId}
        />
      </section>
    );
  }

  return (
    <section className="space-y-6">
      <div>
        <h2 className="mb-1 text-lg font-bold text-white">Rohmaterial</h2>
        <p className="max-w-3xl text-sm leading-relaxed text-zinc-500">
          Offene Kandidaten aus Scraper Ultra in <span className="font-mono text-zinc-400">game_guides_rohmaterial</span>.
          Auf dem Handy prüfst du sie per Tinder-Leiste auf der Spieleseite.
        </p>
      </div>

      <div className="flex flex-wrap gap-2">
        {FILTERS.map((item) => (
          <button
            key={item.id}
            type="button"
            onClick={() => setFilter(item.id)}
            className={`rounded-xl border px-3 py-2 text-[11px] font-mono font-bold uppercase tracking-wider ${
              filter === item.id
                ? 'border-[#00ff66]/40 bg-[#00ff66]/10 text-[#00ff66]'
                : 'border-zinc-700 text-zinc-400 hover:text-zinc-200'
            }`}
          >
            {item.label}
          </button>
        ))}
        <button
          type="button"
          onClick={load}
          disabled={loading}
          className="rounded-xl border border-zinc-700 px-3 py-2 text-[11px] font-mono uppercase tracking-wider text-zinc-400 hover:text-zinc-200 disabled:opacity-40"
        >
          Neu laden
        </button>
      </div>

      {error ? (
        <p className="rounded-lg border border-red-500/25 bg-red-500/10 px-3 py-2 text-xs text-red-400">
          {error}
        </p>
      ) : null}

      {loading ? (
        <p className="font-mono text-sm text-zinc-500">Rohmaterial wird geladen…</p>
      ) : null}

      {!loading && visible.length === 0 ? (
        <p className="text-sm text-zinc-500">Keine Batches für diesen Filter.</p>
      ) : null}

      {!loading && visible.length > 0 ? (
        <ul className="space-y-3">
          {visible.map((row) => {
            const href = previewHref(row);
            return (
              <li
                key={`${row.gameId || 'game'}:${row.batchKey}`}
                className="rounded-2xl border border-zinc-800 bg-[#1a1b1c] p-4"
              >
                <div className="flex flex-wrap items-start justify-between gap-3">
                  <div className="min-w-0 space-y-1">
                    <p className="break-all font-mono text-sm font-bold text-white">{row.batchKey}</p>
                    <p className="text-xs text-zinc-400">
                      {row.totalRows} Zeilen{row.rowsAreGameTotal ? ' (Spiel gesamt)' : ''}
                      {row.creatorName ? ` · ${row.creatorName}` : ''}
                      {row.platformGameId ? ` · ${row.platformGameId}` : ''}
                      {row.gameId ? (
                        <span className="ml-1 font-mono text-[10px] text-zinc-600">
                          ({String(row.gameId).slice(0, 8)}…)
                        </span>
                      ) : null}
                    </p>
                    <span
                      className={`inline-flex rounded-md border px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider ${statusTone(row.batchStatus)}`}
                    >
                      {row.batchStatus || 'OPEN'}
                    </span>
                  </div>
                  <div className="flex flex-wrap gap-2">
                    <button
                      type="button"
                      onClick={() => setEditorGameId(row.gameId || row.platformGameId || '__ALL__')}
                      className="rounded-xl border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-[11px] font-mono font-bold uppercase tracking-wider text-amber-300 hover:bg-amber-500/20"
                    >
                      🔬 Gruppen & Batch-Editor
                    </button>
                    {href ? (
                      <a
                        href={href}
                        onClick={(event) => handleStaffGamePreviewClick(event, href)}
                        className="rounded-xl border border-[#00ff66]/35 bg-[#00ff66]/10 px-3 py-2 text-[11px] font-mono font-bold uppercase tracking-wider text-[#00ff66] no-underline hover:bg-[#00ff66]/15"
                      >
                        Auf Website prüfen
                      </a>
                    ) : null}
                    <button
                      type="button"
                      disabled={busyKey === row.batchKey}
                      onClick={() => handleDiscard(row.batchKey)}
                      className="rounded-xl border border-red-500/35 bg-red-500/10 px-3 py-2 text-[11px] font-mono font-bold uppercase tracking-wider text-red-300 hover:bg-red-500/15 disabled:opacity-40"
                      title="Batch löschen"
                    >
                      🗑 Löschen
                    </button>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      ) : null}
    </section>
  );
}

export default IntranetRohmaterial;
</file>

<file path="src/components/CategoryCarousel.jsx">
import { useCallback, useEffect, useRef, useState } from 'react';
import { getGameUuid, getRouteSlug } from '../lib/gameModel';
import { gameGuidePath } from '../lib/routeUtils';
import { getHomeCategoryTitle } from '../lib/homeCategories';
import { useLocale } from '../context/LocaleContext';
import GameTile from './GameTile';

const TILE_CLASS =
  'home-carousel-tile flex-shrink-0 snap-start w-[9.5rem] sm:w-44 lg:w-[calc((100%-3rem)/5)] max-w-[12rem] lg:max-w-[11.5rem]';

function CategoryCarousel({
  category,
  games,
  openGame,
  loading,
  onCategorySearch,
  onRequestLogin,
  isAdmin = false,
}) {
  const { globalLocale, t } = useLocale();
  const trackRef = useRef(null);
  const [canScrollLeft, setCanScrollLeft] = useState(false);
  const [canScrollRight, setCanScrollRight] = useState(false);

  const displayTitle = getHomeCategoryTitle(category, globalLocale, t);
  const searchTerm = category.searchTerm || category.title || displayTitle;

  const updateScrollHints = useCallback(() => {
    const el = trackRef.current;
    if (!el) return;
    setCanScrollLeft(el.scrollLeft > 8);
    setCanScrollRight(el.scrollLeft + el.clientWidth < el.scrollWidth - 8);
  }, []);

  useEffect(() => {
    updateScrollHints();
    const el = trackRef.current;
    if (!el) return undefined;
    const ro = new ResizeObserver(updateScrollHints);
    ro.observe(el);
    return () => ro.disconnect();
  }, [games.length, loading, updateScrollHints]);

  const scrollByTiles = (direction) => {
    const el = trackRef.current;
    if (!el) return;
    const amount = Math.round(el.clientWidth * 0.85) * direction;
    el.scrollBy({ left: amount, behavior: 'smooth' });
  };

  const renderTile = (g, index) => {
    const routeSlug = getRouteSlug(g);
    const watchlistGameId = getGameUuid(g);
    return (
      <GameTile
        key={routeSlug || watchlistGameId || `${category.id}-${index}`}
        game={g}
        href={gameGuidePath(g, globalLocale)}
        className={TILE_CLASS}
        accent={category.accent}
        isAdmin={isAdmin}
        onRequestLogin={onRequestLogin}
        onOpen={() => {
          openGame(g);
        }}
      />
    );
  };

  return (
    <section className="home-category w-full min-w-0 max-w-full" aria-labelledby={`cat-${category.id}`}>
      <header className="home-category-header">
        <div className="home-category-heading min-w-0">
          {(category.search || category.searchTerm) && onCategorySearch ? (
            <button
              type="button"
              id={`cat-${category.id}`}
              className="home-category-title home-category-title--clickable"
              onClick={() => onCategorySearch(searchTerm)}
              title={t('homeCategoryShowAll').replaceAll('{title}', displayTitle)}
            >
              <span className="home-category-emoji" aria-hidden>
                {category.emoji}
              </span>
              {displayTitle}
              <span className="home-category-search-hint" aria-hidden>
                ↗
              </span>
            </button>
          ) : (
            <h2 id={`cat-${category.id}`} className="home-category-title">
              <span className="home-category-emoji" aria-hidden>
                {category.emoji}
              </span>
              {displayTitle}
            </h2>
          )}
        </div>
        <div className="home-category-nav flex-shrink-0">
          <button
            type="button"
            className="home-scroll-btn"
            aria-label={t('homeCategoryScrollLeft').replaceAll('{title}', displayTitle)}
            disabled={!canScrollLeft}
            onClick={() => scrollByTiles(-1)}
          >
            ‹
          </button>
          <button
            type="button"
            className="home-scroll-btn"
            aria-label={t('homeCategoryScrollRight').replaceAll('{title}', displayTitle)}
            disabled={!canScrollRight}
            onClick={() => scrollByTiles(1)}
          >
            ›
          </button>
        </div>
      </header>

      <div className="home-carousel-wrap">
        {loading ? (
          <div className="home-carousel-track home-carousel-track--loading" ref={trackRef}>
            {Array.from({ length: 6 }).map((_, i) => (
              <div key={i} className={`${TILE_CLASS} home-tile-skeleton`} />
            ))}
          </div>
        ) : games.length === 0 ? (
          <p className="home-category-empty">
            {t('homeCategoryEmpty')}
          </p>
        ) : (
          <div
            ref={trackRef}
            className="home-carousel-track scrollbar-hide"
            onScroll={updateScrollHints}
          >
            {games.map(renderTile)}
          </div>
        )}
      </div>
    </section>
  );
}

export default CategoryCarousel;
</file>

<file path="src/components/GameSeoInfobox.jsx">
import { useEffect, useState } from 'react';
import { useLocale } from '../context/LocaleContext';
import { updateGameLocalizedFields } from '../lib/gameQueries';
import { supabase } from '../pages/supabaseClient';

function YoutubeIcon() {
  return (
    <svg viewBox="0 0 24 24" className="w-4 h-4" aria-hidden="true">
      <path
        fill="currentColor"
        d="M23.5 6.2a3.1 3.1 0 0 0-2.2-2.2C19.4 3.5 12 3.5 12 3.5s-7.4 0-9.3.5A3.1 3.1 0 0 0 .5 6.2 32.6 32.6 0 0 0 0 12a32.6 32.6 0 0 0 .5 5.8 3.1 3.1 0 0 0 2.2 2.2c1.9.5 9.3.5 9.3.5s7.4 0 9.3-.5a3.1 3.1 0 0 0 2.2-2.2A32.6 32.6 0 0 0 24 12a32.6 32.6 0 0 0-.5-5.8zM9.8 15.5v-7L16 12l-6.2 3.5z"
      />
    </svg>
  );
}

function GameSeoInfobox({
  title,
  description,
  creator = null,
  creators = null,
  isAdmin = false,
  gameUuid = '',
  locale = '',
  onDescriptionSaved,
  showDescription = true,
  className = '',
}) {
  const { globalLocale, t } = useLocale();
  const text = showDescription && typeof description === 'string' ? description.trim() : '';
  const list = (Array.isArray(creators) ? creators : [creator]).filter(Boolean);
  const names = [...new Set(list.map((item) => String(item.channelName ?? '').trim()).filter(Boolean))];
  const withYoutube = list.filter((item) => String(item.youtubeUrl ?? '').trim());
  const AND_WORD = {
    ja: 'と',
    en: 'and',
    fr: 'et',
    es: 'y',
    de: 'und',
    it: 'e',
    nl: 'en',
    pt: 'e',
    pl: 'i',
    ru: 'и',
    ko: '및',
    'zh-hant': '和',
    'zh-hans': '和',
    fi: 'ja',
    sv: 'och',
    ar: 'و',
  };
  const andWord = AND_WORD[globalLocale] ?? 'and';
  const nameLabel =
    names.length <= 1
      ? names[0] || ''
      : names.length === 2
        ? `${names[0]} ${andWord} ${names[1]}`
        : `${names.slice(0, -1).join(', ')} ${andWord} ${names[names.length - 1]}`;
  const credit = nameLabel ? t('creatorCredit').replaceAll('{name}', nameLabel) : '';

  const [editing, setEditing] = useState(false);
  const [draft, setDraft] = useState('');
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState('');

  useEffect(() => {
    setEditing(false);
    setError('');
  }, [gameUuid, locale]);

  if (!text && !credit && withYoutube.length === 0 && !(showDescription && isAdmin)) return null;

  const paragraphs = text.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);

  const startEdit = () => {
    setDraft(typeof description === 'string' ? description : '');
    setError('');
    setEditing(true);
  };

  const handleSave = async () => {
    if (!gameUuid || !locale || saving) return;
    setSaving(true);
    setError('');
    const { error: saveError } = await updateGameLocalizedFields(
      supabase,
      gameUuid,
      locale,
      { description: draft },
    );
    setSaving(false);
    if (saveError) {
      setError(saveError.message || 'Beschreibung konnte nicht gespeichert werden.');
      return;
    }
    onDescriptionSaved?.(draft);
    setEditing(false);
  };

  return (
    <section
      className={`${className || 'mb-8'} rounded-2xl border border-white/10 bg-zinc-900/60 p-5 md:p-6 shadow-none`}
      aria-label={showDescription ? 'Spielbeschreibung' : 'Content Creator'}
    >
      <div>
        {showDescription ? (
          <>
            <div className="mb-4 flex flex-wrap items-center gap-2">
              <span className="inline-flex items-center gap-1.5 rounded-sm border border-[#00ff66]/20 bg-[#00ff66]/10 px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-[#00ff66]">
                <span aria-hidden="true">◆</span> Guide-Info
              </span>
              {title && (
                <h3 className="text-sm font-bold tracking-tight text-zinc-200 md:text-base">
                  {title}
                </h3>
              )}
              {isAdmin && !editing ? (
                <button
                  type="button"
                  onClick={startEdit}
                  className="ml-auto rounded-lg border border-zinc-700 px-2.5 py-1 text-[11px] font-mono font-bold uppercase tracking-wider text-zinc-300 hover:border-[#00ff66]/40 hover:text-[#00ff66]"
                >
                  {text ? 'Beschreibung bearbeiten' : '+ Beschreibung hinzufügen'}
                </button>
              ) : null}
            </div>

            {editing ? (
              <div className="space-y-3">
                <textarea
                  value={draft}
                  onChange={(e) => setDraft(e.target.value)}
                  rows={8}
                  className="w-full rounded-xl border border-zinc-700 bg-zinc-950 px-3 py-2 text-sm leading-relaxed text-zinc-200"
                  placeholder="Spielbeschreibung…"
                />
                <div className="flex flex-wrap justify-end gap-2">
                  <button
                    type="button"
                    onClick={() => setEditing(false)}
                    disabled={saving}
                    className="rounded-lg border border-zinc-700 px-2.5 py-1 text-[11px] font-mono uppercase tracking-wider text-zinc-400"
                  >
                    Abbrechen
                  </button>
                  <button
                    type="button"
                    onClick={handleSave}
                    disabled={saving}
                    className="rounded-lg border border-[#00ff66]/40 bg-[#00ff66]/10 px-2.5 py-1 text-[11px] font-mono font-bold uppercase tracking-wider text-[#00ff66]"
                  >
                    {saving ? '…' : 'Speichern'}
                  </button>
                </div>
                {error ? <p className="text-xs text-red-400">{error}</p> : null}
              </div>
            ) : (
              <>
                {paragraphs.length > 0 && (
                  <div className="space-y-3 text-sm leading-relaxed text-zinc-300 md:text-[15px]">
                    {paragraphs.map((paragraph, index) => (
                      <p key={index}>{paragraph}</p>
                    ))}
                  </div>
                )}

                {!text && isAdmin ? (
                  <p className="text-sm italic text-zinc-500">Noch keine Beschreibung für diese Sprache.</p>
                ) : null}
              </>
            )}
          </>
        ) : null}

        {(credit || withYoutube.length > 0) && !editing && (
          <div className={showDescription && (paragraphs.length > 0 || (!text && isAdmin)) ? 'mt-5 pt-5 border-t border-white/10' : ''}>
            {credit ? (
              <p className="text-sm leading-relaxed text-zinc-200">{credit}</p>
            ) : null}
            {withYoutube.length > 0 ? (
              <div className={`flex flex-wrap gap-2 ${credit ? 'mt-4' : ''}`}>
                {withYoutube.map((item) => (
                  <a
                    key={item.id || item.youtubeUrl}
                    href={item.youtubeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="inline-flex items-center gap-3 rounded-xl bg-[#ff0000] hover:bg-[#e00000] text-white text-xs font-bold uppercase tracking-wider px-4 py-2.5 transition"
                  >
                    <YoutubeIcon />
                    <span>{t('creatorYoutube')}</span>
                    {item.channelName ? (
                      <span className="ml-1.5 normal-case tracking-normal font-semibold opacity-95">
                        {item.channelName}
                      </span>
                    ) : null}
                  </a>
                ))}
              </div>
            ) : null}
          </div>
        )}
      </div>
    </section>
  );
}

