<file path="src/pages/WatchlistPage.jsx">
import { useEffect, useState } from 'react';
import { supabase } from './supabaseClient';
import SearchResultsPage from './SearchResultsPage';
import { fetchGamesByIds, parseRouteGameRef } from '../lib/gameQueries';
import { GAME_STRUCT } from '../lib/gameSchema';
import { getGameUuid, getPlatformGameIds } from '../lib/gameModel';
import { isGameDraftMode, parseStatusMap, setGameDraftMode } from '../lib/guidePublication';
import { canonicalizeWatchlistIds, watchlistIdsEqual } from '../lib/localWatchlist';
import { useWatchlist } from '../context/WatchlistContext';
import { useLocale } from '../context/LocaleContext';
import { useVisibility } from '../context/VisibilityContext';

/**
 * Volle Watchlist in Suchergebnis-Optik.
 */
function WatchlistPage({
  openGame,
  onBack,
  onRequestLogin,
  isAdmin = false,
}) {
  const { globalLocale, t } = useLocale();
  const { watchlistIdList, version, replaceWatchlistIds } = useWatchlist();
  const { getEntryState, gameKey } = useVisibility();
  const [games, setGames] = useState([]);
  const [loading, setLoading] = useState(true);
  const [page, setPage] = useState(1);

  useEffect(() => {
    const previous = document.title;
    document.title = `${t('watchlistTitle')} · TrophyBase.app`;
    return () => {
      document.title = previous;
    };
  }, [t]);

  useEffect(() => {
    let cancelled = false;

    async function load() {
      const ids = watchlistIdList.filter((id) => parseRouteGameRef(id).valid);
      if (ids.length === 0) {
        if (!cancelled) {
          if (watchlistIdList.length > 0) {
            try {
              replaceWatchlistIds([]);
            } catch {
              /* Quota */
            }
          }
          setGames([]);
          setLoading(false);
        }
        return;
      }

      setLoading(true);
      const { data, error } = await fetchGamesByIds(supabase, ids, globalLocale);
      if (cancelled) return;

      if (error) {
        console.error('Watchlist-Seite:', error.message);
        setGames([]);
        setLoading(false);
        return;
      }

      const byRef = new Map();
      for (const game of data || []) {
        const uuid = getGameUuid(game);
        if (uuid) byRef.set(uuid, game);
        for (const npwr of getPlatformGameIds(game)) byRef.set(npwr, game);
      }

      const seen = new Set();
      const ordered = [];
      for (const id of ids) {
        const game = byRef.get(id);
        if (!game) continue;
        const uuid = getGameUuid(game) || id;
        if (seen.has(uuid)) continue;
        seen.add(uuid);
        ordered.push(game);
      }

      const canonical = canonicalizeWatchlistIds(watchlistIdList, (id) =>
        getGameUuid(byRef.get(id)),
      );
      if (!watchlistIdsEqual(canonical, watchlistIdList)) {
        try {
          replaceWatchlistIds(canonical);
        } catch {
          /* Quota */
        }
      }

      setGames(ordered);
      setLoading(false);
    }

    load();
    return () => {
      cancelled = true;
    };
  }, [watchlistIdList, version, globalLocale, replaceWatchlistIds]);

  const visibleGames = games.filter((game) => {
    const id = getGameUuid(game);
    if (!id) return true;
    return getEntryState(gameKey(id), { completed: false }).visible;
  });

  const handleToggleDraftMode = async (game) => {
    const uuid = getGameUuid(game);
    if (!uuid || !isAdmin) return { error: new Error('Keine Berechtigung') };
    const nextEnable = !isGameDraftMode(game);
    const { status: rpcStatus, error } = await setGameDraftMode(supabase, uuid, nextEnable);
    if (error) {
      console.error('tb_set_game_draft_mode:', error.message);
      return { error };
    }
    setGames((prev) =>
      prev.map((item) => {
        if (getGameUuid(item) !== uuid) return item;
        const currentStatus = parseStatusMap(item[GAME_STRUCT.status] ?? item.status);
        const nextStatus =
          rpcStatus && Object.keys(rpcStatus).length > 0
            ? rpcStatus
            : {
                ...currentStatus,
                production_roadmap: nextEnable ? 'ACTIVE' : 'INACTIVE',
                guide_de: nextEnable
                  ? currentStatus.guide_de || 'DRAFT'
                  : currentStatus.guide_de === 'DRAFT'
                    ? undefined
                    : currentStatus.guide_de,
              };
        return {
          ...item,
          [GAME_STRUCT.status]: nextStatus,
          status: nextStatus,
        };
      }),
    );
    return { error: null };
  };

  const handleOpenWatchlistGame = (game, options = {}) => {
    if (isAdmin && (isGameDraftMode(game) || options?.preferGuideTab)) {
      openGame(game, { ...options, preferGuideTab: true });
      return;
    }
    openGame(game, options);
  };

  return (
    <SearchResultsPage
      searchResults={visibleGames}
      openGame={handleOpenWatchlistGame}
      loading={loading}
      onRequestLogin={onRequestLogin}
      onBack={onBack}
      isAdmin={isAdmin}
      isWatchlist
      onToggleDraftMode={isAdmin ? handleToggleDraftMode : null}
      page={page}
      onPageChange={setPage}
      resultsTitle={t('watchlistTitle')}
      emptyMessage={t('watchlistEmpty')}
    />
  );
}

export default WatchlistPage;
</file>

<file path="supabase/tb_sitemap_locale.sql">
-- Sitemap-RPC: eine Sprache, fester Timeout, schlanke Spalten.
-- Stand: Migration sitemap_locale_limit_10000 (10/2026) – identisch mit der Live-DB.
-- Zusammen mit games_sitemap_locale_idx.sql fuer schnelle Plaene.
--
-- Ohne Index wuerde PostgREST oft an statement_timeout (oft 8s) scheitern.
-- Die Funktion setzt lokal 30s, filtert guide_<lang> = PUBLISHED und schliesst
-- noindex-Spiele sowie Quickwin / easy_platin / Servertot / Unlesbar aus.
-- server/sitemap.js ruft sie per supabase.rpc('tb_sitemap_locale', ...) auf.

create or replace function public.tb_sitemap_locale(
  p_locale text,
  p_limit integer default 10000
)
returns table (
  slug text,
  hardware text,
  spiel_typ text,
  is_indexable boolean,
  created_at timestamptz
)
language plpgsql
stable
security definer
set search_path = public
set statement_timeout = '30s'
as $$
declare
  lang text := lower(trim(both from coalesce(p_locale, '')));
  status_key text;
  row_cap integer := least(greatest(coalesce(p_limit, 10000), 1), 10000);
begin
  if lang = '' or lang !~ '^[a-z]{2}(-[a-z]+)?$' then
    return;
  end if;

  status_key := 'guide_' || lang;

  return query
  select
    g.slug::text,
    g.hardware::text,
    g.spiel_typ::text,
    coalesce(g.is_indexable, true)::boolean,
    g.created_at::timestamptz
  from public.games g
  where g.slug is not null
    and btrim(g.slug) <> ''
    and g.status ->> status_key = 'PUBLISHED'
    and coalesce(g.is_indexable, true) = true
    and coalesce(g.spiel_typ, '') not in ('Quickwin', 'easy_platin', 'Servertot', 'Unlesbar')
  order by g.created_at desc nulls last
  limit row_cap;
end;
$$;

revoke all on function public.tb_sitemap_locale(text, integer) from public;
grant execute on function public.tb_sitemap_locale(text, integer) to anon, authenticated;

