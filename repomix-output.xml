}) {
  const [sheetType, setSheetType] = useState(GUIDE_SHEET_TYPE.WALKTHROUGH);
  const [videoUrl, setVideoUrl] = useState('');
  const [creators, setCreators] = useState([]);
  const [creatorId, setCreatorId] = useState('');
  const [newChannel, setNewChannel] = useState('');
  const [newYoutube, setNewYoutube] = useState('');
  const [defaultGroup, setDefaultGroup] = useState('Walkthrough');
  const [trophyId, setTrophyId] = useState('');
  const [rawText, setRawText] = useState('');
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState('');
  const [loadingCreators, setLoadingCreators] = useState(false);

  useEffect(() => {
    if (!open) return undefined;
    setSheetType(GUIDE_SHEET_TYPE.WALKTHROUGH);
    setVideoUrl('');
    setCreatorId('');
    setNewChannel('');
    setNewYoutube('');
    setDefaultGroup('Walkthrough');
    setTrophyId('');
    setRawText('');
    setError('');
    setSaving(false);

    let cancelled = false;
    setLoadingCreators(true);
    supabase
      .from(TABLES.contentCreators)
      .select('id, channel_name, youtube_url')
      .order('channel_name', { ascending: true })
      .then(({ data, error: loadError }) => {
        if (cancelled) return;
        setLoadingCreators(false);
        if (loadError) {
          setError(loadError.message || 'Creator konnten nicht geladen werden.');
          setCreators([]);
          return;
        }
        setCreators(data ?? []);
      });

    return () => {
      cancelled = true;
    };
  }, [open]);

  const steps = useMemo(
    () => parseQuickGuideText(rawText, defaultGroup),
    [rawText, defaultGroup],
  );

  if (!open) return null;

  const handleSheetChange = (value) => {
    const next = Number(value);
    setSheetType(next);
    const option = SHEET_OPTIONS.find((item) => item.value === next);
    if (option) setDefaultGroup(option.defaultGroup);
  };

  const ensureCreatorId = async () => {
    if (creatorId !== NEW_CREATOR) return creatorId || null;
    const channelName = newChannel.trim();
    const youtubeUrl = newYoutube.trim();
    if (!channelName) {
      throw new Error('Bitte einen Creator-Namen angeben.');
    }
    const { data, error: insertError } = await supabase
      .from(TABLES.contentCreators)
      .insert({ channel_name: channelName, youtube_url: youtubeUrl || null })
      .select('id, channel_name, youtube_url')
      .maybeSingle();
    if (insertError) throw insertError;
    if (data) setCreators((prev) => [...prev, data]);
    setCreatorId(data?.id ?? '');
    return data?.id ?? null;
  };

  const handleSave = async () => {
    if (!gameId || saving) return;
    if (steps.length === 0) {
      setError('Keine Schritte erkannt.');
      return;
    }
    setSaving(true);
    setError('');
    try {
      const resolvedCreatorId = await ensureCreatorId();
      const { inserted, status, error: insertError } = await insertQuickGuideSteps(supabase, {
        gameId,
        platformGameId,
        locale,
        sheetType,
        videoUrl,
        creatorId: resolvedCreatorId,
        trophyId: trophyId || null,
        steps,
      });
      if (insertError) {
        setError(insertError.message || 'Schritte konnten nicht gespeichert werden.');
        setSaving(false);
        return;
      }
      onSaved?.({ sheetType, inserted, status });
      setSaving(false);
      onClose?.();
    } catch (err) {
      setError(err?.message || 'Speichern fehlgeschlagen.');
      setSaving(false);
    }
  };

  return (
    <div
      className="fixed inset-0 z-50 flex items-end justify-center bg-black/70 p-3 sm:items-center"
      role="dialog"
      aria-modal="true"
      aria-label="Guide-Schritte einfügen"
    >
      <button
        type="button"
        className="absolute inset-0 cursor-default"
        aria-label="Schließen"
        onClick={onClose}
      />
      <div className="relative z-10 flex max-h-[92vh] w-full max-w-lg flex-col overflow-hidden rounded-2xl border border-zinc-700 bg-[#121314] shadow-2xl">
        <div className="flex items-center justify-between gap-3 border-b border-zinc-800 px-4 py-3">
          <h2 className="text-sm font-bold uppercase tracking-wider text-white">+ Guide-Schritte</h2>
          <button
            type="button"
            onClick={onClose}
            className="rounded-lg border border-zinc-700 px-2 py-1 text-xs text-zinc-400"
          >
            ×
          </button>
        </div>

        <div className="space-y-3 overflow-y-auto px-4 py-3 text-sm">
          <label className="block space-y-1">
            <span className="font-mono text-[10px] uppercase tracking-wider text-zinc-500">Ziel-Reiter</span>
            <select
              value={sheetType}
              onChange={(e) => handleSheetChange(e.target.value)}
              className="w-full rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-zinc-100"
            >
              {SHEET_OPTIONS.map((option) => (
                <option key={option.value} value={option.value}>
                  {option.label}
                </option>
              ))}
            </select>
          </label>

          <label className="block space-y-1">
            <span className="font-mono text-[10px] uppercase tracking-wider text-zinc-500">
              YouTube-Video-URL (optional)
            </span>
            <input
              type="url"
              value={videoUrl}
              onChange={(e) => setVideoUrl(e.target.value)}
              placeholder="https://www.youtube.com/watch?v=…"
              className="w-full rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-zinc-100"
            />
          </label>

          <label className="block space-y-1">
            <span className="font-mono text-[10px] uppercase tracking-wider text-zinc-500">Creator</span>
            <select
              value={creatorId}
              onChange={(e) => setCreatorId(e.target.value)}
              disabled={loadingCreators}
              className="w-full rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-zinc-100"
            >
              <option value="">— Kein Creator —</option>
              {creators.map((creator) => (
                <option key={creator.id} value={creator.id}>
                  {creator.channel_name || creator.id}
                </option>
              ))}
              <option value={NEW_CREATOR}>+ Neuen Creator anlegen</option>
            </select>
          </label>

          {creatorId === NEW_CREATOR ? (
            <div className="grid gap-2 sm:grid-cols-2">
              <input
                type="text"
                value={newChannel}
                onChange={(e) => setNewChannel(e.target.value)}
                placeholder="channel_name"
                className="rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-zinc-100"
              />
              <input
                type="url"
                value={newYoutube}
                onChange={(e) => setNewYoutube(e.target.value)}
                placeholder="youtube_url"
                className="rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-zinc-100"
              />
            </div>
          ) : null}

          <label className="block space-y-1">
            <span className="font-mono text-[10px] uppercase tracking-wider text-zinc-500">
              Standard-Gruppenname
            </span>
            <input
              type="text"
              value={defaultGroup}
              onChange={(e) => setDefaultGroup(e.target.value)}
              className="w-full rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-zinc-100"
            />
          </label>

          <label className="block space-y-1">
            <span className="font-mono text-[10px] uppercase tracking-wider text-zinc-500">
              Mit Trophäe verknüpfen (optional)
            </span>
            <select
              value={trophyId}
              onChange={(e) => setTrophyId(e.target.value)}
              className="w-full rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-2 text-zinc-100"
            >
              <option value="">— Keine —</option>
              {(trophies ?? []).map((trophy) => {
                const id = getTrophyIdKey(trophy);
                if (!id) return null;
                const label = String(trophy.trophy_name || trophy.name || trophy.title || id).trim();
                return (
                  <option key={id} value={id}>
                    {label}
                  </option>
                );
              })}
            </select>
          </label>

          <label className="block space-y-1">
            <span className="font-mono text-[10px] uppercase tracking-wider text-zinc-500">
              YouTube-Timestamps
            </span>
            <p className="text-xs text-zinc-500">
              Format: <code className="text-zinc-400">02:15 - Name</code> pro Zeile. Zeilen mit{' '}
              <code className="text-zinc-400"># Gruppenname</code> starten eine neue Kachel.
            </p>
            <textarea
              value={rawText}
              onChange={(e) => setRawText(e.target.value)}
              rows={10}
              className="w-full rounded-xl border border-zinc-700 bg-zinc-950 px-3 py-2 font-mono text-xs leading-relaxed text-zinc-200"
              placeholder={'# Kapitel 1\n02:15 - Erster Schritt\n05:40 Zweiter Schritt'}
            />
            <p className="text-xs text-zinc-400">{steps.length} Schritte erkannt</p>
          </label>

          {error ? <p className="text-xs text-red-400">{error}</p> : null}
        </div>

        <div className="flex flex-wrap justify-end gap-2 border-t border-zinc-800 px-4 py-3">
          <button
            type="button"
            onClick={onClose}
            disabled={saving}
            className="rounded-lg border border-zinc-700 px-3 py-2 text-xs font-mono uppercase tracking-wider text-zinc-400"
          >
            Abbrechen
          </button>
          <button
            type="button"
            onClick={handleSave}
            disabled={saving || steps.length === 0}
            className="rounded-lg border border-[#00ff66]/40 bg-[#00ff66]/10 px-3 py-2 text-xs font-mono font-bold uppercase tracking-wider text-[#00ff66] disabled:opacity-40"
          >
            {saving ? 'Speichern…' : `${steps.length} Schritte speichern`}
          </button>
        </div>
      </div>
    </div>
  );
}

export default AdminQuickGuideModal;
</file>

<file path="src/components/AdminRohmaterialTinderBar.jsx">
/**
 * Mobile Tinder-Leiste für Rohmaterial-Kandidaten auf der Spieleseite.
 */
function AdminRohmaterialTinderBar({
  batches = [],
  mode = 'productive',
  activeIndex = 0,
  hasProductiveGuide = false,
  busy = false,
  onModeChange,
  onIndexChange,
  onDiscard,
  onMatch,
  onPromote,
}) {
  const total = batches.length;
  if (total === 0) return null;

  const safeIndex = Math.min(Math.max(activeIndex, 0), total - 1);
  const batch = batches[safeIndex];
  const inRohmaterial = mode === 'rohmaterial';

  const goPrev = () => onIndexChange?.(safeIndex <= 0 ? total - 1 : safeIndex - 1);
  const goNext = () => onIndexChange?.(safeIndex >= total - 1 ? 0 : safeIndex + 1);

  return (
    <div className="mb-4 space-y-3 rounded-2xl border border-amber-500/30 bg-amber-500/5 p-3 sm:p-4">
      <div className="flex flex-wrap gap-2">
        <button
          type="button"
          disabled={busy}
          onClick={() => onModeChange?.('productive')}
          className={`rounded-xl border px-3 py-2 text-[11px] font-mono font-bold uppercase tracking-wider transition ${
            !inRohmaterial
              ? 'border-[#00ff66]/40 bg-[#00ff66]/10 text-[#00ff66]'
              : 'border-zinc-700 text-zinc-400 hover:text-zinc-200'
          } disabled:opacity-40`}
        >
          Produktiver Guide{hasProductiveGuide ? '' : ' (leer)'}
        </button>
        <button
          type="button"
          disabled={busy}
          onClick={() => onModeChange?.('rohmaterial')}
          className={`rounded-xl border px-3 py-2 text-[11px] font-mono font-bold uppercase tracking-wider transition ${
            inRohmaterial
              ? 'border-amber-400/50 bg-amber-500/15 text-amber-200'
              : 'border-zinc-700 text-zinc-400 hover:text-zinc-200'
          } disabled:opacity-40`}
        >
          🧪 Rohmaterial-Kandidaten ({total})
        </button>
      </div>

      {inRohmaterial && batch ? (
        <>
          <div className="flex items-center gap-2">
            <button
              type="button"
              disabled={busy || total < 2}
              onClick={goPrev}
              className="shrink-0 rounded-lg border border-zinc-700 px-2.5 py-2 text-sm text-zinc-300 disabled:opacity-30"
              aria-label="Vorheriger Kandidat"
            >
              ‹
            </button>
            <p className="min-w-0 flex-1 text-center text-xs leading-relaxed text-zinc-200">
              <span className="font-mono text-amber-200">
                Kandidat {safeIndex + 1}/{total}
              </span>
              <span className="mx-1 text-zinc-500">:</span>
              <span className="break-all font-mono text-[11px] text-white">{batch.batchKey}</span>
              <span className="mt-0.5 block text-[11px] text-zinc-400">
                {batch.totalRows} Schritte
                {batch.creatorName ? ` · ${batch.creatorName}` : ''}
                {batch.batchStatus ? ` · ${batch.batchStatus}` : ''}
              </span>
            </p>
            <button
              type="button"
              disabled={busy || total < 2}
              onClick={goNext}
              className="shrink-0 rounded-lg border border-zinc-700 px-2.5 py-2 text-sm text-zinc-300 disabled:opacity-30"
              aria-label="Nächster Kandidat"
            >
              ›
            </button>
          </div>

          <div className="grid grid-cols-1 gap-2 sm:grid-cols-3">
            <button
              type="button"
              disabled={busy}
              onClick={() => onDiscard?.(batch)}
              className="rounded-xl border border-red-500/40 bg-red-500/10 px-3 py-3 text-xs font-bold uppercase tracking-wider text-red-300 hover:bg-red-500/15 disabled:opacity-40"
            >
              ❌ Wegwerfen
            </button>
            <button
              type="button"
              disabled={busy}
              onClick={() => onMatch?.(batch)}
              className="rounded-xl border border-sky-500/40 bg-sky-500/10 px-3 py-3 text-xs font-bold uppercase tracking-wider text-sky-300 hover:bg-sky-500/15 disabled:opacity-40"
            >
              📌 Match (für PC-Excel)
            </button>
            <button
              type="button"
              disabled={busy}
              onClick={() => onPromote?.(batch)}
              className="rounded-xl border border-emerald-500/40 bg-emerald-500/10 px-3 py-3 text-xs font-bold uppercase tracking-wider text-emerald-300 hover:bg-emerald-500/15 disabled:opacity-40"
            >
              💚 Direkt als Guide übernehmen
            </button>
          </div>
        </>
      ) : null}
    </div>
  );
}

export default AdminRohmaterialTinderBar;
</file>

<file path="src/components/CollapsibleSectionCard.jsx">
import { useState } from 'react';

/**
 * Wiederverwendbare Accordion-Kachel für 100%-Layout (Trophäen, Guides, Bosse).
 */
function CollapsibleSectionCard({
  sectionId,
  title,
  subtitle,
  badge,
  defaultOpen = false,
  accent = 'green',
  children,
  className = '',
  storageKey = null,
  headerActions = null,
}) {
  const [isOpen, setIsOpen] = useState(() => {
    if (storageKey && typeof window !== 'undefined' && window.localStorage) {
      const saved = localStorage.getItem(storageKey);
      if (saved === 'closed') return false;
      if (saved === 'open') return true;
    }
    return defaultOpen;
  });

  const toggleOpen = () => {
    setIsOpen((prev) => {
      const next = !prev;
      if (storageKey && typeof window !== 'undefined' && window.localStorage) {
        try {
          localStorage.setItem(storageKey, next ? 'open' : 'closed');
        } catch (e) {
          console.error('Failed to save collapsible state:', e);
        }
      }
      return next;
    });
  };

  const accentStyles =
    accent === 'purple'
      ? 'border-purple-500/30 hover:border-purple-500/50'
      : accent === 'amber'
        ? 'border-amber-500/30 hover:border-amber-500/50'
        : 'border-[#00ff66]/20 hover:border-[#00ff66]/40';

  const titleAccent =
    accent === 'purple' ? 'text-purple-400' : accent === 'amber' ? 'text-amber-400' : 'text-[#00ff66]';

  return (
    <section
      id={sectionId}
      className={`rounded-2xl border border-zinc-800 bg-[#1a1b1c] shadow-xl overflow-hidden transition-all duration-300 ${accentStyles} ${className}`}
    >
      <div
        onClick={toggleOpen}
        className="w-full flex items-center justify-between gap-4 px-5 py-4 bg-[#121314] border-b border-zinc-800/80 text-left cursor-pointer transition-colors duration-300 hover:bg-zinc-900/80 select-none"
        role="button"
        tabIndex={0}
        onKeyDown={(e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggleOpen();
          }
        }}
        aria-expanded={isOpen}
      >
        <div className="min-w-0 flex-1">
          <div className="flex flex-wrap items-center gap-2">
            <h3 className={`text-sm font-bold uppercase tracking-wider font-mono ${titleAccent}`}>
              {title}
            </h3>
            {badge && (
              <span className="text-[10px] font-mono text-zinc-500 bg-zinc-800/80 border border-zinc-700 px-2 py-0.5 rounded-sm">
                {badge}
              </span>
            )}
          </div>
          {subtitle && (
            <p className="text-xs text-zinc-500 mt-1 truncate">{subtitle}</p>
          )}
        </div>
        <div className="flex items-center gap-3 flex-shrink-0">
          {headerActions && (
            <div onClick={(e) => e.stopPropagation()}>
              {headerActions}
            </div>
          )}
          <span
            className="text-zinc-500 text-sm flex-shrink-0 transition-transform duration-300"
            aria-hidden
          >
            {isOpen ? '▲' : '▼'}
          </span>
        </div>
      </div>

      <div
        className={`grid transition-all duration-300 ease-in-out ${
          isOpen ? 'grid-rows-[1fr] opacity-100' : 'grid-rows-[0fr] opacity-0'
        }`}
      >
        <div className="overflow-hidden">
          <div className="p-4 sm:p-5">{children}</div>
        </div>
      </div>
    </section>
  );
}

export default CollapsibleSectionCard;
</file>

<file path="src/components/CustomizeTrophyBaseModal.jsx">
import { useEffect, useId, useRef } from 'react';
import {
  getHomeCategoriesByIds,
  getHomeCategoryTitle,
  HOME_CATEGORIES,
} from '../lib/homeCategories';
import {
  HOME_BLUEPRINTS,
  HOME_LAYOUT_MODE,
  useUserPreferences,
} from '../lib/userPreferences';
import { useLocale } from '../context/LocaleContext';
import '../styles/home.css';

const LAYOUT_OPTIONS = [
  { id: HOME_LAYOUT_MODE.RAILS, labelKey: 'customizeLayoutRails', emoji: '🎞️' },
  { id: HOME_LAYOUT_MODE.GRID, labelKey: 'customizeLayoutGrid', emoji: '🎯' },
  { id: HOME_LAYOUT_MODE.TABLE, labelKey: 'customizeLayoutTable', emoji: '📊' },
  { id: HOME_LAYOUT_MODE.MINIMAL, labelKey: 'customizeLayoutMinimal', emoji: '🧘' },
];

function CustomizeTrophyBaseModal({ open, onClose }) {
  const { globalLocale, t } = useLocale();
  const {
    homeLayoutMode,
    orderedHomeCategories,
    setHomeLayoutMode,
    toggleHomeCategory,
    moveHomeCategory,
    applyHomeBlueprint,
    resetToDefaultBlueprint,
  } = useUserPreferences();
  const titleId = useId();
  const closeRef = useRef(null);

  useEffect(() => {
    if (!open) return undefined;
    const onKeyDown = (event) => {
      if (event.key === 'Escape') onClose?.();
    };
    document.addEventListener('keydown', onKeyDown);
    const prevOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    closeRef.current?.focus();
    return () => {
      document.removeEventListener('keydown', onKeyDown);
      document.body.style.overflow = prevOverflow;
    };
  }, [open, onClose]);

  if (!open) return null;

  const active = getHomeCategoriesByIds(orderedHomeCategories);
  const activeIds = new Set(orderedHomeCategories);
  const available = HOME_CATEGORIES.filter((cat) => !activeIds.has(cat.id));

  return (
    <div
      className="tb-architect-backdrop"
      role="dialog"
      aria-modal="true"
      aria-labelledby={titleId}
      onMouseDown={(event) => {
        if (event.target === event.currentTarget) onClose?.();
      }}
    >
      <div className="tb-architect">
        <header className="tb-architect-header">
          <div>
            <p className="tb-architect-kicker">{t('customizeTrophyBase')}</p>
            <h2 id={titleId} className="tb-architect-title">
              {t('customizeTrophyBaseTitle')}
            </h2>
            <p className="tb-architect-lead">{t('customizeTrophyBaseLead')}</p>
          </div>
          <button
            ref={closeRef}
            type="button"
            className="tb-architect-close"
            onClick={onClose}
            aria-label={t('customizeClose')}
          >
            ×
          </button>
        </header>

        <div className="tb-architect-body">
          <section className="tb-architect-section" aria-labelledby="tb-blueprints-heading">
            <h3 id="tb-blueprints-heading" className="tb-architect-section-title">
              {t('customizeBlueprints')}
            </h3>
            <div className="tb-architect-blueprints">
              {HOME_BLUEPRINTS.map((blueprint) => (
                <button
                  key={blueprint.id}
                  type="button"
                  className="tb-architect-blueprint"
                  onClick={() => applyHomeBlueprint(blueprint.id)}
                >
                  <span className="tb-architect-blueprint-emoji" aria-hidden>
                    {blueprint.emoji}
                  </span>
                  <span className="tb-architect-blueprint-copy">
                    <strong>{t(blueprint.titleKey)}</strong>
                    <span>{t(blueprint.bodyKey)}</span>
                  </span>
                </button>
              ))}
            </div>
          </section>

          <section className="tb-architect-section" aria-labelledby="tb-layout-heading">
            <h3 id="tb-layout-heading" className="tb-architect-section-title">
              {t('customizeLayoutMode')}
            </h3>
            <div className="tb-architect-layouts">
              {LAYOUT_OPTIONS.map((option) => {
                const selected = homeLayoutMode === option.id;
                return (
                  <button
                    key={option.id}
                    type="button"
                    className={`tb-architect-layout${selected ? ' is-active' : ''}`}
                    aria-pressed={selected}
                    onClick={() => setHomeLayoutMode(option.id)}
                  >
                    <span aria-hidden>{option.emoji}</span>
                    {t(option.labelKey)}
                  </button>
                );
              })}
            </div>
          </section>

          <section className="tb-architect-section" aria-labelledby="tb-cats-heading">
            <h3 id="tb-cats-heading" className="tb-architect-section-title">
              {t('customizeCategories')}
            </h3>
            <p className="tb-architect-hint">{t('customizeCategoriesHint')}</p>

            {active.length > 0 ? (
              <ul className="tb-architect-active">
                {active.map((cat, index) => {
                  const title = getHomeCategoryTitle(cat, globalLocale, t);
                  return (
                    <li key={cat.id} className="tb-architect-row">
                      <span className="tb-architect-row-label">
                        <span aria-hidden>{cat.emoji}</span>
                        {title}
                      </span>
                      <span className="tb-architect-row-actions">
                        <button
                          type="button"
                          className="tb-architect-icon-btn"
                          disabled={index === 0}
                          aria-label={t('customizeMoveUp').replaceAll('{title}', title)}
                          onClick={() => moveHomeCategory(cat.id, -1)}
                        >
                          ↑
                        </button>
                        <button
                          type="button"
                          className="tb-architect-icon-btn"
                          disabled={index === active.length - 1}
                          aria-label={t('customizeMoveDown').replaceAll('{title}', title)}
                          onClick={() => moveHomeCategory(cat.id, 1)}
                        >
                          ↓
                        </button>
                        <button
                          type="button"
                          className="tb-architect-remove"
                          onClick={() => toggleHomeCategory(cat.id)}
                        >
                          {t('customizeRemove')}
                        </button>
                      </span>
                    </li>
                  );
                })}
              </ul>
            ) : (
              <p className="tb-architect-empty">{t('customizeNoActive')}</p>
            )}

            {available.length > 0 ? (
              <div className="tb-architect-available">
                {available.map((cat) => (
                  <button
                    key={cat.id}
                    type="button"
                    className="tb-architect-chip"
                    onClick={() => toggleHomeCategory(cat.id)}
                  >
                    <span aria-hidden>{cat.emoji}</span>
                    {getHomeCategoryTitle(cat, globalLocale, t)}
                    <span aria-hidden>+</span>
                  </button>
                ))}
              </div>
            ) : null}
          </section>
        </div>

        <footer className="tb-architect-footer">
          <button
            type="button"
            className="tb-architect-reset"
            onClick={() => resetToDefaultBlueprint()}
          >
            {t('customizeReset')}
          </button>
          <button type="button" className="tb-architect-done" onClick={onClose}>
            {t('customizeClose')}
          </button>
        </footer>
      </div>
    </div>
  );
}

export default CustomizeTrophyBaseModal;
