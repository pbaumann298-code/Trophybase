<file path="src/lib/userProgressQueries.js">
import { TABLES, GAME_FK } from './gameSchema';
import { isUuid } from './gameModel';

export const GUIDE_PROGRESS = {
  steps: 'completed_steps',
  platinum: 'is_platinum',
  onConflict: 'user_id,game_id',
};

/**
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} userId
 * @returns {Promise<{ byGame: Record<string, { steps: string[], isPlatinum: boolean }>, error: Error|null }>}
 */
export async function fetchUserGuideProgress(supabase, userId) {
  if (!userId) return { byGame: {}, error: null };

  const { data, error } = await supabase
    .from(TABLES.guideProgress)
    .select(`${GAME_FK}, ${GUIDE_PROGRESS.steps}, ${GUIDE_PROGRESS.platinum}`)
    .eq('user_id', userId);

  if (error) return { byGame: {}, error };

  const byGame = {};
  for (const row of data ?? []) {
    const gameId = String(row?.[GAME_FK] ?? '').trim();
    if (!isUuid(gameId)) continue;
    const steps = Array.isArray(row?.[GUIDE_PROGRESS.steps])
      ? row[GUIDE_PROGRESS.steps].map((s) => String(s ?? '').trim()).filter(Boolean)
      : [];
    byGame[gameId] = {
      steps,
      isPlatinum: Boolean(row?.[GUIDE_PROGRESS.platinum]),
    };
  }
  return { byGame, error: null };
}

/**
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} userId
 * @param {string} gameId
 * @param {string[]} steps
 * @param {boolean} [isPlatinum]
 */
export async function upsertUserGuideProgress(supabase, userId, gameId, steps, isPlatinum = false) {
  if (!userId || !isUuid(gameId)) {
    return { error: new Error('Anmeldung und Spiel-ID erforderlich') };
  }

  const uniqueSteps = [];
  const seen = new Set();
  for (const raw of steps ?? []) {
    const id = String(raw ?? '').trim();
    if (!id || seen.has(id)) continue;
    seen.add(id);
    uniqueSteps.push(id);
  }

  if (uniqueSteps.length === 0 && !isPlatinum) {
    const { error } = await supabase
      .from(TABLES.guideProgress)
      .delete()
      .eq('user_id', userId)
      .eq(GAME_FK, gameId);
    return { error };
  }

  const { error } = await supabase.from(TABLES.guideProgress).upsert(
    {
      user_id: userId,
      [GAME_FK]: gameId,
      [GUIDE_PROGRESS.steps]: uniqueSteps,
      [GUIDE_PROGRESS.platinum]: Boolean(isPlatinum),
    },
    { onConflict: GUIDE_PROGRESS.onConflict },
  );
  return { error };
}

/**
 * Mehrere Spiele in die Cloud schreiben (Union bereits im Aufrufer).
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} userId
 * @param {Record<string, { steps: string[], isPlatinum?: boolean }>} byGame
 */
export async function upsertUserGuideProgressBulk(supabase, userId, byGame) {
  if (!userId) return { error: new Error('Anmeldung erforderlich') };

  const entries = Object.entries(byGame ?? {});
  if (entries.length === 0) return { error: null };

  const results = await Promise.all(
    entries.map(([gameId, row]) =>
      upsertUserGuideProgress(
        supabase,
        userId,
        gameId,
        row?.steps ?? [],
        Boolean(row?.isPlatinum),
      ),
    ),
  );
  return { error: results.find((r) => r.error)?.error ?? null };
}
</file>

<file path="src/lib/visibilityPreferences.js">
import { HIDDEN_IDS_STORAGE_KEY, runGuideKeyMigration } from './guideKeyMigration';

const HIDDEN_IDS_KEY = HIDDEN_IDS_STORAGE_KEY;
const DISPLAY_MODE_KEY = 'tb_hidden_display_mode';

export const DISPLAY_MODE_STORAGE_KEY = DISPLAY_MODE_KEY;

export const VISIBILITY_MODE = {
  /** Ausgeblendete Einträge bleiben sichtbar, aber ausgegraut */
  DIM: 'dim',
  /** Ausgeblendete Einträge werden komplett aus der Liste entfernt */
  FILTER: 'filter',
};

/** @param {string} id guideProgressKey(item), nicht die reiter-präfixierte item.id */
export function itemVisibilityKey(id) {
  return `item:${id}`;
}

export function gameVisibilityKey(npwrId) {
  return `game:${npwrId}`;
}

function readHiddenIds() {
  runGuideKeyMigration();
  try {
    const raw = localStorage.getItem(HIDDEN_IDS_KEY);
    const parsed = raw ? JSON.parse(raw) : [];
    return new Set(Array.isArray(parsed) ? parsed : []);
  } catch {
    return new Set();
  }
}

function writeHiddenIds(set) {
  try {
    localStorage.setItem(HIDDEN_IDS_KEY, JSON.stringify([...set]));
  } catch {
    /* Speicher voll oder nicht verfügbar */
  }
}

export function loadDisplayMode() {
  try {
    const mode = localStorage.getItem(DISPLAY_MODE_KEY);
    return mode === VISIBILITY_MODE.FILTER ? VISIBILITY_MODE.FILTER : VISIBILITY_MODE.DIM;
  } catch {
    return VISIBILITY_MODE.DIM;
  }
}

export function saveDisplayMode(mode) {
  try {
    localStorage.setItem(DISPLAY_MODE_KEY, mode);
  } catch {
    /* Speicher voll oder nicht verfügbar */
  }
}

export function createVisibilityStore() {
  let hiddenIds = readHiddenIds();
  let displayMode = loadDisplayMode();
  const listeners = new Set();

  const notify = () => listeners.forEach((fn) => fn());

  return {
    subscribe(listener) {
      listeners.add(listener);
      return () => listeners.delete(listener);
    },
    getDisplayMode() {
      return displayMode;
    },
    setDisplayMode(mode) {
      displayMode = mode;
      saveDisplayMode(mode);
      notify();
    },
    isHidden(id) {
      return hiddenIds.has(id);
    },
    setHidden(id, hidden) {
      const key = String(id ?? '').trim();
      if (!key) return;
      const currently = hiddenIds.has(key);
      if (Boolean(hidden) === currently) return;
      if (hidden) hiddenIds.add(key);
      else hiddenIds.delete(key);
      writeHiddenIds(hiddenIds);
      notify();
    },
    toggleHidden(id) {
      if (hiddenIds.has(id)) hiddenIds.delete(id);
      else hiddenIds.add(id);
      writeHiddenIds(hiddenIds);
      notify();
    },
    /** UUID-Liste aller als Spiel ausgeblendeten Einträge (`game:{uuid}`). */
    listHiddenGameUuids() {
      const ids = [];
      for (const key of hiddenIds) {
        if (!String(key).startsWith('game:')) continue;
        const id = String(key).slice(5).trim();
        if (id) ids.push(id);
      }
      return ids;
    },
    /**
     * Cloud-/Merge-Ergebnis für Spiele anwenden (nur `game:`-Keys; item:-Keys bleiben).
     * @param {Iterable<string>} gameUuids
     */
    replaceHiddenGameUuids(gameUuids) {
      const next = new Set();
      for (const key of hiddenIds) {
        if (!String(key).startsWith('game:')) next.add(key);
      }
      for (const raw of gameUuids ?? []) {
        const id = String(raw ?? '').trim();
        if (!id) continue;
        next.add(gameVisibilityKey(id));
      }
      hiddenIds = next;
      writeHiddenIds(hiddenIds);
      notify();
    },
    /**
     * @param {string} id
     * @param {{ completed?: boolean }} [options]
     */
    getEntryState(id, { completed = false } = {}) {
      const affected = hiddenIds.has(id) || completed;
      if (!affected) return { visible: true, dimmed: false };
      if (displayMode === VISIBILITY_MODE.FILTER) return { visible: false, dimmed: false };
      return { visible: true, dimmed: true };
    },
    getSnapshot() {
      return { displayMode, hiddenCount: hiddenIds.size };
    },
    reloadFromStorage() {
      hiddenIds = readHiddenIds();
      displayMode = loadDisplayMode();
      notify();
    },
  };
}
</file>

<file path="src/pages/BetaRegistrationPage.jsx">
import { useEffect, useState } from 'react';
import { supabase } from './supabaseClient';
import { isBetaTester, signInWithBetaTesterKeys } from '../lib/betaAccess';

function TrophyBaseLogo() {
  return (
    <div className="text-2xl sm:text-3xl font-bold text-center mb-10">
      <span className="text-white">TrophyBase</span>
      <span className="text-[#00ff66]">.app</span>
    </div>
  );
}

function ensureBetaUrl() {
  if (window.location.pathname !== '/beta') {
    window.history.pushState({}, '', '/beta');
  }
}

/**
 * Beta-Zugang: Tester-ID (Tester_XXXXX) + Passwort aus public.beta_testers.
 * Alte E-Mail-Registrierung + invite_keys entfällt hier.
 */
function BetaRegistrationPage({ sessionUser, onSessionEstablished, onComplete }) {
  const [testerId, setTesterId] = useState('');
  const [password, setPassword] = useState('');
  const [showPassword, setShowPassword] = useState(false);
  const [loading, setLoading] = useState(false);
  const [info, setInfo] = useState('');

  useEffect(() => {
    ensureBetaUrl();
    if (sessionUser && isBetaTester(sessionUser)) {
      onComplete?.();
    }
  }, [sessionUser, onComplete]);

  const handleSubmit = async (event) => {
    event.preventDefault();
    setLoading(true);
    setInfo('');

    const result = await signInWithBetaTesterKeys(supabase, testerId, password);
    setLoading(false);

    if (!result.ok) {
      setInfo(result.message);
      return;
    }

    onSessionEstablished?.(result.user);
    onComplete?.();
  };

  return (
    <div className="min-h-screen w-full flex items-center justify-center bg-[#121314] px-4 py-12">
      <div className="w-full max-w-sm">
        <TrophyBaseLogo />

        <form
          onSubmit={handleSubmit}
          className="bg-[#1a1b1c] border border-zinc-800 rounded-2xl p-8 shadow-2xl flex flex-col gap-4"
        >
          <p className="text-xs text-zinc-500 text-center mb-1">Beta-Zugang</p>
          <p className="text-xs text-zinc-400 text-center leading-relaxed mb-2">
            Gib deine persönliche <span className="font-mono text-zinc-300">Tester-ID</span> und
            das zugehörige Passwort ein (beides aus der Beta-Mail).
          </p>

          <div className="flex flex-col gap-1.5">
            <label className="text-[11px] font-bold text-zinc-400 uppercase tracking-wider">
              Tester-ID
            </label>
            <input
              type="text"
              required
              autoComplete="username"
              spellCheck={false}
              value={testerId}
              onChange={(e) => setTesterId(e.target.value)}
              className="bg-[#121314] border border-zinc-800 rounded-xl px-4 py-2.5 text-sm text-zinc-200 font-mono focus:outline-hidden focus:border-[#00ff66]/40 w-full"
              placeholder="Tester_A9k2M"
            />
          </div>

          <div className="flex flex-col gap-1.5">
            <label className="text-[11px] font-bold text-zinc-400 uppercase tracking-wider">
              Passwort
            </label>
            <div className="relative w-full">
              <input
                type={showPassword ? 'text' : 'password'}
                required
                autoComplete="current-password"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                className="bg-[#121314] border border-zinc-800 rounded-xl pl-4 pr-12 py-2.5 text-sm text-zinc-200 font-mono focus:outline-hidden focus:border-[#00ff66]/40 w-full"
                placeholder="Beta-Passwort"
              />
              <button
                type="button"
                onClick={() => setShowPassword((prev) => !prev)}
                className="absolute right-3 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 transition text-sm select-none"
                title={showPassword ? 'Passwort verbergen' : 'Passwort anzeigen'}
              >
                {showPassword ? '🙈' : '👁️'}
              </button>
            </div>
          </div>

          <button
            type="submit"
            disabled={loading}
            className="bg-[#00ff66] hover:bg-[#00e65c] disabled:opacity-50 text-black font-semibold text-sm py-2.5 rounded-xl transition mt-2 shadow-[0_0_15px_rgba(0,255,102,0.15)]"
          >
            {loading ? 'Wird geprüft …' : 'Beta starten'}
          </button>

          {info ? (
            <p className="text-xs text-amber-400/90 text-center leading-relaxed">{info}</p>
          ) : null}
        </form>

        <p className="mt-6 text-[11px] text-zinc-600 text-center leading-relaxed">
          Social-Logins (Google / Discord) kommen als Nächstes – bis dahin reicht der Beta-Key.
        </p>

        <nav className="mt-6 flex justify-center gap-4 text-[11px] text-zinc-600">
          <a href="/impressum" className="hover:text-zinc-300 transition">
            Impressum
          </a>
          <a href="/datenschutz" className="hover:text-zinc-300 transition">
            Datenschutz
          </a>
        </nav>
      </div>
    </div>
  );
}

export default BetaRegistrationPage;
</file>

