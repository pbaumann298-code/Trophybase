<file path="src/context/MediaConsentContext.jsx">
import { createContext, useCallback, useContext, useEffect, useMemo, useState } from 'react';
import {
  allowYoutubeEmbeds,
  declineOptionalMedia,
  MEDIA_CONSENT_EVENT,
  readMediaConsent,
  revokeYoutubeConsent,
} from '../lib/mediaConsent';

const MediaConsentContext = createContext(null);

export function MediaConsentProvider({ children }) {
  const [consent, setConsent] = useState(() =>
    typeof window === 'undefined' ? { youtube: false, affiliates: false, decided: false } : readMediaConsent(),
  );

  useEffect(() => {
    const onChange = (event) => {
      setConsent(event?.detail ?? readMediaConsent());
    };
    window.addEventListener(MEDIA_CONSENT_EVENT, onChange);
    return () => window.removeEventListener(MEDIA_CONSENT_EVENT, onChange);
  }, []);

  const allowYoutube = useCallback(() => {
    setConsent(allowYoutubeEmbeds());
  }, []);

  const declineOptional = useCallback(() => {
    setConsent(declineOptionalMedia());
  }, []);

  const revokeYoutube = useCallback(() => {
    setConsent(revokeYoutubeConsent());
  }, []);

  const value = useMemo(
    () => ({
      youtube: consent.youtube,
      affiliates: consent.affiliates,
      decided: consent.decided,
      allowYoutube,
      declineOptional,
      revokeYoutube,
    }),
    [consent, allowYoutube, declineOptional, revokeYoutube],
  );

  return <MediaConsentContext.Provider value={value}>{children}</MediaConsentContext.Provider>;
}

export function useMediaConsent() {
  const ctx = useContext(MediaConsentContext);
  if (!ctx) {
    return {
      youtube: false,
      affiliates: false,
      decided: false,
      allowYoutube: () => {},
      declineOptional: () => {},
      revokeYoutube: () => {},
    };
  }
  return ctx;
}
</file>

<file path="src/context/ProgressSyncContext.jsx">
import { createContext, useCallback, useContext, useEffect, useMemo, useRef, useState } from 'react';
import { supabase } from '../pages/supabaseClient';
import ProgressSyncPrompt from '../components/ProgressSyncPrompt';
import {
  applyProgressByGameToLocal,
  loadProgressOwner,
  mergeProgressByGame,
  planProgressSync,
  saveProgressOwner,
  scanLocalProgressByGame,
} from '../lib/localUserProgress';
import { setProgressCloudUser } from '../lib/progressCloudBridge';
import { setGameHiddenCloudUser } from '../lib/gameHiddenCloudBridge';
import {
  fetchUserGuideProgress,
  upsertUserGuideProgressBulk,
} from '../lib/userProgressQueries';
import { fetchHiddenGameIds, upsertGameHidden } from '../lib/userGameSettingsQueries';
import { isUuid } from '../lib/gameModel';
import { useVisibility } from './VisibilityContext';

const ProgressSyncContext = createContext(null);

export function ProgressSyncProvider({ sessionUser, children }) {
  const userId = sessionUser?.id ?? null;
  const { listHiddenGameUuids, replaceHiddenGameUuids } = useVisibility();
  const [prompt, setPrompt] = useState(null);
  const [busy, setBusy] = useState(false);
  const runIdRef = useRef(0);

  const enableCloudPush = useCallback((id) => {
    setProgressCloudUser(id);
    setGameHiddenCloudUser(id);
    if (id) saveProgressOwner(id);
  }, []);

  const disableCloudPush = useCallback(() => {
    setProgressCloudUser(null);
    // Ausblenden darf weiter syncen, auch während der Fortschritts-Abfrage.
  }, []);

  useEffect(() => {
    if (!userId) {
      disableCloudPush();
      setGameHiddenCloudUser(null);
      setPrompt(null);
      return undefined;
    }

    setGameHiddenCloudUser(userId);

    let cancelled = false;
    const runId = ++runIdRef.current;

    async function reconcileHidden() {
      const { ids: cloudHidden, error } = await fetchHiddenGameIds(supabase, userId);
      if (cancelled || error) {
        if (error) console.warn('Spiel-Sichtbarkeit:', error.message);
        return;
      }
      const localHidden = listHiddenGameUuids().filter((id) => isUuid(id));
      const merged = new Set([...localHidden, ...cloudHidden]);
      replaceHiddenGameUuids(merged);
      const toPush = localHidden.filter((id) => !cloudHidden.includes(id));
      if (toPush.length > 0) {
        await Promise.all(toPush.map((id) => upsertGameHidden(supabase, userId, id, true)));
      }
    }

    async function reconcile() {
      void reconcileHidden();

      const localByGame = scanLocalProgressByGame();
      const { byGame: cloudByGame, error } = await fetchUserGuideProgress(supabase, userId);
      if (cancelled || runId !== runIdRef.current) return;

      if (error) {
        console.warn('Fortschritt-Sync:', error.message);
        // Ohne Cloud-Lesen nicht pushen – sonst könnten Profil-Daten überschrieben werden.
        disableCloudPush();
        return;
      }

      const plan = planProgressSync({
        localByGame,
        cloudByGame,
        owner: loadProgressOwner(),
        userId,
      });

      if (plan.action === 'noop') {
        enableCloudPush(userId);
        return;
      }

      if (plan.action === 'pull') {
        applyProgressByGameToLocal(cloudByGame, { replaceAll: true });
        enableCloudPush(userId);
        return;
      }

      // prompt – Cloud-Push erst nach Entscheidung
      disableCloudPush();
      setPrompt({
        reason: plan.reason,
        localByGame: plan.localByGame,
        cloudByGame: plan.cloudByGame,
        localStats: plan.localStats,
        cloudStats: plan.cloudStats,
      });
    }

    reconcile().catch((err) => {
      if (!cancelled) {
        console.warn('Fortschritt-Sync:', err?.message || err);
        disableCloudPush();
      }
    });

    return () => {
      cancelled = true;
    };
  }, [userId, enableCloudPush, disableCloudPush, listHiddenGameUuids, replaceHiddenGameUuids]);

  const acceptBrowser = useCallback(async () => {
    if (!userId || !prompt) return;
    setBusy(true);
    try {
      const merged = mergeProgressByGame(prompt.localByGame, prompt.cloudByGame);
      const { error } = await upsertUserGuideProgressBulk(supabase, userId, merged);
      if (error) {
        console.warn('Fortschritt-Sync:', error.message);
        setBusy(false);
        return;
      }
      applyProgressByGameToLocal(merged, { replaceAll: true });
      enableCloudPush(userId);
      setPrompt(null);
    } finally {
      setBusy(false);
    }
  }, [userId, prompt, enableCloudPush]);

  const declineBrowser = useCallback(() => {
    if (!userId || !prompt) return;
    setBusy(true);
    try {
      applyProgressByGameToLocal(prompt.cloudByGame, { replaceAll: true });
      enableCloudPush(userId);
      setPrompt(null);
    } finally {
      setBusy(false);
    }
  }, [userId, prompt, enableCloudPush]);

  const value = useMemo(
    () => ({
      progressSyncPending: Boolean(prompt),
    }),
    [prompt],
  );

  return (
    <ProgressSyncContext.Provider value={value}>
      {children}
      <ProgressSyncPrompt
        open={Boolean(prompt)}
        busy={busy}
        localStats={prompt?.localStats}
        cloudStats={prompt?.cloudStats}
        reason={prompt?.reason ?? ''}
        onAccept={acceptBrowser}
        onDecline={declineBrowser}
      />
    </ProgressSyncContext.Provider>
  );
}

export function useProgressSync() {
  return useContext(ProgressSyncContext);
}
</file>

<file path="src/hooks/useAdminFollowups.js">
import { useEffect, useState } from 'react';
import { loadAdminFollowups, subscribeAdminFollowups } from '../lib/adminFollowups';

export function useAdminFollowups(userId) {
  const [entries, setEntries] = useState([]);
  const [error, setError] = useState('');

  useEffect(() => {
    if (!userId) {
      setEntries([]);
      setError('');
      return undefined;
    }

    let cancelled = false;
    let request = 0;

    const refresh = () => {
      const current = ++request;
      loadAdminFollowups()
        .then((rows) => {
          if (cancelled || current !== request) return;
          setEntries(rows);
          setError('');
        })
        .catch((err) => {
          if (cancelled || current !== request) return;
          setEntries([]);
          setError(err.message || 'Wiedervorlage konnte nicht geladen werden.');
        });
    };

    refresh();

    const unsubscribe = subscribeAdminFollowups((rows) => {
      request += 1;
      if (cancelled) return;
      setEntries(rows);
      setError('');
    });

    return () => {
      cancelled = true;
      unsubscribe();
    };
  }, [userId]);

  return { entries, error };
}
</file>

<file path="src/hooks/useTabScrollMemory.js">
import { useCallback, useEffect, useLayoutEffect, useRef } from 'react';

/** Inhalte wachsen nach dem Mount noch (Bilder, Akkordeons) – Ziel ein paar Frames halten. */
const RESTORE_FRAMES = 12;
const ANCHOR_GAP = 8;

function stickyHeaderOffset() {
  const header = document.querySelector('.site-header');
  if (!header) return 0;
  const { position } = window.getComputedStyle(header);
  if (position !== 'sticky' && position !== 'fixed') return 0;
  return header.getBoundingClientRect().height;
}

function maxScrollTop() {
  return Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
}

function anchorScrollTop(anchor) {
  if (!anchor) return 0;
  const top = anchor.getBoundingClientRect().top + window.scrollY;
  return Math.max(0, top - stickyHeaderOffset() - ANCHOR_GAP);
}

/**
 * Merkt sich die Scroll-Position je Reiter und stellt sie beim Zurückwechseln wieder her.
 * Nötig, weil inaktive Reiter komplett unmounted werden – der Browser kann hier nichts behalten.
 * Noch nicht besuchte Reiter starten am Anker (der Reiter-Leiste).
 *
 * @param {object}  options
 * @param {string}  options.activeTab
 * @param {object}  options.anchorRef  Element, an dem unbesuchte Reiter ausgerichtet werden
 * @param {any}     [options.resetKey] Wechsel löscht das Gedächtnis (z. B. anderes Spiel)
 * @param {boolean} [options.enabled]
 */
export function useTabScrollMemory({ activeTab, anchorRef, resetKey, enabled = true }) {
  const positionsRef = useRef(new Map());
  const activeTabRef = useRef(activeTab);
  const resetKeyRef = useRef(resetKey);
  const restoringRef = useRef(false);

  /** Vor dem Reiterwechsel aufrufen: nach dem Re-Render ist scrollY ggf. schon gekappt. */
  const rememberScroll = useCallback(() => {
    positionsRef.current.set(activeTabRef.current, window.scrollY);
  }, []);

  useEffect(() => {
    if (!enabled) return undefined;

    let frame = 0;
    const onScroll = () => {
      if (restoringRef.current || frame) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        if (restoringRef.current) return;
        positionsRef.current.set(activeTabRef.current, window.scrollY);
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    return () => {
      if (frame) window.cancelAnimationFrame(frame);
      window.removeEventListener('scroll', onScroll);
    };
  }, [enabled]);

  useLayoutEffect(() => {
    const previousTab = activeTabRef.current;
    const previousKey = resetKeyRef.current;
    activeTabRef.current = activeTab;
    resetKeyRef.current = resetKey;

    if (previousKey !== resetKey) {
      // Anderes Spiel: Tab-Gedächtnis verwerfen und an den Seitenanfang.
      // Sonst bleibt man unten bei „Ähnliche Spiele“, weil die SPA nicht neu lädt.
      positionsRef.current.clear();
      restoringRef.current = false;
      if (enabled) {
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      }
      return undefined;
    }
    if (!enabled || previousTab === activeTab) return undefined;

    const stored = positionsRef.current.get(activeTab);
    const hasStored = typeof stored === 'number';

    let frames = 0;
    let rafId = 0;
    let cancelled = false;

    const stop = () => {
      cancelled = true;
      restoringRef.current = false;
      if (rafId) window.cancelAnimationFrame(rafId);
      window.removeEventListener('wheel', stop);
      window.removeEventListener('touchstart', stop);
      window.removeEventListener('keydown', stop);
    };

    const step = () => {
      if (cancelled) return;

      const target = hasStored ? stored : anchorScrollTop(anchorRef?.current);
      const clamped = Math.min(target, maxScrollTop());
      if (Math.abs(window.scrollY - clamped) > 1) {
        window.scrollTo({ top: clamped, left: 0, behavior: 'instant' });
      }

      frames += 1;
      const reachedTarget = clamped >= target - 1;
      if (frames < RESTORE_FRAMES && !reachedTarget) {
        rafId = window.requestAnimationFrame(step);
        return;
      }
      stop();
    };

    restoringRef.current = true;
    // Nutzereingabe gewinnt immer gegen eine noch laufende Wiederherstellung.
    window.addEventListener('wheel', stop, { passive: true, once: true });
    window.addEventListener('touchstart', stop, { passive: true, once: true });
    window.addEventListener('keydown', stop, { once: true });
    step();

    return stop;
  }, [activeTab, resetKey, anchorRef, enabled]);

  return rememberScroll;
}
</file>

<file path="src/lib/adminFollowups.js">
import { supabase } from '../pages/supabaseClient';
import { GAME_I18N, GAME_PK, GAME_PLATFORM_ID, TABLES } from './gameSchema';

const CHANGE_EVENT = 'tb-admin-followups';
const TABLE = TABLES.gameWiedervorlage;
const ROW_SELECT = 'id, platform_game_id, spieltitel, freitext';

function notify(entries) {
  window.dispatchEvent(new CustomEvent(CHANGE_EVENT, { detail: { entries } }));
}

function normalizeRow(row) {
  return {
    id: String(row?.id ?? '').trim(),
    platform_game_id: row?.platform_game_id ?? null,
    spieltitel: row?.spieltitel ?? null,
    freitext: row?.freitext ?? null,
  };
}

export async function loadAdminFollowups() {
  const { data, error } = await supabase.from(TABLE).select(ROW_SELECT);
  if (error) {
    throw new Error(error.message || 'Wiedervorlage konnte nicht geladen werden.');
  }
  return (data ?? []).map(normalizeRow).filter((entry) => entry.id);
}

async function copyFromGames(gameId, freitext) {
  const { data, error } = await supabase
    .from(TABLES.games)
    .select(`${GAME_PK}, ${GAME_PLATFORM_ID}, ${GAME_I18N.title}`)
    .eq(GAME_PK, gameId)
    .maybeSingle();

  if (error) {
    throw new Error(error.message || 'Spiel konnte nicht gelesen werden.');
  }
  if (!data) {
    throw new Error('Spiel wurde nicht gefunden.');
  }

  const note = String(freitext ?? '').trim();
  return {
    id: data[GAME_PK],
    platform_game_id: data[GAME_PLATFORM_ID] ?? null,
    spieltitel: data[GAME_I18N.title] ?? null,
    freitext: note || null,
  };
}

/**
 * Legt eine Kopie in game_wiedervorlage an oder löscht nur diese Zeile.
 * @param {string} userId
 * @param {{ id: string, freitext?: string }} game
 */
export async function toggleAdminFollowup(userId, game) {
  const id = String(game?.id ?? '').trim();
  if (!userId || !id) {
    throw new Error('Wiedervorlage braucht eine angemeldete Admin-Sitzung.');
  }

  const { data: existing, error: readError } = await supabase
    .from(TABLE)
    .select('id')
    .eq('id', id)
    .maybeSingle();

  if (readError) {
    throw new Error(readError.message || 'Wiedervorlage konnte nicht gelesen werden.');
  }

  if (existing) {
    const { error } = await supabase.from(TABLE).delete().eq('id', id);
    if (error) {
      throw new Error(error.message || 'Wiedervorlage konnte nicht entfernt werden.');
    }
  } else {
    const row = await copyFromGames(id, game?.freitext);
    const { error } = await supabase.from(TABLE).insert(row);
    if (error) {
      throw new Error(error.message || 'Wiedervorlage konnte nicht gespeichert werden.');
    }
  }

  const next = await loadAdminFollowups();
  notify(next);
  return next;
}

export function subscribeAdminFollowups(listener) {
  if (typeof window === 'undefined') return () => {};

  const onCustom = (event) => {
    const entries = event.detail?.entries;
    if (Array.isArray(entries)) listener(entries);
  };

  window.addEventListener(CHANGE_EVENT, onCustom);
  return () => window.removeEventListener(CHANGE_EVENT, onCustom);
}
</file>

