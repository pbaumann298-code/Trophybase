        flexWrap: 'wrap',
        marginLeft: 'auto',
      }}
    >
      {hasNote && (
        <span
          title={`Take / Rohdatei: ${noteVal.trim()}`}
          style={{
            display: 'inline-flex',
            alignItems: 'center',
            gap: '4px',
            padding: '2px 7px',
            borderRadius: '5px',
            fontSize: '11px',
            fontFamily: 'monospace',
            fontWeight: 'bold',
            backgroundColor: 'rgba(245, 158, 11, 0.16)',
            border: '1px solid rgba(245, 158, 11, 0.45)',
            color: '#fcd34d',
            whiteSpace: 'nowrap',
          }}
        >
          🎬 {noteVal.trim()}
        </span>
      )}

      <label
        style={{
          display: 'inline-flex',
          alignItems: 'center',
          gap: '4px',
          backgroundColor: hasNote ? 'rgba(245, 158, 11, 0.1)' : '#121314',
