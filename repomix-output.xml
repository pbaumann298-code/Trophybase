            label_info = f"Trophy #{str_tid}" if str_tid else f"Gruppe '{group_name}'"
            print(f"📺 [{label_info}] Scanne: {video_url}")
            supabase.table("trophy_video_scrape_queue").update(
                {"status": "PROCESSING"}
