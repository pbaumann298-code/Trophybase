}

.tb-brand:hover .tb-name,
.tb-brand:focus-visible .tb-name {
  filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.3));
}

.tb-brand:hover .tb-tld,
.tb-brand:focus-visible .tb-tld {
  filter: drop-shadow(0 0 20px rgba(34, 197, 94, 1));
}

.home-hero-features {
  max-width: 32rem;
  margin: 0 auto 1.5rem;
  text-align: center;
}

.home-hero-features-summary {
  list-style: none;
  cursor: pointer;
  display: block;
  margin: 0;
  padding: 0.35rem 1.75rem;
  font-size: clamp(1.05rem, 2.8vw, 1.25rem);
  font-weight: 700;
