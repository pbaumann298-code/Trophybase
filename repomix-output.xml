      enabled: Boolean(xboxStack),
      status: xboxStack?.match_status ?? null,
    },
  ];

  return (
    <div className="flex flex-wrap gap-1.5" role="group" aria-label="Plattform">
      {chips.map((chip) => {
        const active = activePlatform === chip.id;
        return (
