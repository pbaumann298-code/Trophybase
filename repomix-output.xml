                      >
                        PlayStation-Master-Guide
                      </a>
                    ) : (
                      <span className="text-[11px] uppercase tracking-wider text-zinc-600">
                        kein linked_game_id
                      </span>
                    )}
                    <button
                      type="button"
                      onClick={() => setOpenKey(open ? '' : key)}
