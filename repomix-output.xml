    activeTab: selectedCreatorName || creatorNamesList[0] || '',
    onTabChange: setSelectedCreatorName,
    containerRef: previewSwipeRef,
    enabled: editorViewMode === 'preview' && creatorNamesList.length > 1,
  });

  const uniqueCreatorVideos = useMemo(() => {
    const seen = new Set();
    const videos = [];
    for (const row of currentCreatorRows) {
      const cleanUrl = stripDraftVideoUrl(row.video_url);
      if (!cleanUrl || seen.has(cleanUrl)) continue;
      seen.add(cleanUrl);
      const groups = resolveCreatorVideoGroups(row, selectedGame);
      videos.push({
        rowId: row.id,
        videoUrl: cleanUrl,
        ...groups,
      });
    }
    return videos;
  }, [currentCreatorRows, selectedGame]);

  const creatorChronoStillGeneric =
    uniqueCreatorVideos.length > 0 && uniqueCreatorVideos.every((video) => video.chronoIsGeneric);

  // Batch-check existing game_guides counts for visible queue games so sidebar badges show conflicts immediately
  useEffect(() => {
    const visibleIds = visibleQueueList
      .map((item) => item.gameId)
      .filter((id) => id && !liveGuideCountsMap.has(id));
    if (visibleIds.length === 0) return undefined;

    let cancelled = false;
    async function checkVisibleGuideCounts() {
      const { data, error: gErr } = await supabase
        .from(TABLES.guides)
        .select('game_id')
        .in('game_id', visibleIds);
      if (cancelled || gErr) return;

      const counts = new Map();
      for (const id of visibleIds) counts.set(id, 0);
      for (const row of data ?? []) {
        if (row.game_id) {
          counts.set(row.game_id, (counts.get(row.game_id) || 0) + 1);
        }
      }
      setLiveGuideCountsMap((prev) => {
        const next = new Map(prev);
        for (const [k, v] of counts.entries()) next.set(k, v);
        return next;
      });
    }

    checkVisibleGuideCounts();
    return () => {
      cancelled = true;
    };
  }, [visibleQueueList, liveGuideCountsMap]);

  // Vorabprüfung: Lade bestehende game_guides & aktuellen Spiel-Status für selectedGameId
  useEffect(() => {
    if (!selectedGameId) {
      setLiveGuideRows([]);
      setShowConflictModal(false);
      setSelectedGameDbCounts({
        game_guides: null,
        game_guides_rohmaterial: null,
        staging_game_guides: null,
      });
      return undefined;
    }

    let cancelled = false;
    async function checkSelectedGameConflict() {
      setLoadingLiveGuides(true);
      try {
        const [guidesRes, gameRes, rohCountRes, stagingCountRes] = await Promise.all([
          supabase
            .from(TABLES.guides)
            .select(
              'id, guide_id, sheet_type, item_name, chronological_group, category_group, boss_group, video_chapter, timestamp, video_url, trophy_id',
              { count: 'exact' }
            )
            .eq('game_id', selectedGameId)
            .order('id', { ascending: true })
            .limit(1000),
          supabase
            .from(TABLES.games)
            .select(GAMES_QUEUE_SELECT_COLS)
            .eq(GAME_PK, selectedGameId)
            .maybeSingle(),
          supabase
            .from('game_guides_rohmaterial')
            .select('id', { count: 'exact', head: true })
            .eq('game_id', selectedGameId),
          supabase
            .from('staging_game_guides')
            .select('id', { count: 'exact', head: true })
            .eq('game_id', selectedGameId),
        ]);

        if (cancelled) return;

        const fetchedGuides = guidesRes.data ?? [];
        const freshGame = gameRes.data ?? null;

        setLiveGuideRows(fetchedGuides);
        setSelectedGameDbCounts({
          game_guides:
            typeof guidesRes.count === 'number' ? guidesRes.count : fetchedGuides.length,
          game_guides_rohmaterial:
            typeof rohCountRes?.count === 'number' ? rohCountRes.count : null,
          staging_game_guides:
            typeof stagingCountRes?.count === 'number' ? stagingCountRes.count : null,
        });
        setLiveGuideCountsMap((prev) => {
          const next = new Map(prev);
          next.set(selectedGameId, fetchedGuides.length);
          return next;
        });

        if (freshGame) {
          setGamesMap((prev) => {
            const next = new Map(prev);
            next.set(selectedGameId, freshGame);
            return next;
          });
          setRohGamesMap((prev) => {
            if (!prev.has(selectedGameId)) return prev;
            const next = new Map(prev);
            next.set(selectedGameId, freshGame);
            return next;
          });
        }

        const effectiveGame = freshGame || selectedGame;
        const alreadyPub = isGameAlreadyPublishedOrLocked(effectiveGame);
        const hasExistingGuides = fetchedGuides.length > 0;

        if (alreadyPub || hasExistingGuides) {
          setApproveLocale((prev) => prev || 'de');
          setSelectedGameTypes(parseGameTypes(effectiveGame?.spiel_typ));

          const shouldOpen =
            pendingReopenConflictRef.current === selectedGameId ||
            !dismissedConflictGameIdsRef.current.has(selectedGameId);

          if (shouldOpen) {
            pendingReopenConflictRef.current = null;
            setShowConflictModal(true);
          }
        } else {
          setShowConflictModal(false);
        }
      } catch (err) {
        console.warn('Vorabprüfung konnte nicht geladen werden:', err);
      } finally {
        if (!cancelled) {
          setLoadingLiveGuides(false);
        }
      }
    }

    checkSelectedGameConflict();
    return () => {
      cancelled = true;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [selectedGameId]);

  // Berechnete Konflikt-Details für Vorabprüfungs-Banner & Modal
  const conflictInfo = useMemo(() => {
    if (!selectedGame) {
      return {
        hasConflict: false,
        isPublished: false,
        isLocked: false,
        publishedLocales: [],
        liveRowCount: 0,
      };
    }
    const isPublished = isGameAlreadyPublishedOrLocked(selectedGame);
    const isLocked = Boolean(selectedGame.is_guide_locked);
    const pubLocales = publishedGuideLocales(selectedGame);
    const fallbackLocales = Array.isArray(selectedGame.published_locales)
      ? selectedGame.published_locales
      : [];
    const mergedLocales = [...new Set([...pubLocales, ...fallbackLocales])];
    const liveRowCount = liveGuideRows.length;

    return {
      hasConflict: isPublished || liveRowCount > 0,
      isPublished,
      isLocked,
      publishedLocales: mergedLocales,
      liveRowCount,
    };
  }, [selectedGame, liveGuideRows]);

  const selectedGameDeepLinks = useMemo(
    () => (selectedGameId ? getGameSupabaseDeepLinks(selectedGameId) : null),
    [selectedGameId]
  );

  const dbXrayStats = useMemo(() => {
    const sourceRows =
      currentCreatorRows.length > 0
        ? currentCreatorRows
        : currentGameRows.length > 0
          ? currentGameRows
          : liveGuideRows;

    const sourceLabel =
      currentCreatorRows.length > 0 || currentGameRows.length > 0
        ? activeDataSource === 'rohmaterial'
          ? `game_guides_rohmaterial${selectedCreatorName ? ` (${selectedCreatorName})` : ''}`
          : `staging_game_guides${selectedCreatorName ? ` (${selectedCreatorName})` : ''}`
        : liveGuideRows.length > 0
          ? 'game_guides (Live)'
          : activeDataSource === 'rohmaterial'
            ? 'game_guides_rohmaterial'
            : 'staging_game_guides';

    let chronoFilled = 0;
    let categoryFilled = 0;
    let bossFilled = 0;
    const sheetCounts = new Map();

    for (const row of sourceRows) {
      if (getLocalizedItemName(row?.chronological_group).trim()) chronoFilled += 1;
      if (getLocalizedItemName(row?.category_group).trim()) categoryFilled += 1;
      if (getLocalizedItemName(row?.boss_group).trim()) bossFilled += 1;

      const resolvedRaw = resolveSheetTypes(row?.sheet_type);
      const effectiveTypes = resolvedRaw.length > 0 ? resolvedRaw : deriveSheetTypesFromRow(row);
      const key =
        resolvedRaw.length > 0
          ? `[${effectiveTypes.join(', ')}]`
          : `[${effectiveTypes.join(', ')}] (auto)`;
      sheetCounts.set(key, (sheetCounts.get(key) || 0) + 1);
    }

    const sheetDistribution = [...sheetCounts.entries()]
      .map(([label, count]) => ({ label, count }))
      .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

    const guidesCount =
      selectedGameDbCounts.game_guides != null
        ? selectedGameDbCounts.game_guides
        : liveGuideRows.length;
    const rohInMemoryCount =
      (rohGameGroups.get(selectedGameId) || []).filter((r) => r._sourceTable !== TABLES.guides)
        .length;
    const rohCount =
      selectedGameDbCounts.game_guides_rohmaterial != null
        ? selectedGameDbCounts.game_guides_rohmaterial
        : rohInMemoryCount;
    const stagingInMemoryCount = (gameGroups.get(selectedGameId) || []).length;
    const stagingCount =
      selectedGameDbCounts.staging_game_guides != null
        ? selectedGameDbCounts.staging_game_guides
        : stagingInMemoryCount;

    const statusObj = parseStatusMap(selectedGame?.status);

    return {
      sourceLabel,
      totalLoadedRows: sourceRows.length,
      chronoFilled,
      categoryFilled,
      bossFilled,
      sheetDistribution,
      guidesCount,
      rohCount,
      stagingCount,
      statusObj,
    };
  }, [
    currentCreatorRows,
    currentGameRows,
    liveGuideRows,
    activeDataSource,
    selectedCreatorName,
    selectedGameDbCounts,
    rohGameGroups,
    gameGroups,
    selectedGameId,
    selectedGame,
  ]);

  // Load trophies for selected game (nutzt tb_fetch_achievements_for_auth als Fallback/Creator-RPC für unveröffentlichte Spiele)
  useEffect(() => {
    if (!selectedGameId) {
      loadedTrophiesGameIdRef.current = null;
      setGameTrophies([]);
      return;
    }

    if (loadedTrophiesGameIdRef.current === selectedGameId) {
      return;
    }

    let cancelled = false;
    async function loadTrophies() {
      setLoadingTrophies(true);
      try {
        let loaded = [];
        if (!isCreatorMode) {
          const { data, error: trophyErr } = await supabase
            .from(TABLES.achievements)
            .select('*')
            .eq(GAME_FK, selectedGameId)
            .order('platform_achievement_id', { ascending: true });

          if (!trophyErr && Array.isArray(data) && data.length > 0) {
            loaded = [...data];
            loaded.sort(
              (a, b) =>
                extractNumericTrophyId(a.platform_achievement_id, 9999) -
                extractNumericTrophyId(b.platform_achievement_id, 9999)
            );
          }
        }

        if (loaded.length === 0) {
          const { data: rpcData, error: rpcErr } = await supabase.rpc(
            'tb_fetch_achievements_for_auth',
            { p_game_id: selectedGameId }
          );
          if (rpcErr) {
            throw new Error(`Fehler beim Laden der Trophäen via RPC: ${rpcErr.message}`);
          }
          if (Array.isArray(rpcData)) {
            loaded = [...rpcData];
            loaded.sort(
              (a, b) =>
                extractNumericTrophyId(a.platform_achievement_id, 9999) -
                extractNumericTrophyId(b.platform_achievement_id, 9999)
            );
          }
        }

        if (!cancelled) {
          loadedTrophiesGameIdRef.current = selectedGameId;
          setGameTrophies(loaded);
        }
      } catch (err) {
        console.error('Fehler beim Laden der Trophäen:', err);
        if (!cancelled) {
          setError((prev) => prev || err?.message || 'Trophäen konnten nicht geladen werden.');
          setGameTrophies([]);
        }
      } finally {
        if (!cancelled) {
          setLoadingTrophies(false);
        }
      }
    }

    loadTrophies();
    return () => {
      cancelled = true;
    };
  }, [selectedGameId, isCreatorMode]);

  // Jump to next game in queue
