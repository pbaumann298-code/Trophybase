<file path="src/components/GameTile.jsx">
import { useState } from 'react';
import { getGameCover, getGameTitle, getGameUuid } from '../lib/gameModel';
import { GAME_FIELDS } from '../lib/gameSchema';
import { isGameDraftMode } from '../lib/guidePublication';
import { useLocale } from '../context/LocaleContext';
import { useVisibility } from '../context/VisibilityContext';
import { usePlatinumStatus } from '../context/PlatinumStatusContext';
import { pushGameHiddenToCloud } from '../lib/gameHiddenCloudBridge';
import { trophyTypeIcon, TROPHY_TYPE } from '../lib/trophyTypes';
import WatchlistButton from './WatchlistButton';
import GuideOnlineBadge from './GuideOnlineBadge';

const FADE_MS = 280;

function EyeOffIcon({ className }) {
  return (
    <svg
      viewBox="0 0 24 24"
      className={className}
      fill="none"
      stroke="currentColor"
      strokeWidth="1.85"
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden
    >
      <path d="M3 3l18 18" />
      <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
      <path d="M9.9 5.1A9.8 9.8 0 0 1 12 5c5 0 9.3 3.1 11 7.5a11.4 11.4 0 0 1-1.7 3.1" />
      <path d="M6.1 6.1A11.3 11.3 0 0 0 1 12.5C2.7 16.9 7 20 12 20a9.9 9.9 0 0 0 4.2-.9" />
    </svg>
  );
}

/**
 * Cover-Overlays: Watchlist (oben rechts), Platin (unten links), Ausblenden (unten rechts).
 */
export function GameCoverOverlays({
  gameId,
  game = null,
  isAdmin = false,
  size = 'sm',
  showWatchlist = true,
  showHide = true,
  showPlatinum = true,
  onRequestLogin,
  onHideStart,
}) {
  const { t } = useLocale();
  const { setHidden, gameKey, isHidden } = useVisibility();
  const { isPlatinum } = usePlatinumStatus();
  const platinumSrc = trophyTypeIcon(TROPHY_TYPE.PLATINUM);
  const isPlatinActive = Boolean(showPlatinum && gameId && isPlatinum(gameId));
  const btnSize = size === 'md' ? 'w-8 h-8' : 'w-7 h-7';

  const handleHide = (event) => {
    event.preventDefault();
    event.stopPropagation();
    if (!gameId) return;
    const key = gameKey(gameId);
    if (isHidden(key)) return;
    onHideStart?.();
    setHidden(key, true);
    pushGameHiddenToCloud(gameId, true);
  };

  return (
    <>
      <div className="home-tile-online">
        <GuideOnlineBadge game={game} visible={isAdmin} size={size === 'md' ? 'md' : 'sm'} />
      </div>

      {showWatchlist && gameId ? (
        <div className="home-tile-watchlist">
          <WatchlistButton
            gameId={gameId}
            onRequestLogin={onRequestLogin}
            size={size}
            variant="cover"
          />
        </div>
      ) : null}

      {showPlatinum && platinumSrc ? (
        <div
          className="home-tile-platinum"
          title={isPlatinActive ? t('platinumUnlocked') : t('platinized')}
          aria-label={isPlatinActive ? t('platinumUnlocked') : t('platinized')}
          role="img"
        >
          <span
            className={`home-tile-overlay-chip pointer-events-none transition-all duration-300 ${
              isPlatinActive
                ? 'home-tile-overlay-chip--platinum-active'
                : 'home-tile-overlay-chip--platinum-inactive'
            }`}
          >
            <img
              src={platinumSrc}
              alt=""
              width={size === 'md' ? 26 : 22}
              height={size === 'md' ? 26 : 22}
              draggable={false}
              className={isPlatinActive ? 'filter drop-shadow-[0_0_6px_rgba(234,179,8,0.9)]' : 'opacity-40 grayscale'}
            />
          </span>
        </div>
      ) : null}

      {showHide && gameId ? (
        <div className="home-tile-hide opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 focus-within:opacity-100 max-md:opacity-50 transition-opacity duration-200">
          <button
            type="button"
            className={`home-tile-overlay-chip home-tile-overlay-chip--btn ${btnSize}`}
            title={t('hideGame')}
            aria-label={t('hideGame')}
            onClick={handleHide}
          >
            <EyeOffIcon className="w-[1.05rem] h-[1.05rem]" />
          </button>
        </div>
      ) : null}
    </>
  );
}

/**
 * Zentrale Spiel-Kachel (Startseite, Katalog, Related, …).
 */
function GameTile({
  game,
  href,
  onOpen,
  accent = '#00ff66',
  isAdmin = false,
  onRequestLogin,
  className = '',
  as = 'a',
  showConsole = true,
  showOverlays = true,
  'aria-expanded': ariaExpanded,
}) {
  const { globalLocale } = useLocale();
  const { getEntryState, gameKey } = useVisibility();
  const gameId = getGameUuid(game);
  const title = getGameTitle(game, globalLocale);
  const cover = getGameCover(game, globalLocale);
  const consoleLabel = game?.[GAME_FIELDS.console] ?? '';
  const visKey = gameKey(gameId || '');
  const entry = gameId ? getEntryState(visKey, { completed: false }) : { visible: true, dimmed: false };
  const [exiting, setExiting] = useState(false);
  const [dismissed, setDismissed] = useState(false);

  if (dismissed && !exiting) return null;
  if (!entry.visible && !exiting) return null;

  const handleHideStart = () => {
    setExiting(true);
    window.setTimeout(() => {
      setExiting(false);
      setDismissed(true);
    }, FADE_MS);
  };

  const shellClass = [
    'home-tile group h-full',
    entry.dimmed && !exiting ? 'home-tile--dimmed' : '',
    exiting ? 'home-tile--exiting' : '',
  ]
    .filter(Boolean)
    .join(' ');

  const body = (
    <article className={shellClass} style={{ '--tile-accent': accent }}>
      <div className="home-tile-cover-wrap">
        {cover ? (
          <img src={cover} className="home-tile-cover" alt="" loading="lazy" />
        ) : (
          <div className="home-tile-cover home-tile-cover--empty">🎮</div>
        )}
        {showOverlays ? (
          <GameCoverOverlays
            gameId={gameId}
            game={game}
            isAdmin={isAdmin}
            onRequestLogin={onRequestLogin}
            onHideStart={handleHideStart}
          />
        ) : null}
        <div className="home-tile-shine" aria-hidden />
      </div>
      <div className="home-tile-meta">
        <p className="home-tile-title" title={title}>
          {title}
        </p>
        {isAdmin && isGameDraftMode(game) ? (
          <span
            className="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-[10px] font-mono font-bold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-400/50"
            title="Video-Roadmap (Entwurf)"
          >
            🎬 Video-Roadmap (Entwurf)
          </span>
        ) : null}
        {showConsole && consoleLabel ? (
          <span className="home-tile-badge">{consoleLabel}</span>
        ) : null}
      </div>
    </article>
  );

  if (as === 'button') {
    return (
      <button
        type="button"
        className={className}
        aria-expanded={ariaExpanded}
        onClick={onOpen}
      >
        {body}
      </button>
    );
  }

  return (
    <a
      href={href || '#'}
      className={className}
      onClick={(event) => {
        event.preventDefault();
        onOpen?.(event);
      }}
    >
      {body}
    </a>
  );
}

export default GameTile;
</file>

<file path="src/components/GuideOnlineBadge.jsx">
import { hasPublishedGuide, isGameDraftMode, parseStatusMap } from '../lib/guidePublication';
import { GAME_STRUCT, isServerDeadType } from '../lib/gameSchema';

/**
 * Mehrstufiges Status-Icon oben links auf dem Game-Cover.
 * - Für Admins (visible = true / isAdmin): Aktueller / neuester Status der Pipeline
 *   (DRAFT 🎬, PUBLISHED green check, READY ⏳, VEREDELT blue circle, PROCESSED white circle).
 * - Für normale User: Bei spiel_typ === 'Servertot' das "Unobtainable Platins"-Badge.
 */
function GuideOnlineBadge({ game, visible = false, size = 'sm', className = '' }) {
  if (!game) return null;

  const isServerDead = isServerDeadType(game?.[GAME_STRUCT.gameType] ?? game?.spiel_typ);

  // Für Admins: Mehrstufiges Admin-Status-Icon
  if (visible) {
    const statusMap = parseStatusMap(game?.[GAME_STRUCT.status] ?? game?.status);
    const sizeClass =
      size === 'md' ? 'w-8 h-8 text-sm' : size === 'lg' ? 'w-10 h-10 text-base' : 'w-7 h-7 text-xs';
    const iconSize = size === 'md' || size === 'lg' ? 'w-3.5 h-3.5' : 'w-3 h-3';

    // 1. DRAFT / production_roadmap === 'ACTIVE' -> Gelbes Filmklappen-Icon (🎬)
    if (isGameDraftMode(game)) {
      return (
        <span
          className={`${sizeClass} rounded-full border border-amber-400 bg-amber-500/90 text-black flex items-center justify-center shadow-md font-bold ${className}`}
          title="DRAFT / Video-Roadmap (Entwurf)"
          aria-label="DRAFT / Video-Roadmap (Entwurf)"
        >
          🎬
        </span>
      );
    }

    // 2. PUBLISHED 3. Phase -> Grüner Kreis mit Häkchen
    if (hasPublishedGuide(game)) {
      return (
        <span
          className={`${sizeClass} rounded-full border border-[#00ff66] bg-[#00ff66] text-[#121314] flex items-center justify-center shadow-md ${className}`}
          title="PUBLISHED (Online)"
          aria-label="PUBLISHED (Online)"
        >
          <svg
            viewBox="0 0 24 24"
            className={iconSize}
            fill="none"
            stroke="currentColor"
            strokeWidth="2.8"
            strokeLinecap="round"
            strokeLinejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12.5 10 17.5 19 7" />
          </svg>
        </span>
      );
    }

    // 3. READY (Drip-Feed-Warteschlange) -> Blaues Uhr-Icon (⏳)
    const guideDe = String(statusMap.guide_de ?? '').toUpperCase();
    const isReady =
      guideDe === 'READY' ||
      guideDe === 'FERTIG' ||
      String(statusMap.status ?? '').toUpperCase() === 'READY' ||
      Object.entries(statusMap).some(
        ([k, v]) => k.startsWith('guide_') && (String(v).toUpperCase() === 'READY' || String(v).toUpperCase() === 'FERTIG'),
      );

    if (isReady) {
      return (
        <span
          className={`${sizeClass} rounded-full border border-sky-300 bg-sky-500 text-white flex items-center justify-center shadow-md ${className}`}
          title="READY (Drip-Feed-Warteschlange)"
          aria-label="READY (Drip-Feed-Warteschlange)"
        >
          ⏳
        </span>
      );
    }

    // 4. "refinement": "VEREDELT" (blauer Kreis) 2. Phase
    if (String(statusMap.refinement ?? '').toUpperCase() === 'VEREDELT') {
      return (
        <span
          className={`${sizeClass} rounded-full border border-blue-300 bg-blue-600 text-white flex items-center justify-center shadow-md ${className}`}
          title="VEREDELT (Phase 2)"
          aria-label="VEREDELT (Phase 2)"
        >
          <span className="w-2.5 h-2.5 rounded-full bg-blue-200" />
        </span>
      );
    }

    // 5. "trophies": "PROCESSED" (weißer Kreis) 1. Phase
    if (String(statusMap.trophies ?? '').toUpperCase() === 'PROCESSED') {
      return (
        <span
          className={`${sizeClass} rounded-full border border-zinc-200 bg-white text-zinc-900 flex items-center justify-center shadow-md ${className}`}
          title="PROCESSED (Phase 1)"
          aria-label="PROCESSED (Phase 1)"
        >
          <span className="w-2.5 h-2.5 rounded-full bg-zinc-800" />
        </span>
      );
    }

    // Fallback falls kein expliziter Status vorliegt, aber Servertot
    if (isServerDead) {
      return (
        <span
          className={`${sizeClass} rounded-full overflow-hidden border border-amber-500/80 shadow-md bg-black flex items-center justify-center ${className}`}
          title="Unobtainable Platins (Servertot)"
          aria-label="Unobtainable Platins (Servertot)"
        >
          <img
            src="/images/unobtainable-platins-tile.jpg"
            alt=""
            className="w-full h-full object-cover"
            draggable={false}
          />
        </span>
      );
    }

    return null;
  }

  // Für normale User: Wenn das Spiel spiel_typ === 'Servertot' hat
  if (isServerDead) {
    const sizeClass =
      size === 'md' ? 'w-8 h-8' : size === 'lg' ? 'w-10 h-10' : 'w-7 h-7';

    return (
      <span
        className={`${sizeClass} rounded-full overflow-hidden border border-amber-500/80 shadow-md bg-black flex items-center justify-center ${className}`}
        title="Unobtainable Platins (Servertot)"
        aria-label="Unobtainable Platins (Servertot)"
      >
        <img
          src="/images/unobtainable-platins-tile.jpg"
          alt=""
          className="w-full h-full object-cover"
          draggable={false}
        />
      </span>
    );
  }

  return null;
}

export default GuideOnlineBadge;
