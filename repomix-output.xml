<file path="src/components/Dashboard.jsx">
import { useCallback, useEffect, useRef, useState } from 'react';
import { supabase } from '../pages/supabaseClient';
import { fetchGameByRouteRef, fetchGamesByIds, parseRouteGameRef } from '../lib/gameQueries';
import { GAME_PLATFORM_ID } from '../lib/gameSchema';
import { gameGuidePath, navigateToGame } from '../lib/routeUtils';
import {
  getGameUuid,
  getPlatformGameIds,
  getRouteSlug,
} from '../lib/gameModel';
import { useVisibility } from '../context/VisibilityContext';
import { useWatchlist } from '../context/WatchlistContext';
import { useLocale } from '../context/LocaleContext';
import { canonicalizeWatchlistIds, watchlistIdsEqual } from '../lib/localWatchlist';
import { isGameDraftMode } from '../lib/guidePublication';
import GameTile from './GameTile';

/** Ab so vielen Titeln lohnt die Startseiten-Leiste zum horizontalen Scrollen. */
export const HOME_WATCHLIST_MIN = 3;

const TILE_CLASS =
  'home-carousel-tile flex-shrink-0 snap-start w-[9.5rem] sm:w-44 lg:w-[calc((100%-3rem)/5)] max-w-[12rem] lg:max-w-none';

/**
 * Kompakte Watchlist-Leiste auf der Startseite (nur ab HOME_WATCHLIST_MIN Einträgen).
 * Volle Liste: /watchlist
 */
function Dashboard({ openGame, onOpenWatchlist, isAdmin = false }) {
  const { globalLocale, t } = useLocale();
  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(true);
  const { getEntryState, gameKey } = useVisibility();
  const { watchlistIdList, version, replaceWatchlistIds } = useWatchlist();
  const trackRef = useRef(null);
  const [canScrollLeft, setCanScrollLeft] = useState(false);
  const [canScrollRight, setCanScrollRight] = useState(false);

  const updateScrollHints = useCallback(() => {
    const el = trackRef.current;
    if (!el) return;
    setCanScrollLeft(el.scrollLeft > 8);
    setCanScrollRight(el.scrollLeft + el.clientWidth < el.scrollWidth - 8);
  }, []);

  useEffect(() => {
    let cancelled = false;

    async function loadWatchlistGames() {
      const ids = watchlistIdList.filter((id) => parseRouteGameRef(id).valid);
      if (ids.length === 0) {
        if (!cancelled) {
          if (watchlistIdList.length > 0) {
            try {
              replaceWatchlistIds([]);
            } catch {
              /* Quota */
            }
          }
          setItems([]);
          setLoading(false);
        }
        return;
      }

      setLoading(true);
      const { data: games, error: gamesError } = await fetchGamesByIds(
        supabase,
        ids,
        globalLocale,
      );

      if (cancelled) return;

      if (gamesError) {
        console.error('Watchlist-Leiste:', gamesError.message);
        setItems([]);
        setLoading(false);
        return;
      }

      const byRef = new Map();
      for (const game of games || []) {
        const uuid = getGameUuid(game);
        if (uuid) byRef.set(uuid, game);
        for (const npwr of getPlatformGameIds(game)) byRef.set(npwr, game);
      }

      const seenGames = new Set();
      const merged = [];
      for (const id of ids) {
        const game = byRef.get(id);
        if (!game) continue;
        const gameUuid = getGameUuid(game) || id;
        if (seenGames.has(gameUuid)) continue;
        seenGames.add(gameUuid);
        merged.push({
          gameUuid,
          routeSlug: getRouteSlug(game) || id,
          game,
        });
      }

      const canonical = canonicalizeWatchlistIds(watchlistIdList, (id) =>
        getGameUuid(byRef.get(id)),
      );
      if (!watchlistIdsEqual(canonical, watchlistIdList)) {
        try {
          replaceWatchlistIds(canonical);
        } catch {
          /* Quota */
        }
      }

      setItems(merged);
      setLoading(false);
    }

    loadWatchlistGames();
    return () => {
      cancelled = true;
    };
  }, [watchlistIdList, version, globalLocale, replaceWatchlistIds]);

  const visibleItems = items.filter((item) => {
    const key = gameKey(item.gameUuid || item.routeSlug);
    return getEntryState(key, { completed: false }).visible;
  });

  useEffect(() => {
    if (loading || visibleItems.length < HOME_WATCHLIST_MIN) return undefined;
    updateScrollHints();
    const el = trackRef.current;
    if (!el) return undefined;
    const ro = new ResizeObserver(updateScrollHints);
    ro.observe(el);
    return () => ro.disconnect();
  }, [loading, visibleItems.length, updateScrollHints]);

  const handleOpenGame = async (item) => {
    const preferGuideTab = Boolean(isAdmin && item.game && isGameDraftMode(item.game));
    if (item.game) {
      openGame(item.game, preferGuideTab ? { preferGuideTab: true } : undefined);
      return;
    }
    if (!item.routeSlug && !item.gameUuid) return;

    const { data: game, error: gameError } = await fetchGameByRouteRef(
      supabase,
      item.routeSlug ?? item.gameUuid,
      globalLocale,
    );

    if (gameError) {
      console.error('Watchlist-Spiel:', gameError.message);
    }

    if (game) {
      openGame(game);
      return;
    }

    navigateToGame(item.routeSlug ?? item.gameUuid);
    openGame({ id: item.gameUuid, [GAME_PLATFORM_ID]: item.routeSlug });
  };

  if (loading || visibleItems.length < HOME_WATCHLIST_MIN) {
    return null;
  }

  const scrollByTiles = (direction) => {
    const el = trackRef.current;
    if (!el) return;
    el.scrollBy({ left: Math.round(el.clientWidth * 0.85) * direction, behavior: 'smooth' });
  };

  return (
    <section className="home-category w-full min-w-0 max-w-full" aria-labelledby="home-watchlist-title">
      <header className="home-category-header">
        <div className="home-category-heading min-w-0">
          {typeof onOpenWatchlist === 'function' ? (
            <button
              type="button"
              id="home-watchlist-title"
              className="home-category-title home-category-title--clickable"
              onClick={onOpenWatchlist}
              title={t('watchlistTitle')}
            >
              {t('watchlistTitle')}
              <span className="home-category-search-hint" aria-hidden>
                ↗
              </span>
            </button>
          ) : (
            <h2 id="home-watchlist-title" className="home-category-title">
              {t('watchlistTitle')}
            </h2>
          )}
        </div>
        <div className="home-category-nav flex-shrink-0">
          <button
            type="button"
            className="home-scroll-btn"
            aria-label={`${t('watchlistTitle')} nach links`}
            disabled={!canScrollLeft}
            onClick={() => scrollByTiles(-1)}
          >
            ‹
          </button>
          <button
            type="button"
            className="home-scroll-btn"
            aria-label={`${t('watchlistTitle')} nach rechts`}
            disabled={!canScrollRight}
            onClick={() => scrollByTiles(1)}
          >
            ›
          </button>
        </div>
      </header>

      <div className="home-carousel-wrap">
        <div
          ref={trackRef}
          className="home-carousel-track scrollbar-hide"
          onScroll={updateScrollHints}
        >
          {visibleItems.map((item) => {
            if (!item.game) return null;
            const href = gameGuidePath(item.game, globalLocale);
            return (
              <GameTile
                key={item.gameUuid || item.routeSlug}
                game={item.game}
                href={href}
                isAdmin={isAdmin}
                className={TILE_CLASS}
                onOpen={() => {
                  navigateToGame(item.game, { locale: globalLocale });
                  handleOpenGame(item);
                }}
              />
            );
          })}
        </div>
      </div>
    </section>
  );
}

export default Dashboard;
</file>

<file path="src/lib/gameSearch.js">
import { getGameTitle } from './gameModel';
import { GAME_STRUCT, GAME_TYPE } from './gameSchema';
import {
  SEARCH_RESULT_CAP,
  searchGamesByFreeText,
  searchGamesAdvanced as runAdvancedSearch,
  validateSearchQuery,
} from './gameQueries';
import { findHomeCategoryForQuery, searchHomeCategory } from './homeCategories';
import { getLocale } from './locale';

/** Suchreihenfolge: Evergreen, Premium, Standard, danach Quickwins (Servertot nie in der Suche). */
const SEARCH_TYPE_RANK = {
  [GAME_TYPE.EVERGREEN]: 0,
  [GAME_TYPE.PREMIUM]: 1,
  [GAME_TYPE.STANDARD]: 2,
  [GAME_TYPE.QUICKWIN]: 3,
  [GAME_TYPE.EASY_PLATIN]: 3,
};

function searchTypeRank(game) {
  const type = String(game?.[GAME_STRUCT.gameType] ?? '').trim();
  return SEARCH_TYPE_RANK[type] ?? 2;
}

/** Gleiche Typen behalten die bisherige Reihenfolge (Release-Jahr). */
export function rankSearchResults(games) {
  return [...(games ?? [])].sort((a, b) => searchTypeRank(a) - searchTypeRank(b));
}

export const SEARCH_PAGE_SIZE = 50;

export const CONSOLE_FILTER_OPTIONS = [
  { value: '', labelKey: 'consoleAll' },
  { value: 'PS5', label: 'PlayStation 5' },
  { value: 'PS4', label: 'PlayStation 4' },
  { value: 'PS3', label: 'PlayStation 3' },
  { value: 'PS Vita', label: 'PS Vita' },
  { value: 'PSP', label: 'PSP' },
];

/**
 * @param {unknown[]} items
 * @param {number} page
 * @param {number} [pageSize]
 */
export function paginateItems(items, page, pageSize = SEARCH_PAGE_SIZE) {
  const list = Array.isArray(items) ? items : [];
  const total = list.length;
  const totalPages = Math.max(1, Math.ceil(total / pageSize) || 1);
  const safePage = Math.min(Math.max(Number(page) || 1, 1), totalPages);
  const start = (safePage - 1) * pageSize;
  return {
    items: list.slice(start, start + pageSize),
    page: safePage,
    totalPages,
    total,
    pageSize,
    showPager: total > pageSize,
  };
}

/**
 * Suche in games.spieltitel (JSONB), games.genre, games.entwickler und games.publisher.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} query
 * @param {{ limit?: number, locale?: string, includeTrophiesOnly?: boolean }} [options]
 */
export async function searchGames(supabase, query, options = {}) {
  const limit = options.limit ?? SEARCH_RESULT_CAP;
  const locale = options.locale ?? getLocale();
  const check = validateSearchQuery(query);

  if (!check.valid) {
    return { data: [], error: new Error(check.error) };
  }

  const excludeQuickwins = options.excludeQuickwins !== false;
  const includeTrophiesOnly = options.includeTrophiesOnly === true;
  const catalog = includeTrophiesOnly
    ? { includeTrophiesOnly: true, excludeQuickwins, locale }
    : options.includeReady
      ? { includeReady: true, excludeQuickwins, locale }
      : { publishedOnly: options.publishedOnly !== false, excludeQuickwins, locale };

  // Rail-Shortcuts sind Guide-Kataloge – bei „nur Trophäen“ freie Textsuche.
  const rail = !includeTrophiesOnly && findHomeCategoryForQuery(check.query);
  const result = rail?.search
    ? await searchHomeCategory(
      supabase,
      rail,
      locale,
      Boolean(options.includeReady),
      limit,
      excludeQuickwins,
    )
    : await searchGamesByFreeText(supabase, check.pattern, limit, locale, catalog);

  if (result.error) return result;
  return { ...result, data: rankSearchResults(result.data) };
}

/**
 * Erweiterte Suche über einzelne Felder (UND).
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {{ title?: string, developer?: string, genre?: string, console?: string }} filters
 * @param {{ limit?: number, locale?: string, includeReady?: boolean, publishedOnly?: boolean, excludeQuickwins?: boolean, includeTrophiesOnly?: boolean }} [options]
 */
export async function searchGamesAdvanced(supabase, filters, options = {}) {
  const includeTrophiesOnly = options.includeTrophiesOnly === true;
  const result = await runAdvancedSearch(supabase, filters, {
    ...options,
    excludeQuickwins: options.excludeQuickwins !== false,
    includeTrophiesOnly,
    publishedOnly: includeTrophiesOnly ? false : options.publishedOnly,
  });
  if (result.error) return result;
  return { ...result, data: rankSearchResults(result.data) };
}

export { getGameTitle };
