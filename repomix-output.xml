          borderRadius: '6px',
          padding: '2px 6px',
        }}
        title="🎬 Take / Rohdatei (prod_note, z. B. 03_Erde, 14:20)"
      >
        <span style={{ fontSize: '11px' }} aria-hidden>
          🎬
        </span>
        <input
          type="text"
