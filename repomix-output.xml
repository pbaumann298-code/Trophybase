            <input 
              type="password" 
              name="newPassword" 
              required 
              className="w-full bg-[#121314] text-zinc-200 px-4 py-2.5 rounded-xl border border-zinc-800 focus:border-zinc-700 focus:outline-hidden text-sm transition" 
              placeholder="••••••••" 
            />
          </div>
          <div>
            <label className="block text-[11px] font-medium text-zinc-400 uppercase tracking-wider mb-1.5">
              Passwort wiederholen
            </label>
            <input 
              type="password" 
              name="newPasswordConfirm" 
              required 
              className="w-full bg-[#121314] text-zinc-200 px-4 py-2.5 rounded-xl border border-zinc-800 focus:border-zinc-700 focus:outline-hidden text-sm transition" 
              placeholder="••••••••" 
            />
          </div>
          <button 
