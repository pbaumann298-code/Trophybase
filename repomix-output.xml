    const [{ error: stagingDelErr }, { error: rohDelErr }] = await Promise.all([
      discardAll || !targetCreator ? stagingDelete : stagingDelete.eq('creator_name', targetCreator),
      discardAll || !targetCreator ? rohDelete : rohDelete.eq('creator_name', targetCreator),
    ]);
    setActionBusy(false);

    if (stagingDelErr || rohDelErr) {
      setError(
        `Entwurf verwerfen fehlgeschlagen: ${stagingDelErr?.message || rohDelErr?.message}`,
      );
      return;
    }

    const gameTitle = getLocalizedTitle(selectedGame?.spieltitel);
    if (discardAll) {
      setShowConflictModal(false);
      setNotice(
        `🗑️ Vorabprüfung: Alle Entwürfe für "${gameTitle}" verworfen. Das veröffentlichte Live-Spiel bleibt unverändert.`,
      );
      jumpToNextGame(targetGameId);
      setStagingRows((prev) => prev.filter((row) => row.game_id !== targetGameId));
      setRohmaterialRows((prev) =>
        prev.filter(
          (row) =>
            row.game_id !== targetGameId &&
            row.platform_game_id !== targetGameId &&
            row.batch_key !== targetGameId,
        ),
      );
      setRohmaterialGames((prev) => prev.filter((game) => game.gameId !== targetGameId));
      setTotalStagingCountsMap((prev) => {
        if (!prev.has(targetGameId)) return prev;
        const next = new Map(prev);
        next.delete(targetGameId);
        return next;
      });
      setTotalStagingCreatorsMap((prev) => {
        if (!prev.has(targetGameId)) return prev;
        const next = new Map(prev);
        next.delete(targetGameId);
        return next;
      });
      fetchQueue();
      return;
    }

    setNotice(
      `🗑️ Vorabprüfung: Nur Creator "${targetCreator}" von "${gameTitle}" verworfen. Die übrigen Creator bleiben in der Queue.`,
    );
    setStagingRows((prev) =>
      prev.filter((row) => !(row.game_id === targetGameId && row.creator_name === targetCreator)),
    );
    setRohmaterialRows((prev) =>
      prev.filter((row) => !(row.game_id === targetGameId && row.creator_name === targetCreator)),
    );
    const removedStaging = stagingRows.filter(
      (row) => row.game_id === targetGameId && row.creator_name === targetCreator,
    ).length;
    const removedRoh = rohmaterialRows.filter(
      (row) => row.game_id === targetGameId && row.creator_name === targetCreator,
    ).length;
    if (removedStaging > 0) {
      setTotalStagingCountsMap((prev) => {
        const next = new Map(prev);
        const left = (next.get(targetGameId) || 0) - removedStaging;
        if (left > 0) next.set(targetGameId, left);
        else next.delete(targetGameId);
        return next;
      });
      setTotalStagingCreatorsMap((prev) => {
        const next = new Map(prev);
        const left = (next.get(targetGameId) || 1) - 1;
        if (left > 0) next.set(targetGameId, left);
        else next.delete(targetGameId);
        return next;
      });
    }
    if (removedRoh > 0) {
      setRohmaterialGames((prev) =>
        prev
          .map((item) =>
            item.gameId === targetGameId
              ? { ...item, rowCount: Math.max(0, (item.rowCount || 0) - removedRoh) }
              : item,
          )
          .filter((item) => item.gameId !== targetGameId || item.rowCount > 0),
      );
    }

    const remainingCreators = creatorTabs.filter((tab) => tab.creatorName !== targetCreator);
    if (remainingCreators.length === 0) {
      setShowConflictModal(false);
      jumpToNextGame(targetGameId);
      return;
    }
    jumpToNextCreatorOrGame(targetGameId, targetCreator);
  };

  // Open approval modal (oder Vorabprüfung, falls Spiel bereits Published / Guide-Daten in game_guides hat)
  const handleOpenApproveModal = () => {
    if (!selectedGameId || !selectedCreatorName || actionBusy) return;
    setDiscardOtherCreators(true);
    if (conflictInfo.hasConflict) {
      handleOpenConflictModal();
      return;
    }
    setApproveLocale('de');
    setSelectedGameTypes(parseGameTypes(selectedGame?.spiel_typ));
    setIncludeAllRohBatchesOnApprove(true);
    setDiscardOtherCreators(true);
    resetApproveCoverDraft();
    setShowApproveModal(true);
  };

  const handleApplyCoverInApproveModal = async () => {
    const url = approveCoverUrlInput.trim();
    if (!selectedGameId || !url || approveCoverSaving || actionBusy) return;
    setApproveCoverSaving(true);
    setError('');
    const applied = await setIntranetIgdbCover(supabase, selectedGameId, url);
    setApproveCoverSaving(false);
    if (applied.error) {
      setError(applied.error.message || 'Cover konnte nicht gesetzt werden.');
      return;
    }
    patchDraftGame(selectedGameId, {
      cover_url: applied.coverMap,
      cover_status: 'valid',
      cover_notes: null,
      ...(applied.status ? { status: applied.status } : {}),
    });
    setApproveCoverUrlInput('');
    setApproveMarkCoverValid(true);
    setNotice('Cover gesetzt und als valid markiert.');
  };

  // 3. Creator freigeben (Zentraler Freigabe-Prozess über RPC approve_staging_guide bzw. Rohmaterial-Pipeline)
  // Unterstützt p_conflict_mode: null | 'replace' | 'keep_both' für die Vorabprüfung
  const handleApproveCreatorConfirm = async (conflictMode = null) => {
    const resolvedConflictMode =
      conflictMode === 'replace' || conflictMode === 'keep_both' ? conflictMode : null;
    const selectedLanguage = approveLocale || 'de';
    const effectiveGameTypes =
      selectedGameTypes.length > 0 ? selectedGameTypes : parseGameTypes(selectedGame?.spiel_typ);

    if (
      !selectedGameId ||
      !selectedCreatorName ||
      actionBusy ||
      !selectedLanguage ||
      effectiveGameTypes.length === 0
    ) {
      return;
    }

    setActionBusy(true);
    setNotice('');
    setError('');

    const keepOtherCreators = discardOtherCreators === false && otherCreatorsCount > 0;
    const otherCreatorStagingRows = keepOtherCreators
      ? stagingRows.filter(
          (row) => row.game_id === selectedGameId && row.creator_name !== selectedCreatorName,
        )
      : [];

    const deleteDraftRowsAfterApprove = async () => {
      if (!keepOtherCreators) {
        const [{ error: stagingDelErr }, { error: rohDelErr }] = await Promise.all([
          supabase.from('staging_game_guides').delete().eq('game_id', selectedGameId),
          supabase.from(TABLES.guidesRohmaterial).delete().eq('game_id', selectedGameId),
        ]);
        if (stagingDelErr) throw new Error(`staging_game_guides: ${stagingDelErr.message}`);
        if (rohDelErr) throw new Error(`${TABLES.guidesRohmaterial}: ${rohDelErr.message}`);
        return [];
      }

      const [{ error: stagingDelErr }, { error: rohDelErr }] = await Promise.all([
        supabase
          .from('staging_game_guides')
          .delete()
          .eq('game_id', selectedGameId)
          .eq('creator_name', selectedCreatorName),
        supabase
          .from(TABLES.guidesRohmaterial)
          .delete()
          .eq('game_id', selectedGameId)
          .eq('creator_name', selectedCreatorName),
      ]);
      if (stagingDelErr) throw new Error(`staging_game_guides: ${stagingDelErr.message}`);
      if (rohDelErr) throw new Error(`${TABLES.guidesRohmaterial}: ${rohDelErr.message}`);

      if (otherCreatorStagingRows.length === 0) return [];

      const { count: remainingCount, error: remainErr } = await supabase
        .from('staging_game_guides')
        .select('id', { count: 'exact', head: true })
        .eq('game_id', selectedGameId);
      if (remainErr) throw new Error(`staging_game_guides: ${remainErr.message}`);
      if ((remainingCount ?? 0) > 0) return [];

      const payloads = otherCreatorStagingRows.map((row) => {
        const copy = { ...row };
        delete copy.id;
        delete copy._sourceTable;
        return copy;
      });
      const restored = [];
      const CHUNK = 80;
      for (let i = 0; i < payloads.length; i += CHUNK) {
        const chunk = payloads.slice(i, i + CHUNK);
        const { data, error: insErr } = await supabase
          .from('staging_game_guides')
          .insert(chunk)
          .select('*');
        if (insErr) throw new Error(`staging_game_guides: ${insErr.message}`);
        const rows = data ?? [];
        if (rows.length !== chunk.length) {
          throw new Error(
            `staging_game_guides: Wiederherstellung lieferte ${rows.length} von ${chunk.length} Zeilen zurück.`,
          );
        }
        for (const row of rows) restored.push({ ...row, _sourceTable: 'staging_game_guides' });
      }
      return restored;
    };

    try {
      let restoredStagingRows = [];

      const coverInput = approveCoverUrlInput.trim();
      const existingCoverUrl = getLocalizedCover(selectedGame?.cover_url);
      if (coverInput) {
        const applied = await setIntranetIgdbCover(supabase, selectedGameId, coverInput);
        if (applied.error) {
          setActionBusy(false);
          setError(applied.error.message || 'Cover konnte nicht gesetzt werden.');
          return;
        }
        patchDraftGame(selectedGameId, {
          cover_url: applied.coverMap,
          cover_status: 'valid',
          cover_notes: null,
          ...(applied.status ? { status: applied.status } : {}),
        });
        setApproveCoverUrlInput('');
        setApproveMarkCoverValid(true);
      } else if (
        existingCoverUrl &&
        approveMarkCoverValid &&
        selectedGame?.cover_status !== 'valid'
      ) {
        const marked = await markGameCoverValid(supabase, selectedGameId);
        if (marked.error) {
          setActionBusy(false);
          setError(marked.error.message || 'Cover-Status konnte nicht gesetzt werden.');
          return;
        }
        patchDraftGame(selectedGameId, { cover_status: 'valid', cover_notes: null });
      }

      // 1. Spieltyp speichern, falls gewählt/geändert
      const { error: typeErr } = await setIntranetGameType(
        supabase,
        selectedGameId,
        effectiveGameTypes
      );
      if (typeErr) {
        console.warn('Fehler beim Speichern des Spiel-Typs im Freigabe-Modal:', typeErr.message);
      } else {
        const updateGameMap = (prev) => {
          const next = new Map(prev);
          const current = next.get(selectedGameId);
          if (current) {
            next.set(selectedGameId, {
              ...current,
              spiel_typ: effectiveGameTypes.join(', '),
            });
          }
          return next;
        };
        setGamesMap(updateGameMap);
        setRohGamesMap(updateGameMap);
      }

      if (activeDataSource === 'staging') {
        // 2. Eventuelle ausstehende Inline-Edits in staging_game_guides sicherstellen
        const stagingTargets = currentCreatorRows.filter(
          (r) => (r._sourceTable || 'staging_game_guides') === 'staging_game_guides'
        );
        if (stagingTargets.length > 0) {
          await persistRowPatchesToSupabase(stagingTargets, (row) => ({
            guide_id: formatFieldValueForTable(row, 'guide_id', row.guide_id),
            item_name: formatFieldValueForTable(
              row,
              'item_name',
              getLocalizedItemName(row.item_name)
            ),
            chronological_group: formatFieldValueForTable(
              row,
              'chronological_group',
              getLocalizedItemName(row.chronological_group)
            ),
            category_group: formatFieldValueForTable(
              row,
              'category_group',
              getLocalizedItemName(row.category_group)
            ),
            boss_group: formatFieldValueForTable(
              row,
              'boss_group',
              getLocalizedItemName(row.boss_group)
            ),
            video_chapter: formatFieldValueForTable(
              row,
              'video_chapter',
              getLocalizedItemName(row.video_chapter)
            ),
            timestamp: row.timestamp || '00:00',
            video_url: row.video_url || '',
            prod_note: formatFieldValueForTable(row, 'prod_note', row.prod_note),
            trophy_id: formatFieldValueForTable(row, 'trophy_id', row.trophy_id),
            is_trophy_relevant: row.is_trophy_relevant || null,
          }));
          const regionTargets = stagingTargets.filter(
            (row) =>
              Boolean(getLocalizedItemName(row.spiel_region).trim()) ||
              normalizeSpielRegionTab(row.spiel_region_tab).length > 0,
          );
          if (regionTargets.length > 0) {
            await persistRowPatchesToSupabase(regionTargets, (row) => ({
              spiel_region: formatFieldValueForTable(
                row,
                'spiel_region',
                getLocalizedItemName(row.spiel_region),
              ),
              spiel_region_tab: formatFieldValueForTable(
                row,
                'spiel_region_tab',
                row.spiel_region_tab,
              ),
            }));
          }
        }

        // 3. Zentrale Supabase-RPC aufrufen (inkl. Vorabprüfungs-Entscheidung p_conflict_mode)
        const rpcPayload = {
          p_game_id: selectedGameId,
          p_lang: selectedLanguage,
          p_creator_name: selectedCreatorName,
        };
        if (resolvedConflictMode) {
          rpcPayload.p_conflict_mode = resolvedConflictMode;
        }

        const { error: rpcErr } = await supabase.rpc('approve_staging_guide', rpcPayload);

        if (rpcErr) {
          setActionBusy(false);
          if (String(rpcErr.message || '').includes('VORABPRUEFUNG_ERFORDERLICH')) {
            setShowApproveModal(false);
            setShowConflictModal(true);
            return;
          }
          setError(`Freigabe über approve_staging_guide fehlgeschlagen: ${rpcErr.message}`);
          return;
        }

        const targetCheckTable = TABLES.guides;
        const { count: targetCount, error: countErr } = await supabase
          .from(targetCheckTable)
          .select('id', { count: 'exact', head: true })
          .eq('game_id', selectedGameId);
        if (countErr || !targetCount || targetCount === 0) {
          throw new Error(
            'Sicherheits-Stopp: Ziel-Tabelle enthält noch 0 Zeilen für dieses Spiel! Quell-Daten wurden NICHT gelöscht.'
          );
        }

        await writeSpielRegionOntoGameGuides(selectedGameId, stagingTargets, selectedLanguage);

        restoredStagingRows = await deleteDraftRowsAfterApprove();
      } else {
        // Rohmaterial / Multi-Tab Freigabe
        // Alle Rohmaterial-Zeilen des Spiels einschließen (damit 07.0 Trophäen-Videos mit abweichendem creator_name nicht beim Cleanup verloren gehen)
        const publishAllRohBatches = includeAllRohBatchesOnApprove && !keepOtherCreators;
        const baseCandidateRows = publishAllRohBatches
          ? [
              ...currentCreatorRows,
              ...currentGameRows.filter(
                (r) =>
                  !currentCreatorRows.some((cr) => cr.id === r.id) &&
                  r._sourceTable !== TABLES.guides
              ),
            ]
          : currentCreatorRows;

        const mergedRohById = new Map();
        for (const r of baseCandidateRows) {
          if (r._sourceTable === TABLES.guides) continue;
          if (r.id) mergedRohById.set(r.id, r);
        }

        if (publishAllRohBatches) {
          const { data: dbRohRows } = await supabase
            .from(TABLES.guidesRohmaterial)
            .select('*')
            .eq('game_id', selectedGameId)
            .order('id', { ascending: true });
          for (const dbRow of dbRohRows ?? []) {
            if (dbRow?.id && !mergedRohById.has(dbRow.id)) {
              mergedRohById.set(dbRow.id, {
                ...dbRow,
                _sourceTable: TABLES.guidesRohmaterial,
              });
            }
          }
        }

        const rowsFromNonProductive =
          mergedRohById.size > 0
            ? [...mergedRohById.values()]
            : baseCandidateRows.filter((r) => r._sourceTable !== TABLES.guides);

        let creatorId =
          currentCreatorRows.find((r) => r.creator_id)?.creator_id ||
          rowsFromNonProductive.find((r) => r.creator_id)?.creator_id ||
          null;
        if (
          !creatorId &&
          selectedCreatorName &&
          !selectedCreatorName.startsWith('Produktiver Guide')
        ) {
          const { data: existingCreator } = await supabase
            .from(TABLES.contentCreators)
            .select('id')
            .ilike('channel_name', selectedCreatorName.trim())
            .maybeSingle();

          if (existingCreator?.id) {
            creatorId = existingCreator.id;
          } else {
            const sampleRowWithUrl = rowsFromNonProductive.find(
              (r) => r.creator_input_url || r.playlist_url || r.video_url
            );
            const rawUrl =
              sampleRowWithUrl?.creator_input_url ||
              sampleRowWithUrl?.playlist_url ||
              sampleRowWithUrl?.video_url ||
              '';
            const inputUrl = rawUrl.trim() || 'https://www.youtube.com';
            const { data: newCreator } = await supabase
              .from(TABLES.contentCreators)
              .insert({ channel_name: selectedCreatorName.trim(), youtube_url: inputUrl })
              .select('id')
              .maybeSingle();

            if (newCreator?.id) {
              creatorId = newCreator.id;
            }
          }
        }

        const toLocalized = (val) => {
          if (!val) return null;
          if (typeof val === 'object' && !Array.isArray(val)) {
            const str = val[selectedLanguage] || val.de || val.en || Object.values(val)[0] || '';
            return str ? { ...val, [selectedLanguage]: String(str).trim() } : null;
          }
          const str = String(val).trim();
          return str ? { [selectedLanguage]: str } : null;
        };

        const parseDigitStr = (val, offset = 0) => {
          const digits = String(val ?? '').replace(/\D/g, '');
          if (!digits) return offset > 0 ? String(offset + 1) : null;
          return String(Number.parseInt(digits, 10) + offset);
        };

        if (resolvedConflictMode === 'replace') {
          const { data: curGameForUnlock } = await supabase
            .from(TABLES.games)
            .select(`${GAME_STRUCT.status}, ${GAME_STRUCT.progress}`)
            .eq(GAME_PK, selectedGameId)
            .maybeSingle();
          const unlockedStatus = { ...parseStatusMap(curGameForUnlock?.[GAME_STRUCT.status]) };
          for (const [k, v] of Object.entries(unlockedStatus)) {
            if (!k.startsWith('guide_')) continue;
            const up = String(v ?? '').trim().toUpperCase();
            if (up === GUIDE_PUBLICATION.PUBLISHED || up === 'READY') {
              unlockedStatus[k] = GUIDE_PUBLICATION.DONE;
            }
          }
          unlockedStatus.publish_status = GUIDE_PUBLICATION.DONE;
          const unlockGamePatch = {
            [GAME_STRUCT.isGuideLocked]: false,
            [GAME_STRUCT.status]: unlockedStatus,
            [GAME_STRUCT.publishingStatus]: {},
            [GAME_STRUCT.publishedLocales]: [],
          };
          if (
            String(curGameForUnlock?.[GAME_STRUCT.progress] ?? '').trim().toUpperCase() ===
            GUIDE_PUBLICATION.PUBLISHED
          ) {
            unlockGamePatch[GAME_STRUCT.progress] = GUIDE_PUBLICATION.DONE;
          }
          await supabase
            .from(TABLES.games)
            .update(unlockGamePatch)
            .eq(GAME_PK, selectedGameId);
          await supabase.from(TABLES.guides).delete().eq('game_id', selectedGameId);
        }

        let guideIdOffset = 0;
        if (resolvedConflictMode === 'keep_both' && liveGuideRows.length > 0) {
          for (const lr of liveGuideRows) {
            const n = Number.parseInt(String(lr.guide_id ?? '').replace(/\D/g, ''), 10);
            if (Number.isFinite(n) && n > guideIdOffset) guideIdOffset = n;
          }
        }

        if (rowsFromNonProductive.length > 0) {
          const usedGuideIds = new Set();
          let maxSeenGuideId = guideIdOffset;
          for (const r of rowsFromNonProductive) {
            const digits = String(r.guide_id ?? '').replace(/\D/g, '');
            if (digits) {
              const n = Number.parseInt(digits, 10) + guideIdOffset;
              if (Number.isFinite(n) && n > maxSeenGuideId) maxSeenGuideId = n;
            }
          }

          const rowsToApprove = rowsFromNonProductive.map((r, idx) => {
            let resolvedGuideId = parseDigitStr(r.guide_id ?? idx + 1, guideIdOffset);
            if (!resolvedGuideId || usedGuideIds.has(resolvedGuideId)) {
              maxSeenGuideId += 1;
              resolvedGuideId = String(maxSeenGuideId);
            }
            usedGuideIds.add(resolvedGuideId);

            return {
              game_id: r.game_id || selectedGameId,
              platform_game_id: r.platform_game_id || null,
              guide_id: resolvedGuideId,
              item_name: toLocalized(r.item_name),
              chronological_group: toLocalized(r.chronological_group),
              category_group: toLocalized(r.category_group),
              boss_group: toLocalized(r.boss_group),
              video_chapter: toLocalized(r.video_chapter),
              ...(toLocalized(r.spiel_region)
                ? { spiel_region: toLocalized(r.spiel_region) }
                : {}),
              ...(normalizeSpielRegionTab(r.spiel_region_tab).length > 0
                ? { spiel_region_tab: normalizeSpielRegionTab(r.spiel_region_tab) }
                : toLocalized(r.spiel_region)
                  ? { spiel_region_tab: deriveSheetTypesFromRow(r) }
                  : {}),
              timestamp: r.timestamp || null,
              video_url: r.video_url || null,
              trophy_id: parseDigitStr(r.trophy_id, 0),
              is_trophy_relevant: r.is_trophy_relevant || null,
              creator_id: creatorId,
              sheet_type: deriveSheetTypesFromRow(r),
            };
          });

          const INSERT_CHUNK = 500;
          for (let i = 0; i < rowsToApprove.length; i += INSERT_CHUNK) {
            const chunk = rowsToApprove.slice(i, i + INSERT_CHUNK);
            const { error: insertErr } = await supabase.from(TABLES.guides).insert(chunk);
            if (insertErr) {
              setActionBusy(false);
              setError(`Freigabe fehlgeschlagen: ${insertErr.message}`);
              return;
            }
          }
        }

        // Einheitliches Update auf public.games (guide_<lang>: 'PUBLISHED', publish_status: 'PUBLISHED', is_guide_locked: true)
        const { data: current } = await supabase
          .from(TABLES.games)
          .select(
            `${GAME_STRUCT.status}, ${GAME_STRUCT.publishingStatus}, ${GAME_STRUCT.publishedLocales}`
          )
          .eq(GAME_PK, selectedGameId)
          .maybeSingle();

        const hasVideo = rowsFromNonProductive.some((r) => Boolean(r.video_url));
        const updatePatch = buildUnifiedGuidePublishPatch({
          currentGame: current,
          lang: selectedLanguage,
          guideState: GUIDE_PUBLICATION.PUBLISHED,
          hasVideo,
          clearRohmaterial: publishAllRohBatches,
        });

        const { error: gameUpErr } = await supabase
          .from(TABLES.games)
          .update(updatePatch)
          .eq(GAME_PK, selectedGameId);

        if (gameUpErr) {
          setActionBusy(false);
          setError(`Fehler beim Aktualisieren des Spiel-Status: ${gameUpErr.message}`);
          return;
        }

        await removeGameFromWiedervorlage(supabase, selectedGameId);

        const targetCheckTable = TABLES.guides;
        const { count: targetCount, error: countErr } = await supabase
          .from(targetCheckTable)
          .select('id', { count: 'exact', head: true })
          .eq('game_id', selectedGameId);
        if (countErr || !targetCount || targetCount === 0) {
          throw new Error(
            'Sicherheits-Stopp: Ziel-Tabelle enthält noch 0 Zeilen für dieses Spiel! Quell-Daten wurden NICHT gelöscht.'
          );
        }

        restoredStagingRows = await deleteDraftRowsAfterApprove();
      }

      const approvedGameId = selectedGameId;
      const approvedCreator = selectedCreatorName;

      const localOverrides = loadStagingLocalOverrides();
      const overrideRows = keepOtherCreators ? currentCreatorRows : currentGameRows;
      for (const row of overrideRows) {
        if (row?.id) delete localOverrides[row.id];
      }
      saveStagingLocalOverrides(localOverrides);

      if (keepOtherCreators) {
        const { data: freshGuides, error: guidesErr } = await fetchPages((from, to) =>
          supabase
            .from(TABLES.guides)
            .select(
              'id, guide_id, sheet_type, item_name, chronological_group, category_group, boss_group, video_chapter, timestamp, video_url, trophy_id',
            )
            .eq('game_id', approvedGameId)
            .order('id', { ascending: true })
            .range(from, to),
        );
        if (!guidesErr) {
          const rows = freshGuides ?? [];
          setLiveGuideRows(rows);
          setLiveGuideCountsMap((prev) => {
            const next = new Map(prev);
            next.set(approvedGameId, rows.length);
            return next;
          });
          setSelectedGameDbCounts((prev) => ({
            ...prev,
            game_guides: rows.length,
          }));
        }
      }

      setShowApproveModal(false);
      if (!keepOtherCreators) setShowConflictModal(false);
      setActionBusy(false);

      const keptHint = keepOtherCreators
        ? ` ${otherCreatorsCount} weitere Creator bleiben in der Queue.`
        : '';
      if (resolvedConflictMode === 'replace') {
        setNotice(
          `🔄 Vorabprüfung: Bestehende Guide-Daten wurden ersetzt und Entwurf von "${approvedCreator}" in [${selectedLanguage.toUpperCase()}] veröffentlicht!${keptHint}`,
        );
      } else if (resolvedConflictMode === 'keep_both') {
        setNotice(
          `➕ Vorabprüfung: Bestehende Live-Daten behalten und Entwurf von "${approvedCreator}" zusätzlich in [${selectedLanguage.toUpperCase()}] übernommen!${keptHint}`,
        );
      } else {
        setNotice(
          `✓ Guide von Creator "${approvedCreator}" erfolgreich in [${selectedLanguage.toUpperCase()}] freigegeben!${keptHint}`,
        );
      }

      if (!keepOtherCreators) {
        jumpToNextGame(approvedGameId);
        setStagingRows((prev) => prev.filter((r) => r.game_id !== approvedGameId));
        setRohmaterialRows((prev) => prev.filter((r) => r.game_id !== approvedGameId));
        setRohmaterialGames((prev) => prev.filter((g) => g.gameId !== approvedGameId));
        setProductiveRohRows([]);
        setTotalStagingCountsMap((prev) => {
          if (!prev.has(approvedGameId)) return prev;
          const next = new Map(prev);
          next.delete(approvedGameId);
          return next;
        });
        setTotalStagingCreatorsMap((prev) => {
          if (!prev.has(approvedGameId)) return prev;
          const next = new Map(prev);
          next.delete(approvedGameId);
          return next;
        });
        fetchQueue();
      } else {
        const removedStaging = stagingRows.filter(
          (row) => row.game_id === approvedGameId && row.creator_name === approvedCreator,
        ).length;
        const removedRoh = rohmaterialRows.filter(
          (row) => row.game_id === approvedGameId && row.creator_name === approvedCreator,
        ).length;
        setStagingRows((prev) => {
          const withoutApproved = prev.filter(
            (row) => !(row.game_id === approvedGameId && row.creator_name === approvedCreator),
          );
          if (restoredStagingRows.length === 0) return withoutApproved;
          return withoutApproved
            .filter((row) => row.game_id !== approvedGameId)
            .concat(restoredStagingRows);
        });
        setRohmaterialRows((prev) =>
          prev.filter(
            (row) => !(row.game_id === approvedGameId && row.creator_name === approvedCreator),
          ),
        );
        if (removedStaging > 0) {
          setTotalStagingCountsMap((prev) => {
            const next = new Map(prev);
            const left = (next.get(approvedGameId) || 0) - removedStaging;
            if (left > 0) next.set(approvedGameId, left);
            else next.delete(approvedGameId);
            return next;
          });
          setTotalStagingCreatorsMap((prev) => {
            const next = new Map(prev);
            const left = (next.get(approvedGameId) || 1) - 1;
            if (left > 0) next.set(approvedGameId, left);
            else next.delete(approvedGameId);
            return next;
          });
        }
        if (removedRoh > 0) {
          setRohmaterialGames((prev) =>
            prev
              .map((item) =>
                item.gameId === approvedGameId
                  ? { ...item, rowCount: Math.max(0, (item.rowCount || 0) - removedRoh) }
                  : item,
              )
              .filter((item) => item.gameId !== approvedGameId || item.rowCount > 0),
          );
        }
        jumpToNextCreatorOrGame(approvedGameId, approvedCreator);
      }
    } catch (err) {
      setActionBusy(false);
      setError(`Unerwarteter Fehler bei der Freigabe: ${err.message}`);
    }
  };

  const handleBatchDeleteSelectedRows = async () => {
    if (actionBusy || selectedRowIds.size === 0) return;
    const rowsToDelete = currentCreatorRows.filter((row) => selectedRowIds.has(row.id));
    if (rowsToDelete.length === 0) {
      setConfirmBatchDelete(false);
      return;
    }

    setActionBusy(true);
    setError('');
    setNotice('');

    const idsByTable = new Map();
    for (const row of rowsToDelete) {
      const tableName = row._sourceTable || 'staging_game_guides';
      const list = idsByTable.get(tableName);
      if (list) list.push(row.id);
      else idsByTable.set(tableName, [row.id]);
    }

    const deletedIds = new Set();
    try {
      for (const [tableName, ids] of idsByTable) {
        for (const chunkIds of chunkList(ids, 100)) {
          const { error: delErr } = await supabase.from(tableName).delete().in('id', chunkIds);
          if (delErr) throw new Error(`${tableName}: ${delErr.message}`);
          for (const id of chunkIds) deletedIds.add(id);
        }
      }
    } catch (err) {
      setError(`Batch-Löschen fehlgeschlagen: ${err.message}`);
    }

    if (deletedIds.size > 0) {
      setStagingRows((prev) => prev.filter((row) => !deletedIds.has(row.id)));
      setRohmaterialRows((prev) => prev.filter((row) => !deletedIds.has(row.id)));
      setProductiveRohRows((prev) => prev.filter((row) => !deletedIds.has(row.id)));
      const overrides = loadStagingLocalOverrides();
      let overridesChanged = false;
      for (const id of deletedIds) {
        const key = String(id);
        if (Object.prototype.hasOwnProperty.call(overrides, id) || Object.prototype.hasOwnProperty.call(overrides, key)) {
          delete overrides[id];
          delete overrides[key];
          overridesChanged = true;
        }
      }
      if (overridesChanged) saveStagingLocalOverrides(overrides);
    }

    if (deletedIds.size === rowsToDelete.length) {
      try {
        const remaining = currentCreatorRows.filter((row) => !deletedIds.has(row.id));
        const renumberById = new Map();
        const rowsToRenumber = [];
        remaining.forEach((row, index) => {
          const newGuideId = index + 1;
          if (String(row.guide_id) !== String(newGuideId)) {
            rowsToRenumber.push(row);
            renumberById.set(row.id, newGuideId);
          }
        });
        if (rowsToRenumber.length > 0) {
          rowsToRenumber.sort(
            (a, b) => renumberById.get(a.id) - renumberById.get(b.id),
          );
          await persistRowPatchesToSupabase(rowsToRenumber, (row) => ({
            guide_id: formatFieldValueForTable(row, 'guide_id', renumberById.get(row.id)),
          }));
        }
        setSortField('guide_id');
        setSortDirection('asc');
        setSelectedRowIds(new Set());
        setConfirmBatchDelete(false);
        setNotice(`🗑️ ${rowsToDelete.length} markierte Zeilen wurden gelöscht. Verbleibende Guide-IDs neu von 1 bis ${remaining.length} nummeriert.`);
      } catch (err) {
        setError(`Neu-Nummerierung nach dem Löschen fehlgeschlagen: ${err.message || err}`);
        setSelectedRowIds(new Set());
        setConfirmBatchDelete(false);
      }
    } else {
      setSelectedRowIds((prev) => {
        const next = new Set(prev);
        for (const id of deletedIds) next.delete(id);
        return next;
      });
    }
    setActionBusy(false);
  };

  // 4. Einzelne Zeile löschen
  const handleDeleteRow = async (rowId) => {
    if (!rowId || actionBusy) return;
    const targetRow = currentCreatorRows.find((r) => r.id === rowId);
    const sourceTable = targetRow?._sourceTable || 'staging_game_guides';

    const { error: delErr } = await supabase
      .from(sourceTable)
      .delete()
      .eq('id', rowId);

    if (delErr) {
      setError(`Zeile löschen fehlgeschlagen: ${delErr.message}`);
      return;
    }

    setSelectedRowIds((prev) => {
      const next = new Set(prev);
      next.delete(rowId);
      return next;
    });

    if (sourceTable === 'staging_game_guides') {
      setStagingRows((prev) => prev.filter((r) => r.id !== rowId));
    } else if (sourceTable === TABLES.guidesRohmaterial) {
      setRohmaterialRows((prev) => prev.filter((r) => r.id !== rowId));
    } else if (sourceTable === TABLES.guides) {
      setProductiveRohRows((prev) => prev.filter((r) => r.id !== rowId));
    }
  };

  // 5. Ganzes Video / Chapter entfernen
  const handleDeleteVideoChapter = async (videoChapter, videoUrl) => {
    if (!selectedGameId || !selectedCreatorName || actionBusy) return;
    if (!window.confirm('Möchtest du alle Zeilen dieses Videos / Chapters für diesen Creator löschen?')) return;

    setActionBusy(true);
    const targetTable =
      activeDataSource === 'rohmaterial' ? TABLES.guidesRohmaterial : 'staging_game_guides';

    let query = supabase
      .from(targetTable)
      .delete()
      .eq('game_id', selectedGameId)
      .eq('creator_name', selectedCreatorName);

    if (videoUrl) {
      query = query.eq('video_url', videoUrl);
    } else if (videoChapter) {
      query = query.eq('video_chapter', videoChapter);
    }

    const { error: delErr } = await query;
    setActionBusy(false);

    if (delErr) {
      setError(`Video/Chapter löschen fehlgeschlagen: ${delErr.message}`);
      return;
    }

    if (activeDataSource === 'rohmaterial') {
      fetchRohmaterialSummary();
    } else {
      fetchQueue();
    }
  };

  // Helper: Synchronisiert video_url mit neuem Timestamp
  const updateVideoUrlTimestamp = (url, newTimestamp) => {
    if (!url) return url;
    const seconds = parseTimecodeToSeconds(newTimestamp);
    if (seconds == null) {
      return url;
    }
    const cleanUrl = url.replace(/([?&]t=)[^&]*/, '');
    const separator = cleanUrl.includes('?') ? '&' : '?';
    return `${cleanUrl}${separator}t=${seconds}s`;
  };

  // 6. Zeilen-Eigenschaft inline updaten
  const handleUpdateRowField = async (rowId, field, value) => {
    const targetRow = currentCreatorRows.find((r) => r.id === rowId) || stagingRows.find((r) => r.id === rowId);
    if (!targetRow) return;

    try {
      await persistRowPatchesToSupabase([targetRow], (row) => {
        if (field === 'timestamp') {
          const newVideoUrl = updateVideoUrlTimestamp(row?.video_url, value);
          return {
            timestamp: value,
            video_url: newVideoUrl,
          };
        }
        return {
          [field]: formatFieldValueForTable(row, field, value),
        };
      });
    } catch (err) {
      console.error(`Fehler beim Speichern von ${field}:`, err.message);
    }
  };

  // 7. 1-Klick-Reparatur für Zeitspannen im Item-Namen
  const handleCleanItemTimes = async () => {
    if (!currentCreatorRows.length || actionBusy) return;

    setActionBusy(true);
    setError('');
    setNotice('');

    try {
      const modifiedRows = [];
      const patchesMap = new Map();

      for (const row of currentCreatorRows) {
        const rawName = getLocalizedItemName(row.item_name);
        let nameStr = rawName.trim();
        let cleanTime = row.timestamp;
        let newVideoUrl = row.video_url;
        let isModified = false;

        // a) Prüfe Regex auf Uhrzeit am Ende des Item-Namens
        const match = nameStr.match(/[:\s-]*(\d{1,2}:\s*\d{2}(?::\s*\d{2})?)\s*$/);
        if (match) {
          const rawTime = match[1];
          cleanTime = rawTime.replace(/\s+/g, '');
          newVideoUrl = updateVideoUrlTimestamp(row.video_url, cleanTime);
          nameStr = nameStr.replace(/[:\s-]*\d{1,2}:\s*\d{2}(?::\s*\d{2})?\s*$/, '').trim();
          isModified = true;
        }

        // b) Zeilen mit item_name === '<Untitled Chapter...>' werden sauber in "Start" umbenannt
        if (/^<Untitled Chapter.*>/i.test(nameStr)) {
          nameStr = 'Start';
          isModified = true;
        }

        if (isModified) {
          modifiedRows.push(row);
          patchesMap.set(row.id, {
            item_name: formatFieldValueForTable(row, 'item_name', nameStr),
            timestamp: cleanTime,
            video_url: newVideoUrl,
          });
        }
      }

      if (modifiedRows.length > 0) {
        await persistRowPatchesToSupabase(modifiedRows, (row) => patchesMap.get(row.id));
      }

      setNotice(
        `Bereinigung abgeschlossen: ${modifiedRows.length} Zeilen in Items bereinigt / umbenannt.`
      );
    } catch (err) {
      setError(`Fehler bei der Bereinigung: ${err.message}`);
    } finally {
      setActionBusy(false);
    }
  };

  // 8. Trophy ID zuweisen
  const handleAssignTrophyToActiveRow = (trophyId) => {
    if (!activeRowId) return;
    const numericId = extractNumericTrophyId(trophyId);
    handleUpdateRowField(activeRowId, 'trophy_id', numericId);
    handleUpdateRowField(activeRowId, 'is_trophy_relevant', 'ja');
  };

  // --- TROPHÄEN-SCHNELL-PICKER & AUTO-MATCHER ("JUST DO IT") ---

  // Aufbereitete Trophäen mit numerischer ID & normalisierten Texten für Matching
  const normalizedTrophies = useMemo(() => {
    return (gameTrophies ?? []).map((ach, idx) => {
      const rawAchId = ach.platform_achievement_id ?? ach.id ?? '';
      const numericId = extractNumericTrophyId(rawAchId, idx + 1);
      const nameDe = getLocalizedTrophyName(ach.trophy_name, 'de');
      const nameEn = getLocalizedTrophyName(ach.trophy_name, 'en');
      const displayName =
        getLocalizedTrophyName(ach.trophy_name, trophyLang) || String(rawAchId);
      const descDe = getLocalizedTrophyDesc(ach.trophy_desc ?? ach.trophy_description, 'de');
      const descEn = getLocalizedTrophyDesc(ach.trophy_desc ?? ach.trophy_description, 'en');
      const displayDesc = getLocalizedTrophyDesc(ach.trophy_desc ?? ach.trophy_description, trophyLang);

      return {
        raw: ach,
        rawAchId: String(rawAchId),
        numericId,
        displayName: String(displayName || '').trim(),
        displayDesc: String(displayDesc || '').trim(),
        normDe: normalizeForMatch(nameDe),
        normEn: normalizeForMatch(nameEn),
        normDescDe: normalizeForMatch(descDe),
        normDescEn: normalizeForMatch(descEn),
        iconUrl:
          typeof ach.icon_url === 'object' && ach.icon_url !== null
            ? ach.icon_url.de || ach.icon_url.en || Object.values(ach.icon_url)[0] || ''
            : ach.icon_url || '',
        trophyType: ach.trophy_type || 'bronze',
      };
    });
  }, [gameTrophies, trophyLang]);

  // Prüft eine Guide-Zeile auf 100%-Match ("Just Do It") gegen alle Trophäen
  const findExactTrophyMatchForItem = useCallback(
    (itemNameRaw) => {
      const itemNorm = normalizeForMatch(itemNameRaw);
      if (!itemNorm || normalizedTrophies.length === 0) return null;

      // a) 100% exakte Übereinstimmung mit normDe oder normEn (muss eindeutig sein)
      const exactMatches = normalizedTrophies.filter(
        (t) =>
          (t.normDe && t.normDe === itemNorm) ||
          (t.normEn && t.normEn === itemNorm)
      );
      if (exactMatches.length === 1) {
        return exactMatches[0];
      }

      // b) Normalisierter Trophäenname >= 5 Zeichen lang und eindeutig als ganzes Wort im item_name enthalten
      const containedMatches = normalizedTrophies.filter((t) => {
        const matchDe = t.normDe && t.normDe.length >= 5 && isWholeWordContained(itemNorm, t.normDe);
        const matchEn = t.normEn && t.normEn.length >= 5 && isWholeWordContained(itemNorm, t.normEn);
        return matchDe || matchEn;
      });
      if (containedMatches.length === 1) {
        return containedMatches[0];
      }

      return null;
    },
    [normalizedTrophies]
  );

  // Prüft auf Fuzzy-Vorschlag (Teil-Übereinstimmung über trophy_name oder trophy_desc)
  const findFuzzyTrophySuggestion = useCallback(
    (itemNameRaw, chronoGroupRaw) => {
      const itemNorm = normalizeForMatch(itemNameRaw);
      const groupNorm = normalizeForMatch(chronoGroupRaw);
      const combinedNorm = `${itemNorm} ${groupNorm}`.trim();
      if (!combinedNorm || normalizedTrophies.length === 0) return null;

      const tokens = combinedNorm
        .split(' ')
        .filter((w) => w.length >= 4);

      let bestTrophy = null;
      let bestScore = 0;

      for (const t of normalizedTrophies) {
        let score = 0;

        // Teil-Substring im Namen
        if (itemNorm.length >= 4) {
          if ((t.normDe && (t.normDe.includes(itemNorm) || itemNorm.includes(t.normDe))) ||
              (t.normEn && (t.normEn.includes(itemNorm) || itemNorm.includes(t.normEn)))) {
            score += 5;
          }
        }
        if (groupNorm.length >= 4) {
          if ((t.normDe && (t.normDe.includes(groupNorm) || groupNorm.includes(t.normDe))) ||
              (t.normEn && (t.normEn.includes(groupNorm) || groupNorm.includes(t.normEn)))) {
            score += 4;
          }
        }

        // Token-Treffer in Name oder Beschreibung
        for (const token of tokens) {
          if ((t.normDe && t.normDe.includes(token)) || (t.normEn && t.normEn.includes(token))) {
            score += 3;
          } else if (
            (t.normDescDe && t.normDescDe.includes(token)) ||
            (t.normDescEn && t.normDescEn.includes(token))
          ) {
            score += 2;
          }
        }

        if (score > bestScore) {
          bestScore = score;
          bestTrophy = t;
        }
      }

      return bestScore >= 3 ? bestTrophy : null;
    },
    [normalizedTrophies]
  );

  // Führt den "Just Do It" Auto-Matcher für alle offenen Zeilen aus
  const runJustDoItAutoMatcher = useCallback(
    async (isManualClick = false) => {
      if (!currentCreatorRows.length || !normalizedTrophies.length) {
        if (isManualClick) {
          setNotice('⚡ Auto-Match: Keine passenden offenen Zeilen oder Trophäen gefunden.');
        }
        return 0;
      }

      const unassignedRows = currentCreatorRows.filter(
        (r) => r.trophy_id == null || String(r.trophy_id).trim() === ''
      );

      if (unassignedRows.length === 0) {
        if (isManualClick) {
          setNotice('⚡ Alle Zeilen haben bereits eine trophy_id!');
        }
        return 0;
      }

      const matchedRows = [];
      const matchedTrophyById = new Map();

      for (const row of unassignedRows) {
        const itemStr = getLocalizedItemName(row.item_name);
        const matchedTrophy = findExactTrophyMatchForItem(itemStr);
        if (matchedTrophy) {
          matchedRows.push(row);
          matchedTrophyById.set(row.id, matchedTrophy.numericId);
        }
      }

      if (matchedRows.length === 0) {
        if (isManualClick) {
          setNotice('⚡ Auto-Match: Keine neuen 100%-Übereinstimmungen gefunden.');
        }
        return 0;
      }

      try {
        await persistRowPatchesToSupabase(matchedRows, (row) => {
          const numId = matchedTrophyById.get(row.id);
          return {
            trophy_id: formatFieldValueForTable(row, 'trophy_id', numId),
            is_trophy_relevant: 'ja',
          };
        });

        setAutoMatchedBannerCount((prev) => prev + matchedRows.length);
        setNotice(`⚡ ${matchedRows.length} Zeilen automatisch zu 100% verknüpft`);
        return matchedRows.length;
      } catch (err) {
        console.error('Fehler beim Auto-Match:', err);
        if (isManualClick) {
          setError(`Auto-Match fehlgeschlagen: ${err.message}`);
        }
        return 0;
      }
    },
    [
      currentCreatorRows,
      normalizedTrophies,
      findExactTrophyMatchForItem,
      persistRowPatchesToSupabase,
      formatFieldValueForTable,
    ]
  );

  // Automatischer "Just Do It" Lauf sobald ein Spiel-Entwurf + Trophäen geladen sind
  useEffect(() => {
    if (!selectedGameId || !selectedCreatorName || loading || loadingTrophies) {
      return;
    }

    const sessionKey = `${activeDataSource}::${selectedGameId}::${selectedCreatorName}`;
    if (autoMatchedKeysRef.current.has(sessionKey)) return;
    if (currentCreatorRows.length === 0 || normalizedTrophies.length === 0) return;
    autoMatchedKeysRef.current.add(sessionKey);

    runJustDoItAutoMatcher(false);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [
    selectedGameId,
    selectedCreatorName,
    activeDataSource,
    loading,
    loadingTrophies,
  ]);

  // Anzahl offener Zeilen ohne trophy_id
  const openUnassignedRowCount = useMemo(() => {
    return currentCreatorRows.filter(
      (r) => r.trophy_id == null || String(r.trophy_id).trim() === ''
    ).length;
  }, [currentCreatorRows]);

  // Bereits vergebene numerische Trophy-IDs im aktuellen Entwurf
  const assignedNumericTrophyIds = useMemo(() => {
    const set = new Set();
    for (const r of currentCreatorRows) {
      if (r.trophy_id != null && String(r.trophy_id).trim() !== '') {
        const num = extractNumericTrophyId(r.trophy_id, -1);
        if (num > 0) set.add(num);
      }
    }
    return set;
  }, [currentCreatorRows]);

  // Smart Grouping für die linke/obere Spalte des Trophäen-Schnell-Pickers (alphabetisch A-Z)
  const matcherSmartGroups = useMemo(() => {
    const sourceRows =
      matcherItemFilter === 'open'
        ? currentCreatorRows.filter((r) => r.trophy_id == null || String(r.trophy_id).trim() === '')
        : currentCreatorRows;

    if (sourceRows.length === 0) return [];

    // Zähle Häufigkeit von normalisiertem item_name und chronological_group
    const itemNormCounts = new Map();
    const chronoNormCounts = new Map();

    for (const r of sourceRows) {
      const iNorm = normalizeForMatch(getLocalizedItemName(r.item_name));
      const cRaw = getLocalizedItemName(r.chronological_group).trim();
      const cNorm = normalizeForMatch(cRaw);
      if (iNorm) itemNormCounts.set(iNorm, (itemNormCounts.get(iNorm) || 0) + 1);
      if (cNorm) chronoNormCounts.set(cNorm, (chronoNormCounts.get(cNorm) || 0) + 1);
    }

    const groupsMap = new Map();

    for (const row of sourceRows) {
      const itemStr = getLocalizedItemName(row.item_name).trim() || '(Unbenannt)';
      const chronoStr = getLocalizedItemName(row.chronological_group).trim();
      const iNorm = normalizeForMatch(itemStr);
      const cNorm = normalizeForMatch(chronoStr);

      let groupKey = `row_${row.id}`;
      let groupLabel = itemStr;
      let groupKind = 'single';

      if (iNorm && (itemNormCounts.get(iNorm) || 0) > 1) {
        groupKey = `item_${iNorm}`;
        groupLabel = itemStr.replace(/[:\s#-]*\d+\s*$/, '').trim() || itemStr;
        groupKind = 'item_norm';
      } else if (cNorm && (chronoNormCounts.get(cNorm) || 0) > 1) {
        groupKey = `chrono_${cNorm}`;
        groupLabel = chronoStr;
        groupKind = 'chrono_group';
      }

      if (!groupsMap.has(groupKey)) {
        groupsMap.set(groupKey, {
          key: groupKey,
          label: groupLabel,
          kind: groupKind,
          rows: [],
          sampleItemName: itemStr,
          sampleChrono: chronoStr,
        });
      }
      groupsMap.get(groupKey).rows.push(row);
    }

    const result = [];
    for (const g of groupsMap.values()) {
      const assignedIds = [
        ...new Set(
          g.rows
            .map((r) => (r.trophy_id != null && String(r.trophy_id).trim() !== '' ? Number(r.trophy_id) : null))
            .filter((v) => v != null)
        ),
      ];
      const isOpen = g.rows.some((r) => r.trophy_id == null || String(r.trophy_id).trim() === '');
      const suggestion = isOpen
        ? findFuzzyTrophySuggestion(g.sampleItemName, g.sampleChrono)
        : null;

      result.push({
        ...g,
        count: g.rows.length,
        isGrouped: g.rows.length > 1,
        isOpen,
        assignedIds,
        suggestion,
      });
    }

    // Alphabetisch A-Z sortieren
    result.sort((a, b) => a.label.localeCompare(b.label, 'de', { numeric: true }));
    return result;
  }, [currentCreatorRows, matcherItemFilter, findFuzzyTrophySuggestion]);

  // Automatische Vorauswahl des obersten offenen Items im Trophäen-Schnell-Picker
  useEffect(() => {
    if (!showTrophyMatcher) return;
    if (matcherSmartGroups.length === 0) {
      setMatcherActiveGroupKey(null);
      return;
    }
    const stillExists = matcherSmartGroups.some((g) => g.key === matcherActiveGroupKey);
    if (!matcherActiveGroupKey || !stillExists) {
      const firstOpen = matcherSmartGroups.find((g) => g.isOpen) || matcherSmartGroups[0];
      setMatcherActiveGroupKey(firstOpen ? firstOpen.key : null);
    }
  }, [showTrophyMatcher, matcherSmartGroups, matcherActiveGroupKey]);

  // Alphabetisch sortierte (A-Z) und gefilterte Trophäen für die rechte/untere Spalte
  const matcherVisibleTrophies = useMemo(() => {
    let list = [...normalizedTrophies];

    if (matcherHideAssignedTrophies) {
      list = list.filter((t) => !assignedNumericTrophyIds.has(t.numericId));
    }

    if (matcherTrophySearch.trim()) {
      const q = matcherTrophySearch.toLowerCase().trim();
      list = list.filter(
        (t) =>
          t.displayName.toLowerCase().includes(q) ||
          t.displayDesc.toLowerCase().includes(q) ||
          String(t.numericId).includes(q) ||
          t.rawAchId.toLowerCase().includes(q)
      );
    }

    list.sort((a, b) => a.displayName.localeCompare(b.displayName, 'de', { numeric: true }));
    return list;
  }, [normalizedTrophies, matcherHideAssignedTrophies, assignedNumericTrophyIds, matcherTrophySearch]);

  // 1-Tap-Zuweisung für ein Item / eine Smart-Group und automatisches Weiterspringen zum nächsten offenen Item
  const handleMatcherAssignTrophyToGroup = useCallback(
    async (targetGroup, numericTrophyId) => {
      if (!targetGroup || !targetGroup.rows?.length || actionBusy) return;

      // Bestimme vorab das nächste offene Item in der Liste
      const currentIdx = matcherSmartGroups.findIndex((g) => g.key === targetGroup.key);
      let nextGroupKey = null;
      for (let i = currentIdx + 1; i < matcherSmartGroups.length; i += 1) {
        if (matcherSmartGroups[i].isOpen && matcherSmartGroups[i].key !== targetGroup.key) {
          nextGroupKey = matcherSmartGroups[i].key;
          break;
        }
      }
      if (!nextGroupKey) {
        for (let i = 0; i < currentIdx; i += 1) {
          if (matcherSmartGroups[i].isOpen && matcherSmartGroups[i].key !== targetGroup.key) {
            nextGroupKey = matcherSmartGroups[i].key;
            break;
          }
        }
      }

      try {
        await persistRowPatchesToSupabase(targetGroup.rows, (row) => ({
          trophy_id: formatFieldValueForTable(row, 'trophy_id', numericTrophyId),
          is_trophy_relevant: 'ja',
        }));

        setMatcherActiveGroupKey(nextGroupKey);
      } catch (err) {
        setError(`Zuweisung fehlgeschlagen: ${err.message}`);
      }
    },
    [actionBusy, matcherSmartGroups, persistRowPatchesToSupabase, formatFieldValueForTable]
  );

  // 8b. IDs neu durchnummerieren (1..N) in aktueller Sortierreihenfolge
  const handleRenumberGuideIds = async () => {
    if (!currentCreatorRows.length || actionBusy) return;

    setActionBusy(true);
    setError('');
    setNotice('');

    try {
      const indexById = new Map();
      currentCreatorRows.forEach((row, index) => {
        indexById.set(row.id, index + 1);
      });

      await persistRowPatchesToSupabase(currentCreatorRows, (row) => ({
        guide_id: formatFieldValueForTable(row, 'guide_id', indexById.get(row.id)),
      }));

      setSortField('guide_id');
      setSortDirection('asc');
      setNotice(`🔢 ${currentCreatorRows.length} Zeilen erfolgreich neu durchnummeriert (1..${currentCreatorRows.length}).`);
    } catch (err) {
      setError(`Fehler beim Neu-Nummerieren: ${err.message}`);
    } finally {
      setActionBusy(false);
    }
  };

  // 8c. Suchen & Ersetzen Logik (inkl. category_group)
  const searchReplacePreview = useMemo(() => {
    if (!searchQuery || !currentCreatorRows.length) {
      return { matchCount: 0, matchedRows: [], regexError: null };
    }

    let regex = null;
    try {
      const flags = caseSensitive ? 'g' : 'gi';
      const pattern = useRegex
        ? searchQuery
        : searchQuery.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      regex = new RegExp(pattern, flags);
    } catch (err) {
      return { matchCount: 0, matchedRows: [], regexError: err.message };
    }

    const targetFields =
      searchTargetField === 'all'
        ? ['item_name', 'spiel_region', 'chronological_group', 'category_group', 'boss_group', 'video_chapter', 'prod_note']
        : [searchTargetField];

    const matchedRows = [];

    for (const row of currentCreatorRows) {
      let rowMatched = false;
      const newFields = {};

      for (const field of targetFields) {
        const rawVal = row[field];
        const currentStr = getLocalizedItemName(rawVal);
        if (!currentStr) continue;

        regex.lastIndex = 0;
        if (regex.test(currentStr)) {
          rowMatched = true;
          regex.lastIndex = 0;
          const replacedStr = currentStr.replace(regex, replaceValue);
          newFields[field] = formatFieldValueForTable(row, field, replacedStr);
        }
      }

      if (rowMatched) {
        matchedRows.push({ row, id: row.id, updates: newFields });
      }
    }

    return {
      matchCount: matchedRows.length,
      matchedRows,
      regexError: null,
    };
  }, [searchQuery, replaceValue, searchTargetField, useRegex, caseSensitive, currentCreatorRows, formatFieldValueForTable]);

  const handleApplySearchReplace = async () => {
    const { matchedRows, matchCount, regexError } = searchReplacePreview;
    if (!matchCount || regexError || actionBusy) return;

    setActionBusy(true);
    setError('');
    setNotice('');

    try {
      const updatesById = new Map(matchedRows.map((m) => [m.id, m.updates]));
      await persistRowPatchesToSupabase(
        matchedRows.map((m) => m.row),
        (row) => updatesById.get(row.id)
      );

      setNotice(`🔄 Suchen & Ersetzen in ${matchCount} Zeilen erfolgreich angewendet.`);
    } catch (err) {
      setError(`Fehler bei Suchen & Ersetzen: ${err.message}`);
    } finally {
      setActionBusy(false);
    }
  };

  // 8c-b. Suchfelder leeren (KEIN DB-Delete!)
  const handleClearSearchReplaceInputs = () => {
    setSearchQuery('');
    setReplaceValue('');
  };

  // Titel via RPC tb_search_games_trophies_only, NPWR über platform_game_id-Containment.
  const searchGamesByTitleOrNpwr = async (raw) => {
    const words = String(raw ?? '')
      .split(/\s+/)
      .map((word) => word.trim())
      .filter(Boolean);
    const merged = [];
    const seen = new Set();
    const pushGame = (game) => {
      if (!game?.id || seen.has(game.id)) return;
      seen.add(game.id);
      merged.push(game);
    };

    const npwrMatch = String(raw ?? '').match(/NPWR\d+_\d+/i);
    if (npwrMatch) {
      const npwr = npwrMatch[0].toUpperCase();
      const { data: npwrRows, error: npwrErr } = await supabase
        .from(TABLES.games)
        .select(GAMES_QUEUE_SELECT_COLS)
        .contains('platform_game_id', JSON.stringify([npwr]))
        .limit(15);
      if (npwrErr) throw new Error(npwrErr.message);
      for (const game of npwrRows ?? []) pushGame(game);
    }

    if (words.length > 0) {
      const { data, error: rpcErr } = await supabase.rpc('tb_search_games_trophies_only', {
        p_words: words,
        p_limit: 15,
      });
      if (rpcErr) throw new Error(rpcErr.message);
      const list = Array.isArray(data) ? data : [];
      for (const game of list) pushGame(game);
    }

    return merged.slice(0, 15);
  };

  // 8c-c. Zielspiel für verrutschte Creator-Zuordnung suchen (Titel via RPC, NPWR via Containment)
  const handleSearchReassignGames = async (event) => {
    if (event) event.preventDefault();
    const raw = reassignQuery.trim();
    if (!raw || reassignSearching) return;

    setReassignSearching(true);
    setReassignSearchDone(false);
    setError('');

    try {
      setReassignResults(await searchGamesByTitleOrNpwr(raw));
      setReassignSearchDone(true);
    } catch (err) {
      setReassignResults([]);
      setReassignSearchDone(true);
      setError(`Spielsuche fehlgeschlagen: ${err.message}`);
    } finally {
      setReassignSearching(false);
    }
  };

  const handleSearchBatchTransferGames = async (event) => {
    if (event) event.preventDefault();
    const raw = batchTransferQuery.trim();
    if (!raw || batchTransferSearching) return;

    setBatchTransferSearching(true);
    setError('');
    try {
      setBatchTransferResults(await searchGamesByTitleOrNpwr(raw));
    } catch (err) {
      setBatchTransferResults([]);
      setError(`Spielsuche fehlgeschlagen: ${err.message}`);
    } finally {
      setBatchTransferSearching(false);
    }
  };

  const fetchMaxGuideIdForGame = async (tableName, gameId) => {
    let maxId = 0;
    let from = 0;
    for (;;) {
      const { data, error } = await supabase
        .from(tableName)
        .select('guide_id')
        .eq('game_id', gameId)
        .range(from, from + 999);
      if (error) throw new Error(`${tableName}: ${error.message}`);
      const page = data ?? [];
      for (const row of page) {
        const n = parseGuideIdNumber(row.guide_id);
        if (n > maxId) maxId = n;
      }
      if (page.length < 1000) break;
      from += 1000;
    }
    return maxId;
  };

  const insertGuideRows = async (tableName, payloads) => {
    const inserted = [];
    const CHUNK = 80;
    for (let i = 0; i < payloads.length; i += CHUNK) {
      const chunk = payloads.slice(i, i + CHUNK);
      const { data, error } = await supabase.from(tableName).insert(chunk).select('*');
      if (error) throw new Error(`${tableName}: ${error.message}`);
      const rows = data ?? [];
      if (rows.length !== chunk.length) {
        throw new Error(`${tableName}: Insert lieferte ${rows.length} von ${chunk.length} Zeilen zurück.`);
      }
      for (const row of rows) inserted.push({ ...row, _sourceTable: tableName });
    }
    return inserted;
  };

  // Kopie ohne id / _sourceTable. Staging bleibt flach (guide_id integer), Rohmaterial jsonb (guide_id text).
  const buildGuideRowClonePayload = (row, { gameId, platformGameId, guideId, itemName }) => {
    const table = row._sourceTable || 'staging_game_guides';
    const isRoh = table === TABLES.guidesRohmaterial;
    const trophyDigits = String(row.trophy_id ?? '').replace(/\D/g, '');
    const nextItem =
      itemName != null ? formatFieldValueForTable(row, 'item_name', itemName) : row.item_name;

    if (isRoh) {
      return {
        game_id: gameId ?? row.game_id,
        platform_game_id: platformGameId ?? row.platform_game_id,
        creator_id: row.creator_id ?? null,
        creator_name: row.creator_name ?? null,
        playlist_url: row.playlist_url ?? row.creator_input_url ?? row.video_url ?? null,
        batch_key: row.batch_key ?? null,
        batch_status: row.batch_status ?? null,
        sheet_type: Array.isArray(row.sheet_type) ? row.sheet_type : deriveSheetTypesFromRow(row),
        guide_id: String(guideId),
        item_name: nextItem ?? null,
        spiel_region: formatFieldValueForTable(
          { ...row, _sourceTable: TABLES.guidesRohmaterial },
          'spiel_region',
          getLocalizedItemName(row.spiel_region),
        ),
        spiel_region_tab: formatFieldValueForTable(row, 'spiel_region_tab', row.spiel_region_tab),
        chronological_group: row.chronological_group ?? null,
        category_group: row.category_group ?? null,
        boss_group: row.boss_group ?? null,
        video_chapter: row.video_chapter ?? null,
        timestamp: row.timestamp ?? null,
        video_url: row.video_url ?? null,
        trophy_id: trophyDigits ? String(Number.parseInt(trophyDigits, 10)) : null,
        is_trophy_relevant: row.is_trophy_relevant ?? null,
      };
    }

    return {
      game_id: gameId ?? row.game_id,
      platform_game_id: String(platformGameId ?? row.platform_game_id ?? ''),
      creator_id: row.creator_id ?? null,
      creator_name: row.creator_name || 'Unbekannt',
      creator_input_url: row.creator_input_url ?? null,
      guide_id: Number(guideId),
      chronological_group: formatFieldValueForTable(
        row,
        'chronological_group',
        getLocalizedItemName(row.chronological_group),
      ),
      category_group: formatFieldValueForTable(
        row,
        'category_group',
        getLocalizedItemName(row.category_group),
      ),
      boss_group: formatFieldValueForTable(
        row,
        'boss_group',
        getLocalizedItemName(row.boss_group),
      ),
      spiel_region: formatFieldValueForTable(
        row,
        'spiel_region',
        getLocalizedItemName(row.spiel_region),
      ),
      spiel_region_tab: formatFieldValueForTable(row, 'spiel_region_tab', row.spiel_region_tab),
      video_chapter: formatFieldValueForTable(
        row,
        'video_chapter',
        getLocalizedItemName(row.video_chapter),
      ),
      item_name: typeof nextItem === 'string' ? nextItem : String(nextItem ?? ''),
      timestamp: row.timestamp ?? null,
      video_url: row.video_url || '',
      prod_note: row.prod_note ?? null,
      trophy_id: trophyDigits ? Number.parseInt(trophyDigits, 10) : null,
      is_trophy_relevant: row.is_trophy_relevant ?? null,
      ...(row.workflow_status ? { workflow_status: row.workflow_status } : {}),
    };
  };

  const markTargetRohmaterialPending = async (targetGame) => {
    const targetGameId = targetGame.id;
    const { data: currentGameData, error: readErr } = await supabase
      .from(TABLES.games)
      .select(GAME_STRUCT.status)
      .eq(GAME_PK, targetGameId)
      .maybeSingle();
    if (readErr) {
      return { status: targetGame.status, warning: `status.rohmaterial lesen fehlgeschlagen: ${readErr.message}` };
    }
    const nextStatus = {
      ...parseStatusMap(currentGameData?.[GAME_STRUCT.status] ?? targetGame.status),
      rohmaterial: 'PENDING_MULTI_TAB',
    };
    const { error: statusUpErr } = await supabase
      .from(TABLES.games)
      .update({ [GAME_STRUCT.status]: nextStatus })
      .eq(GAME_PK, targetGameId);
    if (statusUpErr) {
      return {
        status: targetGame.status,
        warning: `status.rohmaterial setzen fehlgeschlagen: ${statusUpErr.message}`,
      };
    }
    return { status: nextStatus, warning: '' };
  };

  // 8c-d. Aktuellen Creator-Entwurf an ein anderes Spiel hängen
  const handleReassignCreatorToGame = async (targetGame) => {
    if (!targetGame?.id || !selectedGameId || !selectedCreatorName || actionBusy) return;

    const targetGameId = targetGame.id;
    if (targetGameId === selectedGameId) {
      setNotice('Dieses Spiel ist bereits die aktuelle Zuordnung.');
      return;
    }

    const rowsToMove = currentCreatorRows.filter((row) => {
      const sourceTable = row._sourceTable || 'staging_game_guides';
      return sourceTable === 'staging_game_guides' || sourceTable === TABLES.guidesRohmaterial;
    });

    if (rowsToMove.length === 0) {
      setError('Für diesen Creator gibt es keine Entwurfszeilen, die umgehängt werden können.');
      return;
    }

    const targetNpwr = resolveDraftPlatformGameId(targetGame);
    if (!targetNpwr) {
      setError('Zielspiel hat keine platform_game_id.');
      return;
    }

    setActionBusy(true);
    setError('');
    setNotice('');

    const sourceGameId = selectedGameId;

    try {
      const idsByTable = new Map();
      for (const row of rowsToMove) {
        const sourceTable = row._sourceTable || 'staging_game_guides';
        const list = idsByTable.get(sourceTable) || [];
        list.push(row.id);
        idsByTable.set(sourceTable, list);
      }

      for (const [tableName, ids] of idsByTable.entries()) {
        const CHUNK_SIZE = 100;
        for (let i = 0; i < ids.length; i += CHUNK_SIZE) {
          const chunkIds = ids.slice(i, i + CHUNK_SIZE);
          const { error: upErr } = await supabase
            .from(tableName)
            .update({
              game_id: targetGameId,
              platform_game_id: targetNpwr,
            })
            .in('id', chunkIds);
          if (upErr) {
            throw new Error(`${tableName}: ${upErr.message}`);
          }
        }
      }

      let nextStatus = targetGame.status;
      let statusWarning = '';
      if (activeDataSource === 'rohmaterial') {
        const { data: currentGameData, error: readErr } = await supabase
          .from(TABLES.games)
          .select(GAME_STRUCT.status)
          .eq(GAME_PK, targetGameId)
          .maybeSingle();
        if (readErr) {
          statusWarning = `status.rohmaterial lesen fehlgeschlagen: ${readErr.message}`;
        } else {
          nextStatus = {
            ...parseStatusMap(currentGameData?.[GAME_STRUCT.status] ?? targetGame.status),
            rohmaterial: 'PENDING_MULTI_TAB',
          };
          const { error: statusUpErr } = await supabase
            .from(TABLES.games)
            .update({ [GAME_STRUCT.status]: nextStatus })
            .eq(GAME_PK, targetGameId);
          if (statusUpErr) {
            statusWarning = `status.rohmaterial setzen fehlgeschlagen: ${statusUpErr.message}`;
            nextStatus = targetGame.status;
          }
        }
      }

      const targetGameForMap = {
        ...targetGame,
        id: targetGameId,
        status: nextStatus,
      };
      const movedIds = new Set(rowsToMove.map((row) => row.id));
      const patchRow = (row) =>
        movedIds.has(row.id)
          ? { ...row, game_id: targetGameId, platform_game_id: targetNpwr }
          : row;

      setStagingRows((prev) => prev.map(patchRow));
      setRohmaterialRows((prev) => prev.map(patchRow));
      setGamesMap((prev) => {
        const next = new Map(prev);
        next.set(targetGameId, { ...(next.get(targetGameId) || {}), ...targetGameForMap });
        return next;
      });

      const movedRohCount = rowsToMove.filter(
        (row) => row._sourceTable === TABLES.guidesRohmaterial
      ).length;
      if (movedRohCount > 0) {
        setRohGamesMap((prev) => {
          const next = new Map(prev);
          next.set(targetGameId, { ...(next.get(targetGameId) || {}), ...targetGameForMap });
          return next;
        });
        const sourceCount = rohmaterialRows.filter(
          (row) => row.game_id === sourceGameId && !movedIds.has(row.id)
        ).length;
        const targetCount =
          rohmaterialRows.filter((row) => row.game_id === targetGameId).length + movedRohCount;
        setRohmaterialGames((prev) => {
          const next = prev
            .map((item) => {
              if (item.gameId !== sourceGameId) return item;
              return { ...item, rowCount: sourceCount };
            })
            .filter((item) => item.gameId !== sourceGameId || sourceCount > 0);

          const targetTitle = getLocalizedTitle(targetGame.spieltitel);
          const existing = next.find((item) => item.gameId === targetGameId);
          if (existing) {
            return next.map((item) =>
              item.gameId === targetGameId
                ? {
                    ...item,
                    game: { ...item.game, ...targetGameForMap },
                    title: targetTitle,
                    platformGameId: targetNpwr,
                    coverUrl: getLocalizedCover(targetGame.cover_url) || item.coverUrl,
                    rowCount: targetCount,
                    statusRohmaterial: 'PENDING_MULTI_TAB',
                  }
                : item
            );
          }

          return [
            {
              gameId: targetGameId,
              game: targetGameForMap,
              title: targetTitle,
              platformGameId: targetNpwr,
              coverUrl: getLocalizedCover(targetGame.cover_url),
              creatorCount: 1,
              creatorList: selectedCreatorName ? [selectedCreatorName] : [],
              batchList: [],
              rowCount: targetCount,
              statusRohmaterial: 'PENDING_MULTI_TAB',
            },
            ...next,
          ];
        });
      }

      setShowReassignGame(false);
      setReassignQuery('');
      setReassignResults([]);
      setReassignSearchDone(false);
      setSelectedGameId(targetGameId);
      setNotice(
        `✓ Entwurf (${currentCreatorRows.length} Zeilen) erfolgreich zu "${getLocalizedTitle(targetGame.spieltitel)}" verschoben!`
      );
      if (statusWarning) {
        setError(`Zeilen sind verschoben, aber ${statusWarning}`);
      }
    } catch (err) {
      setError(`Spiel-Zuordnung ändern fehlgeschlagen: ${err.message}`);
    } finally {
      setActionBusy(false);
    }
  };

  // Markierte Zeilen eines Creators auf ein anderes Spiel verschieben oder duplizieren.
  const handleBatchTransferRowsToGame = async (targetGame, mode) => {
    if (!targetGame?.id || !selectedGameId || actionBusy) return;
    if (mode !== 'move' && mode !== 'duplicate') return;

    const targetGameId = targetGame.id;
    if (targetGameId === selectedGameId) {
      setNotice('Dieses Spiel ist bereits die aktuelle Zuordnung.');
      return;
    }

    const rowsToProcess = currentCreatorRows.filter((row) => selectedRowIds.has(row.id));
    if (rowsToProcess.length === 0) {
      setError('Keine markierten Zeilen zum Übertragen.');
      return;
    }

    const targetNpwr = resolveDraftPlatformGameId(targetGame);
    if (!targetNpwr) {
      setError('Zielspiel hat keine platform_game_id.');
      return;
    }

    const rowsByTable = new Map();
    for (const row of rowsToProcess) {
      const tableName = row._sourceTable || 'staging_game_guides';
      if (!isEditableDraftTable(tableName)) continue;
      const list = rowsByTable.get(tableName) || [];
      list.push(row);
      rowsByTable.set(tableName, list);
    }
    if (rowsByTable.size === 0) {
      setError('Die markierten Zeilen liegen nicht in staging_game_guides oder game_guides_rohmaterial.');
      return;
    }

    setActionBusy(true);
    setError('');
    setNotice('');

    const sourceGameId = selectedGameId;
    const targetTitle = getLocalizedTitle(targetGame.spieltitel);

    try {
      let statusWarning = '';
      let nextStatus = targetGame.status;
      const touchedRoh = rowsByTable.has(TABLES.guidesRohmaterial);
      const insertedByTable = new Map();

      if (mode === 'move') {
        for (const [tableName, rows] of rowsByTable.entries()) {
          const ids = rows.map((row) => row.id);
          const CHUNK_SIZE = 100;
          for (let i = 0; i < ids.length; i += CHUNK_SIZE) {
            const chunkIds = ids.slice(i, i + CHUNK_SIZE);
            const { error: upErr } = await supabase
              .from(tableName)
              .update({ game_id: targetGameId, platform_game_id: targetNpwr })
              .in('id', chunkIds);
            if (upErr) throw new Error(`${tableName}: ${upErr.message}`);
          }
        }
      } else {
        for (const [tableName, rows] of rowsByTable.entries()) {
          const maxTargetGuideId = await fetchMaxGuideIdForGame(tableName, targetGameId);
          const payloads = rows.map((row, index) =>
            buildGuideRowClonePayload(row, {
              gameId: targetGameId,
              platformGameId: targetNpwr,
              guideId: maxTargetGuideId + index + 1,
            }),
          );
          const inserted = await insertGuideRows(tableName, payloads);
          insertedByTable.set(tableName, inserted);
        }
      }

      if (touchedRoh) {
        const pending = await markTargetRohmaterialPending(targetGame);
        nextStatus = pending.status;
        statusWarning = pending.warning;
      }

      const targetGameForMap = { ...targetGame, id: targetGameId, status: nextStatus };
      const transferredRows = [...rowsByTable.values()].flat();
      const movedIds = new Set(transferredRows.map((row) => row.id));

      if (mode === 'move') {
        const patchRow = (row) =>
          movedIds.has(row.id)
            ? { ...row, game_id: targetGameId, platform_game_id: targetNpwr }
            : row;
        setStagingRows((prev) => prev.map(patchRow));
        setRohmaterialRows((prev) => prev.map(patchRow));

        const toRenumber = [];
        const indexById = new Map();
        const remainingByCreator = new Map();
        for (const row of currentGameRows) {
          if (movedIds.has(row.id)) continue;
          if (!isEditableDraftTable(row._sourceTable || 'staging_game_guides')) continue;
          const key = creatorKeyOfRow(row);
          const list = remainingByCreator.get(key) || [];
          list.push(row);
          remainingByCreator.set(key, list);
        }
        for (const rows of remainingByCreator.values()) {
          const sorted = [...rows].sort(
            (a, b) => parseGuideIdNumber(a.guide_id) - parseGuideIdNumber(b.guide_id) || String(a.id).localeCompare(String(b.id)),
          );
          sorted.forEach((row, index) => {
            indexById.set(row.id, index + 1);
            toRenumber.push(row);
          });
        }
        if (toRenumber.length > 0) {
          await persistRowPatchesToSupabase(toRenumber, (row) => ({
            guide_id: formatFieldValueForTable(row, 'guide_id', indexById.get(row.id)),
          }));
        }
      } else {
        const stagingInserted = insertedByTable.get('staging_game_guides') || [];
        const rohInserted = insertedByTable.get(TABLES.guidesRohmaterial) || [];
        if (stagingInserted.length > 0) {
          setStagingRows((prev) => prev.concat(stagingInserted));
        }
        if (rohInserted.length > 0) {
          setRohmaterialRows((prev) => prev.concat(rohInserted));
        }
      }

      setGamesMap((prev) => {
        const next = new Map(prev);
        next.set(targetGameId, { ...(next.get(targetGameId) || {}), ...targetGameForMap });
        return next;
      });

      const stagingDelta = (rowsByTable.get('staging_game_guides') || []).length;
      if (stagingDelta > 0) {
        setTotalStagingCountsMap((prev) => {
          const next = new Map(prev);
          if (mode === 'move') {
            const srcLeft = (next.get(sourceGameId) || 0) - stagingDelta;
            if (srcLeft > 0) next.set(sourceGameId, srcLeft);
            else next.delete(sourceGameId);
          }
          next.set(targetGameId, (next.get(targetGameId) || 0) + stagingDelta);
          return next;
        });
        setTotalStagingCreatorsMap((prev) => {
          const next = new Map(prev);
          if (!next.has(targetGameId)) next.set(targetGameId, 1);
          if (mode === 'move') {
            const srcLeft = (totalStagingCountsMap.get(sourceGameId) || 0) - stagingDelta;
            if (srcLeft <= 0) next.delete(sourceGameId);
          }
          return next;
        });
        if (mode === 'move' && (totalStagingCountsMap.get(sourceGameId) || 0) - stagingDelta <= 0) {
          setStagingWorkflowByGame((prev) => {
            if (!prev.has(sourceGameId)) return prev;
            const next = new Map(prev);
            next.delete(sourceGameId);
            return next;
          });
        }
      }

      const rohDelta = (rowsByTable.get(TABLES.guidesRohmaterial) || []).length;
      if (rohDelta > 0) {
        setRohGamesMap((prev) => {
          const next = new Map(prev);
          next.set(targetGameId, { ...(next.get(targetGameId) || {}), ...targetGameForMap });
          return next;
        });
        setRohmaterialGames((prev) => {
          const sourceDelta = mode === 'move' ? -rohDelta : 0;
          let next = prev.map((item) => {
            if (item.gameId !== sourceGameId || sourceDelta === 0) return item;
            return { ...item, rowCount: Math.max(0, (item.rowCount || 0) + sourceDelta) };
          });
          if (mode === 'move') {
            next = next.filter((item) => item.gameId !== sourceGameId || item.rowCount > 0);
          }
          const existing = next.find((item) => item.gameId === targetGameId);
          if (existing) {
            return next.map((item) =>
              item.gameId === targetGameId
                ? {
                    ...item,
                    game: { ...item.game, ...targetGameForMap },
                    title: targetTitle,
                    platformGameId: targetNpwr,
                    coverUrl: getLocalizedCover(targetGame.cover_url) || item.coverUrl,
                    rowCount: (item.rowCount || 0) + rohDelta,
                    statusRohmaterial: touchedRoh ? 'PENDING_MULTI_TAB' : item.statusRohmaterial,
                  }
                : item,
            );
          }
          return [
            {
              gameId: targetGameId,
              game: targetGameForMap,
              title: targetTitle,
              platformGameId: targetNpwr,
              coverUrl: getLocalizedCover(targetGame.cover_url),
              creatorCount: 1,
              creatorList: selectedCreatorName ? [selectedCreatorName] : [],
              batchList: [],
              rowCount: rohDelta,
              statusRohmaterial: 'PENDING_MULTI_TAB',
            },
            ...next,
          ];
        });
      }

      setSelectedRowIds(new Set());
      setBatchTransferMode(null);
      setBatchTransferQuery('');
      setBatchTransferResults([]);
      const verb = mode === 'move' ? 'verschoben' : 'dupliziert';
      setNotice(`✓ ${transferredRows.length} Zeilen nach „${targetTitle}“ ${verb}.`);
      if (statusWarning) {
        setError(`Zeilen sind ${verb}, aber ${statusWarning}`);
      }
    } catch (err) {
      setError(`${mode === 'move' ? 'Verschieben' : 'Duplizieren'} fehlgeschlagen: ${err.message}`);
    } finally {
      setActionBusy(false);
    }
  };

  // Multi-Item-Zeile an Komma, Semikolon oder Zeilenumbruch in Einzelzeilen zerlegen.
  // Ein Präfix vor dem ersten Komma (z. B. "Kapitel 1: Item A, Item B") bleibt am ersten Item.
  // Reihenfolge und guide_id 1..N stehen fest, bevor irgendetwas geschrieben wird.
  const handleSplitRowsByComma = async (targetRows) => {
    if (actionBusy) return;

    const targetIdSet = new Set((targetRows ?? []).map((row) => row.id));
    const orderedRows = [...currentCreatorRows];
    const expandedPlan = [];

    for (const row of orderedRows) {
      if (!targetIdSet.has(row.id)) {
        expandedPlan.push({
          kind: 'existing',
          row,
          newItemName: getLocalizedItemName(row.item_name).trim(),
        });
        continue;
      }

      const tableName = row._sourceTable || 'staging_game_guides';
      const rawName = getLocalizedItemName(row.item_name);

      const parts = rawName
        .split(/[,;\n]/)
        .map((part) => part.trim())
        .filter(Boolean);

      if (parts.length < 2 || !isEditableDraftTable(tableName)) {
        expandedPlan.push({
          kind: 'existing',
          row,
          newItemName: rawName.trim(),
        });
        continue;
      }

      expandedPlan.push({
        kind: 'existing',
        row,
        newItemName: parts[0],
        itemChanged: true,
      });

      for (const part of parts.slice(1)) {
        expandedPlan.push({
          kind: 'insert',
          templateRow: row,
          newItemName: part,
        });
      }
    }

    const insertEntries = expandedPlan.filter((entry) => entry.kind === 'insert');
    if (insertEntries.length === 0) {
      setNotice('Keine der Zeilen enthält mehrere trennbare Items (Komma/Semikolon).');
      return;
    }

    expandedPlan.forEach((entry, index) => {
      entry.newGuideId = index + 1;
    });

    setActionBusy(true);
    setError('');
    setNotice('Zerlege Zeilen…');

    try {
      const insertsByTable = new Map();
      for (const entry of insertEntries) {
        const tableName = entry.templateRow._sourceTable || 'staging_game_guides';
        const payload = buildGuideRowClonePayload(entry.templateRow, {
          gameId: entry.templateRow.game_id,
          platformGameId: entry.templateRow.platform_game_id,
          guideId: entry.newGuideId,
          itemName: entry.newItemName,
        });

        delete payload._sourceTable;
        delete payload.id;

        payload.item_name = formatFieldValueForTable(entry.templateRow, 'item_name', entry.newItemName);
        payload.guide_id = formatFieldValueForTable(entry.templateRow, 'guide_id', entry.newGuideId);

        const list = insertsByTable.get(tableName) || [];
        list.push(payload);
        insertsByTable.set(tableName, list);
      }

      const insertedRows = [];
      for (const [tableName, payloads] of insertsByTable.entries()) {
        const inserted = await insertGuideRows(tableName, payloads);
        insertedRows.push(...inserted.map((row) => ({ ...row, _sourceTable: tableName })));
      }

      const existingToPatch = expandedPlan.filter(
        (entry) =>
          entry.kind === 'existing' &&
          (entry.itemChanged || String(entry.row.guide_id) !== String(entry.newGuideId)),
      );

      if (existingToPatch.length > 0) {
        const patchById = new Map(existingToPatch.map((entry) => [entry.row.id, entry]));
        const orderedPatches = [...existingToPatch].sort((a, b) => b.newGuideId - a.newGuideId);
        await persistRowPatchesToSupabase(
          orderedPatches.map((entry) => entry.row),
          (row) => {
            const entry = patchById.get(row.id);
            if (!entry) return {};
            const patch = {};
            if (entry.itemChanged) {
              patch.item_name = formatFieldValueForTable(row, 'item_name', entry.newItemName);
            }
            if (String(row.guide_id) !== String(entry.newGuideId)) {
              patch.guide_id = formatFieldValueForTable(row, 'guide_id', entry.newGuideId);
            }
            return patch;
          },
        );
      }

      const stagingInserted = insertedRows.filter((row) => row._sourceTable === 'staging_game_guides');
      const rohInserted = insertedRows.filter((row) => row._sourceTable === TABLES.guidesRohmaterial);

      if (stagingInserted.length > 0) {
        setStagingRows((prev) => prev.concat(stagingInserted));
        if (selectedGameId) {
          setTotalStagingCountsMap((prev) => {
            const next = new Map(prev);
            next.set(selectedGameId, (next.get(selectedGameId) || 0) + stagingInserted.length);
            return next;
          });
        }
      }
      if (rohInserted.length > 0) {
        setRohmaterialRows((prev) => prev.concat(rohInserted));
        if (selectedGameId) {
          setRohmaterialGames((prev) =>
            prev.map((item) =>
              item.gameId === selectedGameId
                ? { ...item, rowCount: (item.rowCount || 0) + rohInserted.length }
                : item,
            ),
          );
        }
      }

      const splitSourceCount = expandedPlan.filter((entry) => entry.kind === 'existing' && entry.itemChanged).length;
      setSortField('guide_id');
      setSortDirection('asc');
      setSelectedRowIds(new Set());
      setNotice(`✂️ ${splitSourceCount} Zeile(n) in ${splitSourceCount + insertedRows.length} Einzelzeilen zerlegt.`);
    } catch (err) {
      console.error('Fehler bei handleSplitRowsByComma:', err);
      setError(`Zerlegen fehlgeschlagen: ${err.message || err}`);
      setNotice('');
    } finally {
      setActionBusy(false);
    }
  };

  // Zeilen des aktuellen Creators (oder nur die markierten) in einen anderen Creator-Tab desselben Spiels ziehen.
  const handleMergeCreatorIntoTarget = async (targetCreatorName) => {
    const targetName = String(targetCreatorName ?? '').trim();
    if (!targetName || !selectedCreatorName || targetName === selectedCreatorName || actionBusy) return;
    if (!creatorGroups.has(targetName)) {
      setError('Ziel-Creator wurde in diesem Spiel nicht gefunden.');
      return;
    }

    const selected = currentCreatorRows.filter(
      (row) => selectedRowIds.has(row.id) && isEditableDraftTable(row._sourceTable || 'staging_game_guides'),
    );
    const draftRows = currentCreatorRows.filter((row) =>
      isEditableDraftTable(row._sourceTable || 'staging_game_guides'),
    );
    const rowsToMove = selectedRowIds.size > 0 ? selected : draftRows;
    if (rowsToMove.length === 0) {
      setError('Keine Entwurfszeilen zum Zusammenführen.');
      return;
    }

    const targetRows = (creatorGroups.get(targetName) || []).filter((row) =>
      isEditableDraftTable(row._sourceTable || 'staging_game_guides'),
    );
    if ((creatorGroups.get(targetName) || []).length > 0 && targetRows.length === 0) {
      setError('Produktive Guide-Zeilen können nicht als Ziel dienen.');
      return;
    }
    const targetCreatorId = targetRows.find((row) => row.creator_id)?.creator_id || null;
    const incomingIds = new Set(rowsToMove.map((row) => row.id));
    const remainingSource = draftRows.filter((row) => !incomingIds.has(row.id));
    const targetSorted = [...targetRows].sort(
      (a, b) => parseGuideIdNumber(a.guide_id) - parseGuideIdNumber(b.guide_id) || String(a.id).localeCompare(String(b.id)),
    );
    const combined = [...targetSorted, ...rowsToMove];

    setActionBusy(true);
    setError('');
    setNotice('');

    try {
      const indexById = new Map();
      combined.forEach((row, index) => indexById.set(row.id, index + 1));
      const sourceIndex = new Map();
      remainingSource.forEach((row, index) => sourceIndex.set(row.id, index + 1));

      await persistRowPatchesToSupabase([...combined, ...remainingSource], (row) => {
        const patch = {};
        if (indexById.has(row.id)) {
          patch.guide_id = formatFieldValueForTable(row, 'guide_id', indexById.get(row.id));
        } else if (sourceIndex.has(row.id)) {
          patch.guide_id = formatFieldValueForTable(row, 'guide_id', sourceIndex.get(row.id));
        }
        if (incomingIds.has(row.id)) {
          patch.creator_name = targetName;
          if (targetCreatorId) patch.creator_id = targetCreatorId;
        }
        return patch;
      });

      setSortField('guide_id');
      setSortDirection('asc');
      setSelectedRowIds(new Set());
      setSelectedCreatorName(targetName);
      setNotice(`🔗 ${rowsToMove.length} Zeilen mit „${targetName}“ zusammengeführt.`);
    } catch (err) {
      setError(`Zusammenführen fehlgeschlagen: ${err.message}`);
    } finally {
      setActionBusy(false);
    }
  };

  // 8d. Großes Spiel -> Rohmaterial (Multi-Tab) verschieben
  const handleMoveToRohmaterial = async () => {
    if (!selectedGameId || !selectedCreatorName || actionBusy) return;

    setActionBusy(true);
    setError('');
    setNotice('');

    const targetGameId = selectedGameId;
    const targetCreator = selectedCreatorName;

    try {
      let movedViaRpc = false;
      const hasCustomCategoryOrSheet = currentCreatorRows.some(
        (r) =>
          Boolean(getLocalizedItemName(r.category_group).trim()) ||
          Boolean(getLocalizedItemName(r.boss_group).trim()) ||
          Boolean(getLocalizedItemName(r.spiel_region).trim()) ||
          normalizeSpielRegionTab(r.spiel_region_tab).length > 0 ||
          deriveSheetTypesFromRow(r).join(',') !== '1'
      );

      // 1. Versuche Supabase RPC move_staging_to_rohmaterial (nur wenn keine lokalen category_group/boss_group Anpassungen vorliegen)
      if (!hasCustomCategoryOrSheet) {
        const { error: rpcErr } = await supabase.rpc('move_staging_to_rohmaterial', {
          p_game_id: targetGameId,
          p_creator_name: targetCreator,
        });
        if (!rpcErr) {
          const targetCheckTable = TABLES.guidesRohmaterial;
          const { count: rpcCount, error: rpcCountErr } = await supabase
            .from(targetCheckTable)
            .select('id', { count: 'exact', head: true })
            .eq('game_id', selectedGameId);
          if (!rpcCountErr && rpcCount && rpcCount > 0) {
            movedViaRpc = true;
          } else {
            console.warn(
              'RPC move_staging_to_rohmaterial lieferte 0 Zeilen in Ziel-Tabelle, nutze Fallback.'
            );
          }
        } else {
          console.warn(
            'RPC move_staging_to_rohmaterial nicht verfügbar oder fehlgeschlagen, nutze Fallback:',
            rpcErr.message
          );
        }
      }

      if (!movedViaRpc) {
        // Fallback: Zeilen in game_guides_rohmaterial kopieren, games.status.rohmaterial = 'PENDING_MULTI_TAB' setzen, aus staging_game_guides löschen
        const safeCreator = targetCreator.replace(/[^a-zA-Z0-9_-]/g, '_').slice(0, 30);
        const batchKey = `staging_${String(targetGameId).slice(0, 8)}_${safeCreator}_${Date.now()}`;

        const toJsonb = (val) => {
          if (!val) return null;
          if (typeof val === 'object' && !Array.isArray(val)) return val;
          const str = String(val).trim();
          return str ? { de: str, en: str } : null;
        };

        const parseNum = (val) => {
          const digits = String(val ?? '').replace(/\D/g, '');
          return digits ? Number.parseInt(digits, 10) : null;
        };

        const rohRows = currentCreatorRows.map((r, idx) => ({
          batch_key: batchKey,
          batch_status: 'MATCHED',
          creator_name: targetCreator,
          playlist_url: r.creator_input_url || r.video_url || null,
          game_id: r.game_id,
          platform_game_id:
            r.platform_game_id ||
            (Array.isArray(selectedGame?.platform_game_id)
              ? selectedGame.platform_game_id[0]
              : selectedGame?.platform_game_id) ||
            null,
          guide_id: String(parseNum(r.guide_id) ?? idx + 1),
          sheet_type: deriveSheetTypesFromRow(r),
          item_name: toJsonb(r.item_name),
          spiel_region: toJsonb(r.spiel_region),
          spiel_region_tab:
            normalizeSpielRegionTab(r.spiel_region_tab).length > 0
              ? normalizeSpielRegionTab(r.spiel_region_tab)
              : null,
          chronological_group: toJsonb(r.chronological_group),
          category_group: toJsonb(r.category_group),
          boss_group: toJsonb(r.boss_group),
          video_chapter: toJsonb(r.video_chapter),
          timestamp: r.timestamp || null,
          video_url: r.video_url || null,
          trophy_id: parseNum(r.trophy_id) != null ? String(parseNum(r.trophy_id)) : null,
          is_trophy_relevant: r.is_trophy_relevant || null,
        }));

        if (rohRows.length > 0) {
          const { error: insErr } = await supabase
            .from(TABLES.guidesRohmaterial)
            .insert(rohRows);

          if (insErr) {
            throw new Error(`Fehler beim Kopieren in game_guides_rohmaterial: ${insErr.message}`);
          }
        }

        // games.status.rohmaterial = 'PENDING_MULTI_TAB' setzen
        const { data: currentGameData } = await supabase
          .from(TABLES.games)
          .select(GAME_STRUCT.status)
          .eq(GAME_PK, targetGameId)
          .maybeSingle();

        const statusMap = {
          ...parseStatusMap(currentGameData?.[GAME_STRUCT.status]),
          rohmaterial: 'PENDING_MULTI_TAB',
        };

        const { error: statusUpErr } = await supabase
          .from(TABLES.games)
          .update({ [GAME_STRUCT.status]: statusMap })
          .eq(GAME_PK, targetGameId);

        if (statusUpErr) {
          console.warn('Warnung beim Setzen von status.rohmaterial:', statusUpErr.message);
        }

        // Sicherheits-Check vor dem Löschen aus staging_game_guides
        const targetCheckTable = TABLES.guidesRohmaterial;
        const { count: targetCount, error: countErr } = await supabase
          .from(targetCheckTable)
          .select('id', { count: 'exact', head: true })
          .eq('game_id', selectedGameId);
        if (countErr || !targetCount || targetCount === 0) {
          throw new Error(
            'Sicherheits-Stopp: Ziel-Tabelle enthält noch 0 Zeilen für dieses Spiel! Quell-Daten wurden NICHT gelöscht.'
          );
        }

        // Aus staging_game_guides löschen (für dieses Spiel)
        const { error: delStagingErr } = await supabase
          .from('staging_game_guides')
          .delete()
          .eq('game_id', targetGameId);

        if (delStagingErr) {
          throw new Error(`Fehler beim Löschen aus staging_game_guides: ${delStagingErr.message}`);
        }
      }

      setNotice(
        `📦 Spiel "${getLocalizedTitle(selectedGame?.spieltitel)}" (${targetCreator}) zu Rohmaterial (Multi-Tab) verschoben${movedViaRpc ? ' (RPC)' : ''}.`
      );
      jumpToNextGame(targetGameId);
      setStagingRows((prev) => prev.filter((r) => r.game_id !== targetGameId));
      fetchQueue();
      fetchRohmaterialSummary();
    } catch (err) {
      setError(`Verschieben zu Rohmaterial fehlgeschlagen: ${err.message}`);
    } finally {
      setActionBusy(false);
    }
  };

  // 8e. Sonderfall: Creator aus Staging + bestehende Live-Sammelobjekte (+ evtl. 07.0 Rohmaterial) in Multi-Tab zusammenführen
  const handleMergeStagingCreatorAndLiveToRohmaterial = async () => {
    if (!selectedGameId || !selectedCreatorName || actionBusy) return;

    const targetGameId = selectedGameId;
    const targetCreator = selectedCreatorName;

    setActionBusy(true);
    setError('');
    setNotice('');

    try {
      // 1. Spiel-Metadaten lesen & auf public.games entsperren + status.rohmaterial = 'PENDING_MULTI_TAB' setzen
      const { data: currentGameData, error: gameReadErr } = await supabase
        .from(TABLES.games)
        .select(
          `${GAME_PK}, platform_game_id, ${GAME_STRUCT.status}, ${GAME_STRUCT.publishingStatus}, ${GAME_STRUCT.publishedLocales}, ${GAME_STRUCT.progress}, ${GAME_STRUCT.isGuideLocked}`
        )
        .eq(GAME_PK, targetGameId)
        .maybeSingle();

      if (gameReadErr) {
        throw new Error(`Fehler beim Lesen des Spiels: ${gameReadErr.message}`);
      }

      const nextStatus = {
        ...parseStatusMap(currentGameData?.[GAME_STRUCT.status] ?? selectedGame?.[GAME_STRUCT.status]),
      };
      for (const [key, value] of Object.entries(nextStatus)) {
        if (!key.startsWith('guide_')) continue;
        const upper = String(value ?? '').trim().toUpperCase();
        if (upper === GUIDE_PUBLICATION.PUBLISHED || upper === 'READY') {
          nextStatus[key] = GUIDE_PUBLICATION.DONE;
        }
      }
      if (String(nextStatus.publish_status ?? '').trim().toUpperCase() === GUIDE_PUBLICATION.PUBLISHED) {
        nextStatus.publish_status = GUIDE_PUBLICATION.DONE;
      }
      nextStatus.rohmaterial = 'PENDING_MULTI_TAB';

      const unlockPatch = {
        [GAME_STRUCT.isGuideLocked]: false,
        [GAME_STRUCT.status]: nextStatus,
        [GAME_STRUCT.publishingStatus]: {},
        [GAME_STRUCT.publishedLocales]: [],
      };
      if (
        String(currentGameData?.[GAME_STRUCT.progress] ?? selectedGame?.[GAME_STRUCT.progress] ?? '')
          .trim()
          .toUpperCase() === GUIDE_PUBLICATION.PUBLISHED
      ) {
        unlockPatch[GAME_STRUCT.progress] = GUIDE_PUBLICATION.DONE;
      }

      const { error: unlockErr } = await supabase
        .from(TABLES.games)
        .update(unlockPatch)
        .eq(GAME_PK, targetGameId);

      if (unlockErr) {
        throw new Error(`Fehler beim Entsperren des Spiels auf public.games: ${unlockErr.message}`);
      }

      // 2. Alle bestehenden Zeilen des Spiels aus public.game_guides paginiert laden
      const PAGE_SIZE = 1000;
      let allLiveRows = [];
      for (let from = 0; ; from += PAGE_SIZE) {
        const { data: chunk, error: liveErr } = await supabase
          .from(TABLES.guides)
          .select('*')
          .eq('game_id', targetGameId)
          .order('id', { ascending: true })
          .range(from, from + PAGE_SIZE - 1);

        if (liveErr) {
          throw new Error(`Fehler beim Laden von game_guides: ${liveErr.message}`);
        }
        allLiveRows = allLiveRows.concat(chunk ?? []);
        if ((chunk ?? []).length < PAGE_SIZE) break;
      }

      const parseNum = (val) => {
        const digits = String(val ?? '').replace(/\D/g, '');
        return digits ? Number.parseInt(digits, 10) : null;
      };

      allLiveRows.sort(
        (a, b) =>
          (parseNum(a.guide_id) ?? Number.MAX_SAFE_INTEGER) -
          (parseNum(b.guide_id) ?? Number.MAX_SAFE_INTEGER)
      );

      const toJsonb = (val) => {
        if (!val) return null;
        if (typeof val === 'object' && !Array.isArray(val)) {
          return Object.keys(val).length > 0 ? val : null;
        }
        const str = String(val).trim();
        return str ? { de: str, en: str } : null;
      };

      const rawPlatformId = currentGameData?.platform_game_id ?? selectedGame?.platform_game_id;
      const fallbackPlatformGameId = Array.isArray(rawPlatformId)
        ? rawPlatformId[0] || null
        : rawPlatformId || null;
      const stagingCreatorId = currentCreatorRows.find((r) => r.creator_id)?.creator_id || null;
      const liveBatchKey = `live_import_${String(targetGameId).slice(0, 8)}`;

      let maxGuideId = 0;
      const liveRohRows = allLiveRows.map((r, idx) => {
        const parsedId = parseNum(r.guide_id) ?? idx + 1;
        if (parsedId > maxGuideId) maxGuideId = parsedId;
        const resolvedSheets = resolveSheetTypes(r.sheet_type);
        return {
          batch_key: liveBatchKey,
          batch_status: 'OPEN',
          game_id: targetGameId,
          platform_game_id: r.platform_game_id || fallbackPlatformGameId,
          creator_id: r.creator_id || stagingCreatorId || null,
          creator_name: targetCreator,
          playlist_url: r.video_url || null,
          guide_id: String(parsedId),
          sheet_type: resolvedSheets.length > 0 ? resolvedSheets : deriveSheetTypesFromRow(r),
          item_name: toJsonb(r.item_name),
          spiel_region: toJsonb(r.spiel_region),
          spiel_region_tab:
            normalizeSpielRegionTab(r.spiel_region_tab).length > 0
              ? normalizeSpielRegionTab(r.spiel_region_tab)
              : null,
          chronological_group: toJsonb(r.chronological_group),
          category_group: toJsonb(r.category_group),
          boss_group: toJsonb(r.boss_group),
          video_chapter: toJsonb(r.video_chapter),
          timestamp: r.timestamp || null,
          video_url: r.video_url || null,
          trophy_id: parseNum(r.trophy_id) != null ? String(parseNum(r.trophy_id)) : null,
          is_trophy_relevant: r.is_trophy_relevant || null,
        };
      });

      // 3. Zeilen des aktuell ausgewählten Staging-Creators in game_guides_rohmaterial-Zeilen konvertieren
      const safeCreator = targetCreator.replace(/[^a-zA-Z0-9_-]/g, '_').slice(0, 30);
      const stagingBatchKey = `staging_${String(targetGameId).slice(0, 8)}_${safeCreator}`;
      const stagingSourceRows = currentCreatorRows.filter(
        (r) => r._sourceTable !== TABLES.guides && r._sourceTable !== TABLES.guidesRohmaterial
      );

      const stagingRohRows = stagingSourceRows.map((r, idx) => {
        const nextGuideId = maxGuideId + idx + 1;
        return {
          batch_key: stagingBatchKey,
          batch_status: 'OPEN',
          game_id: targetGameId,
          platform_game_id: r.platform_game_id || fallbackPlatformGameId,
          creator_id: r.creator_id || stagingCreatorId || null,
          creator_name: targetCreator,
          playlist_url: r.creator_input_url || r.playlist_url || r.video_url || null,
          guide_id: String(nextGuideId),
          sheet_type: deriveSheetTypesFromRow(r),
          item_name: toJsonb(r.item_name),
          spiel_region: toJsonb(r.spiel_region),
          spiel_region_tab:
            normalizeSpielRegionTab(r.spiel_region_tab).length > 0
              ? normalizeSpielRegionTab(r.spiel_region_tab)
              : null,
          chronological_group: toJsonb(r.chronological_group),
          category_group: toJsonb(r.category_group),
          boss_group: toJsonb(r.boss_group),
          video_chapter: toJsonb(r.video_chapter),
          timestamp: r.timestamp || null,
          video_url: r.video_url || null,
          trophy_id: parseNum(r.trophy_id) != null ? String(parseNum(r.trophy_id)) : null,
          is_trophy_relevant: r.is_trophy_relevant || null,
        };
      });

      // 4. Falls in game_guides_rohmaterial bereits Zeilen (z. B. aus 07.0 Trophäen-Videos) liegen,
      // deren creator_name ebenfalls auf selectedCreatorName setzen (Konsolidierung unter einem Creator-Tab)
      const { error: unifyRohErr } = await supabase
        .from(TABLES.guidesRohmaterial)
        .update({ creator_name: targetCreator, batch_status: 'OPEN' })
        .eq('game_id', targetGameId);

      if (unifyRohErr) {
        console.warn('Hinweis beim Konsolidieren bestehender Rohmaterial-Zeilen:', unifyRohErr.message);
      }

      const combinedRohRows = [...liveRohRows, ...stagingRohRows];
      const INSERT_CHUNK = 500;
      for (let i = 0; i < combinedRohRows.length; i += INSERT_CHUNK) {
        const chunk = combinedRohRows.slice(i, i + INSERT_CHUNK);
        const { error: insErr } = await supabase.from(TABLES.guidesRohmaterial).insert(chunk);
        if (insErr) {
          throw new Error(`Fehler beim Einfügen in game_guides_rohmaterial: ${insErr.message}`);
        }
      }

      // 5. Alte Zeilen aus public.game_guides löschen & ALLE Zeilen dieses Spiels aus public.staging_game_guides löschen
      const targetCheckTable = TABLES.guidesRohmaterial;
      const { count: targetCount, error: countErr } = await supabase
        .from(targetCheckTable)
        .select('id', { count: 'exact', head: true })
        .eq('game_id', selectedGameId);
      if (countErr || !targetCount || targetCount === 0) {
        throw new Error(
          'Sicherheits-Stopp: Ziel-Tabelle enthält noch 0 Zeilen für dieses Spiel! Quell-Daten wurden NICHT gelöscht.'
        );
      }

      if (allLiveRows.length > 0) {
        const { error: delLiveErr } = await supabase
          .from(TABLES.guides)
          .delete()
          .eq('game_id', targetGameId);
        if (delLiveErr) {
          throw new Error(`Fehler beim Löschen aus game_guides: ${delLiveErr.message}`);
        }
      }

      const { error: delStagingErr } = await supabase
        .from('staging_game_guides')
        .delete()
        .eq('game_id', targetGameId);

      if (delStagingErr) {
        throw new Error(`Fehler beim Bereinigen von staging_game_guides: ${delStagingErr.message}`);
      }

      const localOverrides = loadStagingLocalOverrides();
      for (const row of gameGroups.get(targetGameId) || []) {
        if (row?.id) delete localOverrides[row.id];
      }
      saveStagingLocalOverrides(localOverrides);

      // 6. Konflikt-Modal schließen, Rohmaterial-Queue neu laden und Spiel direkt im Multi-Tab-Editor aktiv halten
      setShowConflictModal(false);
      setLiveGuideRows([]);
      setLiveGuideCountsMap((prev) => {
        const next = new Map(prev);
        next.set(targetGameId, 0);
        return next;
      });
      setProductiveRohRows([]);
      pendingReturnCreatorRef.current = targetCreator;

      await Promise.all([fetchRohmaterialSummary(), fetchQueue()]);

      setActiveDataSource('rohmaterial');
      setSelectedGameId(targetGameId);
      setSelectedCreatorName(targetCreator);

      setNotice(
        `📦 "${getLocalizedTitle(selectedGame?.spieltitel)}": Creator "${targetCreator}" (${stagingRohRows.length} Zeilen) + ${liveRohRows.length} Live-Zeilen in Multi-Tab (Rohmaterial) zusammengeführt. Andere Staging-Creator wurden verworfen.`
      );
    } catch (err) {
      setError(`Zusammenführen in Multi-Tab fehlgeschlagen: ${err.message}`);
    } finally {
      setActionBusy(false);
    }
  };

  // 9. Guide-Tipp für Trophäe in DB speichern
  const handleSaveTrophyGuideTip = async (platformAchievementId, newTipText) => {
    if (!selectedGameId || !platformAchievementId) return;
    const { error: err } = await saveTrophyGuideTip(
      supabase,
      selectedGameId,
      platformAchievementId,
      trophyLang,
      newTipText
    );

    if (err) {
      console.error('Fehler beim Speichern des Guide-Tipps:', err.message);
      setError(`Trophäen-Tipp konnte nicht gespeichert werden: ${err.message}`);
      return;
    }

    setNotice(
      newTipText.trim()
        ? `Guide-Tipp für Trophäe "${platformAchievementId}" [${trophyLang.toUpperCase()}] gespeichert.`
        : `Guide-Tipp für Trophäe "${platformAchievementId}" [${trophyLang.toUpperCase()}] gelöscht.`
    );
    setGameTrophies((prev) =>
      prev.map((t) => {
        if (t.platform_achievement_id === platformAchievementId || t.id === platformAchievementId) {
          let currentMap = {};
          if (typeof t.guide_tip === 'object' && t.guide_tip !== null && !Array.isArray(t.guide_tip)) {
            currentMap = { ...t.guide_tip };
          } else if (typeof t.guide_tip === 'string' && t.guide_tip) {
            currentMap = { de: t.guide_tip };
          }

          if (newTipText.trim()) {
            currentMap[trophyLang] = newTipText.trim();
          } else {
            delete currentMap[trophyLang];
          }

          return { ...t, guide_tip: Object.keys(currentMap).length ? currentMap : null };
        }
        return t;
      })
    );
  };

  // 9b. Alle Guide-Tipps für das Spiel in der gewählten Sprache löschen
  const handleClearAllTrophyGuideTips = async () => {
    if (!selectedGameId || actionBusy) return;
    if (
