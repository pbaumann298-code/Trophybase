  exists (select 1 from public.game_guides gg where gg.game_id = g.id) as hat_guide
from public.games g
join mapped m on m.game_id = g.id
where not (
  coalesce(g.spiel_typ, '') = 'Quickwin'
  and coalesce(g.status ->> 'guide_de', '') = 'PUBLISHED'
