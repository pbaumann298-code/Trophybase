    <div id="root">
      <!-- Crawler-/No-JS-Fallback: vor React-Mount im DOM, visuell versteckt; createRoot().render() ersetzt #root. -->
      <div
        style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)"
        data-tb-home-fallback
      >
        <h1>TrophyBase.app – Interaktive PlayStation Trophäen-Guides (PS3, PS4, PS5)</h1>
