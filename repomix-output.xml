 */

const EASY_PLATINS_SERIES = [
  { label: 'Enigmatis', title: 'Enigmatis' },
  { label: 'Grim Legends', title: 'Grim Legends' },
  { label: 'Nightmares from the Deep', title: 'Nightmares from the Deep' },
