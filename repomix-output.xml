<file path="src/components/Dashboard.jsx">
import { useCallback, useEffect, useRef, useState } from 'react';
import { supabase } from '../pages/supabaseClient';
import { fetchGameByRouteRef, fetchGamesByIds, parseRouteGameRef } from '../lib/gameQueries';
import { GAME_PLATFORM_ID } from '../lib/gameSchema';
import { gameGuidePath } from '../lib/routeUtils';
import {
  getGameUuid,
  getPlatformGameIds,
  getRouteSlug,
} from '../lib/gameModel';
import { useVisibility } from '../context/VisibilityContext';
import { useWatchlist } from '../context/WatchlistContext';
import { useLocale } from '../context/LocaleContext';
import { canonicalizeWatchlistIds, watchlistIdsEqual } from '../lib/localWatchlist';
import { isGameDraftMode } from '../lib/guidePublication';
import GameTile from './GameTile';

/** Ab so vielen Titeln lohnt die Startseiten-Leiste zum horizontalen Scrollen. */
export const HOME_WATCHLIST_MIN = 3;

const TILE_CLASS =
  'home-carousel-tile flex-shrink-0 snap-start w-[9.5rem] sm:w-44 lg:w-[calc((100%-3rem)/5)] max-w-[12rem] lg:max-w-[11.5rem]';

/**
 * Kompakte Watchlist-Leiste auf der Startseite (nur ab HOME_WATCHLIST_MIN Einträgen).
 * Volle Liste: /watchlist
 */
function Dashboard({
  openGame,
  onOpenWatchlist,
  isAdmin = false,
  minItems = HOME_WATCHLIST_MIN,
  showEmpty = false,
}) {
  const { globalLocale, t } = useLocale();
  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(true);
  const { getEntryState, gameKey } = useVisibility();
  const { watchlistIdList, version, replaceWatchlistIds } = useWatchlist();
  const trackRef = useRef(null);
  const [canScrollLeft, setCanScrollLeft] = useState(false);
  const [canScrollRight, setCanScrollRight] = useState(false);

  const updateScrollHints = useCallback(() => {
    const el = trackRef.current;
    if (!el) return;
    setCanScrollLeft(el.scrollLeft > 8);
    setCanScrollRight(el.scrollLeft + el.clientWidth < el.scrollWidth - 8);
  }, []);

  useEffect(() => {
    let cancelled = false;

    async function loadWatchlistGames() {
      const ids = watchlistIdList.filter((id) => parseRouteGameRef(id).valid);
      if (ids.length === 0) {
        if (!cancelled) {
          if (watchlistIdList.length > 0) {
            try {
              replaceWatchlistIds([]);
            } catch {
              /* Quota */
            }
          }
          setItems([]);
          setLoading(false);
        }
        return;
      }

      setLoading(true);
      const { data: games, error: gamesError } = await fetchGamesByIds(
        supabase,
        ids,
        globalLocale,
      );

      if (cancelled) return;

      if (gamesError) {
        console.error('Watchlist-Leiste:', gamesError.message);
        setItems([]);
        setLoading(false);
        return;
      }

      const byRef = new Map();
      for (const game of games || []) {
        const uuid = getGameUuid(game);
        if (uuid) byRef.set(uuid, game);
        for (const npwr of getPlatformGameIds(game)) byRef.set(npwr, game);
      }

      const seenGames = new Set();
      const merged = [];
      for (const id of ids) {
        const game = byRef.get(id);
        if (!game) continue;
        const gameUuid = getGameUuid(game) || id;
        if (seenGames.has(gameUuid)) continue;
        seenGames.add(gameUuid);
        merged.push({
          gameUuid,
          routeSlug: getRouteSlug(game) || id,
          game,
        });
      }

      const canonical = canonicalizeWatchlistIds(watchlistIdList, (id) =>
        getGameUuid(byRef.get(id)),
      );
      if (!watchlistIdsEqual(canonical, watchlistIdList)) {
        try {
          replaceWatchlistIds(canonical);
        } catch {
          /* Quota */
        }
      }

      setItems(merged);
      setLoading(false);
    }

    loadWatchlistGames();
    return () => {
      cancelled = true;
    };
  }, [watchlistIdList, version, globalLocale, replaceWatchlistIds]);

  const visibleItems = items.filter((item) => {
    const key = gameKey(item.gameUuid || item.routeSlug);
    return getEntryState(key, { completed: false }).visible;
  });

  useEffect(() => {
    if (loading || visibleItems.length < HOME_WATCHLIST_MIN) return undefined;
    updateScrollHints();
    const el = trackRef.current;
    if (!el) return undefined;
    const ro = new ResizeObserver(updateScrollHints);
    ro.observe(el);
    return () => ro.disconnect();
  }, [loading, visibleItems.length, updateScrollHints]);

  const handleOpenGame = async (item) => {
    const preferGuideTab = Boolean(isAdmin && item.game && isGameDraftMode(item.game));
    if (item.game) {
      openGame(item.game, preferGuideTab ? { preferGuideTab: true } : undefined);
      return;
    }
    if (!item.routeSlug && !item.gameUuid) return;

    const { data: game, error: gameError } = await fetchGameByRouteRef(
      supabase,
      item.routeSlug ?? item.gameUuid,
      globalLocale,
    );

    if (gameError) {
      console.error('Watchlist-Spiel:', gameError.message);
    }

    if (game) {
      openGame(game);
      return;
    }

    openGame({ id: item.gameUuid, [GAME_PLATFORM_ID]: item.routeSlug });
  };

  if (loading) {
    return showEmpty ? (
      <section className="home-category w-full min-w-0 max-w-full" aria-labelledby="home-watchlist-title">
        <p className="home-category-empty">{t('homeWatchlistLoading')}</p>
      </section>
    ) : null;
  }

  if (visibleItems.length === 0) {
    return showEmpty ? (
      <section className="home-category w-full min-w-0 max-w-full" aria-labelledby="home-watchlist-title">
        <header className="home-category-header">
          <h2 id="home-watchlist-title" className="home-category-title">
            {t('watchlistTitle')}
          </h2>
        </header>
        <p className="home-category-empty">{t('homeWatchlistEmpty')}</p>
      </section>
    ) : null;
  }

  if (visibleItems.length < minItems) {
    return null;
  }

  const scrollByTiles = (direction) => {
    const el = trackRef.current;
    if (!el) return;
    el.scrollBy({ left: Math.round(el.clientWidth * 0.85) * direction, behavior: 'smooth' });
  };

  return (
    <section className="home-category w-full min-w-0 max-w-full" aria-labelledby="home-watchlist-title">
      <header className="home-category-header">
        <div className="home-category-heading min-w-0">
          {typeof onOpenWatchlist === 'function' ? (
            <button
              type="button"
              id="home-watchlist-title"
              className="home-category-title home-category-title--clickable"
              onClick={onOpenWatchlist}
              title={t('watchlistTitle')}
            >
              {t('watchlistTitle')}
              <span className="home-category-search-hint" aria-hidden>
                ↗
              </span>
            </button>
          ) : (
            <h2 id="home-watchlist-title" className="home-category-title">
              {t('watchlistTitle')}
            </h2>
          )}
        </div>
        <div className="home-category-nav flex-shrink-0">
          <button
            type="button"
            className="home-scroll-btn"
            aria-label={`${t('watchlistTitle')} nach links`}
            disabled={!canScrollLeft}
            onClick={() => scrollByTiles(-1)}
          >
            ‹
          </button>
          <button
            type="button"
            className="home-scroll-btn"
            aria-label={`${t('watchlistTitle')} nach rechts`}
            disabled={!canScrollRight}
            onClick={() => scrollByTiles(1)}
          >
            ›
          </button>
        </div>
      </header>

      <div className="home-carousel-wrap">
        <div
          ref={trackRef}
          className="home-carousel-track scrollbar-hide"
          onScroll={updateScrollHints}
        >
          {visibleItems.map((item) => {
            if (!item.game) return null;
            const href = gameGuidePath(item.game, globalLocale);
            return (
              <GameTile
                key={item.gameUuid || item.routeSlug}
                game={item.game}
                href={href}
                isAdmin={isAdmin}
                className={TILE_CLASS}
                onOpen={() => {
                  handleOpenGame(item);
                }}
              />
            );
          })}
        </div>
      </div>
    </section>
  );
}

export default Dashboard;
</file>

<file path=".cursor/rules/SUPABASE_SCHEMA.mdc">
---
description: Offizielles TrophyBase Supabase Datenbank-Schema, Spaltentypen, Trigger und PostgREST-Regeln
globs: **/*.{js,jsx,ts,tsx,py,sql}
alwaysApply: true
---

# TrophyBase – Offizielles Supabase Datenbank-Schema & Architektur-Regeln (Stand: 10/2026)

## ⚠️ Regel 0: Das Admin-Gate & Quellsprachen-Gesetz (Für Cursor & Gemini via Repomix)
**Diese Regel steht über allen anderen Pipeline-Annahmen. Wer sie verletzt, baut Bugs ein.**
1. **Admin-Gate:** Jedes Spiel, das in IRGENDEINER Sprache `status->>'guide_<lang>' = 'PUBLISHED'` trägt, ist persönlich vom Admin durch das Gate gegangen – entweder einzeln gesichtet oder über ein zu 99 % verifiziertes, deterministisches Creator-Schema abgenommen. `PUBLISHED` ist nie „zufällig“ und wird NIE von Automatik zurückgenommen.
2. **Keine „Geister-Spiele“:** `0` Zeilen in `game_guides` bei einem `PUBLISHED`-Spiel sind KEIN Bug und KEIN Datenfehler. Das Spiel braucht schlicht keinen Schritt-für-Schritt-Guide (In-Game-Selbstläufer, reine Trophäen-Tipps über `game_achievements.guide_tip` / `"Guide-Tip-lang"`, Erklärung über `games.beschreibung` / `status_explanation_localized`). **NIEMALS `guide_rows > 0` als Blocker in Freigabe-, Sitemap- oder Hub-Logik einbauen!** (`tb_check_and_publish_locale` wurde 10/2026 genau davon befreit.)
3. **Quellsprache ist sprachagnostisch:** Die Erst-Freigabe-Sprache ist NICHT zwingend `de` oder `en`. Jede Sprache (`de`, `en`, `es`, `pt`, …) kann als Erste auf `PUBLISHED` gehen und ist dann Quelle für Übersetzer und `tb_check_and_publish_locale`. Ermittlung über `tb_source_lang_for_game(status)`: bevorzugt `de` → `en` → `es` → `pt` → jede weitere `guide_<lang> = 'PUBLISHED'`. Code darf nie hart `guide_de`/`guide_en` als „die“ Quelle annehmen.
4. **Auto-Release ist ereignisgesteuert:** Sobald Übersetzungen eintreffen – `games.beschreibung` / `status_explanation_localized` (Trigger `games_auto_release_on_texts`) oder `game_achievements.guide_tip` / `"Guide-Tip-lang"` (Statement-Trigger `game_achievements_auto_release_on_tips`) – läuft `tb_auto_release_locales(game_id)` und setzt die Zielsprache auf `PUBLISHED` (Hubs, `de`/`en`, `is_indexable = false`) bzw. `READY` (indexierbare Hauptspiele → Drip-Feed). Es braucht keinen manuellen Backfill mehr.

## 1. Kritische Architektur- & Datentyp-Regeln (ZWINGEND BEACHTEN!)
1. **PostgREST 1.000-Zeilen-Limit:** Jede Abfrage auf `staging_game_guides` (ca. 17.000+ Zeilen), `game_guides` (82.500+ Zeilen), `games` (20.250+ Zeilen) oder `game_achievements` (565.500+ Zeilen), die mehr als 1.000 Zeilen liefern kann, MUSS zwingend mit `.range(from, to)` paginiert oder per `game_id` gefiltert werden!
2. **Typ-Unterschiede zwischen Staging und Produktion:**
   - In `staging_game_guides` sind `guide_id` (`integer`), `trophy_id` (`integer`), `item_name` (`text`), `chronological_group` (`text`), `category_group` (`text`), `boss_group` (`text`), `video_chapter` (`text`) flache Datentypen!
   - In `game_guides` und `game_guides_rohmaterial` sind `guide_id` (`text`), `trophy_id` (`text`), `sheet_type` (`jsonb`, Format `[1, 2, 3]`), `item_name` (`jsonb`), `chronological_group` (`jsonb`), `category_group` (`jsonb`), `boss_group` (`jsonb`), `video_chapter` (`jsonb`), `spiel_region` (`jsonb` – übergeordnete Spiel-Region/Welt für die Guide-Anordnung), `spiel_region_tab` (`jsonb` – Array `[1]`, `[2]`, `[3]` oder `[1, 2, 3]`, in welchen Tabs die Region angezeigt wird) mehrsprachige/strukturierte Typen!
   - `spiel_region` steuert die räumliche/strukturelle Anordnung im Guide. `spiel_region_tab` steuert, in welchen Reitern diese Region als Ober-Kachel erscheint.
3. **3-Spalten-Gruppenprinzip & Auto-Tab-Trigger (`trg_auto_derive_sheet_type`):**
   - `chronological_group` gefüllt -> Tab `[1]` (Walkthrough)
   - `category_group` gefüllt -> Tab `[2]` (Sammelobjekte / Collectibles)
   - `boss_group` gefüllt -> Tab `[3]` (Bosse)
   - Sind mehrere Spalten in einer Zeile gefüllt, entsteht automatisch `[1, 2]`, `[1, 3]` usw. in `sheet_type`.
4. **Schreibschutz-Trigger (`trg_protect_published_guides`):**
   - Veröffentlichte Spiele (`is_guide_locked = true` oder `PUBLISHED` in `fortschritt`/`status`/`publishing_status`) sind auf DB-Ebene gegen `DELETE` und strukturelle `UPDATE`s (`guide_id`, `sheet_type`, `video_url`, `timestamp`, `trophy_id`, `chronological_group`, `category_group`, `boss_group`) gesperrt!
   - Erlaubt ohne Entsperrung sind NUR Updates auf `spiel_region`, `translation_status`, `prod_note` und `item_name`.
   - Für strukturelle Einzel-Änderungen an veröffentlichten Zeilen muss `edit_unlocked = true` auf der jeweiligen `game_guides`-Zeile gesetzt werden (setzt sich beim Speichern per Auto-Relock wieder auf `false`).
5. **Doppelte Tabellen (Single Source of Truth):**
   - **User-Profile:** Immer `public.profiles` nutzen (NICHT `user_profiles`).
   - **Fehlermeldungen / Reports:** Immer `public.community_reports` nutzen (NICHT `report_tickets`).
   - **Wiedervorlage:** Liegt in `public.game_wiedervorlage` (`id`, `platform_game_id`, `spieltitel`, `freitext`).
6. **Guide-Status & Sprachen (`games.status` jsonb):**
   - Pro Sprache ein Key `guide_<locale>` mit `DRAFT` → `FERTIG` → `READY` → `PUBLISHED`. `publishing_status` und `published_locales` werden vom Trigger `games_sync_publishing_columns` abgeleitet – NIE direkt schreiben.
   - Unterstützte Locales (Frontend `SUPPORTED_LOCALES` in `shared/countryLocaleMap.js` = DB-Zielsprachen): `de, en, fr, es, it, nl, pt, pl, ru, ja, ko, zh-hans, zh-hant, fi, sv, ar`. **`pl` und `ar` sind seit 10/2026 live** (Routing, Sitemap, UI-Strings, Hubs, Auto-Release).
   - Sony-Rohdaten (`spieltitel`, `trophy_name`, `trophy_desc`, `guide_tip`) kennen den Key `zh` sowie `ar` (und `tr`); `zh-hans`/`zh-hant`, `fi`, `sv` liegen dort NICHT vor. **zh-Fallback** (Stage 1, Stufe 3/3b): `zh` wird nach `zh-hans` UND `zh-hant` kopiert, wenn diese Keys fehlen – im Spieltitel-Match, in `game_achievements` (`trophy_name`, `trophy_desc`, `guide_tip`, `"Guide-Tip-lang"`) und in `game_guides.item_name` (`tb_zh_fallback_jsonb`, `tb_apply_zh_fallback_for_game`). Der Trigger `trg_set_platinum_guide_tip` (statischer Platin-Tipp) enthält `zh-hans`/`zh-hant` und `ar` ebenfalls. `games.beschreibung` hat keinen `zh`-Key → dort kein Fallback. `fi`/`sv` haben keine Quelle und bleiben bei ~0.
7. **Hub-Seiten (Quickwins, easy_platin, Servertot):**
   - Query-Filter im Frontend (`fetchGamesByType` → `applyGuideCatalogFilter({ publishedInAny: [locale, 'de', 'en'] })`) zeigt ein Hub-Spiel in jeder Sprache, sobald es in der Locale ODER `de` ODER `en` `PUBLISHED` ist. Texte (`beschreibung`, `guide_tip`, `status_explanation_localized`) fallen auf den Hubs auf `de`/`en` zurück (`getGameDescription(..., { exact: false })`, `mergeAchievementRecord(..., { textFallback: true })`).
   - Normale Guide-Seiten und Suche filtern weiterhin strikt auf `status->>'guide_<locale>' = 'PUBLISHED'`.
 - **Intranet-Queues „D-Freigabe (Radar)“ / „Servertot-Prüfung“** (`IntranetRadarAndServertot.jsx`): unveröffentlicht = `published_locales = '[]'` (nie NULL), gestützt durch den partiellen Index `games_unpublished_queue_idx (guide_typ, id) where published_locales = '[]'` (`supabase/games_unpublished_queue_idx.sql`). `games.guide_typ` (text, S/A/B/C/D) ist die redaktionelle Guide-Kategorie; D = Radar-only ohne Video.
 - **Zurück in die Entwürfe** (`pullGameBackToDrafts` in `src/lib/intranetGameEdits.js`): erst `games` entsperren (`is_guide_locked=false`, `guide_*` PUBLISHED/READY → FERTIG, `publish_status=FERTIG`, `fortschritt` PUBLISHED → FERTIG), dann `game_guides` → flache `staging_game_guides`-Zeilen (`chronological_group`, `video_chapter`, `video_url`, `item_name`, `creator_name`, `platform_game_id` sind dort NOT NULL), zuletzt `game_guides` löschen – sonst blockiert `enforce_published_guide_lock`.

---

## 1b. RPC-Funktionen der Publishing-Pipeline (`public`)
- **`tb_apply_stage1_sql_for_game(p_game_id uuid) → int`** – Wird vom Trigger `games_sync_guide_trophies_on_status` (bei Statuswechsel) aufgerufen. Stufen: (1) `tb_sync_guide_trophies_for_game` (Trophäennamen → `item_name`), (2) Glossar auf `category_group`/`chronological_group`/`boss_group`/`spiel_region`/`item_name`, (3) Spieltitel-Match (fehlende Locale-Keys in `item_name` aus `games.spieltitel`, inkl. `zh`-Fallback; greift bei Titel-Zeilen oder Quickwins mit genau 1 Guide-Zeile ohne `trophy_id`), (3b) `tb_apply_zh_fallback_for_game` (`zh` → `zh-hans`/`zh-hant` in `game_achievements` + `item_name`), (4) `tb_auto_release_locales`. Überspringt sich selbst, wenn `tb.auto_release_running = '1'` (Re-Entrance-Schutz).
- **`tb_source_lang_for_game(p_status jsonb) → text`** – Quellsprache nach Regel 0: `de` → `en` → `es` → `pt` → jede weitere `guide_<lang> = 'PUBLISHED'`; `null`, wenn nirgends veröffentlicht.
- **`tb_auto_release_locales(p_game_id uuid) → jsonb`** – Loop über ALLE 16 Zielsprachen (`de, en, es, pt, fr, it, nl, pl, ru, ja, ko, zh-hans, zh-hant, fi, sv, ar`, inkl. `de`, falls Quelle z. B. `en` ist), ruft je Sprache `tb_check_and_publish_locale`. Läuft nur bei `pg_trigger_depth() <= 1`, Re-Entrance-Schutz über `tb.auto_release_running`. Wird aufgerufen von Stage 1 (Stufe 4) und den Text-Triggern `games_auto_release_on_texts` / `game_achievements_auto_release_on_tips` (letzterer Statement-Level mit Transition-Tables, prüft nur Spiele mit tatsächlich geänderten Tipps; beide pausieren, solange `tb.stage1_running = '1'`).
- **`tb_check_and_publish_locale(p_game_id uuid, p_target_lang text, p_auto_publish bool = true) → jsonb`** – Quelle = `tb_source_lang_for_game(status)` (sprachagnostisch). **Keine `guide_rows`-Sperre** (Regel 0). Verlangt 0 fehlende Übersetzungen in den Feldern, die in der Quellsprache belegt sind: `beschreibung`, `status_explanation_localized`, `item_name`, `chronological_group` (Tab 1/3), `category_group` (Tab 2), `spiel_region`, `guide_tip`, `"Guide-Tip-lang"`. **Weiche:** Ziel `de`/`en`, `is_indexable = false` oder `spiel_typ ~* '(Quickwin|easy_platin|Servertot)'` → direkt `PUBLISHED`; sonst `READY` (Drip-Feed). Liefert `missing`-Objekt mit Zählern je Feld und `guide_rows` nur informativ.
- **`tb_drip_publish_guides(p_batch int)`** – Cron `tb-drip-publish-guides` (`15 */4 * * *`, Batch 3) hebt `READY` → `PUBLISHED`.
- **`tb_backfill_stage1_batch(p_after_id uuid = null, p_limit int = 200) → jsonb`** – Admin/Service-Helfer: ruft Stage 1 für alle in IRGENDEINER Sprache veröffentlichten Spiele (`tb_source_lang_for_game(status) is not null`, `order by id`, Cursor über `last_id`), setzt transaktionslokal `request.jwt.claim.role = service_role` (umgeht `enforce_published_guide_lock`). Rückgabe `{ processed, last_id, remaining, seconds }`. Batches von 500 brauchen ca. 35–60 s. NIE zwei Backfills parallel starten (Deadlock auf `games`).
- **Publish-Stand 10/2026 (nach Admin-Gate-Backfill):** de 2.941, en 2.919, es 2.458, pt 2.456, fr/nl/pl 1.398, it 1.397, ja/ko/ru/zh-hans/zh-hant 1.396, fi/sv 2. Rest-Blocker: `beschreibung` nur in de/en/es/pt übersetzt, `guide_tip` redaktionell nur de/en – beides löst sich per Text-Trigger automatisch auf, sobald Übersetzungen geschrieben werden.
- **`move_staging_to_rohmaterial(p_game_id uuid, p_creator_name text = null, p_prod_note text = …, p_lang text = 'de') → …`** – Verschiebt `staging_game_guides` → `game_guides_rohmaterial` (`batch_status = 'MATCHED'`). Die Notiz landet in `games.status->>'rohmaterial_note'` (Spalte `games.prod_note` existiert nicht mehr; `staging_game_guides.sheet_type`/`.beschreibung` ebenfalls entfernt).
- **`tb_sitemap_locale(p_locale text, p_limit int = 10000) → (slug, hardware, spiel_typ, is_indexable, created_at)`** – Einzige Datenquelle von `server/sitemap.js` (RPC-Aufruf, kein PostgREST-Filter mehr). Liefert pro Locale alle `is_indexable`-Spiele mit `status->>'guide_<locale>' = 'PUBLISHED'`, ohne Quickwin/easy_platin/Servertot/Unlesbar, `btrim(slug) <> ''`, gedeckelt auf 10.000. Die 3 Hub-URLs je Sprache (und `/` nur für `de`) hängt `server/sitemap.js` statisch an. Index-Stütze: `games_status_guide_<locale>_pub_idx` je Locale (siehe `supabase/games_sitemap_locale_idx.sql`).

