  const toggleGuideItem = (idOrIds, forceState) => {
    setCompletedItems((prev) => {
      const next = { ...prev };
      const ids = Array.isArray(idOrIds) ? idOrIds : [idOrIds];
      for (const id of ids) {
        if (!id) continue;
        const targetState = typeof forceState === 'boolean' ? forceState : !prev[id];
        if (targetState) {
