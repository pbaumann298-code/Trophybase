/* WinForms VB2006 – kompakt, Massenabfertigung */
.qa-shell {
  font-family: Tahoma, 'MS Sans Serif', Arial, sans-serif;
  font-size: 10px;
  background: #ece9d8;
  color: #000;
  max-width: 1400px;
  margin: 0 auto;
  padding: 4px;
  border: 2px outset #fff;
  height: 100vh;
  overflow: hidden; /* Persona1: kein Browser-Scroll */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.qa-titlebar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(180deg, #0a246a 0%, #3a6ea5 100%);
  color: #fff;
  padding: 3px 6px;
  font-weight: bold;
  margin-bottom: 4px;
  flex-shrink: 0;
}

.qa-titlebar-right {
  display: flex;
  gap: 10px;
  align-items: center;
  font-weight: normal;
}

.qa-kbd-hint {
  font-size: 9px;
  opacity: 0.9;
  border: 1px solid rgba(255, 255, 255, 0.45);
  padding: 1px 4px;
  background: rgba(0, 0, 0, 0.15);
  cursor: help;
  white-space: nowrap;
}

.qa-link {
  background: transparent;
  border: none;
  color: #fff;
  text-decoration: underline;
  cursor: pointer;
  font-size: 11px;
}

.qa-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  padding: 2px 4px;
  background: #fff;
  border: 1px solid #7f9db9;
  margin-bottom: 2px;
  flex-shrink: 0;
}

.qa-npwr {
  font-family: Consolas, 'Courier New', monospace;
  font-weight: bold;
  font-size: 12px;
}

.qa-tag {
  color: #333;
}

.qa-pipe {
  color: #999;
}

.qa-status {
  margin-left: auto;
  text-transform: uppercase;
  font-weight: bold;
  color: #c00;
}

.qa-game-title {
  font-size: 14px;
  font-weight: bold;
  margin: 0 0 4px;
  padding: 2px 4px;
  background: #ffffe1;
  border: 1px solid #aca899;
  flex-shrink: 0;
  overflow: hidden;
}

.qa-ellipsis {
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.qa-workspace {
  display: grid;
  grid-template-columns: 1fr 1fr 1.1fr;
  gap: 4px;
  flex: 1;
  min-height: 0;
}

@media (max-width: 768px) {
  .qa-workspace {
    grid-template-columns: 1fr;
  }
  .qa-shell {
    overflow: auto;
  }
}

.qa-panel {
  border: 1px solid #7f9db9;
  background: #fff;
  margin: 0;
  padding: 4px;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.qa-panel legend {
  padding: 0 4px;
  font-weight: bold;
}

.qa-panel-body {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.qa-errors-body {
  padding-right: 2px;
}

.qa-errors-pre {
  margin: 0;
  padding: 2px;
  height: 100%;
  box-sizing: border-box;
  font-family: Consolas, monospace;
  font-size: 10px;
  line-height: 1.15;
  border: 1px inset #fff;
  background: #fff;
  white-space: pre-wrap;
  overflow: hidden;
  display: block;
  cursor: help;
}

.qa-version-options {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.qa-version-option {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  padding: 3px;
  border: 1px solid transparent;
  cursor: pointer;
  border-radius: 2px;
  user-select: none;
}

.qa-version-option:hover {
  background: #316ac5;
  color: #fff;
}

.qa-version-option:hover .qa-version-sub,
.qa-version-option:hover .qa-version-title {
  color: #fff;
}

.qa-disabled {
  opacity: 0.45;
  cursor: not-allowed;
  background: #f6f6f6;
}

.qa-disabled:hover {
  background: #f6f6f6;
  color: inherit;
}

.qa-disabled:hover .qa-version-sub,
.qa-disabled:hover .qa-version-title {
  color: #444;
}

.qa-selected {
  border-color: #316ac5;
  background: #dbe7ff;
}

.qa-version-badge {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 2px;
  font-weight: bold;
  border: 1px solid #000;
  padding: 1px 4px;
  font-size: 10px;
  min-width: 64px;
}

.qa-keycap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 14px;
  height: 14px;
  font-size: 9px;
  font-weight: bold;
  background: #fff;
  color: #000;
  border: 1px solid #666;
  border-radius: 2px;
  box-shadow: 0 1px 0 #999;
  line-height: 1;
}

.qa-badge-ps3 {
  background: #ffd6d6;
}
.qa-badge-ps4 {
  background: #d6e9ff;
}
.qa-badge-remastered {
  background: #fff3cd;
}

.qa-version-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.qa-version-title {
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.1;
  display: block;
  cursor: help;
}

.qa-version-sub {
  font-size: 10px;
  color: #444;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
  cursor: help;
}

.qa-version-sub2 {
  opacity: 0.95;
}

.qa-version-thumb {
  width: 34px;
  height: 46px;
  object-fit: cover;
  border: 1px solid #000;
  flex-shrink: 0;
  background: #ddd;
}

.qa-version-thumb-empty {
  width: 34px;
  height: 46px;
  flex-shrink: 0;
  background: #ddd;
  border: 1px solid #999;
}

.qa-actions {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 4px;
  margin-top: 4px;
  flex-shrink: 0;
}

.qa-btn {
  font-family: Tahoma, sans-serif;
  font-size: 12px;
  font-weight: bold;
  padding: 10px 6px;
  border: 2px outset #fff;
  cursor: pointer;
  background: #ece9d8;
}

.qa-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.qa-btn:active:not(:disabled) {
  border-style: inset;
}

.qa-btn-ok {
  background: #d4edda;
}

.qa-btn-no {
  background: #f8d7da;
}

.qa-btn-later {
  background: #fff3cd;
}

.qa-btn-kbd {
  display: inline-block;
  margin-left: 4px;
  font-size: 9px;
  font-weight: normal;
