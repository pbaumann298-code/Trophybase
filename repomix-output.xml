      public.tb_home_game_payload(
        g.id, g.platform_game_id, g.hardware, g.entwickler, g.home_tags, g.spiel_typ,
        g.status, g.slug, g.created_at, coalesce(g.views, 0), g.spieltitel, g.cover_url
