<file path="src/lib/trophyTypes.js">
import bronzeIcon from '../assets/trophies/bronze.png';
import silverIcon from '../assets/trophies/silver.png';
import goldIcon from '../assets/trophies/gold.png';
import platinumIcon from '../assets/trophies/platinum.png';

/**
 * Trophäenstufen als eigene Icons.
 *
 * game_achievements.trophy_type kommt aus der Pipeline uneinheitlich: der
 * Altbestand englisch (BRONZE / SILVER / GOLD / PLATINUM), neuere Uploads
 * deutsch (SILBER / PLATIN) – in Bloodborne stehen SILBER und SILVER sogar
 * gemischt in derselben Trophäenliste. Deshalb wird der Rohwert nie angezeigt,
 * sondern immer erst hier normalisiert.
 */
export const TROPHY_TYPE = {
  BRONZE: 'bronze',
  SILVER: 'silver',
  GOLD: 'gold',
  PLATINUM: 'platinum',
};

/** Rohwerte aus der Pipeline in de / en / es. */
const TYPE_BY_RAW = new Map([
  ['BRONZE', TROPHY_TYPE.BRONZE],
  ['BRONCE', TROPHY_TYPE.BRONZE],
  ['SILVER', TROPHY_TYPE.SILVER],
  ['SILBER', TROPHY_TYPE.SILVER],
  ['PLATA', TROPHY_TYPE.SILVER],
  ['GOLD', TROPHY_TYPE.GOLD],
  ['ORO', TROPHY_TYPE.GOLD],
  ['PLATIN', TROPHY_TYPE.PLATINUM],
  ['PLATINUM', TROPHY_TYPE.PLATINUM],
  ['PLATINO', TROPHY_TYPE.PLATINUM],
]);

const ICON_BY_TYPE = {
  [TROPHY_TYPE.BRONZE]: bronzeIcon,
  [TROPHY_TYPE.SILVER]: silverIcon,
  [TROPHY_TYPE.GOLD]: goldIcon,
  [TROPHY_TYPE.PLATINUM]: platinumIcon,
};

const LABEL_BY_TYPE = {
  [TROPHY_TYPE.BRONZE]: 'Bronze',
  [TROPHY_TYPE.SILVER]: 'Silber',
  [TROPHY_TYPE.GOLD]: 'Gold',
  [TROPHY_TYPE.PLATINUM]: 'Platin',
};

/**
 * @param {unknown} value trophy_type aus game_achievements
 * @returns {'bronze'|'silver'|'gold'|'platinum'|''} leer, wenn unbekannt
 */
export function normalizeTrophyType(value) {
  const raw = String(value ?? '').trim().toUpperCase();
  if (!raw) return '';
  return TYPE_BY_RAW.get(raw) ?? '';
}

/**
 * Icon-URL der Trophäenstufe. Dient doppelt: als Stufen-Abzeichen und als
 * Rückfall, wenn Sony das Original-Bild gelöscht hat.
 * @param {unknown} value trophy_type (roh oder normalisiert)
 * @returns {string} leer, wenn die Stufe unbekannt ist
 */
export function trophyTypeIcon(value) {
  const type = normalizeTrophyType(value) || (ICON_BY_TYPE[value] ? value : '');
  return type ? ICON_BY_TYPE[type] : '';
}

/**
 * @param {unknown} value
 * @returns {string}
 */
export function trophyTypeLabel(value) {
  const type = normalizeTrophyType(value) || (LABEL_BY_TYPE[value] ? value : '');
  return type ? LABEL_BY_TYPE[type] : '';
}

export function isPlatinumTrophy(trophy) {
  return normalizeTrophyType(trophy?.trophy_type) === TROPHY_TYPE.PLATINUM;
}

function trophyKey(trophy) {
  return String(
    trophy?.platform_achievement_id ?? trophy?.trophy_id ?? trophy?.id ?? '',
  ).trim();
}

/**
 * Platin abhaken → alle übrigen Trophäen mit abhaken.
 * Platin abwählen → nur die Platin selbst.
 * @param {Record<string, boolean>} prev
 * @param {string} id platform_achievement_id
 * @param {object[]} trophies
 * @param {Set<string>} [earnedIds]
 */
export function applyTrophyUnlockToggle(prev, id, trophies, earnedIds) {
  const key = String(id ?? '').trim();
  const earned = earnedIds instanceof Set ? earnedIds : new Set();
  if (!key || earned.has(key)) return prev ?? {};

  const list = Array.isArray(trophies) ? trophies : [];
  const target = list.find((trophy) => trophyKey(trophy) === key);
  const turningOn = !prev?.[key];

  if (turningOn && isPlatinumTrophy(target)) {
    const next = { ...(prev ?? {}) };
    for (const trophy of list) {
      const trophyId = trophyKey(trophy);
      if (!trophyId || earned.has(trophyId)) continue;
      next[trophyId] = true;
    }
    return next;
  }

  const next = { ...(prev ?? {}), [key]: turningOn };
  if (!next[key]) delete next[key];
  return next;
}

/**
 * Platin verdient (PSN) oder manuell abgehakt?
 * @param {object[]} trophies
 * @param {Record<string, boolean>} unlockedMap
 * @param {Set<string>} [earnedIds]
 */
export function isPlatinumUnlocked(trophies, unlockedMap, earnedIds) {
  const earned = earnedIds instanceof Set ? earnedIds : new Set();
  const platinum = (trophies ?? []).find(isPlatinumTrophy);
  if (!platinum) return false;
  const key = trophyKey(platinum);
  if (!key) return false;
  return earned.has(key) || Boolean(unlockedMap?.[key]);
}
</file>

<file path="src/lib/userGameSettingsQueries.js">
import { TABLES, GAME_FK } from './gameSchema';
import { isUuid } from './gameModel';

export const GAME_SETTINGS = {
  hidden: 'is_hidden',
  onConflict: 'user_id,game_id',
};

/**
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} userId
 * @returns {Promise<{ ids: string[], error: Error|null }>}
 */
export async function fetchHiddenGameIds(supabase, userId) {
  if (!userId) return { ids: [], error: null };

  const { data, error } = await supabase
    .from(TABLES.gameSettings)
    .select(GAME_FK)
    .eq('user_id', userId)
    .eq(GAME_SETTINGS.hidden, true);

  if (error) return { ids: [], error };

  const ids = [];
  const seen = new Set();
  for (const row of data ?? []) {
    const id = String(row?.[GAME_FK] ?? '').trim();
    if (!isUuid(id) || seen.has(id)) continue;
    seen.add(id);
    ids.push(id);
  }
  return { ids, error: null };
}

/**
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} userId
 * @param {string} gameId
 * @param {boolean} isHidden
 */
export async function upsertGameHidden(supabase, userId, gameId, isHidden) {
  if (!userId || !isUuid(gameId)) {
    return { error: new Error('Anmeldung und Spiel-ID erforderlich') };
  }

  if (!isHidden) {
    const { error } = await supabase
      .from(TABLES.gameSettings)
      .delete()
      .eq('user_id', userId)
      .eq(GAME_FK, gameId);
    return { error };
  }

  const { error } = await supabase.from(TABLES.gameSettings).upsert(
    {
      user_id: userId,
      [GAME_FK]: gameId,
      [GAME_SETTINGS.hidden]: true,
    },
    { onConflict: GAME_SETTINGS.onConflict },
  );
  return { error };
}
