    saw_404 = False

    url_probe = f"https://m.np.playstation.com/api/trophy/v1/npCommunicationIds/{primary_npwr}/trophyGroups"
    for svc in services:
        res_check = sony_get(url_probe, first_accept, svc)
        if res_check and res_check.status_code == 200:
