<file path="src/components/intranet/IntranetCreatorSearch.jsx">
import { useState } from 'react';
import { supabase } from '../../pages/supabaseClient';
import { handleStaffGamePreviewClick } from '../../lib/adminAccess';
import { getPlatformGameIds } from '../../lib/gameModel';
import { formatPipelineStatus } from '../../lib/gamePipelineStatus';
import {
  formatIntranetTitles,
  intranetGameHref,
  searchIntranetCreators,
} from '../../lib/intranetQueries';

const FIELD_CLASS =
  'bg-[#121314] border border-zinc-800 rounded-xl px-3 py-2 text-sm text-zinc-200 focus:outline-hidden focus:border-[#00ff66]/40 w-full';

function emptyFilters() {
  return {
    channelName: '',
    youtubeUrl: '',
    gameTitle: '',
  };
}

function IntranetCreatorSearch() {
  const [filters, setFilters] = useState(emptyFilters);
  const [results, setResults] = useState([]);
  const [loading, setLoading] = useState(false);
  const [hasSearched, setHasSearched] = useState(false);
  const [errorMessage, setErrorMessage] = useState('');

  const updateField = (key) => (event) => {
    setFilters((prev) => ({ ...prev, [key]: event.target.value }));
  };

  const runSearch = async (nextFilters) => {
    setLoading(true);
    setErrorMessage('');
    setHasSearched(true);

    try {
      const { data, error } = await searchIntranetCreators(supabase, nextFilters);
      if (error) {
        setErrorMessage(error.message || 'Suche fehlgeschlagen.');
        setResults([]);
      } else {
        setResults(Array.isArray(data) ? data : []);
      }
    } catch (err) {
      setErrorMessage(err?.message || 'Suche fehlgeschlagen.');
      setResults([]);
    } finally {
      setLoading(false);
    }
  };

  const handleSubmit = (event) => {
    event.preventDefault();
    runSearch(filters);
  };

  const handleReset = () => {
    setFilters(emptyFilters());
    setResults([]);
    setHasSearched(false);
    setErrorMessage('');
  };

  const mappedCount = results.reduce((sum, creator) => sum + creator.games.length, 0);

  return (
    <section className="space-y-6">
      <div>
        <h2 className="text-lg font-bold text-white mb-1">Creator</h2>
        <p className="text-sm text-zinc-500 max-w-3xl leading-relaxed">
          Zeigt über <span className="text-zinc-400 font-mono">game_guides.creator_id</span>, welche
          Spiele an welchen Creator hängen — inklusive Status aus der Datenbank. Ohne Filter:
          alle Zuordnungen.
        </p>
      </div>

      <form
        onSubmit={handleSubmit}
        className="rounded-2xl border border-zinc-800 bg-[#1a1b1c] p-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
      >
        <label className="flex flex-col gap-1.5 min-w-0">
          <span className="text-[10px] font-mono font-bold uppercase tracking-wider text-zinc-500">
            channel_name
          </span>
          <input
            type="text"
            value={filters.channelName}
            onChange={updateField('channelName')}
            autoComplete="off"
            className={FIELD_CLASS}
          />
        </label>
        <label className="flex flex-col gap-1.5 min-w-0">
          <span className="text-[10px] font-mono font-bold uppercase tracking-wider text-zinc-500">
            youtube_url
          </span>
          <input
            type="text"
            value={filters.youtubeUrl}
            onChange={updateField('youtubeUrl')}
            autoComplete="off"
            className={FIELD_CLASS}
          />
        </label>
        <label className="flex flex-col gap-1.5 min-w-0">
          <span className="text-[10px] font-mono font-bold uppercase tracking-wider text-zinc-500">
            Spieltitel
          </span>
          <input
            type="text"
            value={filters.gameTitle}
            onChange={updateField('gameTitle')}
            autoComplete="off"
            className={FIELD_CLASS}
          />
        </label>
        <div className="sm:col-span-2 lg:col-span-3 flex flex-wrap gap-2 pt-1">
          <button
            type="submit"
            disabled={loading}
            className="px-5 py-2.5 rounded-xl bg-[#00ff66] text-[#121314] text-xs font-bold uppercase tracking-wider hover:bg-[#00dd55] disabled:opacity-50"
          >
            {loading ? 'Suche…' : 'Suchen'}
          </button>
          <button
            type="button"
            onClick={handleReset}
            className="px-5 py-2.5 rounded-xl border border-zinc-700 text-zinc-400 text-xs font-bold uppercase tracking-wider hover:text-white"
          >
            Zurücksetzen
          </button>
        </div>
      </form>

      {errorMessage ? (
        <p className="text-xs text-red-400 bg-red-500/10 border border-red-500/25 rounded-lg px-3 py-2">
          {errorMessage}
        </p>
      ) : null}

      {hasSearched && !loading && (
        <p className="text-[11px] font-mono text-zinc-500">
          {results.length} Creator · {mappedCount} Spiel-Zuordnungen
        </p>
      )}

      <div className="space-y-4">
        {results.map((creator) => (
          <article
            key={creator.id || creator.channelName}
            className="rounded-2xl border border-zinc-800 bg-[#1a1b1c] overflow-hidden"
          >
            <div className="px-5 py-4 border-b border-zinc-800 flex flex-wrap items-center justify-between gap-3">
              <div>
                <h3 className="text-sm font-bold text-white">{creator.channelName || '—'}</h3>
                <p className="text-[11px] font-mono text-zinc-600 mt-0.5 break-all">
                  {creator.youtubeUrl || 'kein YouTube-Link'}
                </p>
              </div>
              <div className="flex items-center gap-2">
                <span className="text-[10px] font-mono uppercase tracking-wider text-zinc-500">
                  {creator.games.length} Spiel{creator.games.length === 1 ? '' : 'e'}
                </span>
                {creator.youtubeUrl ? (
                  <a
                    href={creator.youtubeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="inline-flex items-center rounded-lg bg-[#ff0000] text-white text-[10px] font-bold uppercase tracking-wider px-3 py-1.5 hover:bg-[#e00000]"
                  >
                    YouTube
                  </a>
                ) : null}
              </div>
            </div>

            {creator.games.length === 0 ? (
              <p className="px-5 py-4 text-sm text-zinc-500">Keine Spiele zugeordnet.</p>
            ) : (
              <div className="overflow-x-auto">
                <table className="min-w-full text-left text-xs">
                  <thead className="text-[10px] font-mono uppercase tracking-wider text-zinc-500">
                    <tr>
                      <th className="px-5 py-2 font-medium">spieltitel</th>
                      <th className="px-3 py-2 font-medium">hardware</th>
                      <th className="px-3 py-2 font-medium">status</th>
                      <th className="px-3 py-2 font-medium">spiel_typ</th>
                      <th className="px-3 py-2 font-medium">platform_game_id</th>
                      <th className="px-3 py-2 font-medium"></th>
                    </tr>
                  </thead>
                  <tbody>
                    {creator.games.map((game) => {
                      const href = intranetGameHref(game);
                      return (
                        <tr key={`${creator.id}-${game.id}`} className="border-t border-zinc-800/80">
                          <td className="px-5 py-2 text-zinc-200 max-w-[20rem]">
                            {formatIntranetTitles(game.spieltitel)}
                          </td>
                          <td className="px-3 py-2 text-sky-300 whitespace-nowrap">{game.hardware || '—'}</td>
                          <td className="px-3 py-2 max-w-[18rem]">
                            <span className="text-[10px] font-mono tracking-wide text-zinc-400 break-words">
                              {formatPipelineStatus(game.status)}
                            </span>
                          </td>
                          <td className="px-3 py-2 text-zinc-400 whitespace-nowrap">{game.spiel_typ || '—'}</td>
                          <td className="px-3 py-2 font-mono text-[10px] text-zinc-600">
                            {getPlatformGameIds(game).length > 0 ? (
                              <div className="flex flex-col gap-0.5">
                                {getPlatformGameIds(game).map((id) => (
                                  <span key={id} className="whitespace-nowrap">{id}</span>
                                ))}
                              </div>
                            ) : '—'}
                          </td>
                          <td className="px-3 py-2 whitespace-nowrap">
                            {href ? (
                              <a
                                href={href}
                                target="_blank"
                                rel="noopener noreferrer"
                                onClick={(event) => handleStaffGamePreviewClick(event, href)}
                                className="text-[10px] font-bold uppercase tracking-wider text-[#00ff66] hover:underline"
                              >
                                Öffnen
                              </a>
                            ) : null}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            )}
          </article>
        ))}
      </div>

      {hasSearched && !loading && results.length === 0 && !errorMessage && (
        <p className="text-sm text-zinc-500">Keine Creator-Zuordnungen gefunden.</p>
      )}
    </section>
  );
}

export default IntranetCreatorSearch;
</file>

<file path="src/components/intranet/IntranetKrankenstation.jsx">
import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
import { supabase } from '../../pages/supabaseClient';

const VIEW = 'v_krankenstation_denglisch_guides';
const RPC = 'tb_resolve_denglisch_guide';
const ROW_LIMIT = 1000;

const COLUMNS = [
  'row_uuid',
  'game_id',
  'spieltitel',
  'spiel_typ',
  'hardware',
  'verdachts_zeilen_im_spiel',
  'guide_id',
  'trophy_id',
  'text_de',
  'text_en',
].join(', ');

const collator = new Intl.Collator('de', { numeric: true, sensitivity: 'base' });

function cellText(value) {
  const text = String(value ?? '').trim();
  return text || '—';
}

function withoutRow(list, rowUuid) {
  const hit = list.find((row) => row.row_uuid === rowUuid);
  if (!hit) return list;
  return list
    .filter((row) => row.row_uuid !== rowUuid)
    .map((row) => (
      row.game_id === hit.game_id
        ? {
            ...row,
            verdachts_zeilen_im_spiel: Math.max(0, Number(row.verdachts_zeilen_im_spiel || 0) - 1),
          }
        : row
    ));
}

function restoreRows(list, removed) {
  if (!removed?.length) return list;
  const present = new Set(list.map((row) => row.row_uuid));
  const missing = removed.filter((row) => row?.row_uuid && !present.has(row.row_uuid));
  if (!missing.length) return list;
  const gameId = missing[0].game_id;
  const siblingsLeft = list.some((row) => row.game_id === gameId);
  if (!siblingsLeft) return [...missing, ...list];
  const bumped = list.map((row) => (
    row.game_id === gameId
      ? {
          ...row,
          verdachts_zeilen_im_spiel: Number(row.verdachts_zeilen_im_spiel || 0) + missing.length,
        }
      : row
  ));
  return [...missing, ...bumped];
}

function ActionButton({ children, title, onClick, tone = 'zinc' }) {
  const toneClass = tone === 'green'
    ? 'border-[#00ff66]/40 text-[#00ff66] hover:bg-[#00ff66]/10'
    : tone === 'red'
      ? 'border-red-500/40 text-red-300 hover:bg-red-500/10'
      : 'border-sky-500/40 text-sky-200 hover:bg-sky-500/10';
  return (
    <button
      type="button"
      title={title}
      onClick={onClick}
      className={`rounded-lg border bg-zinc-950/80 px-2 py-1 text-[10px] font-bold uppercase tracking-wide ${toneClass}`}
    >
      {children}
    </button>
  );
}

/**
 * Krankenstation-Reiter: DE-Guidezeilen, deren deutscher Text wie Englisch aussieht.
 * Batch-Aktionen schicken `p_row_uuid: null`, Zeilen-Buttons die `row_uuid`.
 */
export default function IntranetKrankenstation({ reloadToken = 0, onCount }) {
  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [capped, setCapped] = useState(false);
  const rowsRef = useRef([]);

  const commit = useCallback((next) => {
    rowsRef.current = next;
    setRows(next);
    onCount?.(next.length);
  }, [onCount]);

  useEffect(() => {
    let cancelled = false;
    supabase
      .from(VIEW)
      .select(COLUMNS)
      .order('verdachts_zeilen_im_spiel', { ascending: false })
      .limit(ROW_LIMIT)
      .then(({ data, error: loadError }) => {
        if (cancelled) return;
        if (loadError) {
          setError(loadError.message || 'Denglisch-Liste konnte nicht geladen werden.');
          commit([]);
        } else {
          const next = data ?? [];
          setError('');
          setCapped(next.length >= ROW_LIMIT);
          commit(next);
        }
        setLoading(false);
      });
    return () => {
      cancelled = true;
    };
  }, [reloadToken, commit]);

  const games = useMemo(() => {
    const groups = new Map();
    for (const row of rows) {
      const id = String(row.game_id ?? '');
      if (!id) continue;
      let group = groups.get(id);
      if (!group) {
        group = {
          game_id: id,
          spieltitel: cellText(row.spieltitel),
          spiel_typ: cellText(row.spiel_typ),
          hardware: cellText(row.hardware),
          verdachts_zeilen_im_spiel: Number(row.verdachts_zeilen_im_spiel || 0),
          rows: [],
        };
        groups.set(id, group);
      }
      group.verdachts_zeilen_im_spiel = Math.max(
        group.verdachts_zeilen_im_spiel,
        Number(row.verdachts_zeilen_im_spiel || 0),
      );
      group.rows.push(row);
    }
    for (const group of groups.values()) {
      group.rows.sort((a, b) => collator.compare(String(a.guide_id ?? ''), String(b.guide_id ?? '')));
    }
    return [...groups.values()].sort(
      (a, b) => b.verdachts_zeilen_im_spiel - a.verdachts_zeilen_im_spiel
        || collator.compare(a.spieltitel, b.spieltitel),
    );
  }, [rows]);

  const resolve = async (gameId, action, rowUuid) => {
    const prev = rowsRef.current;
    const removed = rowUuid
      ? prev.filter((row) => row.row_uuid === rowUuid)
      : prev.filter((row) => row.game_id === gameId);
    if (!removed.length) return;

    commit(rowUuid ? withoutRow(prev, rowUuid) : prev.filter((row) => row.game_id !== gameId));
    setError('');

    const { error: rpcError } = await supabase.rpc(RPC, {
      p_game_id: gameId,
      p_action: action,
      p_row_uuid: rowUuid,
    });
    if (rpcError) {
      commit(restoreRows(rowsRef.current, removed));
      setError(rpcError.message || 'Aktion fehlgeschlagen.');
    }
  };

  if (loading && rows.length === 0) {
    return <p className="font-mono text-sm text-zinc-500">Denglisch-Check wird geladen…</p>;
  }

  return (
    <div className="space-y-4">
      <p className="max-w-3xl text-xs leading-relaxed text-zinc-500">
        Guide-Zeilen, deren deutscher Text dem englischen entspricht. Ein Klick nimmt die Zeile
        sofort aus der Liste. Schlägt die Aktion fehl, kommt sie zurück.
      </p>
      {capped ? (
        <p className="rounded border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-xs text-amber-200">
          Es werden die ersten {ROW_LIMIT} Verdachtszeilen gezeigt, die schwersten Spiele zuerst.
        </p>
      ) : null}
      {error ? (
        <p className="rounded border border-red-500/30 bg-red-500/10 px-3 py-2 text-xs text-red-200">{error}</p>
      ) : null}
      {!loading && games.length === 0 ? (
        <p className="rounded-xl border border-zinc-800 bg-zinc-950/60 px-4 py-10 text-center text-xs text-zinc-500">
          Keine verdächtigen DE/EN-Zeilen.
        </p>
      ) : null}

      {games.map((game) => (
        <article key={game.game_id} className="overflow-hidden rounded-2xl border border-zinc-800 bg-[#141516]">
          <header className="flex flex-col gap-3 border-b border-zinc-800 px-4 py-3 lg:flex-row lg:items-center lg:justify-between">
            <div className="min-w-0 space-y-1">
              <h3 className="text-sm font-bold text-white">{game.spieltitel}</h3>
              <div className="flex flex-wrap items-center gap-1.5">
                <span className="rounded-full border border-sky-500/40 bg-sky-500/10 px-2 py-0.5 font-mono text-[10px] font-bold uppercase text-sky-200">
                  {game.hardware}
                </span>
                <span className="rounded-full border border-zinc-700 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-zinc-400">
                  {game.spiel_typ}
                </span>
                <span className="rounded-full border border-amber-500/40 bg-amber-500/10 px-2 py-0.5 text-[10px] font-bold text-amber-200">
                  {game.verdachts_zeilen_im_spiel} verdächtige Zeilen
                </span>
              </div>
            </div>
            <div className="flex flex-wrap gap-1.5">
              <ActionButton
                title="Alle DE-Texte dieses Spiels nach EN schieben und DE neu übersetzen lassen"
                onClick={() => resolve(game.game_id, 'MOVE_DE_TO_EN', null)}
              >
                ➡️ Alle DE → EN schieben & DE neu übersetzen
              </ActionButton>
              <ActionButton
                tone="red"
                title="Deutschen Text aller Verdachtszeilen dieses Spiels leeren"
                onClick={() => resolve(game.game_id, 'DELETE_DE', null)}
              >
                🗑️ Alle DE leeren
              </ActionButton>
              <ActionButton
                tone="green"
                title="Alle Verdachtszeilen dieses Spiels als gewolltes Denglisch markieren"
                onClick={() => resolve(game.game_id, 'MARK_OK', null)}
              >
                ✅ Ganzes Spiel ist Denglisch (Ignorieren)
              </ActionButton>
            </div>
          </header>

          <div className="overflow-x-auto">
            <table className="w-full min-w-[860px] text-left text-xs">
              <thead className="bg-[#121314] text-[10px] uppercase tracking-wider text-zinc-500">
                <tr>
                  <th className="px-3 py-2 font-medium">Guide-ID</th>
                  <th className="px-3 py-2 font-medium">Trophäen-ID</th>
                  <th className="px-3 py-2 font-medium">🇩🇪 Aktuell in DE</th>
                  <th className="px-3 py-2 font-medium">🇬🇧 Aktuell in EN</th>
                  <th className="px-3 py-2 font-medium text-right">Zeile</th>
                </tr>
              </thead>
              <tbody>
                {game.rows.map((row) => (
                  <tr key={row.row_uuid} className="border-t border-zinc-800/80 align-top">
                    <td className="px-3 py-2 font-mono text-[11px] text-zinc-400">{cellText(row.guide_id)}</td>
                    <td className="px-3 py-2 font-mono text-[11px] text-zinc-500">{cellText(row.trophy_id)}</td>
                    <td className="max-w-xs px-3 py-2 whitespace-pre-wrap text-zinc-100">{cellText(row.text_de)}</td>
                    <td className="max-w-xs px-3 py-2 whitespace-pre-wrap text-zinc-400">{cellText(row.text_en)}</td>
                    <td className="px-3 py-2">
                      <div className="flex flex-wrap justify-end gap-1">
                        <ActionButton
                          title="Deutschen Text dieser Zeile nach EN schieben"
                          onClick={() => resolve(game.game_id, 'MOVE_DE_TO_EN', row.row_uuid)}
                        >
                          [➡️ DE→EN]
                        </ActionButton>
                        <ActionButton
                          tone="red"
                          title="Deutschen Text dieser Zeile leeren"
                          onClick={() => resolve(game.game_id, 'DELETE_DE', row.row_uuid)}
                        >
                          [🗑️ DE löschen]
                        </ActionButton>
                        <ActionButton
                          tone="green"
                          title="Diese Zeile ist gewolltes Denglisch"
                          onClick={() => resolve(game.game_id, 'MARK_OK', row.row_uuid)}
                        >
                          [✅ Ist Denglisch]
                        </ActionButton>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>
      ))}
    </div>
  );
}
