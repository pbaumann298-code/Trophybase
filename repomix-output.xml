  GAME_STRUCT.totalOnlineTrophies,
  GAME_STRUCT.totalMissableTrophies,
  GAME_STRUCT.trophyCount,
  GAME_STRUCT.isSonyFallback,
  GAME_STRUCT.isAutoTranslated,
  GAME_STRUCT.originalLocale,
  GAME_STRUCT.createdAt,
