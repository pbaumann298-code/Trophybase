  /**
   * Ausführliche Fassung des Tipps. Spaltenname mit Bindestrichen und
   * Grossbuchstaben – in SQL/PostgREST zwingend in Anführungszeichen setzen.
   */
  guideTipLong: 'Guide-Tip-lang',
  aiTranslation: 'ai_translation',
