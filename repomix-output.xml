                t_desc = t.get("trophyDetail") or ""
                if t_name:
                    ach_patches[tid]["names"][l_key] = t_name
                if t_desc:
                    ach_patches[tid]["descs"][l_key] = t_desc

                pack_name = group_names.get(group_id) or group_names.get("default")
                if pack_name:
