      <div className="rounded-2xl border border-zinc-800 bg-[#1a1b1c] p-6 space-y-6">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h3 className="text-base font-bold text-white">
