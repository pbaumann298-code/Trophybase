                    className="rounded border border-[#00ff66]/40 bg-black/80 px-1.5 py-0.5 text-[9px] font-mono font-bold uppercase tracking-wider text-[#00ff66] hover:bg-[#00ff66]/15 disabled:opacity-50 cursor-pointer"
