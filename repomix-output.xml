                <tbody className="divide-y divide-zinc-800/70">
                  {dailySeries.length === 0 ? (
                    <tr>
                      <td colSpan={3} className="px-3 py-6 text-center text-zinc-500">
                        {loadingStats ? 'Lade Verlauf…' : 'Noch keine Tagesdaten.'}
