import { useEffect, useState } from 'react';
import { supabase } from '../../pages/supabaseClient';
import { fetchIntranetGamesByIds, formatIntranetTitles } from '../../lib/intranetQueries';
import { toggleAdminFollowup } from '../../lib/adminFollowups';
import { useAdminFollowups } from '../../hooks/useAdminFollowups';
import IntranetGameTable from './IntranetGameTable';

function IntranetFollowups({ sessionUser, onOpenInDrafts }) {
  const userId = sessionUser?.id ?? '';
  const { entries, error: followupError } = useAdminFollowups(userId);
  const [games, setGames] = useState([]);
  const [loading, setLoading] = useState(true);
  const [errorMessage, setErrorMessage] = useState('');

  const entryKey = entries.map((entry) => entry.id).join('|');

  useEffect(() => {
    let cancelled = false;
    const ids = entryKey ? entryKey.split('|') : [];

    async function load() {
      if (!ids.length) {
        setGames([]);
        setLoading(false);
        setErrorMessage('');
        return;
      }

      setLoading(true);
      setErrorMessage('');
      try {
        const { data, error } = await fetchIntranetGamesByIds(supabase, ids);
        if (cancelled) return;
        if (error) throw error;
        setGames(data);
      } catch (err) {
        console.error('Wiedervorlage Load Fehler:', err);
        if (!cancelled) {
          setErrorMessage(err?.message || 'Wiedervorlage konnte nicht geladen werden.');
          setGames([]);
        }
      } finally {
        if (!cancelled) {
          setLoading(false);
        }
      }
    }

    load();
    return () => {
      cancelled = true;
    };
  }, [entryKey]);

  const foundIds = new Set(games.map((game) => game.id));
  const missing = entries.filter((entry) => !foundIds.has(entry.id));

  const handlePatch = (gameId, partial) => {
    setGames((prev) => prev.map((game) => (game.id === gameId ? { ...game, ...partial } : game)));
  };

  return (
    <section className="space-y-6">
      <div>
        <h2 className="text-lg font-bold text-white mb-1">Wiedervorlage</h2>
        <p className="text-sm text-zinc-500 max-w-3xl leading-relaxed">
          Spiele, die beim Durchsehen des Guides noch eine Anpassung brauchen. Markieren geht
          hier über <span className="text-zinc-400">Merken</span> und in der Guide-Ansicht über
          <span className="text-zinc-400"> Zur Wiedervorlage</span>. Die Markierung bleibt
          gespeichert, bis sie wieder entfernt wird.
        </p>
      </div>

      {errorMessage || followupError ? (
        <p className="text-xs text-red-400 bg-red-500/10 border border-red-500/25 rounded-lg px-3 py-2">
          {errorMessage || followupError}
        </p>
      ) : null}

      {loading ? (
        <p className="text-sm text-zinc-500 font-mono">Wiedervorlage wird geladen…</p>
      ) : null}

      {!loading && entries.length === 0 ? (
        <p className="text-sm text-zinc-500">Noch keine Spiele auf der Wiedervorlage.</p>
      ) : null}

      {!loading && games.length > 0 ? (
        <IntranetGameTable
          games={games}
          sessionUser={sessionUser}
          onGamePatch={handlePatch}
          onOpenInDrafts={onOpenInDrafts}
        />
      ) : null}

      {!loading && missing.length > 0 ? (
        <div className="rounded-2xl border border-zinc-800 bg-[#1a1b1c] p-4 space-y-2">
          <p className="text-[10px] font-mono uppercase tracking-wider text-zinc-500">
            Nicht mehr in der Datenbank
          </p>
          {missing.map((entry) => {
            const label = formatIntranetTitles(entry.spieltitel);
            return (
            <div key={entry.id} className="flex items-center justify-between gap-3 text-sm">
              <span className="text-zinc-300">{label === '—' ? entry.id : label}</span>
              <button
                type="button"
                onClick={() => {
                  toggleAdminFollowup(userId, { id: entry.id }).catch((error) => {
                    setErrorMessage(error.message || 'Wiedervorlage konnte nicht entfernt werden.');
                  });
                }}
                className="text-[10px] font-bold uppercase tracking-wider text-zinc-400 hover:text-red-300"
              >
                Entfernen
              </button>
            </div>
            );
          })}
        </div>
      ) : null}
    </section>
  );
}

export default IntranetFollowups;
</file>

<file path="src/context/ProgressSyncContext.jsx">
import { createContext, useCallback, useContext, useEffect, useMemo, useRef, useState } from 'react';
import { supabase } from '../pages/supabaseClient';
import ProgressSyncPrompt from '../components/ProgressSyncPrompt';
import {
  applyProgressByGameToLocal,
  loadProgressOwner,
  mergeProgressByGame,
  planProgressSync,
  saveProgressOwner,
  scanLocalProgressByGame,
} from '../lib/localUserProgress';
import { setProgressCloudUser } from '../lib/progressCloudBridge';
import { setGameHiddenCloudUser } from '../lib/gameHiddenCloudBridge';
import {
  fetchUserGuideProgress,
  upsertUserGuideProgressBulk,
} from '../lib/userProgressQueries';
import { fetchHiddenGameIds, upsertGameHidden } from '../lib/userGameSettingsQueries';
import { isUuid } from '../lib/gameModel';
import { useVisibility } from './VisibilityContext';

const ProgressSyncContext = createContext(null);

export function ProgressSyncProvider({ sessionUser, authLoading = false, children }) {
  const userId = sessionUser?.id ?? null;
  const { listHiddenGameUuids, replaceHiddenGameUuids } = useVisibility();
  const [prompt, setPrompt] = useState(null);
  const [busy, setBusy] = useState(false);
  const runIdRef = useRef(0);

  const enableCloudPush = useCallback((id) => {
    setProgressCloudUser(id);
    setGameHiddenCloudUser(id);
    if (id) saveProgressOwner(id);
  }, []);

  const disableCloudPush = useCallback(() => {
    setProgressCloudUser(null);
    // Ausblenden darf weiter syncen, auch während der Fortschritts-Abfrage.
  }, []);

  useEffect(() => {
    if (authLoading) return undefined;
    if (!userId) {
      disableCloudPush();
      setGameHiddenCloudUser(null);
      setPrompt(null);
      return undefined;
    }

    setGameHiddenCloudUser(userId);

    const initialOwner = loadProgressOwner();
    if (initialOwner === userId) {
      enableCloudPush(userId);
    }

    let cancelled = false;
    const runId = ++runIdRef.current;

    async function reconcileHidden() {
      const { ids: cloudHidden, error } = await fetchHiddenGameIds(supabase, userId);
      if (cancelled || error) {
        if (error) console.warn('Spiel-Sichtbarkeit:', error.message);
        return;
      }
      const localHidden = listHiddenGameUuids().filter((id) => isUuid(id));
      const merged = new Set([...localHidden, ...cloudHidden]);
      replaceHiddenGameUuids(merged);
      const toPush = localHidden.filter((id) => !cloudHidden.includes(id));
      if (toPush.length > 0) {
        await Promise.all(toPush.map((id) => upsertGameHidden(supabase, userId, id, true)));
      }
    }

    async function reconcile() {
      void reconcileHidden();

      const localByGame = scanLocalProgressByGame();
      const { byGame: cloudByGame, error } = await fetchUserGuideProgress(supabase, userId);
      if (cancelled || runId !== runIdRef.current) return;

      if (error) {
        console.warn('Fortschritt-Sync:', error.message);
        // Ohne Cloud-Lesen nicht pushen – sonst könnten Profil-Daten überschrieben werden.
        disableCloudPush();
        return;
      }

      const plan = planProgressSync({
        localByGame,
        cloudByGame,
        owner: loadProgressOwner(),
        userId,
      });

      if (plan.action === 'noop') {
        enableCloudPush(userId);
        return;
      }

      if (plan.action === 'pull') {
        applyProgressByGameToLocal(cloudByGame, { replaceAll: true });
        enableCloudPush(userId);
        return;
      }

      if (plan.action === 'auto_merge') {
        const merged = mergeProgressByGame(localByGame, cloudByGame);
        const { error: mergeErr } = await upsertUserGuideProgressBulk(supabase, userId, merged);
        if (mergeErr) {
          console.warn('Fortschritt-Auto-Merge:', mergeErr.message);
        }
        applyProgressByGameToLocal(merged, { replaceAll: true });
        enableCloudPush(userId);
        return;
      }

      // prompt – Cloud-Push erst nach Entscheidung
      disableCloudPush();
      setPrompt({
        reason: plan.reason,
        localByGame: plan.localByGame,
        cloudByGame: plan.cloudByGame,
        localStats: plan.localStats,
        cloudStats: plan.cloudStats,
      });
    }

    reconcile().catch((err) => {
      if (!cancelled) {
        console.warn('Fortschritt-Sync:', err?.message || err);
        disableCloudPush();
      }
    });

    return () => {
      cancelled = true;
    };
  }, [userId, authLoading, enableCloudPush, disableCloudPush, listHiddenGameUuids, replaceHiddenGameUuids]);

  const acceptBrowser = useCallback(async () => {
    if (!userId || !prompt) return;
    setBusy(true);
    try {
      const merged = mergeProgressByGame(prompt.localByGame, prompt.cloudByGame);
      const { error } = await upsertUserGuideProgressBulk(supabase, userId, merged);
      if (error) {
        console.warn('Fortschritt-Sync:', error.message);
        setBusy(false);
        return;
      }
      applyProgressByGameToLocal(merged, { replaceAll: true });
      enableCloudPush(userId);
      setPrompt(null);
    } finally {
      setBusy(false);
    }
  }, [userId, prompt, enableCloudPush]);

  const declineBrowser = useCallback(() => {
    if (!userId || !prompt) return;
    setBusy(true);
    try {
      applyProgressByGameToLocal(prompt.cloudByGame, { replaceAll: true });
      enableCloudPush(userId);
      setPrompt(null);
    } finally {
      setBusy(false);
    }
  }, [userId, prompt, enableCloudPush]);

  const value = useMemo(
    () => ({
      progressSyncPending: Boolean(prompt),
    }),
    [prompt],
  );

  return (
    <ProgressSyncContext.Provider value={value}>
      {children}
      <ProgressSyncPrompt
        open={Boolean(prompt)}
        busy={busy}
        localStats={prompt?.localStats}
        cloudStats={prompt?.cloudStats}
        reason={prompt?.reason ?? ''}
        onAccept={acceptBrowser}
        onDecline={declineBrowser}
      />
    </ProgressSyncContext.Provider>
  );
}

export function useProgressSync() {
  return useContext(ProgressSyncContext);
}
