}

function deriveSheetTypesFromRow(row) {
  const types = [];
  if (getLocalizedItemName(row?.chronological_group).trim()) types.push(1);
  if (getLocalizedItemName(row?.category_group).trim()) types.push(2);
  if (getLocalizedItemName(row?.boss_group).trim()) types.push(3);
  if (types.length > 0) return types;
  const resolved = resolveSheetTypes(row?.sheet_type);
  return resolved.length > 0 ? resolved : [1];
}

/** spiel_region_tab: JSONB-Array [1], [2], [3] oder Kombinationen daraus. */
function normalizeSpielRegionTab(value) {
  return resolveSheetTypes(value).filter((tab) => tab === 1 || tab === 2 || tab === 3);
}

/**
 * Nach approve_staging_guide: Region und Reiter auf game_guides nachziehen,
 * falls die RPC die beiden Spalten noch nicht selbst kopiert hat.
 * Zuordnung über die numerische guide_id.
 */
async function writeSpielRegionOntoGameGuides(gameId, sourceRows, lang) {
  const pending = [];
  for (const row of sourceRows || []) {
    const name = getLocalizedItemName(row?.spiel_region).trim();
    const explicitTabs = normalizeSpielRegionTab(row?.spiel_region_tab);
    if (!name && explicitTabs.length === 0) continue;
    const guideKey = String(row?.guide_id ?? '').replace(/\D/g, '');
    if (!guideKey) continue;
    pending.push({
      guideKey,
      spiel_region: name ? { [lang]: name } : null,
      spiel_region_tab: explicitTabs.length > 0 ? explicitTabs : deriveSheetTypesFromRow(row),
    });
  }
  if (pending.length === 0) return;

  const liveByGuide = new Map();
  for (let from = 0; ; from += 1000) {
    const { data, error } = await supabase
      .from(TABLES.guides)
      .select('id, guide_id')
      .eq('game_id', gameId)
      .order('id', { ascending: true })
      .range(from, from + 999);
    if (error) throw new Error(`spiel_region Nach-Update: ${error.message}`);
    for (const live of data ?? []) {
      const key = String(live.guide_id ?? '').replace(/\D/g, '');
      if (!key) continue;
      const list = liveByGuide.get(key) || [];
      list.push(live.id);
      liveByGuide.set(key, list);
    }
    if ((data ?? []).length < 1000) break;
  }

  const groups = new Map();
  for (const item of pending) {
    const ids = liveByGuide.get(item.guideKey);
    const liveId = ids?.shift();
    if (!liveId) continue;
    const payload = { edit_unlocked: true };
    if (item.spiel_region) payload.spiel_region = item.spiel_region;
    if (item.spiel_region_tab?.length) payload.spiel_region_tab = item.spiel_region_tab;
    const key = JSON.stringify(payload);
    if (!groups.has(key)) groups.set(key, { payload, ids: [] });
    groups.get(key).ids.push(liveId);
  }

  for (const { payload, ids } of groups.values()) {
    for (let i = 0; i < ids.length; i += 100) {
      const chunk = ids.slice(i, i + 100);
      const { error } = await supabase.from(TABLES.guides).update(payload).in('id', chunk);
      if (error) throw new Error(`spiel_region Nach-Update: ${error.message}`);
    }
  }
}

function parseGuideIdNumber(value) {
  const n = Number.parseInt(String(value ?? '').replace(/\D/g, ''), 10);
  return Number.isFinite(n) ? n : 0;
}

function creatorKeyOfRow(row) {
  return row?.creator_name || (row?.batch_key ? `Batch: ${row.batch_key}` : 'Unbekannter Creator');
}

function isEditableDraftTable(tableName) {
  return tableName === 'staging_game_guides' || tableName === 'game_guides_rohmaterial';
}

function areGroupNamesSimilar(nameA, nameB) {
  const a = String(nameA ?? '').trim().toLowerCase();
  const b = String(nameB ?? '').trim().toLowerCase();
  if (!a || !b || a === b) return false;
  if (a.length >= 3 && b.length >= 3 && (a.startsWith(b) || b.startsWith(a) || a.includes(b) || b.includes(a))) {
    return true;
  }
  if (Math.abs(a.length - b.length) > 2) return false;
  const dp = Array.from({ length: a.length + 1 }, (_, i) => i);
  for (let j = 1; j <= b.length; j += 1) {
    let prev = dp[0];
    dp[0] = j;
    for (let i = 1; i <= a.length; i += 1) {
      const temp = dp[i];
      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
      dp[i] = Math.min(dp[i] + 1, dp[i - 1] + 1, prev + cost);
      prev = temp;
    }
  }
  return dp[a.length] <= 2;
}

/**
 * 1. Text-Normalisierung für den Trophäen-Matcher:
 * - Kleinbuchstaben
 * - Entfernt führende Timestamps / Zahlen (z. B. "01 -", "#1", "12:34 -")
 * - Entfernt typische YouTube-Suffixe/Wörter (trophy, guide, achievement, bronze, silver, gold, collectible)
 * - Entfernt Satzzeichen und mehrfache Leerzeichen
 */
export function normalizeForMatch(str) {
  if (!str) return '';
  let s = String(str).toLowerCase().trim();

  // Führende Timestamps wie "01:23 - ", "1:02:03 " entfernen
  s = s.replace(/^(?:\d{1,2}:)+\d{2}\s*[-–—:|.]*\s*/g, '');
  // Führende Nummern/Aufzählungen wie "01 -", "#1", "1.", "(01)" entfernen
  s = s.replace(/^(?:#?\d+|[(\[]\d+[)\]])\s*(?:[-–—:|.]+\s*|\s+)/g, '');
  // Nachgelagerte Timestamps am Ende entfernen
  s = s.replace(/\s*[-–—:|.]*\s*(?:\d{1,2}:)+\d{2}$/g, '');

  // Typische YouTube-Suffixe / Stopwords als ganze Wörter entfernen
  s = s.replace(
    /\b(trophy|trophies|trophäe|trophäen|guide|achievement|achievements|bronze|silver|silber|gold|platinum|platin|collectible|collectibles|sammelobjekt|sammelobjekte|walkthrough|location|locations|fundort|fundorte)\b/gi,
    ' '
  );

  // Satzzeichen & Sonderzeichen durch Leerzeichen ersetzen (Buchstaben inkl. Umlaute & Ziffern behalten)
  s = s.replace(/[^\p{L}\p{N}\s]/gu, ' ');

  // Mehrfache Leerzeichen reduzieren
  return s.replace(/\s+/g, ' ').trim();
}

/**
 * Extrahiert die reine Zahl für staging_game_guides.trophy_id (integer)
 * z. B. 'trophy_12' -> 12, '05' -> 5
 */
export function extractNumericTrophyId(platform_achievement_id, fallbackIndex = 1) {
  const raw = String(platform_achievement_id ?? '').trim();
  const matches = raw.match(/\d+/g);
  if (matches && matches.length > 0) {
    const lastNum = Number.parseInt(matches[matches.length - 1], 10);
    if (Number.isFinite(lastNum)) return lastNum;
  }
  const fb = Number.parseInt(String(fallbackIndex ?? 1), 10);
  return Number.isFinite(fb) ? fb : 1;
}

function escapeRegExp(str) {
  return String(str).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function isWholeWordContained(haystackNorm, needleNorm) {
  if (!haystackNorm || !needleNorm || needleNorm.length < 5) return false;
  const pattern = new RegExp(`(?:^|\\s)${escapeRegExp(needleNorm)}(?:$|\\s)`, 'i');
  return pattern.test(haystackNorm);
}

function DraftInlineInput({
  value = '',
  onCommit,
  className = '',
  onKeyDown,
  readOnly = false,
  ...rest
}) {
  const [localValue, setLocalValue] = useState(value ?? '');
  const [focused, setFocused] = useState(false);
  const externalValue = value ?? '';

  if (!focused && localValue !== externalValue) {
    setLocalValue(externalValue);
  }

  return (
    <input
      {...rest}
      readOnly={readOnly}
      inputMode={readOnly ? 'none' : rest.inputMode}
      tabIndex={readOnly ? -1 : rest.tabIndex}
      value={localValue}
      className={`${className}${readOnly ? ' pointer-events-none' : ''}`}
      onClick={(event) => {
        if (!readOnly) event.stopPropagation();
      }}
      onPointerDown={(event) => {
        if (readOnly) event.preventDefault();
      }}
      onFocus={(event) => {
        if (readOnly) {
          event.currentTarget.blur();
          return;
        }
        setFocused(true);
      }}
      onChange={(event) => setLocalValue(event.target.value)}
      onBlur={() => {
        setFocused(false);
        onCommit?.(localValue);
      }}
      onKeyDown={(event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          event.currentTarget.blur();
        }
        onKeyDown?.(event);
      }}
    />
  );
}

