  return (
    <div className={`${wrap ? 'flex max-w-[22rem] flex-wrap gap-x-3 gap-y-1' : 'flex flex-col gap-1'} ${className}`}>
      {defs.map((def) => (
        <label
          key={def.slug}
          title={def.slug}
          className="inline-flex items-center gap-2 text-[11px] text-zinc-300"
        >
          <input
            type="checkbox"
            checked={chosen.has(homeTagKey(def.slug))}
            disabled={disabled}
