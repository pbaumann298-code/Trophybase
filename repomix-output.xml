          <ul>
            <li><a href="/quickwins">Quickwins</a></li>
            <li><a href="/de/easy-platins">Easy Platins (DE)</a></li>
            <li><a href="/en/easy-platins">Easy Platins (EN)</a></li>
            <li><a href="/de/unerreichbare-platins">Unerreichbare Platins (DE)</a></li>
            <li><a href="/en/unobtainable-platins">Unobtainable Platins (EN)</a></li>
            <li><a href="/kurz-erklaert">Kurz erklärt</a></li>
          </ul>
        </nav>
