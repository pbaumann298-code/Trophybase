      const { data: stagingSummary, error: sRpcErr } = await supabase.rpc('tb_get_staging_queue_summary', {
        p_creator_id: isCreatorMode ? creatorProfile?.id || null : null,
        p_creator_name: isCreatorMode ? creatorProfile?.channel_name || null : null,
      });
      if (sRpcErr) {
        throw new Error(`Fehler beim Laden der Staging-Übersicht: ${sRpcErr.message}`);
      }

      const summary = unwrapRpcSummary(stagingSummary);
      setTotalStagingRows(Number(summary?.total_rows || 0));
      const summaryItems = Array.isArray(summary?.items) ? summary.items : [];
      const stagingSummaryByGameId = new Map();
      for (const item of summaryItems) {
        const gameId = item?.game_id;
        if (!gameId) continue;
        const creators = Array.isArray(item.creators) ? item.creators.filter(Boolean) : [];
        stagingSummaryByGameId.set(gameId, {
          rowCount: Number(item.row_count) || 0,
          creatorCount: Number(item.creator_count) || creators.length,
          creators,
        });
      }

      const countsMap = new Map();
      const creatorCountMap = new Map();
      for (const [gameId, entry] of stagingSummaryByGameId) {
        countsMap.set(gameId, entry.rowCount);
        creatorCountMap.set(gameId, entry.creatorCount);
      }
      const nextGamesMap = await loadGamesByIds([...stagingSummaryByGameId.keys()]);

      const targetGameId =
        preferredGameId ||
        selectedGameIdRef.current ||
        initialGameId ||
        summaryItems[0]?.game_id ||
        null;
      const detailRows = targetGameId
        ? filterRowsForCreator(
            await loadGuideRowsForGame('staging_game_guides', targetGameId),
            isCreatorMode,
            creatorProfile,
          )
        : [];
      const workflowResolved = new Map();
      if (targetGameId && detailRows.length > 0) {
        workflowResolved.set(
          targetGameId,
          resolveQueueWorkflowStatus(
            new Set(
              detailRows.map((row) =>
                String(row.workflow_status ?? 'CREATOR_RECORDING').trim().toUpperCase(),
              ),
            ),
          ),
        );
      }

      setTotalStagingCountsMap(countsMap);
      setTotalStagingCreatorsMap(creatorCountMap);
      setStagingWorkflowByGame(workflowResolved);
      setGamesMap(nextGamesMap);
      setStagingRows(shapeStagingRows(detailRows));
    } catch (err) {
      console.error('Entwürfe-Queue Fehler:', err);
      setStagingRows([]);
      setError(err?.message || 'Unerwarteter Fehler beim Laden der Queue.');
    } finally {
      setLoading(false);
    }
  }, [isCreatorMode, creatorProfile, initialGameId]);

  useEffect(() => {
    fetchQueue();
    if (!isCreatorMode) {
      fetchRohmaterialSummary();
    }
  }, [fetchQueue, fetchRohmaterialSummary, isCreatorMode]);

  // Volle Guide-Zeilen nur für das gerade gewählte Spiel, gefiltert auf diese game_id.
  useEffect(() => {
    if (!selectedGameId) return undefined;
    let cancelled = false;

    async function ensureSelectedGuideRows() {
      try {
        if (activeDataSource === 'rohmaterial') {
          if (rohmaterialRowsRef.current.some((row) => row.game_id === selectedGameId)) return;
          const summary = rohmaterialGamesRef.current.find((item) => item.gameId === selectedGameId);
          if (summary && !(Number(summary.rowCount) > 0)) return;
          const rows = (await loadGuideRowsForGame(TABLES.guidesRohmaterial, selectedGameId)).map(
            (row) => ({
              ...row,
              _sourceTable: TABLES.guidesRohmaterial,
            }),
          );
          if (cancelled || rows.length === 0) return;
          setRohmaterialRows((prev) => {
            if (prev.some((row) => row.game_id === selectedGameId)) return prev;
            return prev.concat(rows);
          });
          return;
        }

        if (stagingRowsRef.current.some((row) => row.game_id === selectedGameId)) return;
        const knownCount = totalStagingCountsRef.current.get(selectedGameId);
        if (knownCount === 0) return;
        const rows = filterRowsForCreator(
          await loadGuideRowsForGame('staging_game_guides', selectedGameId),
          creatorModeRef.current,
          creatorProfileRef.current,
        );
        if (cancelled || rows.length === 0) return;
        const shaped = shapeStagingRows(rows);
        setStagingRows((prev) => {
          if (prev.some((row) => row.game_id === selectedGameId)) return prev;
          return prev.concat(shaped);
        });
        setStagingWorkflowByGame((prev) => {
          const next = new Map(prev);
          next.set(
            selectedGameId,
            resolveQueueWorkflowStatus(
              new Set(
                shaped.map((row) =>
                  String(row.workflow_status ?? 'CREATOR_RECORDING').trim().toUpperCase(),
                ),
              ),
            ),
          );
          return next;
        });
      } catch (err) {
        console.error('Guide-Zeilen für das ausgewählte Spiel konnten nicht geladen werden:', err);
      }
    }

    ensureSelectedGuideRows();
    return () => {
      cancelled = true;
    };
  }, [selectedGameId, activeDataSource]);

  // Load productive game_guides rows when a Rohmaterial game has PENDING_MULTI_TAB in game_guides
  useEffect(() => {
    if (activeDataSource !== 'rohmaterial' || !selectedGameId) {
      setProductiveRohRows([]);
      return undefined;
    }

    let cancelled = false;
    async function loadProductiveForRohmaterial() {
      let rows = [];
      let from = 0;
      const PAGE_SIZE = 1000;

      while (true) {
        const { data, error: gErr } = await supabase
          .from(TABLES.guides)
          .select('*')
          .eq('game_id', selectedGameId)
          .order('id', { ascending: true })
          .range(from, from + PAGE_SIZE - 1);

        if (gErr || cancelled) break;
        const chunk = (data ?? []).map((r) => ({
          ...r,
          creator_name: r.creator_name || 'Produktiver Guide (game_guides)',
          _sourceTable: TABLES.guides,
        }));
        rows = rows.concat(chunk);
        if (chunk.length < PAGE_SIZE) break;
        from += PAGE_SIZE;
      }

      if (!cancelled) {
        setProductiveRohRows(rows);
      }
    }

    loadProductiveForRohmaterial();
    return () => {
      cancelled = true;
    };
  }, [activeDataSource, selectedGameId]);

  // Group staging rows by game_id
  const gameGroups = useMemo(() => {
    const groups = new Map();
    for (const row of stagingRows) {
      if (!row.game_id) continue;
      const list = groups.get(row.game_id) || [];
      list.push(row);
      groups.set(row.game_id, list);
    }
    return groups;
  }, [stagingRows]);

  // Group Rohmaterial & Multi-Tab rows by game_id / key
  const rohGameGroups = useMemo(() => {
    const groups = new Map();
    for (const row of rohmaterialRows) {
      const key = row.game_id || row.platform_game_id || row.batch_key;
      if (!key) continue;
      const list = groups.get(key) || [];
      list.push(row);
      groups.set(key, list);
    }
    if (selectedGameId && productiveRohRows.length > 0) {
      const existing = groups.get(selectedGameId) || [];
      groups.set(selectedGameId, [...existing, ...productiveRohRows]);
    }
    return groups;
  }, [rohmaterialRows, productiveRohRows, selectedGameId]);

  // List of games in staging queue (random order instead of alphabetical)
  const queueGamesList = useMemo(() => {
    const list = [];
    for (const [gameId, indexedCount] of totalStagingCountsMap.entries()) {
      const rows = gameGroups.get(gameId);
      const hasDetail = Array.isArray(rows) && rows.length > 0;
      const game = gamesMap.get(gameId) || { id: gameId };
      const title = getLocalizedTitle(game.spieltitel);
      let creatorCount = totalStagingCreatorsMap.get(gameId) ?? 0;
      let rowCount = indexedCount ?? 0;
      let workflowStatus = stagingWorkflowByGame.get(gameId) || 'CREATOR_RECORDING';
      if (hasDetail) {
        creatorCount = new Set(rows.map((row) => row.creator_name || 'Unbekannt')).size;
        rowCount = rows.length;
        workflowStatus = resolveQueueWorkflowStatus(
          new Set(
            rows.map((row) => String(row.workflow_status ?? 'CREATOR_RECORDING').trim().toUpperCase()),
          ),
        );
      }

      list.push({
        gameId,
        game,
        title,
        platformGameId: game.platform_game_id || (Array.isArray(game.platform_game_id) ? game.platform_game_id[0] : '—'),
        creatorCount,
        rowCount,
        coverUrl: getLocalizedCover(game.cover_url),
        workflowStatus,
        source: 'staging',
      });
    }

    list.sort((a, b) => getGameRandomWeight(a.gameId) - getGameRandomWeight(b.gameId));
    return list;
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [
    totalStagingCountsMap,
    totalStagingCreatorsMap,
    stagingWorkflowByGame,
    gameGroups,
    gamesMap,
    getGameRandomWeight,
    randomSeed,
  ]);

  // Active sidebar list depending on activeDataSource ('staging' vs 'rohmaterial')
  const activeSidebarGamesList = useMemo(() => {
    if (activeDataSource === 'rohmaterial') {
      const list = rohmaterialGames.map((item) => {
        const dynamicCount = rohGameGroups.get(item.gameId)?.length ?? item.rowCount;
        return {
          ...item,
          rowCount: dynamicCount,
          source: 'rohmaterial',
        };
      });
      list.sort((a, b) => getGameRandomWeight(a.gameId) - getGameRandomWeight(b.gameId));
      return list;
    }
    return queueGamesList;
