<file path="src/context/WatchlistContext.jsx">
import { createContext, useCallback, useContext, useEffect, useMemo, useRef, useState } from 'react';
import { supabase } from '../pages/supabaseClient';
import { isUuid } from '../lib/gameModel';
import {
  LOCAL_WATCHLIST_STORAGE_KEY,
  loadLocalWatchlistIds,
  loadWatchlistOwner,
  planWatchlistMerge,
  saveLocalWatchlistIds,
  toggleLocalWatchlistId,
} from '../lib/localWatchlist';
import {
  ensureGameOnWatchlist,
  fetchWatchlistGameIds,
  removeGameFromWatchlist,
} from '../lib/watchlistQueries';

function asWatchlistError(err) {
  return err instanceof Error ? err : new Error('Watchlist konnte nicht aktualisiert werden.');
}

async function pushMissingWatchlistIds(userId, pushIds) {
  const results = await Promise.all(
    pushIds.map((id) => ensureGameOnWatchlist(supabase, userId, id)),
  );
  return results.find((result) => result.error)?.error ?? null;
}

async function reconcileWatchlistCloud(userId, previousIds, nextIds) {
  const prev = new Set((previousIds ?? []).filter((id) => isUuid(id)));
  const next = (nextIds ?? []).filter((id) => isUuid(id));
  const nextSet = new Set(next);
  const jobs = [];

  for (const id of next) {
    if (!prev.has(id)) jobs.push(ensureGameOnWatchlist(supabase, userId, id));
  }
  for (const id of prev) {
    if (!nextSet.has(id)) jobs.push(removeGameFromWatchlist(supabase, userId, id));
  }
  if (jobs.length === 0) return null;

  const results = await Promise.all(jobs);
  return results.find((result) => result.error)?.error ?? null;
}

const WatchlistContext = createContext(null);

export function WatchlistProvider({ sessionUser, children }) {
  const [watchlistIdList, setWatchlistIdList] = useState(loadLocalWatchlistIds);
  const [version, setVersion] = useState(0);
  const [loading, setLoading] = useState(false);
  const idsRef = useRef(watchlistIdList);
  const userIdRef = useRef(sessionUser?.id ?? null);
  idsRef.current = watchlistIdList;
  userIdRef.current = sessionUser?.id ?? null;

  const applyIds = useCallback((ids, { owner, syncCloud = true } = {}) => {
    const previous = idsRef.current;
    const next = saveLocalWatchlistIds(ids, owner);
    idsRef.current = next;
    setWatchlistIdList(next);
    setVersion((v) => v + 1);

    const userId = userIdRef.current;
    const storedOwner = loadWatchlistOwner();
    // Fremde Geräte-Liste (anderer Account) nicht in die Cloud des neuen Users schieben.
    if (userId && syncCloud && (!storedOwner || storedOwner === userId)) {
      void reconcileWatchlistCloud(userId, previous, next).then((error) => {
        if (error) console.warn('Watchlist-Sync:', error.message);
      });
    }
    return next;
  }, []);

  useEffect(() => {
    const userId = sessionUser?.id;
    if (!userId) return undefined;

    let cancelled = false;
    setLoading(true);

    async function mergeWithAccount() {
      const { ids: cloudIds, error } = await fetchWatchlistGameIds(supabase, userId);
      if (cancelled) return;
      if (error) {
        console.warn('Watchlist-Sync:', error.message);
        setLoading(false);
        return;
      }

      let plan = planWatchlistMerge({
        localIds: loadLocalWatchlistIds(),
        cloudIds,
        owner: loadWatchlistOwner(),
        userId,
      });
      let guard = 0;
      while (plan.pushIds.length > 0 && guard < 3 && !cancelled) {
        guard += 1;
        const pushError = await pushMissingWatchlistIds(userId, plan.pushIds);
        if (cancelled) return;
        if (pushError) {
          console.warn('Watchlist-Sync:', pushError.message);
          break;
        }
        plan = planWatchlistMerge({
          localIds: loadLocalWatchlistIds(),
          cloudIds,
          owner: loadWatchlistOwner(),
          userId,
        });
      }

      if (!cancelled) {
        applyIds(plan.ids, { owner: userId, syncCloud: false });
        setLoading(false);
      }
    }

    mergeWithAccount().catch((err) => {
      if (!cancelled) {
        console.warn('Watchlist-Sync:', asWatchlistError(err).message);
        setLoading(false);
      }
    });

    return () => {
      cancelled = true;
    };
  }, [sessionUser?.id, applyIds]);

  useEffect(() => {
    const onStorage = (event) => {
      if (event.key !== LOCAL_WATCHLIST_STORAGE_KEY) return;
      const next = loadLocalWatchlistIds();
      idsRef.current = next;
      setWatchlistIdList(next);
      setVersion((v) => v + 1);
    };
    window.addEventListener('storage', onStorage);
    return () => window.removeEventListener('storage', onStorage);
  }, []);

  const watchlistIds = useMemo(() => new Set(watchlistIdList), [watchlistIdList]);

  const isOnWatchlist = useCallback(
    (gameId) => {
      if (!gameId) return false;
      return watchlistIds.has(String(gameId));
    },
    [watchlistIds],
  );

  const toggleWatchlist = useCallback(async (gameId) => {
    if (!gameId) {
      return { ok: false, added: false, needsLogin: false, error: new Error('Spiel-ID fehlt') };
    }

    let added = false;
    try {
      const result = toggleLocalWatchlistId(gameId);
      added = result.added;
      idsRef.current = result.ids;
      setWatchlistIdList(result.ids);
      setVersion((v) => v + 1);
    } catch (err) {
      return { ok: false, added: false, needsLogin: false, error: asWatchlistError(err) };
    }

    const userId = userIdRef.current;
    if (!userId) return { ok: true, added, needsLogin: false, error: null };

    const cloudResult = added
      ? await ensureGameOnWatchlist(supabase, userId, gameId)
      : await removeGameFromWatchlist(supabase, userId, gameId);

    if (cloudResult.error) {
      try {
        const reverted = toggleLocalWatchlistId(gameId);
        idsRef.current = reverted.ids;
        setWatchlistIdList(reverted.ids);
        setVersion((v) => v + 1);
      } catch {
        /* Lokaler Rollback scheitert – Cloud und Gerät können kurz auseinanderlaufen */
      }
      return { ok: false, added: false, needsLogin: false, error: cloudResult.error };
    }

    return { ok: true, added, needsLogin: false, error: null };
  }, []);

  const value = useMemo(
    () => ({
      watchlistIds,
      watchlistIdList,
      version,
      loading,
      isOnWatchlist,
      toggleWatchlist,
      replaceWatchlistIds: applyIds,
      refreshWatchlist: () => applyIds(loadLocalWatchlistIds()),
      isLoggedIn: !!sessionUser?.id,
    }),
    [watchlistIds, watchlistIdList, version, loading, isOnWatchlist, toggleWatchlist, applyIds, sessionUser?.id],
  );

  return <WatchlistContext.Provider value={value}>{children}</WatchlistContext.Provider>;
}

export function useWatchlist() {
  const ctx = useContext(WatchlistContext);
  if (!ctx) {
    throw new Error('useWatchlist must be used within WatchlistProvider');
  }
  return ctx;
}
</file>

<file path="src/lib/adminAccess.js">
import { ALLOWED_ADMINS, normalizeEmail } from './maintenanceAccess';

export const ADMIN_RETURN_STORAGE_KEY = 'tb_admin_return';
export const ADMIN_TAB_STORAGE_KEY = 'tb_admin_tab';
export const INTRANET_GAME_SEARCH_STORAGE_KEY = 'tb_intranet_game_search';

/** Öffentliche SPA darf /intranet und /admin nicht als Startseite rendern. */
const STAFF_HTML_BY_PATH = {
  '/intranet': '/intranet.html',
  '/admin': '/admin.html',
};

export const AUTH_SESSION_TIMEOUT_MS = 8000;

function pathWithoutTrailingSlash(pathname = '') {
  const path = pathname || (typeof window !== 'undefined' ? window.location.pathname : '');
  if (!path || path === '/') return '/';
  return path.endsWith('/') && path.length > 1 ? path.slice(0, -1) : path;
}

export function staffAppHtmlForPath(pathname) {
  return STAFF_HTML_BY_PATH[pathWithoutTrailingSlash(pathname)] ?? null;
}

export async function getSessionOrTimeout(client, timeoutMs = AUTH_SESSION_TIMEOUT_MS) {
  const timeout = new Promise((resolve) => {
    window.setTimeout(() => {
      resolve({ data: { session: null }, timedOut: true });
    }, timeoutMs);
  });

  try {
    const result = await Promise.race([client.auth.getSession(), timeout]);
    if (result?.timedOut) return { data: { session: null }, timedOut: true };
    return { data: { session: result?.data?.session ?? null }, timedOut: false };
  } catch {
    return { data: { session: null }, timedOut: false };
  }
}

/** Admin hat die Website geöffnet und kann zurück zum Panel. */
export function setAdminReturnFlag(active = true) {
  try {
    if (active) {
      sessionStorage.setItem(ADMIN_RETURN_STORAGE_KEY, '1');
    } else {
      sessionStorage.removeItem(ADMIN_RETURN_STORAGE_KEY);
    }
  } catch {
    /* ignore */
  }
}

export function hasAdminReturnFlag() {
  try {
    return sessionStorage.getItem(ADMIN_RETURN_STORAGE_KEY) === '1';
  } catch {
    return false;
  }
}

export function readAdminTab(fallback = 'database') {
  try {
    const tab = localStorage.getItem(ADMIN_TAB_STORAGE_KEY);
    return tab || fallback;
  } catch {
    return fallback;
  }
}

export function writeAdminTab(tab) {
  try {
    if (tab) localStorage.setItem(ADMIN_TAB_STORAGE_KEY, tab);
    else localStorage.removeItem(ADMIN_TAB_STORAGE_KEY);
  } catch {
    /* ignore */
  }
}

/** Bleibt im JS-Kontext der Admin-Seite erhalten (auch bei Tab-Remount). */
let intranetGameSearchMemory = null;

export function readIntranetGameSearchState() {
  if (intranetGameSearchMemory?.hasSearched) {
    return intranetGameSearchMemory;
  }
  try {
    const raw = localStorage.getItem(INTRANET_GAME_SEARCH_STORAGE_KEY);
    if (!raw) return null;
    const parsed = JSON.parse(raw);
    if (!parsed || typeof parsed !== 'object' || !parsed.hasSearched) return null;
    const state = {
      filters: parsed.filters && typeof parsed.filters === 'object' ? parsed.filters : null,
      hasSearched: true,
      results: Array.isArray(parsed.results) ? parsed.results : [],
      count: Number(parsed.count) || 0,
    };
    intranetGameSearchMemory = state;
    return state;
  } catch {
    return null;
  }
}

export function writeIntranetGameSearchState({
  filters,
  hasSearched,
  results = [],
  count = 0,
}) {
  if (!hasSearched) {
    intranetGameSearchMemory = null;
    try {
      localStorage.removeItem(INTRANET_GAME_SEARCH_STORAGE_KEY);
    } catch {
      /* ignore */
    }
    return;
  }

  const state = {
    filters,
    hasSearched: true,
    results: Array.isArray(results) ? results : [],
    count: Number(count) || 0,
  };
  intranetGameSearchMemory = state;

  try {
    localStorage.setItem(INTRANET_GAME_SEARCH_STORAGE_KEY, JSON.stringify(state));
  } catch {
    // Quota: Filter behalten, Trefferliste weglassen
    try {
      localStorage.setItem(
        INTRANET_GAME_SEARCH_STORAGE_KEY,
        JSON.stringify({ filters, hasSearched: true, results: [], count: state.count }),
      );
    } catch {
      /* ignore */
    }
  }
}

/**
 * Spielvorschau aus Admin/Intranet: Admin-Tab offen lassen (Suche bleibt),
 * Return-Flag setzen. Nur wenn kein neues Fenster geht → gleiche Seite.
 */
export function handleStaffGamePreviewClick(event, href) {
  if (!href) return;
  event.preventDefault();
  setAdminReturnFlag(true);
  const opened = window.open(href, '_blank');
  if (!opened) {
    window.location.assign(href);
  }
}

export function isAdminUser(user) {
  if (!user?.email) return false;
  return ALLOWED_ADMINS.includes(normalizeEmail(user.email));
}

export { ALLOWED_ADMINS };
</file>

<file path="src/lib/betaAccess.js">
export const BETA_TESTER_ROLE = 'beta_tester';

/** Tester_ + genau 5 alphanumerische Zeichen */
export const BETA_TESTER_ID_PATTERN = /^Tester_[A-Za-z0-9]{5}$/;

export function isBetaTester(user) {
  if (!user) return false;
  const role = user.user_metadata?.role ?? user.app_metadata?.role;
  return role === BETA_TESTER_ROLE;
}

export function normalizeBetaTesterId(value) {
  return String(value ?? '').trim();
}

export function betaTesterEmail(testerId) {
  const id = normalizeBetaTesterId(testerId);
  return `${id.toLowerCase()}@beta.trophybase.app`;
}

function mapValidateError(code) {
  switch (code) {
    case 'missing_credentials':
      return 'Bitte Tester-ID und Passwort eingeben.';
    case 'invalid_tester_id_format':
      return 'Tester-ID muss wie Tester_A9k2M aussehen (Tester_ + 5 Zeichen).';
    case 'invalid_credentials':
      return 'Tester-ID oder Passwort ist falsch.';
    case 'already_used':
      return 'Dieser Beta-Zugang wurde bereits von jemand anderem eingelöst.';
    case 'not_authenticated':
      return 'Keine Session – bitte erneut anmelden.';
    default:
      return 'Beta-Zugang konnte nicht geprüft werden.';
  }
}

/**
 * RPC: Zugangsdaten gegen public.beta_testers prüfen.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 */
export async function validateBetaTester(supabase, testerId, password) {
  const id = normalizeBetaTesterId(testerId);
  const pw = String(password ?? '').trim();

  if (!id || !pw) {
    return { ok: false, message: mapValidateError('missing_credentials') };
  }
  if (!BETA_TESTER_ID_PATTERN.test(id)) {
    return { ok: false, message: mapValidateError('invalid_tester_id_format') };
  }

  const { data, error } = await supabase.rpc('tb_validate_beta_tester', {
    p_tester_id: id,
    p_password: pw,
  });

  if (error) {
    return { ok: false, message: error.message || mapValidateError() };
  }

  const payload = data && typeof data === 'object' ? data : {};
  if (!payload.ok) {
    return { ok: false, message: mapValidateError(payload.error) };
  }

  return {
    ok: true,
    testerId: payload.tester_id || id,
    email: payload.email || betaTesterEmail(id),
    alreadyClaimedByYou: Boolean(payload.already_claimed_by_you),
  };
}

/**
 * RPC: Slot dem aktuellen Auth-User zuordnen.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 */
export async function claimBetaTester(supabase, testerId, password) {
  const id = normalizeBetaTesterId(testerId);
  const pw = String(password ?? '').trim();

  const { data, error } = await supabase.rpc('tb_claim_beta_tester', {
    p_tester_id: id,
    p_password: pw,
  });

  if (error) {
    return { ok: false, message: error.message || mapValidateError() };
  }

  const payload = data && typeof data === 'object' ? data : {};
  if (!payload.ok) {
    return { ok: false, message: mapValidateError(payload.error) };
  }

  return { ok: true, testerId: payload.tester_id || id, email: payload.email };
}

/**
 * Rolle beta_tester in user_metadata setzen.
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 * @param {string} [testerId]
 */
export async function markBetaTesterRole(supabase, testerId) {
  const { data, error } = await supabase.auth.updateUser({
    data: {
      role: BETA_TESTER_ROLE,
      ...(testerId ? { tester_id: normalizeBetaTesterId(testerId) } : {}),
    },
  });
  if (error) return { ok: false, message: error.message, user: null };
  return { ok: true, user: data.user };
}

/**
 * /beta-Login: Tester-ID + Passwort → Session + Rolle.
 * Legt den Auth-User bei Bedarf an (Confirm-Email sollte in der Beta aus sein).
 * @param {import('@supabase/supabase-js').SupabaseClient} supabase
 */
export async function signInWithBetaTesterKeys(supabase, testerId, password) {
  const validated = await validateBetaTester(supabase, testerId, password);
  if (!validated.ok) return validated;

  const email = validated.email;
  const pw = String(password ?? '').trim();
  const id = validated.testerId;

  let user = null;
  let session = null;

  const { data: signInData, error: signInError } = await supabase.auth.signInWithPassword({
    email,
    password: pw,
  });

  if (!signInError && signInData?.session?.user) {
    user = signInData.session.user;
    session = signInData.session;
  } else {
    const { data: signUpData, error: signUpError } = await supabase.auth.signUp({
      email,
      password: pw,
      options: {
        data: {
          role: BETA_TESTER_ROLE,
          tester_id: id,
        },
      },
    });

    if (signUpError) {
      const already =
        /already registered|already exists|user already/i.test(signUpError.message || '');
      if (already) {
        return {
          ok: false,
          message:
            'Zugang existiert, Login fehlgeschlagen. Passwort prüfen oder in Supabase zurücksetzen.',
        };
      }
      return { ok: false, message: signUpError.message };
    }

    if (signUpData.session?.user) {
      user = signUpData.session.user;
      session = signUpData.session;
    } else {
      const retry = await supabase.auth.signInWithPassword({ email, password: pw });
      if (retry.error || !retry.data.session?.user) {
        return {
          ok: false,
          message:
            retry.error?.message ||
            'Account angelegt, aber keine Session. In Supabase „Confirm email“ für die Beta ggf. deaktivieren.',
        };
      }
      user = retry.data.session.user;
      session = retry.data.session;
    }
  }

  const claim = await claimBetaTester(supabase, id, pw);
  if (!claim.ok) {
    return { ok: false, message: claim.message };
  }

  if (!isBetaTester(user)) {
    const marked = await markBetaTesterRole(supabase, id);
    if (!marked.ok) return { ok: false, message: marked.message };
    user = marked.user ?? user;
  }

  return { ok: true, user, session, testerId: id, email };
}

/** @deprecated Alte Invite-Key-Tabelle; bleibt für Referenz. */
export async function redeemInviteKey(supabase, userKey, currentUserId) {
  void supabase;
  void userKey;
  void currentUserId;
  return {
    ok: false,
    message: 'Alte Invite-Keys sind abgelöst. Bitte Tester-ID + Passwort auf /beta nutzen.',
  };
}
