            className="w-full mt-2 bg-[#00ff66] text-black font-semibold text-sm py-2.5 rounded-xl hover:bg-[#00e65c] transition shadow-lg shadow-[#00ff66]/10"
          >
            Meinen Account aktivieren & starten 🚀
          </button>
        </form>
      </div>
    </div>
  );
}

export default TesterSetupPage;
