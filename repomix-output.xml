        if (id !== rowId) return row;
        return {
          ...row,
          ...(patch.prod_note !== undefined ? { prod_note: patch.prod_note } : {}),
          ...(patch.video_url !== undefined ? { video_url: patch.video_url } : {}),
        };
      });
    setChapterRows(applyPatch);
    setGuideRows(applyPatch);
    setBossRows(applyPatch);
  }, []);

  useEffect(() => {
